import AllCharacteristics.CoordinateCharts
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Maps

/-!
# Coefficient maps on homogeneous coordinate rings

Coefficient change descends through homogeneous ideals, preserves the grading,
and carries the homogeneous coordinates to the corresponding coordinates.
The irrelevant-ideal condition needed for a global Proj morphism follows.
-/

open MvPolynomial HomogeneousIdeal
namespace AllCharacteristics
namespace HomogeneousProjective
universe u
variable {R S : Type u} {σ : Type} [CommRing R] [CommRing S]
attribute [local instance] MvPolynomial.gradedAlgebra
variable (f : R →+* S)
variable (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule σ R))
variable (J : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule σ S))
variable (h : I.toIdeal.map (MvPolynomial.map f) = J.toIdeal)

/-- The map of homogeneous coordinate rings induced by coefficient change. -/
noncomputable def coordinateCoefficientMap : CoordinateRing I →+* CoordinateRing J :=
  Ideal.quotientMap J.toIdeal (MvPolynomial.map f)
    (Ideal.map_le_iff_le_comap.mp h.le)

/-- The coefficient map takes a polynomial class to its mapped class. -/
theorem coordinateCoefficientMap_mk (p : MvPolynomial σ R) :
    coordinateCoefficientMap f I J h (Ideal.Quotient.mk I.toIdeal p) =
      Ideal.Quotient.mk J.toIdeal (p.map f) := Ideal.quotientMap_mk

/-- Coefficient change preserves each homogeneous degree of the quotient. -/
theorem coordinateCoefficientMap_mem {n : ℕ} {x : CoordinateRing I}
    (hx : x ∈ grading I n) : coordinateCoefficientMap f I J h x ∈ grading J n := by
  obtain ⟨p, hp, rfl⟩ := hx
  exact ⟨p.map f, hp.map f, (coordinateCoefficientMap_mk f I J h p).symm⟩

/-- Coefficient change as a homomorphism of graded coordinate rings. -/
noncomputable def gradedCoefficientMap : grading I →+*ᵍ grading J where
  __ := coordinateCoefficientMap f I J h
  map_mem hx := coordinateCoefficientMap_mem f I J h hx

/-- The graded coefficient map preserves each homogeneous coordinate. -/
theorem gradedCoefficientMap_coordinate (j : σ) :
    gradedCoefficientMap f I J h (coordinate I j) = coordinate J j := by
  change coordinateCoefficientMap f I J h (Ideal.Quotient.mk I.toIdeal (X j)) = _
  rw [coordinateCoefficientMap_mk, map_X]
  rfl

/-- The target irrelevant ideal is generated by images of the source
irrelevant ideal, so coefficient change induces a global projective morphism. -/
theorem irrelevant_le_map_gradedCoefficientMap :
    irrelevant (grading J) ≤ (irrelevant (grading I)).map (gradedCoefficientMap f I J h) := by
  change (irrelevant (grading J)).toIdeal ≤
    ((irrelevant (grading I)).map (gradedCoefficientMap f I J h)).toIdeal
  rw [HomogeneousIdeal.toIdeal_map, irrelevant_eq_coordinateIdeal,
    irrelevant_eq_coordinateIdeal, Ideal.map_span]
  apply Ideal.span_le.mpr
  rintro _ ⟨j, rfl⟩
  exact Ideal.subset_span ⟨coordinate I j, ⟨j, rfl⟩,
    gradedCoefficientMap_coordinate f I J h j⟩

end HomogeneousProjective
end AllCharacteristics
