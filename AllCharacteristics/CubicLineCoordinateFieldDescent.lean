import Mathlib.RingTheory.Unramified.Field
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.LinearAlgebra.Dual.Lemmas

/-!
A field-theoretic alternative to constructing the whole Fano scheme of
lines. A line graph has four coordinates. If its coordinate field is
generated by these coordinates and every scalar derivation kills them,
then that field is formally unramified. Over an algebraically closed ground
field the coordinate field is the ground field.
-/

noncomputable section

namespace AllCharacteristics

universe u

variable {K L : Type u} [Field K] [Field L] [Algebra K L]

/-- The actual field generated by graph coordinates, with no field-generation
certificate supplied by a caller. -/
def cubicLineCoordinateSubfield {ι : Type*} (a : ι → L) : IntermediateField K L :=
  IntermediateField.adjoin K (Set.range a)

def cubicLineCoordinateInSubfield {ι : Type*} (a : ι → L) (i : ι) :
    cubicLineCoordinateSubfield (K := K) a :=
  ⟨a i, IntermediateField.subset_adjoin K (Set.range a) ⟨i, rfl⟩⟩

/-- The own-coordinate field has precisely the asserted coordinate
generators. This constructs the generation hypothesis of the descent leaf. -/
theorem cubicLineCoordinateInSubfield_adjoin_eq_top
    {ι : Type*} (a : ι → L) :
    IntermediateField.adjoin K (Set.range (cubicLineCoordinateInSubfield (K := K) a)) = ⊤ := by
  let F := cubicLineCoordinateSubfield (K := K) a
  apply IntermediateField.map_injective F.val
  rw [IntermediateField.adjoin_map, ← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val]
  have himage : F.val '' Set.range (cubicLineCoordinateInSubfield (K := K) a) = Set.range a := by
    rw [← Set.range_comp]
    rfl
  rw [himage]
  rfl

/-- A derivation that kills field generators vanishes on the generated
field. The inverse step is included, so algebra generators are not required. -/
theorem cubicLine_derivation_eq_zero_of_field_generators
    {ι : Type*} (a : ι → L)
    (hgen : IntermediateField.adjoin K (Set.range a) = ⊤)
    (D : Derivation K L L) (ha : ∀ i, D (a i) = 0) : D = 0 := by
  ext x
  change D x = 0
  have hx : x ∈ IntermediateField.adjoin K (Set.range a) := by rw [hgen]; trivial
  apply IntermediateField.adjoin_induction K
    (p := fun x _ => D x = 0) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨i, rfl⟩
    exact ha i
  · intro r
    exact D.map_algebraMap r
  · intro x y _ _ hx hy
    rw [map_add, hx, hy, add_zero]
  · intro x _ hx
    rw [D.leibniz_inv, hx, smul_zero]
  · intro x y _ _ hx hy
    rw [D.leibniz, hx, hy, smul_zero, smul_zero, add_zero]

/-- Scalar derivations detect the whole module of differentials over a
field. Thus absence of scalar derivations proves formal unramifiedness. -/
theorem cubicLine_formallyUnramified_of_scalar_derivations_eq_zero
    (hD : ∀ D : Derivation K L L, D = 0) : Algebra.FormallyUnramified K L := by
  have hsub : Subsingleton Ω[L⁄K] := by
    apply (subsingleton_iff_forall_eq (0 : Ω[L⁄K])).2
    intro v
    apply (Module.forall_dual_apply_eq_zero_iff L v).1
    intro φ
    have hφ : φ = 0 := by
      apply (KaehlerDifferential.linearMapEquivDerivation K L).injective
      simpa only [map_zero] using hD ((KaehlerDifferential.linearMapEquivDerivation K L) φ)
    rw [hφ, LinearMap.zero_apply]
  exact ⟨hsub⟩

/-- Finitely many rigid line coordinates over an algebraically closed field
already belong to that field. This replaces the finite-line parameter-space
argument once rigidity of the actual graph equations has been proved. -/
theorem cubicLine_fieldCoordinates_descend_of_scalar_rigidity
    [IsAlgClosed K] {ι : Type*} [Finite ι]
    (a : ι → L)
    (hgen : IntermediateField.adjoin K (Set.range a) = ⊤)
    (hrigid : ∀ D : Derivation K L L, ∀ i, D (a i) = 0) :
    Function.Bijective (algebraMap K L) := by
  letI : Algebra.FormallyUnramified K L :=
    cubicLine_formallyUnramified_of_scalar_derivations_eq_zero
      (fun D => cubicLine_derivation_eq_zero_of_field_generators a hgen D (hrigid D))
  have hfg : (⊤ : IntermediateField K L).FG := by
    rw [← hgen]
    exact IntermediateField.fg_adjoin_of_finite (Set.finite_range a)
  letI : Algebra.EssFiniteType K L := IntermediateField.fg_top_iff.mp hfg
  exact Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing K L

end AllCharacteristics
