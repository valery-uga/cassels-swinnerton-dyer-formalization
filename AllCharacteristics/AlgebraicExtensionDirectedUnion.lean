import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# Algebraic extensions as directed unions of finite subextensions

The arbitrary algebraic residue-extension step in the Cohen-ring construction
is indexed by finite subsets of the target field.  This file gives the field
theory facts needed at that limit stage.
-/

namespace AllCharacteristics

universe u

section

variable {K L : Type u} [Field K] [Field L] [Algebra K L]

/-- The finite subextension generated by a finite set of elements. -/
abbrev algebraicFiniteSubextension (s : Finset L) : IntermediateField K L :=
  IntermediateField.adjoin K (s : Set L)

/-- In an algebraic extension, every subextension generated by finitely many
elements is finite-dimensional. -/
theorem finiteDimensional_algebraicFiniteSubextension
    [Algebra.IsAlgebraic K L] (s : Finset L) :
    FiniteDimensional K (algebraicFiniteSubextension (K := K) s) := by
  apply IntermediateField.finiteDimensional_adjoin
  intro x hx
  exact (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

/-- Inclusion of finite sets induces inclusion of their generated
subextensions. -/
theorem algebraicFiniteSubextension_mono {s t : Finset L} (hst : s ≤ t) :
    algebraicFiniteSubextension (K := K) s ≤ algebraicFiniteSubextension (K := K) t := by
  rw [IntermediateField.adjoin_le_iff]
  intro x hx
  apply IntermediateField.subset_adjoin K (t : Set L)
  simpa using hst hx

/-- Two finite subextensions have a common finite overfield. -/
theorem algebraicFiniteSubextension_union
    [DecidableEq L] (s t : Finset L) :
    algebraicFiniteSubextension (K := K) s ≤
      algebraicFiniteSubextension (K := K) (s ∪ t) ∧
    algebraicFiniteSubextension (K := K) t ≤
      algebraicFiniteSubextension (K := K) (s ∪ t) :=
  ⟨algebraicFiniteSubextension_mono ((Finset.subset_union_left : s ≤ s ∪ t)),
    algebraicFiniteSubextension_mono ((Finset.subset_union_right : t ≤ s ∪ t))⟩

/-- An algebraic field extension is the directed union of the finite
subextensions generated by finite subsets. -/
theorem iSup_algebraicFiniteSubextension
    [Algebra.IsAlgebraic K L] :
    ⨆ s : Finset L, algebraicFiniteSubextension (K := K) s = ⊤ := by
  apply top_unique
  intro x hx
  let s : Finset L := {x}
  have hmem : x ∈ algebraicFiniteSubextension (K := K) s := by
    apply IntermediateField.subset_adjoin
    simp [s]
  exact (show algebraicFiniteSubextension (K := K) s ≤
    ⨆ s : Finset L, algebraicFiniteSubextension (K := K) s from le_iSup _ s) hmem

end

end AllCharacteristics
