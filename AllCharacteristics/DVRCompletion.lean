import AllCharacteristics.SeparatedPrincipalLocalRing
import AllCharacteristics.SurjectiveResiduePresentation
import Mathlib.RingTheory.AdicCompletion.LocalRing
import Mathlib.RingTheory.AdicCompletion.Noetherian
import Mathlib.Algebra.CharP.Algebra

/-!
# Completing a DVR while preserving its specified residue field

The maximal-ideal completion of a DVR is proved to be a domain and a DVR.
Its coefficient map is injective, its maximal ideal is generated by the
original uniformizer, and any prescribed residue-field surjection extends
surjectively and compatibly. Thus completion supplies the required complete
lifting base without a prior domain assumption on the completion.
-/

open IsLocalRing
namespace AllCharacteristics
universe u v
variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- The coefficient map from a DVR into its maximal-ideal completion is
injective, by noetherian adic separatedness. -/
theorem dvrCompletion_algebraMap_injective :
    Function.Injective (algebraMap R (AdicCompletion (maximalIdeal R) R)) :=
  AdicCompletion.of_injective (maximalIdeal R) R

/-- A uniformizer of the original DVR generates the completed maximal ideal. -/
theorem dvrCompletion_maximalIdeal (t : R) (ht : Irreducible t) :
    maximalIdeal (AdicCompletion (maximalIdeal R) R) =
      Ideal.span {algebraMap R (AdicCompletion (maximalIdeal R) R) t} := by
  rw [AdicCompletion.maximalIdeal_eq_map, ht.maximalIdeal_eq, Ideal.map_span,
    Set.image_singleton]

/-- The maximal-ideal completion of a DVR is a domain. -/
instance dvrCompletion_isDomain : IsDomain (AdicCompletion (maximalIdeal R) R) := by
  obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible R
  apply isDomain_of_separated_principal_maximalIdeal _ (dvrCompletion_maximalIdeal t ht)
  rintro ⟨n, hn⟩
  have he : t ^ n = 0 := dvrCompletion_algebraMap_injective
    (by simpa only [map_pow, map_zero] using hn)
  exact pow_ne_zero n ht.ne_zero he

/-- The maximal-ideal completion of a DVR is again a DVR. -/
instance dvrCompletion_isDiscreteValuationRing :
    IsDiscreteValuationRing (AdicCompletion (maximalIdeal R) R) := by
  obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible R
  apply isDiscreteValuationRing_of_separated_principal_maximalIdeal _
    (dvrCompletion_maximalIdeal t ht)
  intro he
  exact ht.ne_zero (dvrCompletion_algebraMap_injective
    (he.trans (map_zero (algebraMap R (AdicCompletion (maximalIdeal R) R))).symm))

/-- A uniformizer remains irreducible after maximal-ideal completion of a
DVR.  This supplies the uniformizer invariant at a limit stage of a directed
tower of complete DVR lifts. -/
theorem dvrCompletion_uniformizer_irreducible
    (t : R) (ht : Irreducible t) :
    Irreducible (algebraMap R (AdicCompletion (maximalIdeal R) R) t) := by
  have hne : algebraMap R (AdicCompletion (maximalIdeal R) R) t ≠ 0 := by
    intro h
    exact ht.ne_zero (dvrCompletion_algebraMap_injective
      (h.trans (map_zero (algebraMap R (AdicCompletion (maximalIdeal R) R))).symm))
  exact IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hne
    (dvrCompletion_maximalIdeal t ht)

/-- Completion preserves characteristic zero for a DVR. -/
theorem dvrCompletion_charZero [CharZero R] :
    CharZero (AdicCompletion (maximalIdeal R) R) :=
  charZero_of_injective_algebraMap dvrCompletion_algebraMap_injective

/-- Extend a prescribed residue-field surjection to the completion. -/
noncomputable def dvrCompletionResidueMap
    {k : Type v} [Field k] (b : R →+* k) (hb : Function.Surjective b) :
    AdicCompletion (maximalIdeal R) R →+* k :=
  (residueEquivOfSurjective b hb).toRingHom.comp
    (AdicCompletion.evalOneₐ (maximalIdeal R)).toRingHom

/-- The residue map of the completion is surjective onto the specified field. -/
theorem dvrCompletionResidueMap_surjective
    {k : Type v} [Field k] (b : R →+* k) (hb : Function.Surjective b) :
    Function.Surjective (dvrCompletionResidueMap b hb) :=
  (residueEquivOfSurjective b hb).surjective.comp
    (AdicCompletion.evalOneₐ_surjective (maximalIdeal R))

/-- Completion retains the exact original coefficient reduction. -/
theorem dvrCompletionResidueMap_algebraMap
    {k : Type v} [Field k] (b : R →+* k) (hb : Function.Surjective b) (r : R) :
    dvrCompletionResidueMap b hb (algebraMap R (AdicCompletion (maximalIdeal R) R) r) =
      b r :=
  residueEquivOfSurjective_residue b hb r

/-- Every characteristic-zero DVR with a specified residue field admits a
complete characteristic-zero DVR lift of the same field, compatibly with the
original coefficient ring. -/
theorem exists_completeDVR_of_DVR_residue [CharZero R]
    {k : Type v} [Field k] (b : R →+* k) (hb : Function.Surjective b) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra R A) (_ : IsDomain A)
      (_ : IsDiscreteValuationRing A) (_ : IsAdicComplete (maximalIdeal A) A)
      (_ : CharZero A) (c : A →+* k),
      Function.Surjective c ∧ ∀ r : R, c (algebraMap R A r) = b r := by
  have := dvrCompletion_charZero (R := R)
  exact ⟨AdicCompletion (maximalIdeal R) R, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, dvrCompletionResidueMap b hb,
    dvrCompletionResidueMap_surjective b hb, dvrCompletionResidueMap_algebraMap b hb⟩

end AllCharacteristics
