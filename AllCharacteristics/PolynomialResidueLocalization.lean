import AllCharacteristics.PrincipalPrimeLocalization
import AllCharacteristics.LocalizationDomainResidue
import Mathlib.RingTheory.AdicCompletion.Noetherian
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Algebra.MvPolynomial.NoZeroDivisors

/-!
# DVRs with rational function residue fields

Reduce the coefficients of a multivariate polynomial ring over a DVR and
localize at the kernel. The kernel is generated by the original uniformizer.
Each nonzero polynomial has finite uniformizer multiplicity, as follows
coefficient by coefficient from separatedness of the original DVR. Thus this
localization is a DVR for any set of variables, including infinite sets.
-/

open IsLocalRing
namespace AllCharacteristics
universe u
variable {R k : Type u} [CommRing R] [Field k]

/-- The prime consisting of polynomials whose coefficients all reduce to zero. -/
noncomputable abbrev polynomialResiduePrime (σ : Type u) (b : R →+* k) : Ideal (MvPolynomial σ R) :=
  RingHom.ker (MvPolynomial.map b)

/-- Coefficient reduction has prime kernel because its target is a domain. -/
instance polynomialResiduePrime_isPrime (σ : Type u) (b : R →+* k) :
    (polynomialResiduePrime σ b).IsPrime :=
  RingHom.ker_isPrime (MvPolynomial.map b)

/-- The polynomial coefficient kernel is generated by the coefficient-ring
uniformizer. -/
theorem polynomialResiduePrime_eq_span [IsLocalRing R]
    (σ : Type u) (b : R →+* k) (hb : Function.Surjective b)
    (t : R) (ht : maximalIdeal R = Ideal.span {t}) :
    polynomialResiduePrime σ b = Ideal.span {MvPolynomial.C t} := by
  have hr : ∀ r : R, b r = 0 ↔ t ∣ r := by
    intro r
    change r ∈ RingHom.ker b ↔ t ∣ r
    rw [IsLocalRing.ker_eq_maximalIdeal b hb, ht, Ideal.mem_span_singleton]
  ext p
  rw [Ideal.mem_span_singleton]
  exact (MvPolynomial.C_dvd_iff_map_hom_eq_zero b t hr p).symm

/-- Uniformizer multiplicity is finite in every nonzero multivariate
polynomial, with no finiteness assumption on the variable set. -/
theorem polynomial_uniformizer_finiteMultiplicity [IsDomain R] [IsDiscreteValuationRing R]
    {σ : Type u} (t : R) (ht : Irreducible t)
    (p : MvPolynomial σ R) (hp : p ≠ 0) : FiniteMultiplicity (MvPolynomial.C t) p := by
  by_contra h
  have hall := FiniteMultiplicity.not_iff_forall.mp h
  apply hp
  ext d
  change MvPolynomial.coeff d p = 0
  apply IsHausdorff.haus (I := maximalIdeal R) inferInstance (MvPolynomial.coeff d p)
  intro n
  rw [SModEq.zero, smul_eq_mul, Ideal.mul_top, ht.maximalIdeal_eq,
    Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  apply (MvPolynomial.C_dvd_iff_dvd_coeff (t ^ n) p).mp ?_ d
  simpa only [map_pow] using hall n

/-- The localization of the coefficient kernel is a DVR in any number of
polynomial variables. -/
theorem polynomialResidueLocalization_isDiscreteValuationRing
    [IsDomain R] [IsDiscreteValuationRing R]
    (σ : Type u) (b : R →+* k) (hb : Function.Surjective b) :
    IsDiscreteValuationRing (Localization.AtPrime (polynomialResiduePrime σ b)) := by
  obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible R
  exact isDiscreteValuationRing_atPrincipalPrime (polynomialResiduePrime σ b)
    (MvPolynomial.C t) (by simpa using ht.ne_zero)
    (polynomialResiduePrime_eq_span σ b hb t ht.maximalIdeal_eq)
    (polynomial_uniformizer_finiteMultiplicity t ht)

/-- The localized polynomial residue map is surjective onto the rational
function field with precisely the specified residue coefficients. -/
theorem polynomialResidueLocalization_surjective
    (σ : Type u) (b : R →+* k) (hb : Function.Surjective b) :
    Function.Surjective
      (localizationResidueMap (MvPolynomial.map b) (polynomialResiduePrime σ b) rfl) :=
  localizationResidueMap_surjective (MvPolynomial.map b) (MvPolynomial.map_surjective b hb)
    (polynomialResiduePrime σ b) rfl

end AllCharacteristics
