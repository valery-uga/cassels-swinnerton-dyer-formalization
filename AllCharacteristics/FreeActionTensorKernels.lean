import AllCharacteristics.InvariantTensorEvaluation
import AllCharacteristics.RingHomChineseRemainder

/-!
# Comaximal tensor kernels for a scheme-theoretically free action

The absence of fixed points is expressed by the actual ideals generated by
`b - g • b`. If these ideals are the whole ring for nonidentity elements,
the evaluations on the tensor square have pairwise comaximal kernels.
-/

open scoped TensorProduct
namespace AllCharacteristics
universe u v
variable (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
variable (G : Type v) [Group G] [MulSemiringAction G B] [SMulCommClass G R B]

/-- The actual ideal defining the affine fixed locus of an action element. -/
noncomputable def actionDifferenceIdeal (g : G) : Ideal B :=
  Ideal.span (Set.range fun b : B ↦ b - g • b)

/-- Empty affine fixed loci make distinct tensor evaluations have comaximal kernels. -/
theorem invariantTensorEvaluation_coprime_kernels
    (hfree : ∀ g : G, g ≠ 1 → actionDifferenceIdeal B G g = ⊤) :
    Pairwise (fun g h ↦ IsCoprime
      (RingHom.ker (invariantTensorEvaluation R B G g).toRingHom)
      (RingHom.ker (invariantTensorEvaluation R B G h).toRingHom)) := by
  intro g h hgh
  let I := FixedPoints.subalgebra R B G
  let T := B ⊗[I] B
  let j : B →+* T := Algebra.TensorProduct.includeLeftRingHom
  let J : Ideal T := RingHom.ker (invariantTensorEvaluation R B G g).toRingHom ⊔
    RingHom.ker (invariantTensorEvaluation R B G h).toRingHom
  have hne : h * g⁻¹ ≠ 1 := by
    intro he
    apply hgh
    exact (mul_inv_eq_one.mp he).symm
  have hle : actionDifferenceIdeal B G (h * g⁻¹) ≤ J.comap j := by
    apply Ideal.span_le.mpr
    rintro _ ⟨b, rfl⟩
    let c : B := g⁻¹ • b
    have hc : g • c = b := by simp [c]
    have hgmem : j b - (1 ⊗ₜ[I] c) ∈
        RingHom.ker (invariantTensorEvaluation R B G g).toRingHom := by
      change invariantTensorEvaluation R B G g (j b - (1 ⊗ₜ[I] c)) = 0
      rw [map_sub]
      change b * (g • (1 : B)) - 1 * (g • c) = 0
      simp only [smul_one, mul_one, one_mul, hc, sub_self]
    have hhmem : j (h • c) - (1 ⊗ₜ[I] c) ∈
        RingHom.ker (invariantTensorEvaluation R B G h).toRingHom := by
      change invariantTensorEvaluation R B G h (j (h • c) - (1 ⊗ₜ[I] c)) = 0
      rw [map_sub]
      change (h • c) * (h • (1 : B)) - 1 * (h • c) = 0
      simp only [smul_one, mul_one, one_mul, sub_self]
    have hs : (j b - (1 ⊗ₜ[I] c)) - (j (h • c) - (1 ⊗ₜ[I] c)) ∈ J :=
      J.sub_mem (Submodule.mem_sup_left hgmem) (Submodule.mem_sup_right hhmem)
    change j (b - (h * g⁻¹) • b) ∈ J
    rw [map_sub, mul_smul]
    convert hs using 1; ring
  rw [hfree _ hne] at hle
  apply Ideal.isCoprime_iff_sup_eq.mpr
  apply (Ideal.eq_top_iff_one _).mpr
  have hm : (1 : B) ∈ J.comap j := hle (by trivial)
  change j 1 ∈ J at hm
  simpa only [map_one] using hm

/-- Under the actual no-fixed-locus ideal condition, tensor evaluation onto
all group components is surjective, with no restriction on the group order. -/
theorem invariantTensorEvaluation_pi_surjective [Finite G]
    (hfree : ∀ g : G, g ≠ 1 → actionDifferenceIdeal B G g = ⊤) :
    Function.Surjective (fun t g ↦ invariantTensorEvaluation R B G g t) :=
  ringHom_pi_surjective_of_coprime_kernels
    (fun g ↦ (invariantTensorEvaluation R B G g).toRingHom)
    (invariantTensorEvaluation_surjective R B G)
    (invariantTensorEvaluation_coprime_kernels R B G hfree)

end AllCharacteristics
