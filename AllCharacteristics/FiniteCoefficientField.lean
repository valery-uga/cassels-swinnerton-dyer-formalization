import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Finitely generated fields containing prescribed coefficient data

A finite set in a field generates a finitely generated subfield. A homogeneous
polynomial descends to any subfield containing its coefficients, retaining its
exact mapped equation and degree. Auxiliary finite coefficient data can be
included in the same subfield for later point and extension descent.
-/

namespace AllCharacteristics
universe u v
variable {k : Type u} [Field k]

/-- The subfield generated by a finite set is finitely generated as a field. -/
theorem fieldFG_closure_finset (s : Finset k) : Field.FG (Subfield.closure (s : Set k)) := by
  classical
  let F := Subfield.closure (s : Set k)
  let t : Finset F := s.attach.image (fun x ↦ ⟨x.1, Subfield.subset_closure x.2⟩)
  refine ⟨t, top_unique ?_⟩
  intro x _
  apply Subfield.closure_induction
    (p := fun y hy ↦ (⟨y, hy⟩ : F) ∈ Subfield.closure (t : Set F))
    (h := x.property)
  · intro y hy
    apply Subfield.subset_closure
    change (⟨y, _⟩ : F) ∈ t
    exact Finset.mem_image.mpr ⟨⟨y, hy⟩, Finset.mem_attach _ _, rfl⟩
  · exact Subfield.one_mem _
  · intro a b ha hb hma hmb
    exact Subfield.add_mem _ hma hmb
  · intro a ha hma
    exact Subfield.neg_mem _ hma
  · intro a ha hma
    exact Subfield.inv_mem _ hma
  · intro a b ha hb hma hmb
    exact Subfield.mul_mem _ hma hmb

/-- Every finite set of field elements is contained in a finitely generated
subfield of the original field. -/
theorem exists_fg_subfield_containing_finset (s : Finset k) :
    ∃ F : Subfield k, Field.FG F ∧ (s : Set k) ⊆ F :=
  ⟨Subfield.closure (s : Set k), fieldFG_closure_finset s, Subfield.subset_closure⟩

/-- A polynomial is defined over any subfield containing all its coefficients. -/
theorem exists_polynomial_over_subfield {σ : Type v}
    (F : Subfield k) (p : MvPolynomial σ k) (hc : (p.coeffs : Set k) ⊆ F) :
    ∃ q : MvPolynomial σ F, q.map F.subtype = p := by
  apply MvPolynomial.mem_range_map_iff_coeffs_subset.mpr
  intro c hc'
  exact ⟨⟨c, hc hc'⟩, rfl⟩

/-- Descent of polynomial coefficients retains homogeneity of the same degree. -/
theorem exists_homogeneous_polynomial_over_subfield {σ : Type v}
    (F : Subfield k) (p : MvPolynomial σ k) {d : ℕ} (hp : p.IsHomogeneous d)
    (hc : (p.coeffs : Set k) ⊆ F) :
    ∃ q : MvPolynomial σ F, ∃ _hq : q.IsHomogeneous d, q.map F.subtype = p := by
  obtain ⟨q, he⟩ := exists_polynomial_over_subfield F p hc
  have hq : q.IsHomogeneous d := .of_map F.subtype.injective (he.symm ▸ hp)
  exact ⟨q, hq, he⟩

/-- A homogeneous equation and arbitrary auxiliary finite coefficient data
descend together to one finitely generated subfield. -/
theorem exists_fg_subfield_homogeneous_model {σ : Type v}
    (p : MvPolynomial σ k) {d : ℕ} (hp : p.IsHomogeneous d) (s : Finset k) :
    ∃ F : Subfield k, Field.FG F ∧ (s : Set k) ⊆ F ∧
      ∃ q : MvPolynomial σ F, ∃ _hq : q.IsHomogeneous d, q.map F.subtype = p := by
  classical
  obtain ⟨F, hF, hc⟩ := exists_fg_subfield_containing_finset (s ∪ p.coeffs)
  refine ⟨F, hF, ?_, exists_homogeneous_polynomial_over_subfield F p hp ?_⟩
  · intro x hx
    exact hc (Finset.mem_union_left _ hx)
  · intro x hx
    exact hc (Finset.mem_union_right _ hx)

end AllCharacteristics
