import AllCharacteristics.FiniteFieldLifting
import AllCharacteristics.RegularLocalLowDimension
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.Algebra.CharP.Algebra

/-!
# Extending a complete DVR lift through a finite residue extension

The previously constructed finite free local lift of a residue extension is
itself a DVR: its maximal ideal remains generated by the original uniformizer,
which remains nonnilpotent by faithful freeness. Thus complete characteristic-zero
DVR lifts extend through arbitrary finite field extensions, including inseparable
extensions of imperfect fields.
-/

open IsLocalRing
namespace AllCharacteristics
universe u

/-- A noetherian local ring with a principal maximal ideal generated by a
nonnilpotent element is a domain. -/
theorem isDomain_of_principal_maximalIdeal_nonnilpotent
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (t : A) (ht : maximalIdeal A = Ideal.span {t}) (hn : ¬ IsNilpotent t) : IsDomain A := by
  have : NoZeroDivisors A := by
    constructor
    intro a b hab
    by_cases ha : a = 0
    · exact Or.inl ha
    by_cases hb : b = 0
    · exact Or.inr hb
    obtain ⟨n, v, hv, hav⟩ := exists_pow_mul_unit_of_principal_maximalIdeal t ht a ha
    obtain ⟨m, w, hw, hbw⟩ := exists_pow_mul_unit_of_principal_maximalIdeal t ht b hb
    have he : t ^ (n + m) * (v * w) = 0 := by
      rw [pow_add, mul_mul_mul_comm, ← hav, ← hbw]
      exact hab
    exact (hn ⟨n + m, (hv.mul hw).mul_left_eq_zero.mp he⟩).elim
  exact NoZeroDivisors.to_isDomain A

/-- A finite free local algebra over a DVR whose maximal ideal is extended
from the base is a domain, including when the residue extension is inseparable. -/
theorem isDomain_of_finiteFree_local_DVR_lift
    {R A : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing A] [Algebra R A] [IsLocalRing A] [Module.Free R A] [Module.Finite R A]
    (hm : maximalIdeal A = (maximalIdeal R).map (algebraMap R A)) : IsDomain A := by
  have : IsNoetherianRing A := IsNoetherianRing.of_finite R A
  obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hi := FaithfulSMul.algebraMap_injective R A
  have hma : maximalIdeal A = Ideal.span {algebraMap R A t} := by
    rw [hm, ht.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  apply isDomain_of_principal_maximalIdeal_nonnilpotent (algebraMap R A t) hma
  rintro ⟨n, hn⟩
  have hzero : t ^ n = 0 := hi (by simpa only [map_pow, map_zero] using hn)
  exact pow_ne_zero n ht.ne_zero hzero

/-- Once its domain structure is supplied by the preceding theorem, a finite
free local lift with extended maximal ideal is a DVR. -/
theorem isDiscreteValuationRing_of_finiteFree_local_lift
    {R A : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing A] [IsDomain A] [Algebra R A] [IsLocalRing A]
    [Module.Free R A] [Module.Finite R A]
    (hm : maximalIdeal A = (maximalIdeal R).map (algebraMap R A)) :
    IsDiscreteValuationRing A := by
  have : IsNoetherianRing A := IsNoetherianRing.of_finite R A
  obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hi := FaithfulSMul.algebraMap_injective R A
  have hma : maximalIdeal A = Ideal.span {algebraMap R A t} := by
    rw [hm, ht.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  have hne : algebraMap R A t ≠ 0 := by
    intro h
    exact ht.ne_zero (hi (h.trans (map_zero (algebraMap R A)).symm))
  apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
  refine ⟨algebraMap R A t,
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hne hma, ?_⟩
  intro x hx
  obtain ⟨n, v, hv, he⟩ := exists_pow_mul_unit_of_principal_maximalIdeal
    (algebraMap R A t) hma x hx
  obtain ⟨v, rfl⟩ := hv
  exact ⟨n, v, he.symm⟩

/-- A complete characteristic-zero DVR with a prescribed residue field lifts
any finite extension of that field to a complete characteristic-zero DVR.
The construction retains the full extension degree and coefficient maps. -/
theorem exists_completeDVR_lift_of_finite_extension
    {R k L : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [CharZero R]
    [IsAdicComplete (maximalIdeal R) R] [Field k] [Field L]
    [Algebra k L] [Module.Finite k L]
    (b : R →+* k) (hb : Function.Surjective b) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra R A) (_ : IsDomain A)
      (_ : IsDiscreteValuationRing A) (_ : Module.Free R A) (_ : Module.Finite R A)
      (_ : IsAdicComplete (maximalIdeal A) A) (_ : CharZero A) (c : A →+* L),
      Function.Surjective c ∧
      (∀ r : R, c (algebraMap R A r) = algebraMap k L (b r)) ∧
      Module.finrank R A = Module.finrank k L ∧
      maximalIdeal A = (maximalIdeal R).map (algebraMap R A) := by
  obtain ⟨A, _, _, _, _, _, _, c, hc, hcoef, hrank, hm⟩ :=
    hasCompleteLocalLift_of_finite_extension (L := L) b hb
  have := isDomain_of_finiteFree_local_DVR_lift hm
  have := isDiscreteValuationRing_of_finiteFree_local_lift hm
  have : CharZero A := charZero_of_injective_algebraMap (FaithfulSMul.algebraMap_injective R A)
  exact ⟨A, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, c, hc, hcoef, hrank, hm⟩

/-- A finite residue-field extension lifts through a complete DVR by an
injective map that preserves a chosen uniformizer as an irreducible element.
This is the successor-stage datum for a compatible tower of DVR lifts. -/
theorem exists_completeDVR_lift_of_finite_extension_with_uniformizer
    {R k L : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [CharZero R]
    [IsAdicComplete (maximalIdeal R) R] [Field k] [Field L]
    [Algebra k L] [Module.Finite k L]
    (b : R →+* k) (hb : Function.Surjective b)
    (t : R) (ht : Irreducible t) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra R A) (_ : IsDomain A)
      (_ : IsDiscreteValuationRing A) (_ : Module.Free R A) (_ : Module.Finite R A)
      (_ : IsAdicComplete (maximalIdeal A) A) (_ : CharZero A) (c : A →+* L),
      Function.Surjective c ∧
      (∀ r : R, c (algebraMap R A r) = algebraMap k L (b r)) ∧
      Function.Injective (algebraMap R A) ∧
      Irreducible (algebraMap R A t) := by
  obtain ⟨A, _, _, _, _, _, _, _, _, c, hc, hcoef, hrank, hm⟩ :=
    exists_completeDVR_lift_of_finite_extension (L := L) b hb
  have hinj : Function.Injective (algebraMap R A) :=
    FaithfulSMul.algebraMap_injective R A
  have hma : maximalIdeal A = Ideal.span {algebraMap R A t} := by
    rw [hm, ht.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  have hne : algebraMap R A t ≠ 0 := by
    intro h
    exact ht.ne_zero (hinj (h.trans (map_zero (algebraMap R A)).symm))
  have htirr : Irreducible (algebraMap R A t) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hne hma
  exact ⟨A, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, c,
    hc, hcoef, hinj, htirr⟩

end AllCharacteristics
