import AllCharacteristics.AlgebraicExtensionDirectedUnion
import Mathlib.Order.SuccPred.Limit

/-!
# Field stages for a transfinite algebraic extension

A well ordering of an algebraic target field supplies initial-subfield stages.
At a successor exactly one enumerated element is adjoined; at a limit the
field is the union of the preceding stages.  This is the field index used by
the compatible DVR-lift tower.
-/

namespace AllCharacteristics

universe u

section

variable {K L : Type u} [Field K] [Field L] [Algebra K L]

/-- The subfield generated by the terms of an enumeration strictly before a
stage. -/
noncomputable def transfiniteStageField {ι : Type u} [LinearOrder ι]
    (e : ι → L) (a : ι) : IntermediateField K L :=
  IntermediateField.adjoin K (e '' Set.Iio a)

/-- The initial-subfield stages form an increasing family. -/
theorem transfiniteStageField_mono {ι : Type u} [LinearOrder ι]
    (e : ι → L) {a b : ι} (hab : a ≤ b) :
    transfiniteStageField (K := K) e a ≤ transfiniteStageField (K := K) e b := by
  apply IntermediateField.adjoin.mono
  rintro _ ⟨x, hx, rfl⟩
  exact ⟨x, hx.trans_le hab, rfl⟩


/-- At a nonfinal successor, the field stage is obtained by adjoining the
single current enumerated element to all previous ones. -/
theorem transfiniteStageField_succ {ι : Type u} [LinearOrder ι] [SuccOrder ι]
    (e : ι → L) (a : ι) (ha : ¬ IsMax a) :
    transfiniteStageField (K := K) e (Order.succ a) =
      IntermediateField.adjoin K (insert (e a) (e '' Set.Iio a)) := by
  rw [transfiniteStageField, Order.Iio_succ_eq_insert_of_not_isMax ha]
  apply congr_arg (IntermediateField.adjoin K)
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    rcases Set.mem_insert_iff.mp hy with rfl | hy
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ ⟨y, hy, rfl⟩
  · intro hx
    rcases Set.mem_insert_iff.mp hx with rfl | ⟨y, hy, rfl⟩
    · exact ⟨a, Set.mem_insert _ _, rfl⟩
    · exact ⟨y, Set.mem_insert_of_mem _ hy, rfl⟩

/-- A surjective enumeration has initial fields whose union is the full
ambient field, provided every index has a later one. -/
theorem iSup_transfiniteStageField_eq_top {ι : Type u}
    [LinearOrder ι] [SuccOrder ι] [NoMaxOrder ι]
    (e : ι → L) (hsurj : Function.Surjective e) :
    ⨆ a : ι, transfiniteStageField (K := K) e a = ⊤ := by
  apply top_unique
  show (⊤ : IntermediateField K L) ≤ ⨆ a : ι, transfiniteStageField (K := K) e a
  intro x hx
  obtain ⟨a, ha⟩ := hsurj x
  exact (le_iSup (fun b : ι => transfiniteStageField (K := K) e b)
    (Order.succ a)) (IntermediateField.subset_adjoin K _ ⟨a, Order.lt_succ a, ha⟩)

/-- At a successor limit, the stage field is the directed union of all
preceding stage fields. -/
theorem transfiniteStageField_eq_iSup_of_isSuccLimit {ι : Type u}
    [LinearOrder ι] [SuccOrder ι]
    (e : ι → L) (a : ι) (ha : Order.IsSuccLimit a) :
    transfiniteStageField (K := K) e a =
      ⨆ b : Set.Iio a, transfiniteStageField (K := K) e b.1 := by
  apply le_antisymm
  · change IntermediateField.adjoin K (e '' Set.Iio a) ≤ _
    rw [IntermediateField.adjoin_le_iff]
    rintro z ⟨i, hi, rfl⟩
    have hsi : Order.succ i < a := ha.succ_lt hi
    have himax : ¬ IsMax i := not_isMax_of_lt hi
    exact (le_iSup (fun b : Set.Iio a => transfiniteStageField (K := K) e b.1)
      ⟨Order.succ i, hsi⟩)
      (IntermediateField.subset_adjoin K _ ⟨i, Order.lt_succ_of_not_isMax himax, rfl⟩)
  · refine iSup_le fun b => ?_
    exact transfiniteStageField_mono e b.2.le

/-- If an intermediate field is obtained by adjoining one algebraic element,
viewing it over a smaller base field does not change the finiteness of that
one-element extension. -/
theorem finiteDimensional_of_restrictScalars_adjoin_eq
    (E F : IntermediateField K L) (hEF : E ≤ F) (x : L)
    [Algebra.IsAlgebraic E L]
    (hF : IntermediateField.restrictScalars K (IntermediateField.adjoin E {x}) = F) :
    let _ : Algebra E F := (IntermediateField.inclusion hEF).toRingHom.toAlgebra
    FiniteDimensional E F := by
  letI : Algebra E F := (IntermediateField.inclusion hEF).toRingHom.toAlgebra
  let M := IntermediateField.adjoin E {x}
  have hsub : F.toSubfield ≤ M.toSubfield := by
    intro y hy
    change (y : L) ∈ M
    change (y : L) ∈ IntermediateField.restrictScalars K M
    rw [hF]
    exact hy
  let f : F →ₐ[E] M :=
    { Subfield.inclusion hsub with
      commutes' := by intro y; rfl }
  have hf : Function.Bijective f := by
    constructor
    · intro y z hyz
      exact Subtype.ext (congrArg (fun q : M => (q : L)) hyz)
    · intro y
      refine ⟨⟨(y : L), ?_⟩, ?_⟩
      · have hy : (y : L) ∈ M := y.property
        change (y : L) ∈ IntermediateField.restrictScalars K M at hy
        rw [hF] at hy
        exact hy
      · rfl
  let e : F ≃ₐ[E] M := AlgEquiv.ofBijective f hf
  letI : FiniteDimensional E M :=
    IntermediateField.adjoin.finiteDimensional
      (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  exact LinearEquiv.finiteDimensional e.symm.toLinearEquiv

/-- A successor in the enumerated algebraic field filtration is a finite
field extension of the preceding stage. -/
theorem transfiniteStageField_finiteDimensional_succ {ι : Type u}
    [LinearOrder ι] [SuccOrder ι] [Algebra.IsAlgebraic K L]
    (e : ι → L) (a : ι) (ha : ¬ IsMax a) :
    let E := transfiniteStageField (K := K) e a
    let F := transfiniteStageField (K := K) e (Order.succ a)
    let _ : Algebra E F :=
      (IntermediateField.inclusion
        (transfiniteStageField_mono e (Order.le_succ a))).toRingHom.toAlgebra
    FiniteDimensional E F := by
  let E := transfiniteStageField (K := K) e a
  let F := transfiniteStageField (K := K) e (Order.succ a)
  have hEF : E ≤ F := transfiniteStageField_mono e (Order.le_succ a)
  letI : Algebra E F := (IntermediateField.inclusion hEF).toRingHom.toAlgebra
  apply finiteDimensional_of_restrictScalars_adjoin_eq E F hEF (e a)
  change IntermediateField.restrictScalars K
      (IntermediateField.adjoin (IntermediateField.adjoin K (e '' Set.Iio a)) {e a}) = F
  rw [IntermediateField.adjoin_adjoin_left, Set.union_comm, Set.singleton_union]
  exact (transfiniteStageField_succ e a ha).symm

/-- Every stage of an algebraic extension remains algebraic over the base. -/
theorem transfiniteStageField_isAlgebraic {ι : Type u} [LinearOrder ι]
    [Algebra.IsAlgebraic K L] (e : ι → L) (a : ι) :
    Algebra.IsAlgebraic K (transfiniteStageField (K := K) e a) := by
  exact IntermediateField.isAlgebraic_adjoin fun x _ ↦
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

end

end AllCharacteristics
