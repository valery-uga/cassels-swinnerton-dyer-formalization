import Mathlib.FieldTheory.Galois.GaloisClosure
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.Perfect
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Projective

/-!
# Finite Galois fields containing finitely many geometric coordinates

A twisted-cubic parametrization and its coordinate changes involve only
finitely many algebraic-closure coefficients.  Over a perfect field they
therefore lie in a concrete finite Galois subextension, obtained as the
normal closure of their generated field.
-/

namespace PfaffianDescent.QuarticNet

open Matrix
open scoped MatrixGroups

universe u

variable {K : Type u} [Field K] [PerfectField K]

noncomputable abbrev finiteGaloisCoordinateField {ι : Type*} [Fintype ι]
    (z : ι → AlgebraicClosure K) :=
  IntermediateField.normalClosure K
    (IntermediateField.adjoin K (Set.range z)) (AlgebraicClosure K)

instance finiteGaloisCoordinateField_finiteDimensional {ι : Type*} [Fintype ι]
    (z : ι → AlgebraicClosure K) :
    FiniteDimensional K (finiteGaloisCoordinateField z) := by
  letI : FiniteDimensional K (IntermediateField.adjoin K (Set.range z)) :=
    IntermediateField.finiteDimensional_adjoin (fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic x).isIntegral)
  exact normalClosure.is_finiteDimensional K
    (IntermediateField.adjoin K (Set.range z)) (AlgebraicClosure K)

instance finiteGaloisCoordinateField_isGalois {ι : Type*} [Fintype ι]
    (z : ι → AlgebraicClosure K) :
    IsGalois K (finiteGaloisCoordinateField z) := ⟨⟩

/-- The given finite family of geometric coordinates has canonical lifts to
its finite Galois coordinate field. -/
noncomputable def finiteGaloisCoordinateLift {ι : Type*} [Fintype ι]
  (z : ι → AlgebraicClosure K) :
    ι → finiteGaloisCoordinateField z := fun i =>
  ⟨z i, IntermediateField.le_normalClosure _
    ((IntermediateField.subset_adjoin K (Set.range z)) (Set.mem_range_self i))⟩

@[simp] theorem finiteGaloisCoordinateLift_coe {ι : Type*} [Fintype ι]
    (z : ι → AlgebraicClosure K) (i : ι) :
    ((finiteGaloisCoordinateLift z i : finiteGaloisCoordinateField z) :
      AlgebraicClosure K) = z i := by
  simp [finiteGaloisCoordinateLift]

/-- The coordinate field used above is a finite Galois extension containing
every prescribed coefficient. -/
theorem finiteGaloisCoordinateField_spec {ι : Type*} [Fintype ι]
    (z : ι → AlgebraicClosure K) :
    FiniteDimensional K (finiteGaloisCoordinateField z) ∧
      IsGalois K (finiteGaloisCoordinateField z) ∧
      ∀ i, ∃ zi : finiteGaloisCoordinateField z,
        (zi : AlgebraicClosure K) = z i :=
  ⟨inferInstance, inferInstance, fun i =>
    ⟨finiteGaloisCoordinateLift z i, finiteGaloisCoordinateLift_coe z i⟩⟩

/-- The finite Galois coordinate field generated by the entries of a square
matrix over the algebraic closure. -/
noncomputable abbrev finiteGaloisMatrixField {n : ℕ}
    (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)) :=
  finiteGaloisCoordinateField (fun ij : Fin n × Fin n => X ij.1 ij.2)

/-- Entrywise lifting of a matrix to the finite Galois field generated by its
entries. -/
noncomputable def finiteGaloisMatrixLift {n : ℕ}
    (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)) :
    Matrix (Fin n) (Fin n) (finiteGaloisMatrixField X) := fun i j =>
  finiteGaloisCoordinateLift (fun ij : Fin n × Fin n => X ij.1 ij.2) (i, j)

@[simp] theorem finiteGaloisMatrixLift_map {n : ℕ}
    (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)) :
    (finiteGaloisMatrixLift X).map
      (algebraMap (finiteGaloisMatrixField X) (AlgebraicClosure K)) = X := by
  ext i j
  exact finiteGaloisCoordinateLift_coe (fun ij : Fin n × Fin n => X ij.1 ij.2) (i, j)

/-- An invertible geometric matrix is already defined over the finite Galois
field generated by its entries. -/
noncomputable def finiteGaloisGLLift {n : ℕ}
    (X : GL (Fin n) (AlgebraicClosure K)) :
    GL (Fin n) (finiteGaloisMatrixField (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))) :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero
    (finiteGaloisMatrixLift (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))) (by
      intro hzero
      have hdetzero : (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)).det = 0 := by
        calc
          (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)).det =
              ((finiteGaloisMatrixLift
                (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))).map
                  (algebraMap (finiteGaloisMatrixField
                    (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)))
                    (AlgebraicClosure K))).det := by
                rw [finiteGaloisMatrixLift_map]
          _ = algebraMap (finiteGaloisMatrixField
                (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K)))
                (AlgebraicClosure K)
              (finiteGaloisMatrixLift
                (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))).det :=
                (RingHom.map_det _ _).symm
          _ = 0 := by rw [hzero, map_zero]
      apply Units.ne_zero X.det
      rw [Matrix.GeneralLinearGroup.val_det_apply]
      exact hdetzero)

@[simp] theorem finiteGaloisGLLift_map {n : ℕ}
    (X : GL (Fin n) (AlgebraicClosure K)) :
    Matrix.GeneralLinearGroup.map
      (algebraMap (finiteGaloisMatrixField
        (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))) (AlgebraicClosure K))
      (finiteGaloisGLLift X) = X := by
  apply Units.ext
  change (finiteGaloisMatrixLift (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))).map
      (algebraMap (finiteGaloisMatrixField
        (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))) (AlgebraicClosure K)) =
        (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))
  apply finiteGaloisMatrixLift_map

/-- Every projective coordinate change over the algebraic closure has a
matrix representative over a finite Galois coordinate field. -/
theorem pgl_over_algebraicClosure_has_finiteGaloisRepresentative {n : ℕ}
    (x : Matrix.ProjGenLinGroup (Fin n) (AlgebraicClosure K)) :
    ∃ X : GL (Fin n) (AlgebraicClosure K),
      Matrix.ProjGenLinGroup.mk X = x ∧
      ∃ Y : GL (Fin n) (finiteGaloisMatrixField
          (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))),
        Matrix.GeneralLinearGroup.map
          (algebraMap (finiteGaloisMatrixField
            (X : Matrix (Fin n) (Fin n) (AlgebraicClosure K))) (AlgebraicClosure K)) Y = X := by
  obtain ⟨X, hX⟩ := Matrix.ProjGenLinGroup.mk_surjective x
  exact ⟨X, hX, finiteGaloisGLLift X, finiteGaloisGLLift_map X⟩

end PfaffianDescent.QuarticNet
