import Mathlib.Algebra.Module.LinearMap.Defs
import Mathlib.LinearAlgebra.Prod
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.Algebra.GroupWithZero.NonZeroDivisors
import Mathlib.Algebra.Divisibility.Units
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

namespace PfaffianDescent
section
variable {R : Type*} [CommRing R]

/-- The first map of the two-generator Koszul complex. -/
def twoGeneratorFirst (q f : R) : R →ₗ[R] R × R where
  toFun a := (-f*a, q*a)
  map_add' a b := by ext <;> simp [mul_add]
  map_smul' r a := by ext <;> simp [mul_left_comm, mul_comm]

/-- The map whose image is the ideal generated by the two equations. -/
def twoGeneratorLast (q f : R) : R × R →ₗ[R] R where
  toFun v := q*v.1 + f*v.2
  map_add' a b := by simp only [Prod.fst_add, Prod.snd_add]; ring
  map_smul' r a := by simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul, RingHom.id_apply]; ring

lemma twoGenerator_comp_zero (q f : R) :
    (twoGeneratorLast q f).comp (twoGeneratorFirst q f) = 0 := by
  apply LinearMap.ext
  intro a
  change q*(-f*a) + f*(q*a) = 0
  ring

lemma twoGeneratorLast_range (q f : R) :
    LinearMap.range (twoGeneratorLast q f) = Ideal.span ({q, f} : Set R) := by
  apply le_antisymm
  · rintro x ⟨⟨a,b⟩, rfl⟩
    have hqI : q ∈ Ideal.span ({q, f} : Set R) := Ideal.subset_span (by simp)
    have hfI : f ∈ Ideal.span ({q, f} : Set R) := Ideal.subset_span (by simp)
    change q*a + f*b ∈ Ideal.span ({q, f} : Set R)
    exact Ideal.add_mem _ (Ideal.mul_mem_right a _ hqI) (Ideal.mul_mem_right b _ hfI)
  · apply Ideal.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨(1,0), by simp [twoGeneratorLast]⟩
    · exact ⟨(0,1), by simp [twoGeneratorLast]⟩

open scoped nonZeroDivisors

/-- A non-zero-divisor first parameter makes the first Koszul map injective. -/
theorem twoGeneratorFirst_injective_of_regular {q f : R} (hq : q ∈ R⁰) :
    Function.Injective (twoGeneratorFirst q f) := by
  intro a b hab
  apply sub_eq_zero.mp
  apply mem_nonZeroDivisors_iff_left.mp hq
  have hs := congrArg Prod.snd hab
  change q * a = q * b at hs
  rw [mul_sub, hs, sub_self]

/-- Regularity of the second parameter modulo the first proves Koszul
exactness over an arbitrary commutative ring. -/
theorem twoGenerator_exact_of_regular {q f : R} (hq : q ∈ R⁰)
    (hf : Ideal.Quotient.mk (Ideal.span {q}) f ∈ (R ⧸ Ideal.span {q})⁰) :
    LinearMap.range (twoGeneratorFirst q f) = LinearMap.ker (twoGeneratorLast q f) := by
  apply le_antisymm
  · exact LinearMap.range_le_ker_iff.mpr (twoGenerator_comp_zero q f)
  · rintro ⟨a, b⟩ hab
    change q * a + f * b = 0 at hab
    have hfb : Ideal.Quotient.mk (Ideal.span {q}) f *
        Ideal.Quotient.mk (Ideal.span {q}) b = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      rw [show f * b = -(q * a) by linear_combination hab]
      exact (Ideal.span {q}).neg_mem
        (Ideal.mul_mem_right a _ (Ideal.subset_span (by simp)))
    have hb := mem_nonZeroDivisors_iff_left.mp hf _ hfb
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hb
    obtain ⟨c, hc⟩ := hb
    have ha : a = -f * c := by
      have hqa : q * (a + f * c) = 0 := by
        rw [hc] at hab
        linear_combination hab
      have hzero := mem_nonZeroDivisors_iff_left.mp hq _ hqa
      linear_combination hzero
    refine ⟨c, ?_⟩
    apply Prod.ext
    · exact ha.symm
    · exact hc.symm

/-- A unimodular pair has an exact Koszul complex, even without regularity
or domain assumptions. -/
theorem twoGenerator_exact_of_span_eq_top {q f : R}
    (hspan : Ideal.span ({q, f} : Set R) = ⊤) :
    LinearMap.range (twoGeneratorFirst q f) = LinearMap.ker (twoGeneratorLast q f) := by
  obtain ⟨r, s, hunit⟩ := Ideal.mem_span_pair.mp
    (show (1 : R) ∈ Ideal.span ({q, f} : Set R) by rw [hspan]; trivial)
  apply le_antisymm
  · exact LinearMap.range_le_ker_iff.mpr (twoGenerator_comp_zero q f)
  · rintro ⟨a, b⟩ hab
    change q * a + f * b = 0 at hab
    refine ⟨r * b - s * a, ?_⟩
    apply Prod.ext
    · change -f * (r * b - s * a) = a
      linear_combination a * hunit - r * hab
    · change q * (r * b - s * a) = b
      linear_combination b * hunit - s * hab

/-- A unimodular pair also makes its first Koszul differential injective. -/
theorem twoGeneratorFirst_injective_of_span_eq_top {q f : R}
    (hspan : Ideal.span ({q, f} : Set R) = ⊤) :
    Function.Injective (twoGeneratorFirst q f) := by
  obtain ⟨r, s, hunit⟩ := Ideal.mem_span_pair.mp
    (show (1 : R) ∈ Ideal.span ({q, f} : Set R) by rw [hspan]; trivial)
  intro a b hab
  have hq := congrArg Prod.snd hab
  have hf := congrArg Prod.fst hab
  change q * a = q * b at hq
  change -f * a = -f * b at hf
  calc
    a = (r * q + s * f) * a := by rw [hunit, one_mul]
    _ = (r * q + s * f) * b := by
      linear_combination r * hq - s * hf
    _ = b := by rw [hunit, one_mul]

variable [IsDomain R] [DecompositionMonoid R]

lemma twoGeneratorFirst_injective {q f : R} (hq : q ≠ 0) :
    Function.Injective (twoGeneratorFirst q f) := by
  intro a b hab
  exact mul_left_cancel₀ hq (congrArg Prod.snd hab)

/-- Relatively prime equations give an exact two-generator Koszul complex. -/
theorem twoGenerator_exact {q f : R} (hq : q ≠ 0) (hrel : IsRelPrime q f) :
    LinearMap.range (twoGeneratorFirst q f) = LinearMap.ker (twoGeneratorLast q f) := by
  apply le_antisymm
  · exact LinearMap.range_le_ker_iff.mpr (twoGenerator_comp_zero q f)
  · rintro ⟨a,b⟩ hab
    change q*a + f*b = 0 at hab
    have hqb : q ∣ f*b := by
      refine ⟨-a, ?_⟩
      linear_combination hab
    obtain ⟨c, hc⟩ := hrel.dvd_of_dvd_mul_left hqb
    have hac : a = -f*c := by
      apply mul_left_cancel₀ hq
      rw [hc] at hab
      linear_combination hab
    refine ⟨c, ?_⟩
    apply Prod.ext
    · exact hac.symm
    · exact hc.symm

end
end PfaffianDescent
