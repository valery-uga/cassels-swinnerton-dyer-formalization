import PfaffianDescent.CoraySelectedEquationNativeFirstJetRegularity
import PfaffianDescent.NativeRankOneStalkKernel196
import PfaffianDescent.CorayCubicSecondEquationActualCurveUnit
import PfaffianDescent.SchemeModuleLocalIsoGerm
import PfaffianDescent.VoisinHypersurfacePositiveTwistLocal
import AllCharacteristics.SmoothSchemeRegularity

/-! Source only. The literal original homogeneous p/q curve's OWN native
stalk map has the actual degree-n Cartier scalar as its principal kernel.
A nonzero native first derivative of THAT scalar proves regularity of THAT
curve stalk. Polynomial/tangent-jet compatibility remains separate. -/
noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian MvPolynomial
open AllCharacteristics.HomogeneousProjective ProjectiveNegativeTwist
universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- The original degree-n Cartier restriction sequence at its OWN curve point. -/
def selectedOriginalEquationStalkComplex001
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n)
    (y : scheme (projectiveIntersectionIdeal p q hp hq)) :
    ShortComplex (ModuleCat ((hypersurface p hp).presheaf.stalk
      (cubicSecondEquationCurveImmersion p q hp n hq y))) :=
  (cubicSecondEquation_unitRestrictionSequence p q hp n hq).map
    (schemeModuleStalkModuleFunctor (hypersurface p hp)
      (cubicSecondEquationCurveImmersion p q hp n hq y))

/-- The actual original negative-n coordinate is constructed on the selected chart. -/
def selectedOriginalEquationFirstStalkIso001
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n)
    (y : scheme (projectiveIntersectionIdeal p q hp hq)) (j : Fin 4)
    (hx : cubicSecondEquationCurveImmersion p q hp n hq y ∈
      quotientCoordinateOpen (equationIdeal p hp) j) :
    (selectedOriginalEquationStalkComplex001 p q hp n hq y).X₁ ≅
      ModuleCat.of ((hypersurface p hp).presheaf.stalk
        (cubicSecondEquationCurveImmersion p q hp n hq y))
        ((hypersurface p hp).presheaf.stalk
          (cubicSecondEquationCurveImmersion p q hp n hq y)) :=
  schemeModuleLocalUnitStalkIso (quotientCoordinateOpen (equationIdeal p hp) j)
    ⟨cubicSecondEquationCurveImmersion p q hp n hq y, hx⟩
    (sheafOfModules (grading (equationIdeal p hp)) (0 + n))
    (quotientCoordinateNegativeTwistUnitIso_all (equationIdeal p hp) j (0 + n))

/-- The scalar of the actual original q multiplication in native chart coordinates. -/
def selectedOriginalEquationStalkScalar001
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n)
    (y : scheme (projectiveIntersectionIdeal p q hp hq)) (j : Fin 4)
    (hx : cubicSecondEquationCurveImmersion p q hp n hq y ∈
      quotientCoordinateOpen (equationIdeal p hp) j) :
    (hypersurface p hp).presheaf.stalk (cubicSecondEquationCurveImmersion p q hp n hq y) :=
  pointCartierNativeStalkScalar (selectedOriginalEquationStalkComplex001 p q hp n hq y)
    (selectedOriginalEquationFirstStalkIso001 p q hp n hq y j hx)
    (schemeModuleUnitStalkIso (hypersurface p hp)
      (cubicSecondEquationCurveImmersion p q hp n hq y))

/-- Exactness of the actual original restriction sequence is constructed. -/
theorem selectedOriginalEquationStalkComplex_shortExact001
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))
    (y : scheme (projectiveIntersectionIdeal p q hp hq)) :
    (selectedOriginalEquationStalkComplex001 p q hp n hq y).ShortExact :=
  (cubicSecondEquation_unitRestrictionSequence_shortExact p q hp hp0 n hq hnot).map_of_exact _

/-- The OWN original curve immersion stalk kernel is generated by the SAME
native q scalar. No kernel or quotient-identification certificate is supplied. -/
theorem selectedOriginalEquationStalkMap_kernel001
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))
    (y : scheme (projectiveIntersectionIdeal p q hp hq)) (j : Fin 4)
    (hx : cubicSecondEquationCurveImmersion p q hp n hq y ∈
      quotientCoordinateOpen (equationIdeal p hp) j) :
    RingHom.ker ((cubicSecondEquationCurveImmersion p q hp n hq).stalkMap y).hom =
      Ideal.span ({selectedOriginalEquationStalkScalar001 p q hp n hq y j hx} : Set _) := by
  let i := cubicSecondEquationCurveImmersion p q hp n hq
  let x := i y
  let S := selectedOriginalEquationStalkComplex001 p q hp n hq y
  let e₁ := selectedOriginalEquationFirstStalkIso001 p q hp n hq y j hx
  let e₂ := schemeModuleUnitStalkIso (hypersurface p hp) x
  apply nativeRankOneStalkKernel196 S
    (selectedOriginalEquationStalkComplex_shortExact001 p q hp hp0 n hq hnot y)
    e₁ e₂ (i.stalkMap y).hom
  intro r
  exact closedImmersionUnitToPushforwardUnit_stalkMap_eq_zero_iff
    i i.isClosedEmbedding.isInducing y r

/-- A nonzero actual native derivative of the original q scalar proves
regularity of the SAME original curve stalk. The jet residue field is the
OWN original surface point's residue field. Neither curve regularity nor
its native principal kernel is supplied. -/
theorem selectedOriginalCurve_regular_of_nonzero_nativeEquationFirstJet001
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))
    (y : scheme (projectiveIntersectionIdeal p q hp hq)) (j : Fin 4)
    (hx : cubicSecondEquationCurveImmersion p q hp n hq y ∈
      quotientCoordinateOpen (equationIdeal p hp) j)
    (φ : (hypersurface p hp).presheaf.stalk
      (cubicSecondEquationCurveImmersion p q hp n hq y) →+*
      TrivSqZeroExt ((hypersurface p hp).residueField
        (cubicSecondEquationCurveImmersion p q hp n hq y))
        (Fin 2 → (hypersurface p hp).residueField
          (cubicSecondEquationCurveImmersion p q hp n hq y)))
    [IsLocalHom φ]
    (hDerivative : (φ (selectedOriginalEquationStalkScalar001 p q hp n hq y j hx)).snd ≠ 0) :
    IsRegularLocalRing ((scheme (projectiveIntersectionIdeal p q hp hq)).presheaf.stalk y) := by
  let i := cubicSecondEquationCurveImmersion p q hp n hq
  let R := (hypersurface p hp).presheaf.stalk (i y)
  let f := (i.stalkMap y).hom
  let q₀ := selectedOriginalEquationStalkScalar001 p q hp n hq y j hx
  letI : IsRegularRing Γ(Spec (.of K), ⊤) :=
    IsRegularRing.of_ringEquiv (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.symm
  letI : IsRegularLocalRing R :=
    AllCharacteristics.isRegularLocalRing_stalk_of_smooth_over_affine
      (hypersurfaceToBase p hp) (i y)
  have hKernel : RingHom.ker f = Ideal.span ({q₀} : Set R) :=
    selectedOriginalEquationStalkMap_kernel001 p q hp hp0 n hq hnot y j hx
  have hqzero : f q₀ = 0 := by
    change q₀ ∈ RingHom.ker f
    rw [hKernel]
    exact Ideal.subset_span (Set.mem_singleton q₀)
  have hValue : (φ q₀).fst = 0 := by
    by_contra h
    have hφunit : IsUnit (φ q₀) := TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr
      (isUnit_iff_ne_zero.mpr h)
    have hqunit : IsUnit q₀ := isUnit_of_map_unit φ q₀ hφunit
    exact (f.isUnit_map hqunit).ne_zero hqzero
  exact nativeFirstJet_nonzero_derivative_regular_actualPrincipalTarget001
    f (i.stalkMap_surjective y) φ q₀ hKernel hValue hDerivative

end PfaffianDescent.Coray
