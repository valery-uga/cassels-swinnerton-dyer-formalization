import PfaffianDescent.SerreExtensionFoundation
import PfaffianDescent.SplitRestrictionKernels
import Mathlib.AlgebraicGeometry.Modules.Tilde
import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExactSequences
import Mathlib.Algebra.Homology.DerivedCategory.Ext.Linear
import Mathlib.Algebra.Category.ModuleCat.Ext.HasExt
import PfaffianDescent.CompleteIntersectionSocleExt
import AllCharacteristics.FlatPrincipalQuotient

/-!
# The local presentation in Serre's rank-two construction

For a two-generator lci ideal `(f, g)`, the usual free resolution has
syzygy `(-g, f)`.  An extension class with local coordinate `c` is represented
by adjoining `-c` to that syzygy.  This file proves the elementary local
calculation used in Voisin's Lemma 3.1: a unit coordinate eliminates the
relation and makes the middle module free of rank two.  Over a local ring,
non-freeness therefore forces the coordinate into the maximal ideal.
-/

namespace PfaffianDescent

open CategoryTheory CategoryTheory.Abelian AlgebraicGeometry
open scoped nonZeroDivisors

universe u w

section

variable {R : Type u} [CommRing R]

/-- The map from two free generators to the ideal generated by `f` and `g`. -/
noncomputable def localKoszulGeneratorMap (f g : R) : R × R →ₗ[R] R where
  toFun x := x.1 * f + x.2 * g
  map_add' x y := by simp [add_mul, add_add_add_comm]
  map_smul' a x := by simp [smul_eq_mul]; ring

lemma localKoszulGeneratorMap_apply (f g : R) (x : R × R) :
    localKoszulGeneratorMap f g x = x.1 * f + x.2 * g := rfl

/-- The familiar syzygy of a regular two-generator ideal is the whole
kernel: if `f` is a non-zero-divisor and `g` remains one modulo `f`, every
relation on `(f, g)` is a multiple of `(-g, f)`. -/
lemma localKoszulGeneratorMap_ker
    (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    (localKoszulGeneratorMap f g).ker =
      Submodule.span R ({(-g, f)} : Set (R × R)) := by
  ext x
  constructor
  · intro hx
    rw [LinearMap.mem_ker] at hx
    rw [Submodule.mem_span_singleton]
    have hbg : Ideal.Quotient.mk (Ideal.span {f}) x.2 *
        Ideal.Quotient.mk (Ideal.span {f}) g = 0 := by
      rw [← map_mul]
      rw [Ideal.Quotient.eq_zero_iff_mem]
      change x.2 * g ∈ Ideal.span {f}
      rw [show x.2 * g = -(x.1 * f) by
        change x.1 * f + x.2 * g = 0 at hx
        exact eq_neg_of_add_eq_zero_right hx]
      exact neg_mem (Ideal.mul_mem_left _ x.1 (Ideal.subset_span (by simp)))
    have hbx : Ideal.Quotient.mk (Ideal.span {f}) x.2 = 0 :=
      (mem_nonZeroDivisors_iff_left.mp hg) _ (by simpa [mul_comm] using hbg)
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hbx
    rcases hbx with ⟨d, hd⟩
    refine ⟨d, ?_⟩
    apply Prod.ext
    · change d * -g = x.1
      have hxf : f * (x.1 + d * g) = 0 := by
        calc
          f * (x.1 + d * g) = x.1 * f + d * f * g := by ring
          _ = x.1 * f + x.2 * g := by rw [hd]; ring
          _ = 0 := hx
      calc
        d * -g = -(d * g) := by ring
        _ = x.1 := neg_eq_iff_add_eq_zero.mpr (by
          simpa [add_comm] using (mem_nonZeroDivisors_iff_left.mp hf _ hxf))
    · change d * f = x.2
      rw [hd]
      ring
  · rw [Submodule.mem_span_singleton]
    rintro ⟨d, rfl⟩
    rw [LinearMap.mem_ker]
    change (d * -g) * f + (d * f) * g = 0
    ring

/-- The relation in the standard local presentation of an extension of the
lci ideal generated by `f` and `g`, with local Ext coordinate `c`. -/
noncomputable def localSerreRelation (f g c : R) : R × R × R :=
  (-g, f, -c)

/-- If the local Ext coordinate is a unit, eliminate the third generator from
Serre's standard local extension presentation. -/
noncomputable def localSerreElimination (f g : R) (u : Rˣ) :
    R × R × R →ₗ[R] R × R where
  toFun x :=
    (x.1 - g * (u⁻¹ : Rˣ) * x.2.2,
      x.2.1 + f * (u⁻¹ : Rˣ) * x.2.2)
  map_add' x y := by
    ext <;> simp [mul_add, sub_eq_add_neg] <;> ring
  map_smul' a x := by
    ext <;> simp <;> ring

lemma localSerreElimination_apply (f g : R) (u : Rˣ) (x : R × R × R) :
    localSerreElimination f g u x =
      (x.1 - g * (u⁻¹ : Rˣ) * x.2.2,
        x.2.1 + f * (u⁻¹ : Rˣ) * x.2.2) := rfl

/-- The one relation in the local extension presentation is precisely the
kernel of the unit-coordinate elimination map. -/
lemma localSerreElimination_ker (f g : R) (u : Rˣ) :
    (localSerreElimination f g u).ker =
      Submodule.span R {localSerreRelation f g (u : R)} := by
  ext x
  constructor
  · intro hx
    rw [LinearMap.mem_ker] at hx
    rw [Submodule.mem_span_singleton]
    refine ⟨-(u⁻¹ : Rˣ) * x.2.2, ?_⟩
    apply Prod.ext
    · change (-(u⁻¹ : Rˣ) * x.2.2) * -g = x.1
      have h := congrArg Prod.fst hx
      change x.1 - g * (u⁻¹ : Rˣ) * x.2.2 = 0 at h
      rw [sub_eq_zero] at h
      rw [h]
      ring
    · apply Prod.ext
      · change (-(u⁻¹ : Rˣ) * x.2.2) * f = x.2.1
        have h := congrArg (fun z : R × R => z.2) hx
        change x.2.1 + f * (u⁻¹ : Rˣ) * x.2.2 = 0 at h
        calc
          (-(u⁻¹ : Rˣ) * x.2.2) * f =
              -(f * (u⁻¹ : Rˣ) * x.2.2) := by ring
          _ = x.2.1 := neg_eq_iff_add_eq_zero.mpr (by simpa [add_comm] using h)
      · change (-(u⁻¹ : Rˣ) * x.2.2) * -(u : R) = x.2.2
        calc
          (-(u⁻¹ : Rˣ) * x.2.2) * -(u : R) =
              ((u⁻¹ : Rˣ) * (u : R)) * x.2.2 := by ring
          _ = x.2.2 := by rw [Units.inv_mul, one_mul]
  · rw [Submodule.mem_span_singleton]
    rintro ⟨a, rfl⟩
    rw [LinearMap.mem_ker]
    ext
    · change a * -g - g * (u⁻¹ : Rˣ) * (a * -(u : R)) = 0
      calc
        a * -g - g * (u⁻¹ : Rˣ) * (a * -(u : R)) =
            -(a * g) - g * (u⁻¹ : Rˣ) * (a * -(u : R)) := by ring
        _ = -g * a + g * (u⁻¹ : Rˣ) * (a * (u : R)) := by ring
        _ = -g * a + g * a * ((u⁻¹ : Rˣ) * (u : R)) := by ring
        _ = 0 := by rw [Units.inv_mul]; ring
    · change a * f + f * (u⁻¹ : Rˣ) * (a * -(u : R)) = 0
      calc
        a * f + f * (u⁻¹ : Rˣ) * (a * -(u : R)) =
            f * a - f * (u⁻¹ : Rˣ) * (a * (u : R)) := by ring
        _ = f * a - f * a * ((u⁻¹ : Rˣ) * (u : R)) := by ring
        _ = 0 := by rw [Units.inv_mul]; ring

lemma localSerreElimination_surjective (f g : R) (u : Rˣ) :
    Function.Surjective (localSerreElimination f g u) := by
  intro x
  refine ⟨(x.1, x.2, 0), ?_⟩
  ext <;> simp [localSerreElimination_apply]

/-- A unit local Ext coordinate makes the standard local Serre extension
presentation explicitly isomorphic to the free module of rank two. -/
noncomputable def localSerreExtensionFreeOfUnit (f g : R) (u : Rˣ) :
    ((R × R × R) ⧸ Submodule.span R {localSerreRelation f g (u : R)}) ≃ₗ[R]
      (R × R) :=
  (Submodule.quotEquivOfEq _ _ (localSerreElimination_ker f g u).symm).trans
    (LinearMap.quotKerEquivOfSurjective (localSerreElimination f g u)
      (localSerreElimination_surjective f g u))

/-- The quotient module representing the standard local Serre extension. -/
abbrev localSerreExtensionPresentation (f g c : R) :=
  (R × R × R) ⧸ Submodule.span R {localSerreRelation f g c}

/-- The quotient presentation maps to the two-generator ideal by forgetting
the extension coordinate. -/
noncomputable def localSerreIdealGeneratorMap (f g : R) : R × R × R →ₗ[R]
    (Ideal.span ({f, g} : Set R)) where
  toFun x := ⟨x.1 * f + x.2.1 * g, by
    apply Submodule.add_mem
    · exact Ideal.mul_mem_left _ x.1 (Ideal.subset_span (by simp))
    · exact Ideal.mul_mem_left _ x.2.1 (Ideal.subset_span (by simp))⟩
  map_add' x y := by
    apply Subtype.ext
    simp [add_mul, add_add_add_comm]
  map_smul' a x := by
    apply Subtype.ext
    simp [smul_eq_mul]
    ring

lemma localSerreIdealGeneratorMap_relation_mem_ker (f g c : R) :
    localSerreRelation f g c ∈ (localSerreIdealGeneratorMap f g).ker := by
  rw [LinearMap.mem_ker]
  apply Subtype.ext
  change (-g) * f + f * g = 0
  ring

/-- The local Serre presentation maps naturally onto the ideal `(f, g)`. -/
noncomputable def localSerreExtensionToIdeal (f g c : R) :
    localSerreExtensionPresentation f g c →ₗ[R] Ideal.span ({f, g} : Set R) :=
  Submodule.liftQ _ (localSerreIdealGeneratorMap f g) (by
    rw [Submodule.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact localSerreIdealGeneratorMap_relation_mem_ker f g c)

/-- The structure-sheaf summand of Serre's local extension presentation. -/
noncomputable def localSerreExtensionFromRing (f g c : R) : R →ₗ[R]
    localSerreExtensionPresentation f g c where
  toFun t := Submodule.Quotient.mk (0, 0, t)
  map_add' x y := by
    rw [← Submodule.Quotient.mk_add]
    congr 1
    all_goals simp
  map_smul' a x := by
    rw [← Submodule.Quotient.mk_smul]
    congr 1
    all_goals simp [smul_eq_mul]

/-- In the unit-coordinate trivialization of a local Serre extension, the
canonical section has these two scalar coordinates. -/
noncomputable def localSerreCanonicalCoordinates (f g : R) (u : Rˣ) : R × R :=
  localSerreExtensionFreeOfUnit f g u
    (localSerreExtensionFromRing f g (u : R) 1)

/-- The explicit free trivialization sends the canonical section to the
Koszul generators, scaled by the inverse extension coordinate. -/
lemma localSerreCanonicalCoordinates_eq (f g : R) (u : Rˣ) :
    localSerreCanonicalCoordinates f g u =
      (-g * (u⁻¹ : Rˣ), f * (u⁻¹ : Rˣ)) := by
  simp [localSerreCanonicalCoordinates, localSerreExtensionFreeOfUnit,
    localSerreExtensionFromRing, localSerreElimination_apply]

/-- The two scalar coordinates of the canonical section generate the original
lci ideal.  This is the local zero-locus calculation in Serre's construction:
when the extension coordinate is a unit, the canonical section vanishes
scheme-theoretically on `(f, g)`. -/
lemma ideal_span_localSerreCanonicalCoordinates (f g : R) (u : Rˣ) :
    Ideal.span ({(localSerreCanonicalCoordinates f g u).1,
      (localSerreCanonicalCoordinates f g u).2} : Set R) =
      Ideal.span ({f, g} : Set R) := by
  rw [localSerreCanonicalCoordinates_eq]
  apply le_antisymm
  · rw [Ideal.span_le]
    intro x hx
    rcases hx with hx | hx
    · rw [hx]
      have hg : g ∈ Ideal.span ({f, g} : Set R) := Ideal.subset_span (by simp)
      exact Ideal.mul_mem_right (((u⁻¹ : Rˣ) : R)) _ (neg_mem hg)
    · rw [hx]
      have hf : f ∈ Ideal.span ({f, g} : Set R) := Ideal.subset_span (by simp)
      exact Ideal.mul_mem_right (((u⁻¹ : Rˣ) : R)) _ hf
  · rw [Ideal.span_le]
    intro x hx
    rcases hx with hx | hx
    · rw [hx]
      have hu : ((u⁻¹ : Rˣ) : R) * (u : R) = 1 := by rw [Units.inv_mul]
      have hcoord : f * ((u⁻¹ : Rˣ) : R) ∈
          Ideal.span ({-g * ((u⁻¹ : Rˣ) : R), f * ((u⁻¹ : Rˣ) : R)} : Set R) :=
        Ideal.subset_span (by simp)
      have hmul := Ideal.mul_mem_right (u : R) _ hcoord
      simpa [mul_assoc, hu] using hmul
    · rw [hx]
      have hu : ((u⁻¹ : Rˣ) : R) * (u : R) = 1 := by rw [Units.inv_mul]
      have hcoord : -g * ((u⁻¹ : Rˣ) : R) ∈
          Ideal.span ({-g * ((u⁻¹ : Rˣ) : R), f * ((u⁻¹ : Rˣ) : R)} : Set R) :=
        Ideal.subset_span (by simp)
      have hmul := Ideal.mul_mem_right (-(u : R)) _ hcoord
      have hprod : (-g * ((u⁻¹ : Rˣ) : R)) * -(u : R) = g := by
        calc
          (-g * ((u⁻¹ : Rˣ) : R)) * -(u : R) =
              g * (((u⁻¹ : Rˣ) : R) * (u : R)) := by ring
          _ = g := by rw [hu, mul_one]
      simpa [hprod] using hmul

lemma localSerreExtensionToIdeal_mk (f g c : R) (x : R × R × R) :
    localSerreExtensionToIdeal f g c (Submodule.Quotient.mk x) =
      localSerreIdealGeneratorMap f g x := by
  exact Submodule.liftQ_apply _ _ _

lemma localSerreExtensionToIdeal_surjective (f g c : R) :
    Function.Surjective (localSerreExtensionToIdeal f g c) := by
  intro z
  obtain ⟨a, b, hab⟩ := (Ideal.mem_span_pair.mp z.property)
  refine ⟨Submodule.Quotient.mk (a, b, 0), ?_⟩
  rw [localSerreExtensionToIdeal_mk]
  apply Subtype.ext
  exact hab

/-- A non-zero-divisor first generator makes the copy of `R` in the local
Serre presentation injective. -/
lemma localSerreExtensionFromRing_injective (f g c : R) (hf : f ∈ R⁰) :
    Function.Injective (localSerreExtensionFromRing f g c) := by
  intro s t h
  have h' : Submodule.Quotient.mk (0, 0, s - t) =
      (0 : localSerreExtensionPresentation f g c) := by
    change (localSerreExtensionFromRing f g c) (s - t) = 0
    rw [map_sub, h, sub_self]
  rw [Submodule.Quotient.mk_eq_zero] at h'
  rw [Submodule.mem_span_singleton] at h'
  obtain ⟨d, hd⟩ := h'
  have hdf : d * f = 0 := by
    have hcoord := congrArg (fun v : R × R × R => v.2.1) hd
    change d * f = 0 at hcoord
    exact hcoord
  have hd0 : d = 0 :=
    mem_nonZeroDivisors_iff_left.mp hf _ (by simpa [mul_comm] using hdf)
  have hst : s - t = 0 := by
    have hcoord := congrArg (fun v : R × R × R => v.2.2) hd
    change d * -c = s - t at hcoord
    rw [hd0, zero_mul] at hcoord
    exact hcoord.symm
  exact sub_eq_zero.mp hst

lemma localSerreExtension_complex (f g c : R) :
    (localSerreExtensionToIdeal f g c).comp (localSerreExtensionFromRing f g c) = 0 := by
  apply LinearMap.ext
  intro t
  change localSerreExtensionToIdeal f g c (Submodule.Quotient.mk (0, 0, t)) = 0
  rw [localSerreExtensionToIdeal_mk]
  apply Subtype.ext
  simp [localSerreIdealGeneratorMap]

/-- The standard local Serre presentation is an extension of the lci ideal:
`0 → R → E → (f, g) → 0`.  The regular-sequence hypothesis is exactly what
identifies all relations on `f, g` with the Koszul relation. -/
lemma localSerreExtension_exact (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    Function.Exact (localSerreExtensionFromRing f g c) (localSerreExtensionToIdeal f g c) := by
  rw [LinearMap.exact_iff]
  apply le_antisymm
  · intro q hq
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [LinearMap.mem_ker, localSerreExtensionToIdeal_mk] at hq
    have hq' : localKoszulGeneratorMap f g (x.1, x.2.1) = 0 := by
      exact congrArg Subtype.val hq
    have hrel : (x.1, x.2.1) ∈
        Submodule.span R ({(-g, f)} : Set (R × R)) := by
      rw [← localKoszulGeneratorMap_ker f g hf hg]
      exact hq'
    rw [Submodule.mem_span_singleton] at hrel
    obtain ⟨d, hd⟩ := hrel
    refine ⟨x.2.2 + d * c, ?_⟩
    change Submodule.Quotient.mk (0, 0, x.2.2 + d * c) =
      Submodule.Quotient.mk x
    rw [Submodule.Quotient.eq]
    change (0, 0, x.2.2 + d * c) - x ∈
      Submodule.span R {localSerreRelation f g c}
    rw [Submodule.mem_span_singleton]
    refine ⟨-d, ?_⟩
    apply Prod.ext
    · change (-d) * -g = 0 - x.1
      have h1 := congrArg Prod.fst hd
      change d * -g = x.1 at h1
      rw [← h1]
      ring
    · apply Prod.ext
      · change (-d) * f = 0 - x.2.1
        have h2 := congrArg (fun v : R × R => v.2) hd
        change d * f = x.2.1 at h2
        rw [← h2]
        ring
      · change (-d) * -c = x.2.2 + d * c - x.2.2
        ring
  · rintro q ⟨t, rfl⟩
    rw [LinearMap.mem_ker]
    change ((localSerreExtensionToIdeal f g c).comp
      (localSerreExtensionFromRing f g c)) t = 0
    rw [localSerreExtension_complex]
    rfl

/-- The standard local presentation as a short complex of modules. -/
noncomputable def localSerreExtensionModuleComplex (f g c : R) :
    ShortComplex (ModuleCat.{u} R) :=
  ShortComplex.moduleCatMk (localSerreExtensionFromRing f g c)
    (localSerreExtensionToIdeal f g c) (localSerreExtension_complex f g c)

/-- The middle morphism from the Koszul extension to the local Serre
presentation; it sends the two free Koszul generators to their evident
classes in the three-generator presentation. -/
noncomputable def localKoszulToSerreMiddleMap (f g c : R) :
    R × R →ₗ[R] localSerreExtensionPresentation f g c where
  toFun x := Submodule.Quotient.mk (x.1, x.2, 0)
  map_add' x y := by
    rw [← Submodule.Quotient.mk_add]
    congr 1
    ext <;> simp
  map_smul' a x := by
    rw [← Submodule.Quotient.mk_smul]
    congr 1
    ext <;> simp [smul_eq_mul]

/-- Under the lci regular-sequence hypotheses, the local presentation is a
genuine short exact sequence of modules. -/
lemma localSerreExtensionModuleComplex_shortExact (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    (localSerreExtensionModuleComplex f g c).ShortExact := by
  apply ShortComplex.ShortExact.mk'
  · rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
    exact localSerreExtension_exact f g c hf hg
  · rw [ModuleCat.mono_iff_injective]
    exact localSerreExtensionFromRing_injective f g c hf
  · rw [ModuleCat.epi_iff_surjective]
    exact localSerreExtensionToIdeal_surjective f g c

/-- The quotient of the two-generator ideal by its ambient ring, as a short
exact sequence of modules. -/
noncomputable def localSerreIdealQuotientComplex (f g : R) :
    ShortComplex (ModuleCat R) :=
  ModuleCat.shortComplexOfCompEqZero
    (Ideal.span ({f, g} : Set R)).subtype
    (Ideal.Quotient.mkₐ R (Ideal.span ({f, g} : Set R))).toLinearMap
    (by
      apply LinearMap.ext
      intro z
      change Ideal.Quotient.mk (Ideal.span ({f, g} : Set R)) (z : R) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr z.property)

/-- The local ideal quotient sequence is short exact. -/
lemma localSerreIdealQuotientComplex_shortExact (f g : R) :
    (localSerreIdealQuotientComplex f g).ShortExact := by
  apply ModuleCat.shortComplex_shortExact
  · change Function.Exact
      (Ideal.span ({f, g} : Set R)).subtype
      (Ideal.Quotient.mkₐ R (Ideal.span ({f, g} : Set R))).toLinearMap
    intro z
    constructor
    · intro hz
      change Ideal.Quotient.mk (Ideal.span ({f, g} : Set R)) (z : R) = 0 at hz
      exact ⟨⟨z, Ideal.Quotient.eq_zero_iff_mem.mp hz⟩, rfl⟩
    · rintro ⟨y, rfl⟩
      exact Ideal.Quotient.eq_zero_iff_mem.mpr y.property
  · change Function.Injective (Ideal.span ({f, g} : Set R)).subtype
    exact (Ideal.span ({f, g} : Set R)).injective_subtype
  · change Function.Surjective
      (Ideal.Quotient.mkₐ R (Ideal.span ({f, g} : Set R))).toLinearMap
    exact Ideal.Quotient.mkₐ_surjective R _

/-- The Koszul relation map for the two generators of the lci ideal. -/
noncomputable def localKoszulRelationMap (f g : R) : R →ₗ[R] R × R where
  toFun d := d • (-g, f)
  map_add' x y := add_smul x y (-g, f)
  map_smul' a x := by simpa [smul_eq_mul] using (mul_smul a x (-g, f))

/-- The left square of the Koszul-to-Serre comparison diagram commutes. -/
lemma localKoszulToSerreMiddle_relation (f g c : R) :
    localKoszulToSerreMiddleMap f g c ∘ₗ localKoszulRelationMap f g =
      localSerreExtensionFromRing f g c ∘ₗ (LinearMap.lsmul R R c) := by
  apply LinearMap.ext
  intro d
  change localKoszulToSerreMiddleMap f g c (localKoszulRelationMap f g d) =
    localSerreExtensionFromRing f g c ((LinearMap.lsmul R R c) d)
  dsimp [localKoszulToSerreMiddleMap, localKoszulRelationMap,
    localSerreExtensionFromRing, LinearMap.lsmul]
  let P : Submodule R (R × R × R) :=
    Submodule.span R {localSerreRelation f g c}
  change Submodule.Quotient.mk (p := P) (d * -g, d * f, 0) =
    Submodule.Quotient.mk (p := P) (0, 0, c * d)
  apply (Submodule.Quotient.eq P).2
  change (d * -g, d * f, 0) - (0, 0, c * d) ∈ P
  dsimp [P]
  rw [Submodule.mem_span_singleton]
  refine ⟨d, ?_⟩
  ext <;> simp [localSerreRelation, smul_eq_mul] <;> ring


/-- A linear functional on a free rank-two module is determined by its two
basis coordinates. -/
noncomputable def localPairLinearMapEvalEquiv :
    ((R × R) →ₗ[R] R) ≃ₗ[R] (R × R) where
  toFun h := (h (1, 0), h (0, 1))
  invFun x := {
    toFun := fun y => y.1 * x.1 + y.2 * x.2
    map_add' := by intro y z; simp [add_mul, add_add_add_comm]
    map_smul' := by intro a y; simp [smul_eq_mul]; ring }
  left_inv h := by
    apply LinearMap.ext
    intro y
    have hy : y = y.1 • (1, 0) + y.2 • (0, 1) := by
      ext <;> simp [smul_eq_mul]
    change y.1 * h (1, 0) + y.2 * h (0, 1) = h y
    calc
      y.1 * h (1, 0) + y.2 * h (0, 1) =
          h (y.1 • (1, 0)) + h (y.2 • (0, 1)) := by
            rw [h.map_smul, h.map_smul]
            simp [smul_eq_mul]
      _ = h (y.1 • (1, 0) + y.2 • (0, 1)) := by rw [map_add]
      _ = h y := by rw [← hy]
  right_inv x := by ext <;> simp
  map_add' h k := by ext <;> simp
  map_smul' a h := by ext <;> simp [smul_eq_mul]

/-- Under evaluation at the free generators, precomposition with the Koszul
relation has image generated by `f` and `g`. -/
lemma localKoszulRelation_precomp_coordinates (f g : R) (h : (R × R) →ₗ[R] R) :
    (LinearMap.ringLmapEquivSelf R R R) (h.comp (localKoszulRelationMap f g)) =
      -g * (localPairLinearMapEvalEquiv h).1 +
        f * (localPairLinearMapEvalEquiv h).2 := by
  change (h.comp (localKoszulRelationMap f g)) 1 = _
  change h ((localKoszulRelationMap f g) 1) = _
  have hmap : (localKoszulRelationMap f g) 1 = (-g, f) := by
    simp [localKoszulRelationMap, smul_eq_mul]
  rw [hmap]
  have hrel : (-g, f) = (-g) • (1, 0) + f • (0, 1) := by
    ext <;> simp [smul_eq_mul]
  rw [hrel, map_add, map_smul, map_smul]
  simp [localPairLinearMapEvalEquiv, smul_eq_mul]

/-- The image of precomposition with the Koszul relation is the ideal
generated by its two entries. -/
lemma range_localKoszulRelation_precomp (f g : R) :
    Set.range (fun h : (R × R) →ₗ[R] R =>
      (LinearMap.ringLmapEquivSelf R R R) (h.comp (localKoszulRelationMap f g))) =
      Ideal.span ({f, g} : Set R) := by
  ext r
  constructor
  · rintro ⟨h, hr⟩
    rw [← hr]
    change (LinearMap.ringLmapEquivSelf R R R) (h.comp (localKoszulRelationMap f g)) ∈
      Ideal.span ({f, g} : Set R)
    rw [localKoszulRelation_precomp_coordinates]
    apply Ideal.mem_span_pair.mpr
    refine ⟨(localPairLinearMapEvalEquiv h).2,
      -(localPairLinearMapEvalEquiv h).1, ?_⟩
    ring
  · intro hr
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hr
    refine ⟨(localPairLinearMapEvalEquiv.symm (-b, a)), ?_⟩
    change (LinearMap.ringLmapEquivSelf R R R)
      ((localPairLinearMapEvalEquiv.symm (-b, a)).comp (localKoszulRelationMap f g)) = r
    rw [localKoszulRelation_precomp_coordinates]
    simp only [LinearEquiv.apply_symm_apply]
    calc
      -g * -b + f * a = a * f + b * g := by ring
      _ = r := hab

/-- The two-generator Koszul map, with codomain restricted to the ideal it
spans. -/
noncomputable def localKoszulToIdeal (f g : R) :
    R × R →ₗ[R] Ideal.span ({f, g} : Set R) where
  toFun x := ⟨x.1 * f + x.2 * g, by
    apply Submodule.add_mem
    · exact Ideal.mul_mem_left _ x.1 (Ideal.subset_span (by simp))
    · exact Ideal.mul_mem_left _ x.2 (Ideal.subset_span (by simp))⟩
  map_add' x y := by apply Subtype.ext; simp [add_mul, add_add_add_comm]
  map_smul' a x := by apply Subtype.ext; simp [smul_eq_mul]; ring

/-- The right square of the Koszul-to-Serre comparison diagram commutes. -/
lemma localKoszulToSerreMiddle_toIdeal (f g c : R) :
    localSerreExtensionToIdeal f g c ∘ₗ localKoszulToSerreMiddleMap f g c =
      localKoszulToIdeal f g := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change x.1 * f + x.2 * g = x.1 * f + x.2 * g
  rfl

lemma localKoszulToIdeal_ker (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    (localKoszulToIdeal f g).ker =
      Submodule.span R {(-g, f)} := by
  ext x
  rw [LinearMap.mem_ker]
  rw [Subtype.ext_iff]
  change x ∈ (localKoszulGeneratorMap f g).ker ↔ _
  rw [localKoszulGeneratorMap_ker f g hf hg]

lemma localKoszulToIdeal_surjective (f g : R) :
    Function.Surjective (localKoszulToIdeal f g) := by
  intro z
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp z.property
  refine ⟨(a, b), ?_⟩
  apply Subtype.ext
  exact hab

/-- The first Koszul short complex for the ideal `(f,g)`. -/
noncomputable def localKoszulIdealComplex (f g : R) : ShortComplex (ModuleCat R) :=
  ModuleCat.shortComplexOfCompEqZero
    (localKoszulRelationMap f g) (localKoszulToIdeal f g) (by
      apply LinearMap.ext
      intro d
      apply Subtype.ext
      change (d • (-g, f) : R × R).1 * f + (d • (-g, f) : R × R).2 * g = 0
      dsimp
      ring)

noncomputable def localKoszulToSerreComparison (f g c : R) :
    localKoszulIdealComplex f g ⟶ localSerreExtensionModuleComplex f g c := by
  dsimp [localKoszulIdealComplex, localSerreExtensionModuleComplex]
  refine ShortComplex.homMk (ModuleCat.ofHom (LinearMap.lsmul R R c))
    (ModuleCat.ofHom (localKoszulToSerreMiddleMap f g c)) (𝟙 _) ?_ ?_
  · apply ModuleCat.hom_ext
    change (localSerreExtensionFromRing f g c).comp (LinearMap.lsmul R R c) =
      (localKoszulToSerreMiddleMap f g c).comp (localKoszulRelationMap f g)
    exact (localKoszulToSerreMiddle_relation f g c).symm
  · apply ModuleCat.hom_ext
    change (localSerreExtensionToIdeal f g c).comp (localKoszulToSerreMiddleMap f g c) =
      (localKoszulToIdeal f g).comp LinearMap.id
    simpa using localKoszulToSerreMiddle_toIdeal f g c

@[simp] lemma localKoszulToSerreComparison_tau1 (f g c : R) :
    (localKoszulToSerreComparison f g c).τ₁ = ModuleCat.ofHom (LinearMap.lsmul R R c) := rfl

@[simp] lemma localKoszulToSerreComparison_tau3 (f g c : R) :
    (localKoszulToSerreComparison f g c).τ₃ =
      𝟙 (localSerreExtensionModuleComplex f g c).X₃ := rfl

/-- A regular pair supplies the first Koszul short exact sequence
`0 → R → R² → (f,g) → 0`. -/
lemma localKoszulIdealComplex_shortExact (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    (localKoszulIdealComplex f g).ShortExact := by
  apply ModuleCat.shortComplex_shortExact
  · change Function.Exact (localKoszulRelationMap f g) (localKoszulToIdeal f g)
    rw [LinearMap.exact_iff, localKoszulToIdeal_ker f g hf hg]
    ext x
    rw [Submodule.mem_span_singleton]
    constructor
    · rintro ⟨d, rfl⟩
      exact ⟨d, rfl⟩
    · rintro ⟨d, rfl⟩
      exact ⟨d, rfl⟩
  · change Function.Injective (localKoszulRelationMap f g)
    intro a b hab
    have h := congrArg Prod.snd hab
    change a * f = b * f at h
    apply sub_eq_zero.mp
    apply mem_nonZeroDivisors_iff_left.mp hf
    have h' : (a - b) * f = 0 := by rw [sub_mul, h, sub_self]
    simpa [mul_comm] using h'
  · change Function.Surjective (localKoszulToIdeal f g)
    exact localKoszulToIdeal_surjective f g

/-- The local Serre extension with coefficient `c` is the pushout of the
Koszul extension along multiplication by `c`.  Equivalently, its `Ext¹`
class is the first Koszul boundary of the coefficient `c`. -/
theorem localSerreExtClass_eq_koszul_boundary (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass =
      (localKoszulIdealComplex_shortExact f g hf hg).extClass.comp
        (Ext.mk₀ (ModuleCat.ofHom (LinearMap.lsmul R R c)))
        (add_zero 1) := by
  have h := ShortComplex.ShortExact.extClass_naturality
    (localKoszulIdealComplex_shortExact f g hf hg)
    (localSerreExtensionModuleComplex_shortExact f g c hf hg)
    (localKoszulToSerreComparison f g c)
  change
    (localKoszulIdealComplex_shortExact f g hf hg).extClass.comp
        (Ext.mk₀ (ModuleCat.ofHom (LinearMap.lsmul R R c))) (add_zero 1) =
      (Ext.mk₀ (𝟙 (localSerreExtensionModuleComplex f g c).X₃)).comp
        (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass
        (zero_add 1) at h
  rw [Ext.mk₀_id_comp] at h
  exact h.symm

/-- The first Koszul connecting map is surjective onto the local extension
classes, since the middle free module has no positive Ext. -/
theorem localKoszulExtBoundary_surjective (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    Function.Surjective
      ((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
        (ModuleCat.of R R) (show 1 + 0 = 1 by omega)) := by
  let S := localKoszulIdealComplex f g
  let hS := localKoszulIdealComplex_shortExact f g hf hg
  letI : Projective S.X₂ := by
    change Projective (ModuleCat.of R (R × R))
    infer_instance
  intro z
  have hzero : (Ext.mk₀ S.g).comp z (zero_add 1) = 0 :=
    Ext.eq_zero_of_projective ((Ext.mk₀ S.g).comp z (zero_add 1))
  exact Ext.contravariant_sequence_exact₃ hS (ModuleCat.of R R) z hzero
    (show 1 + 0 = 1 by omega)

/-- The kernel of the first Koszul connecting map is exactly the image of
maps from the middle free module. -/
theorem localKoszulExtBoundary_exact (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    Function.Exact
      ((Ext.mk₀ (localKoszulIdealComplex f g).f).precomp
        (ModuleCat.of R R) (zero_add 0))
      ((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
        (ModuleCat.of R R) (show 1 + 0 = 1 by omega)) := by
  let S := localKoszulIdealComplex f g
  let hS := localKoszulIdealComplex_shortExact f g hf hg
  have h := Ext.contravariant_sequence_exact₁' hS (ModuleCat.of R R) 0 1
    (show 1 + 0 = 1 by omega)
  rw [ShortComplex.ab_exact_iff_function_exact] at h
  exact h

/-- The `Ext²` class locally represented by the Serre presentation with
coordinate `c`.  It is the Yoneda product of the ideal quotient sequence
with the extension `0 → R → E_c → (f,g) → 0`. -/
noncomputable def localSerreExtTwoClass (f g c : R)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    CategoryTheory.Abelian.Ext
      (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
      (ModuleCat.of R R) 2 :=
  (localSerreIdealQuotientComplex_shortExact f g).extClass.comp
    (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass
    (show 1 + 1 = 2 by omega)

/-- The connecting morphism for `0 → (f,g) → R → R/(f,g) → 0` is bijective
from degree-one Ext to degree-two Ext, since the middle copy of `R` is
projective. -/
theorem localSerreExtBoundary_bijective (f g : R) [HasExt.{w} (ModuleCat R)] :
    Function.Bijective
      ((localSerreIdealQuotientComplex_shortExact f g).extClass.precomp
        (ModuleCat.of R R) (show 1 + 1 = 2 by omega)) := by
  letI : Projective (localSerreIdealQuotientComplex f g).X₂ := by
    change Projective (ModuleCat.of R R)
    infer_instance
  exact extBoundary_one_two_bijective_of_projective_middle
    (localSerreIdealQuotientComplex_shortExact f g) (ModuleCat.of R R)

/-- Evaluation at `1` identifies degree-zero self-Ext of the free rank-one
module with the coefficient ring. -/
noncomputable def localExtZeroSelfLinearEquiv [HasExt.{w} (ModuleCat R)] :
    Ext (ModuleCat.of R R) (ModuleCat.of R R) 0 ≃ₗ[R] R :=
  (Ext.linearEquiv₀ (R := R)).trans <|
    (ModuleCat.homLinearEquiv (S := R)).trans <|
      LinearMap.ringLmapEquivSelf R R R

@[simp]
lemma localExtZeroSelfLinearEquiv_symm_apply (c : R) [HasExt.{w} (ModuleCat R)] :
    localExtZeroSelfLinearEquiv.symm c =
      Ext.mk₀ (ModuleCat.ofHom (LinearMap.lsmul R R c)) := by
  rw [localExtZeroSelfLinearEquiv, LinearEquiv.symm_trans_apply,
    LinearEquiv.symm_trans_apply, Ext.linearEquiv₀_symm_apply]
  congr 1
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change x * c = c * x
  exact mul_comm x c

/-- In the free Koszul complex, the degree-zero Ext coordinate of
precomposition with the relation is ordinary precomposition of linear maps. -/
lemma localExtZeroSelf_precomp_coordinates (f g : R) [HasExt.{w} (ModuleCat R)]
    (x : Ext (ModuleCat.of R (R × R)) (ModuleCat.of R R) 0) :
    localExtZeroSelfLinearEquiv
      ((Ext.mk₀ (localKoszulIdealComplex f g).f).precomp
        (ModuleCat.of R R) (zero_add 0) x) =
      (LinearMap.ringLmapEquivSelf R R R)
        ((ModuleCat.homLinearEquiv (S := R) (Ext.linearEquiv₀ (R := R) x)).comp
          (localKoszulRelationMap f g)) := by
  dsimp [localKoszulIdealComplex]
  change localExtZeroSelfLinearEquiv (R := R)
    ((Ext.mk₀ (ModuleCat.ofHom (localKoszulRelationMap f g))).precomp
      (ModuleCat.of R R) (zero_add 0) x) = _
  dsimp [localExtZeroSelfLinearEquiv]
  have hpre := ext_addEquiv₀_precomp (ModuleCat.ofHom (localKoszulRelationMap f g)) x
  change Ext.linearEquiv₀ (R := R)
    ((Ext.mk₀ (ModuleCat.ofHom (localKoszulRelationMap f g))).precomp
      (ModuleCat.of R R) (zero_add 0) x) =
      ModuleCat.ofHom (localKoszulRelationMap f g) ≫ Ext.linearEquiv₀ (R := R) x at hpre
  rw [hpre]
  rfl

/-- The local coefficient map from `R` to the second Ext group.  It is the
two successive connecting maps of the Koszul and ideal-quotient sequences,
after identifying degree-zero self-Ext with `R`. -/
noncomputable def localExtTwoCoefficientMap (f g : R)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    R →ₗ[R] Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
      (ModuleCat.of R R) 2 :=
  ((localSerreIdealQuotientComplex_shortExact f g).extClass.precompOfLinear R
    (ModuleCat.of R R) (show 1 + 1 = 2 by omega)).comp <|
    ((localKoszulIdealComplex_shortExact f g hf hg).extClass.precompOfLinear R
      (ModuleCat.of R R) (show 1 + 0 = 1 by omega)).comp <|
      localExtZeroSelfLinearEquiv.symm.toLinearMap

/-- The coefficient map sends `c` to the two-extension obtained from the
local Serre presentation with relation `(-g,f,-c)`. -/
theorem localExtTwoCoefficientMap_apply_eq_localSerreExtTwoClass
    (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    localExtTwoCoefficientMap f g hf hg c =
      localSerreExtTwoClass f g c hf hg := by
  change
    (localSerreIdealQuotientComplex_shortExact f g).extClass.comp
        ((localKoszulIdealComplex_shortExact f g hf hg).extClass.comp
          (localExtZeroSelfLinearEquiv.symm c) (add_zero 1))
        (show 1 + 1 = 2 by omega) =
      (localSerreIdealQuotientComplex_shortExact f g).extClass.comp
        (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass
        (show 1 + 1 = 2 by omega)
  rw [localExtZeroSelfLinearEquiv_symm_apply]
  have h := localSerreExtClass_eq_koszul_boundary f g c hf hg
  exact congrArg
    (fun z => (localSerreIdealQuotientComplex_shortExact f g).extClass.comp z
      (show 1 + 1 = 2 by omega)) h.symm

/-- Every local second Ext class has a coefficient. -/
theorem localExtTwoCoefficientMap_surjective (f g : R)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    Function.Surjective (localExtTwoCoefficientMap f g hf hg) := by
  intro z
  obtain ⟨x, hx⟩ := (localSerreExtBoundary_bijective f g).2 z
  obtain ⟨y, hy⟩ := localKoszulExtBoundary_surjective f g hf hg x
  change Ext (ModuleCat.of R R) (ModuleCat.of R R) 0 at y
  refine ⟨localExtZeroSelfLinearEquiv y, ?_⟩
  rw [← hx, ← hy]
  change ((localSerreIdealQuotientComplex_shortExact f g).extClass.precomp
      (ModuleCat.of R R) (show 1 + 1 = 2 by omega))
      (((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
        (ModuleCat.of R R) (show 1 + 0 = 1 by omega))
        (localExtZeroSelfLinearEquiv.symm (localExtZeroSelfLinearEquiv y))) = _
  rw [LinearEquiv.symm_apply_apply]

/-- The local coefficient map has precisely the lci ideal as kernel. -/
theorem localExtTwoCoefficientMap_ker (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    (localExtTwoCoefficientMap.{u, w} f g hf hg).ker =
      Ideal.span ({f, g} : Set R) := by
  ext r
  constructor
  · intro hr
    have hb2 : ((localSerreIdealQuotientComplex_shortExact f g).extClass.precomp
        (ModuleCat.of R R) (show 1 + 1 = 2 by omega))
        (((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
          (ModuleCat.of R R) (show 1 + 0 = 1 by omega))
          (localExtZeroSelfLinearEquiv.symm r)) = 0 := by
      exact hr
    have hb2' : ((localSerreIdealQuotientComplex_shortExact f g).extClass.precomp
        (ModuleCat.of R R) (show 1 + 1 = 2 by omega))
        (((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
          (ModuleCat.of R R) (show 1 + 0 = 1 by omega))
          (localExtZeroSelfLinearEquiv.symm r)) =
        ((localSerreIdealQuotientComplex_shortExact f g).extClass.precomp
          (ModuleCat.of R R) (show 1 + 1 = 2 by omega)) 0 := by
      rw [hb2, map_zero]
    have hb1 : ((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
          (ModuleCat.of R R) (show 1 + 0 = 1 by omega))
          (localExtZeroSelfLinearEquiv.symm r) = 0 :=
      (localSerreExtBoundary_bijective f g).1 hb2'
    obtain ⟨x, hx⟩ := ((localKoszulExtBoundary_exact f g hf hg)
      (localExtZeroSelfLinearEquiv.symm r)).mp hb1
    change Ext (ModuleCat.of R (R × R)) (ModuleCat.of R R) 0 at x
    change r ∈ (Ideal.span ({f, g} : Set R) : Set R)
    rw [← range_localKoszulRelation_precomp f g]
    let h : (R × R) →ₗ[R] R :=
      ModuleCat.homLinearEquiv (S := R) (Ext.linearEquiv₀ (R := R) x)
    refine ⟨h, ?_⟩
    have hx' := congrArg (localExtZeroSelfLinearEquiv (R := R)) hx
    rw [LinearEquiv.apply_symm_apply] at hx'
    rw [localExtZeroSelf_precomp_coordinates] at hx'
    exact hx'
  · intro hr
    change r ∈ (Ideal.span ({f, g} : Set R) : Set R) at hr
    rw [← range_localKoszulRelation_precomp f g] at hr
    obtain ⟨h, hh⟩ := hr
    let x : Ext (ModuleCat.of R (R × R)) (ModuleCat.of R R) 0 :=
      (Ext.linearEquiv₀ (R := R)).symm
        ((ModuleCat.homLinearEquiv (S := R)).symm h)
    have hAx : ((Ext.mk₀ (localKoszulIdealComplex f g).f).precomp
        (ModuleCat.of R R) (zero_add 0) x) = localExtZeroSelfLinearEquiv.symm r := by
      apply localExtZeroSelfLinearEquiv.injective
      dsimp [x]
      rw [localExtZeroSelf_precomp_coordinates]
      simp only [Ext.linearEquiv₀_symm_apply]
      rw [← Ext.linearEquiv₀_symm_apply (R := R), LinearEquiv.apply_symm_apply]
      rw [LinearEquiv.apply_symm_apply]
      rw [LinearEquiv.apply_symm_apply]
      exact hh
    have hBA : ((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
        (ModuleCat.of R R) (show 1 + 0 = 1 by omega))
        ((Ext.mk₀ (localKoszulIdealComplex f g).f).precomp
          (ModuleCat.of R R) (zero_add 0) x) = 0 := by
      have hzero := congrFun (localKoszulExtBoundary_exact f g hf hg).comp_eq_zero x
      exact hzero
    change localExtTwoCoefficientMap f g hf hg r = 0
    change ((localSerreIdealQuotientComplex_shortExact f g).extClass.precomp
      (ModuleCat.of R R) (show 1 + 1 = 2 by omega))
      (((localKoszulIdealComplex_shortExact f g hf hg).extClass.precomp
        (ModuleCat.of R R) (show 1 + 0 = 1 by omega))
        (localExtZeroSelfLinearEquiv.symm r)) = 0
    rw [← hAx]
    rw [hBA]
    exact map_zero _

/-- The standard local complete-intersection calculation
`Ext²_R(R/(f,g), R) ≃ R/(f,g)`. -/
noncomputable def localExtTwoCoefficientEquiv (f g : R)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    (R ⧸ Ideal.span ({f, g} : Set R)) ≃ₗ[R]
      Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R))) (ModuleCat.of R R) 2 :=
  let I : Submodule R R := Ideal.span ({f, g} : Set R)
  let F := localExtTwoCoefficientMap.{u, w} f g hf hg
  let hIF : I ≤ LinearMap.ker F := by
    dsimp [I, F]
    rw [localExtTwoCoefficientMap_ker.{u, w} f g hf hg]
  LinearEquiv.ofBijective (I.liftQ F hIF) ⟨by
    rw [← LinearMap.ker_eq_bot]
    exact Submodule.ker_liftQ_eq_bot I F hIF (by
      dsimp [I, F]
      rw [localExtTwoCoefficientMap_ker.{u, w} f g hf hg]), by
    rw [← LinearMap.range_eq_top, Submodule.range_liftQ]
    exact LinearMap.range_eq_top.mpr
      (localExtTwoCoefficientMap_surjective.{u, w} f g hf hg)⟩

/-- Under the complete-intersection identification
`Ext²_R(R/(f,g),R) ≃ R/(f,g)`, the two-extension defined by the local Serre
presentation has coordinate equal to the residue class of `c`. -/
theorem localExtTwoCoefficientEquiv_symm_localSerreExtTwoClass
    (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)] :
    (localExtTwoCoefficientEquiv f g hf hg).symm
        (localSerreExtTwoClass f g c hf hg) =
      Ideal.Quotient.mk (Ideal.span ({f, g} : Set R)) c := by
  apply (localExtTwoCoefficientEquiv f g hf hg).injective
  rw [LinearEquiv.apply_symm_apply]
  change localSerreExtTwoClass f g c hf hg =
    localExtTwoCoefficientMap f g hf hg c
  exact (localExtTwoCoefficientMap_apply_eq_localSerreExtTwoClass
    f g c hf hg).symm

/-- For a proper two-generator complete-intersection ideal, the local Serre
two-extension with coefficient `1` is nonzero.  This is the local class used
in the Serre-duality step: the coefficient description identifies it with
the nonzero residue class of `1` in `R/(f,g)`. -/
theorem localSerreExtTwoClass_one_ne_zero_of_one_not_mem_span
    (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)]
    (hproper : (1 : R) ∉ Ideal.span ({f, g} : Set R)) :
    localSerreExtTwoClass f g 1 hf hg ≠ 0 := by
  intro hzero
  have hquot : Ideal.Quotient.mk (Ideal.span ({f, g} : Set R)) (1 : R) = 0 := by
    rw [← localExtTwoCoefficientEquiv_symm_localSerreExtTwoClass f g 1 hf hg]
    simp [hzero]
  exact hproper (Ideal.Quotient.eq_zero_iff_mem.mp hquot)

/-- In the local complete-intersection situation, parameters generating the
maximal ideal give the nonzero coefficient-one Serre class automatically. -/
theorem localSerreExtTwoClass_one_ne_zero_of_span_eq_maximalIdeal
    [IsLocalRing R] (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    [HasExt.{w} (ModuleCat R)]
    (hspan : Ideal.span ({f, g} : Set R) = IsLocalRing.maximalIdeal R) :
    localSerreExtTwoClass f g 1 hf hg ≠ 0 := by
  apply localSerreExtTwoClass_one_ne_zero_of_one_not_mem_span f g hf hg
  intro hone
  apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  rw [← hspan, Ideal.eq_top_iff_one]
  exact hone

/-- If the two regular parameters vanish at a local point, reducing the
complete-intersection Ext coordinate to the residue field sends the local
Serre two-extension to the residue class of its coefficient `c`. -/
theorem localSerreExtTwoClass_residue_coordinate
    [IsLocalRing R] (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)] :
    let hfg : Ideal.span ({f, g} : Set R) ≤ IsLocalRing.maximalIdeal R :=
      Ideal.span_le.mpr (by
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl
        · exact hfm
        · exact hgm)
    Ideal.Quotient.factor hfg
        ((localExtTwoCoefficientEquiv f g hf hg).symm
          (localSerreExtTwoClass f g c hf hg)) =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) c := by
  dsimp
  rw [localExtTwoCoefficientEquiv_symm_localSerreExtTwoClass,
    Ideal.Quotient.factor_mk]

/-- The canonical additive local component map obtained by taking the
complete-intersection Ext coordinate and then reducing it to the residue
field. -/
noncomputable def localExtTwoResidueCoordinate
    [IsLocalRing R] (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)] :
    Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
        (ModuleCat.of R R) 2 →+
      R ⧸ IsLocalRing.maximalIdeal R where
  toFun z :=
    let hfg : Ideal.span ({f, g} : Set R) ≤ IsLocalRing.maximalIdeal R :=
      Ideal.span_le.mpr (by
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl
        · exact hfm
        · exact hgm)
    Ideal.Quotient.factor hfg ((localExtTwoCoefficientEquiv f g hf hg).symm z)
  map_zero' := by simp
  map_add' := by intro x y; simp

/-- Linear form of the local residue coordinate.  Besides recording
additivity, this makes its compatibility with multiplication by a stalk
scalar available directly to the global point-scaling argument. -/
noncomputable def localExtTwoResidueCoordinateLinearMap
    [IsLocalRing R] (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)] :
    Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
        (ModuleCat.of R R) 2 →ₗ[R]
      R ⧸ IsLocalRing.maximalIdeal R := by
  let hfg : Ideal.span ({f, g} : Set R) ≤ IsLocalRing.maximalIdeal R :=
    Ideal.span_le.mpr (by
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact hfm
      · exact hgm)
  exact (Ideal.Quotient.factorₐ R hfg).toLinearMap.comp
    (localExtTwoCoefficientEquiv f g hf hg).symm.toLinearMap

@[simp]
theorem localExtTwoResidueCoordinateLinearMap_apply
    [IsLocalRing R] (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)]
    (z : Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
      (ModuleCat.of R R) 2) :
    localExtTwoResidueCoordinateLinearMap f g hf hg hfm hgm z =
      localExtTwoResidueCoordinate f g hf hg hfm hgm z := by
  rfl

theorem localExtTwoResidueCoordinate_smul
    [IsLocalRing R] (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)] (a : R)
    (z : Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
      (ModuleCat.of R R) 2) :
    localExtTwoResidueCoordinate f g hf hg hfm hgm (a • z) =
      a • localExtTwoResidueCoordinate f g hf hg hfm hgm z := by
  rw [← localExtTwoResidueCoordinateLinearMap_apply,
    ← localExtTwoResidueCoordinateLinearMap_apply, map_smul]

/-- Precomposition by scalar multiplication on the lci quotient source
scales the local residue coordinate by the same stalk scalar. -/
theorem localExtTwoResidueCoordinate_precomp_smul_id
    [IsLocalRing R] (f g : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)] (a : R)
    (z : Ext (ModuleCat.of R (R ⧸ Ideal.span ({f, g} : Set R)))
      (ModuleCat.of R R) 2) :
    localExtTwoResidueCoordinate f g hf hg hfm hgm
        ((Ext.mk₀ (a • 𝟙 (ModuleCat.of R
          (R ⧸ Ideal.span ({f, g} : Set R))))).comp z (zero_add 2)) =
      a • localExtTwoResidueCoordinate f g hf hg hfm hgm z := by
  rw [Ext.mk₀_smul, Ext.smul_comp, Ext.mk₀_id_comp,
    localExtTwoResidueCoordinate_smul]

@[simp]
theorem localExtTwoResidueCoordinate_localSerreExtTwoClass
    [IsLocalRing R] (f g c : R) (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [HasExt.{w} (ModuleCat R)] :
    localExtTwoResidueCoordinate f g hf hg hfm hgm
        (localSerreExtTwoClass f g c hf hg) =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) c := by
  exact localSerreExtTwoClass_residue_coordinate f g c hf hg hfm hgm

/-- The local extension module is free when its Ext coordinate is a unit. -/
theorem localSerreExtensionPresentation_free_of_isUnit
    (f g c : R) (hc : IsUnit c) :
    Module.Free R (localSerreExtensionPresentation f g c) := by
  letI : Module.Free R R := inferInstance
  letI : Module.Free R (R × R) := Module.Free.prod R R R
  exact Module.Free.of_equiv
    (localSerreExtensionFreeOfUnit f g hc.unit).symm

/- A converse to the preceding unit-coordinate calculation is needed at a
local bad point.  If the first two section germs lie in the maximal ideal,
then a free quotient would split the one relation
`(-g, f, -c)`.  The resulting coefficient functional would send that
relation to `1`, while every term lies in the maximal ideal, which is
impossible.  This is entirely local algebra and does not use the surface
geometry that supplies the three germs. -/
theorem localSerreExtensionPresentation_not_free_of_mem_maximalIdeal
    [IsLocalRing R] (f g c : R) (hf : f ∈ R⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    (hcm : c ∈ IsLocalRing.maximalIdeal R) :
    ¬ Module.Free R (localSerreExtensionPresentation f g c) := by
  intro hfree
  let v : R × R × R := localSerreRelation f g c
  let ι : R →ₗ[R] R × R × R :=
    { toFun := fun a => a • v
      map_add' := by intro a b; simp [add_smul]
      map_smul' := by intro a b; simp [smul_smul, mul_comm] }
  have hιinj : Function.Injective ι := by
    intro a b hab
    have hsecond : a * f = b * f := by
      have h := congrArg (fun z : R × R × R => z.2.1) hab
      simpa [ι, v, localSerreRelation, smul_eq_mul] using h
    have hz : f * (a - b) = 0 := by
      calc
        f * (a - b) = a * f - b * f := by ring
        _ = 0 := by rw [hsecond]; ring
    exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_left.mp hf) (a - b) hz)
  let e : R ≃ₗ[R] Submodule.span R ({v} : Set (R × R × R)) := by
    apply LinearEquiv.ofBijective (ι.codRestrict _ (by
      intro a
      exact Submodule.smul_mem _ a (Submodule.subset_span (by simp))))
    constructor
    · intro a b hab
      apply hιinj
      exact congrArg Subtype.val hab
    · intro z
      have hz := z.2
      rw [Submodule.mem_span_singleton] at hz
      obtain ⟨a, ha⟩ := hz
      refine ⟨a, ?_⟩
      apply Subtype.ext
      exact ha
  letI : Module.Projective R (localSerreExtensionPresentation f g c) :=
    Module.Projective.of_free
  obtain ⟨p, hp⟩ := submodule_retraction_of_projective_quotient
    (R := R) (M := R × R × R)
      (Submodule.span R ({v} : Set (R × R × R)))
  let ell : (R × R × R) →ₗ[R] R := e.symm.toLinearMap.comp p
  have hellv : ell v = 1 := by
    change e.symm (p v) = 1
    have hpv : p (⟨v, Submodule.subset_span (by simp)⟩ :
        Submodule.span R ({v} : Set (R × R × R))) =
        ⟨v, Submodule.subset_span (by simp)⟩ := by
      exact congrArg (fun z => z) (LinearMap.congr_fun hp
        (⟨v, Submodule.subset_span (by simp)⟩ :
          Submodule.span R ({v} : Set (R × R × R))))
    rw [hpv]
    have heone : e 1 = (⟨v, Submodule.subset_span (by simp)⟩ :
        Submodule.span R ({v} : Set (R × R × R))) := by
      apply Subtype.ext
      dsimp [e, LinearEquiv.ofBijective, ι]
      simp [v, localSerreRelation]
    rw [← heone]
    exact e.symm_apply_apply _
  have hellm : ell v ∈ IsLocalRing.maximalIdeal R := by
    change ell (-g, f, -c) ∈ IsLocalRing.maximalIdeal R
    have hcoeff : ell (1, 0, 0) * (-g) + ell (0, 1, 0) * f +
        ell (0, 0, 1) * (-c) ∈ IsLocalRing.maximalIdeal R := by
      apply Ideal.add_mem
      · apply Ideal.add_mem
        · exact Ideal.mul_mem_left _ _ (neg_mem hgm)
        · exact Ideal.mul_mem_left _ _ hfm
      · exact Ideal.mul_mem_left _ _ (neg_mem hcm)
    have hev : ell (-g, f, -c) =
        ell (1, 0, 0) * (-g) + ell (0, 1, 0) * f +
          ell (0, 0, 1) * (-c) := by
      calc
        ell (-g, f, -c) = ell ((-g) • (1, 0, 0) + f • (0, 1, 0) +
            (-c) • (0, 0, 1)) := by
          congr 1
          ext <;> simp [smul_eq_mul]
        _ = ell (1, 0, 0) * (-g) + ell (0, 1, 0) * f +
            ell (0, 0, 1) * (-c) := by
          rw [map_add, map_add, map_smul, map_smul, map_smul]
          simp [smul_eq_mul]
          ring
    rw [hev]
    exact hcoeff
  have hone : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
    simpa [hellv] using hellm
  exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) hone

/- Under the same regularity and maximal-ideal assumptions, the standard
presentation is free exactly when its local Ext coordinate is a unit. -/
theorem localSerreExtensionPresentation_free_iff_isUnit
    [IsLocalRing R] (f g c : R) (hf : f ∈ R⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R) :
    Module.Free R (localSerreExtensionPresentation f g c) ↔ IsUnit c := by
  constructor
  · intro hfree
    apply IsLocalRing.notMem_maximalIdeal.mp
    intro hcm
    exact (localSerreExtensionPresentation_not_free_of_mem_maximalIdeal
      f g c hf hfm hgm hcm) hfree
  · exact localSerreExtensionPresentation_free_of_isUnit f g c

/- A fibrewise-regular pair over a field supplies the two regularity
   hypotheses in the preceding criterion.  This is the form used by the
   surface-fibre calculation: only the fact that both coordinates vanish at
   the chosen local point is still needed from the geometry. -/
theorem localSerreExtensionPresentation_free_iff_isUnit_of_fibrewiseRegularPair
    {K : Type*} [Field K] (φ : K →+* R)
    [IsLocalRing R] (f g c : R)
    (hregular : AllCharacteristics.IsFibrewiseRegularPair φ f g)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R) :
    Module.Free R (localSerreExtensionPresentation f g c) ↔ IsUnit c := by
  apply localSerreExtensionPresentation_free_iff_isUnit f g c
  · exact hregular.first_mem_nonZeroDivisors_of_field φ f g
  · exact hfm
  · exact hgm

/-- The unit-coordinate local presentation, viewed as a quasicoherent sheaf
on its affine spectrum, is explicitly the free rank-two module sheaf.  This
is the affine sheaf form of the local calculation which a future comparison
with a stalk of the Serre extension can use directly. -/
noncomputable def localSerreExtensionPresentationSheafFreeOfUnit
    (f g : R) (u : Rˣ) :
    tilde (ModuleCat.of R (localSerreExtensionPresentation f g (u : R))) ≅
      SheafOfModules.free (R := (Spec (.of R)).ringCatSheaf) (ULift.{u} (Fin 2)) := by
  let e : localSerreExtensionPresentation f g (u : R) ≃ₗ[R]
      (ULift.{u} (Fin 2) →₀ R) :=
    (localSerreExtensionFreeOfUnit f g u).trans
      ((LinearEquiv.finTwoArrow R R).symm.trans
        ((LinearEquiv.piCongrLeft R (fun _ : Fin 2 => R) Equiv.ulift).symm.trans
          (Finsupp.linearEquivFunOnFinite R R (ULift.{u} (Fin 2))).symm))
  exact ((tilde.functor (CommRingCat.of R)).mapIso (LinearEquiv.toModuleIso e)).trans
    (tildeFinsupp (R := CommRingCat.of R) (ULift.{u} (Fin 2)))

/-- The same affine-sheaf trivialization from the ordinary `IsUnit` form of
the coordinate hypothesis. -/
noncomputable def localSerreExtensionPresentationSheafFreeOfIsUnit
    (f g c : R) (hc : IsUnit c) :
    tilde (ModuleCat.of R (localSerreExtensionPresentation f g c)) ≅
      SheafOfModules.free (R := (Spec (.of R)).ringCatSheaf) (ULift.{u} (Fin 2)) := by
  rw [← hc.unit_spec]
  exact localSerreExtensionPresentationSheafFreeOfUnit f g hc.unit

/-- At a local ring, non-freeness of the standard Serre extension forces its
local Ext coordinate to vanish at the closed point.  This is the algebraic
implication used by Voisin's Galois-orbit argument. -/
theorem localSerreExtension_coordinate_mem_maximalIdeal_of_not_free
    [IsLocalRing R] (f g c : R)
    (hfree : ¬ Module.Free R (localSerreExtensionPresentation f g c)) :
    c ∈ IsLocalRing.maximalIdeal R := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hc
  exact hfree (localSerreExtensionPresentation_free_of_isUnit f g c hc)

/-- Equivalently, a non-free local Serre presentation has zero Ext coordinate
after passing to the residue ring at the closed point. -/
theorem localSerreExtension_coordinate_eq_zero_mod_maximalIdeal_of_not_free
    [IsLocalRing R] (f g c : R)
    (hfree : ¬ Module.Free R (localSerreExtensionPresentation f g c)) :
    Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) c = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact localSerreExtension_coordinate_mem_maximalIdeal_of_not_free f g c hfree

/-- The same residue-coordinate conclusion for any local module identified
with the standard Serre presentation.  This is the form applied to a stalk
of the actual middle sheaf: the only geometric input is the presentation
equivalence at that stalk. -/
theorem localSerreExtension_coordinate_eq_zero_mod_maximalIdeal_of_not_free_of_linearEquiv
    [IsLocalRing R] {E : Type u} [AddCommGroup E] [Module R E]
    (f g c : R) (e : E ≃ₗ[R] localSerreExtensionPresentation f g c)
    (hfree : ¬ Module.Free R E) :
    Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) c = 0 := by
  apply localSerreExtension_coordinate_eq_zero_mod_maximalIdeal_of_not_free f g c
  intro hpresentation
  apply hfree
  exact Module.Free.of_equiv e.symm

/-- The map from three chosen local lifts to an extension middle module. -/
noncomputable def localSerreExtensionLiftMap
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (e₁ e₂ : E) : R × R × R →ₗ[R] E where
  toFun x := x.1 • e₁ + x.2.1 • e₂ + x.2.2 • ι 1
  map_add' x y := by
    simp only [Prod.fst_add, Prod.snd_add, add_smul, add_add_add_comm]
  map_smul' a x := by
    change (a * x.1) • e₁ + (a * x.2.1) • e₂ + (a * x.2.2) • ι 1 =
      a • (x.1 • e₁ + x.2.1 • e₂ + x.2.2 • ι 1)
    simp only [mul_smul, smul_add]

lemma localSerreExtensionLiftMap_apply
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (e₁ e₂ : E) (x : R × R × R) :
    localSerreExtensionLiftMap ι e₁ e₂ x =
      x.1 • e₁ + x.2.1 • e₂ + x.2.2 • ι 1 := rfl

lemma localSerreExtensionLiftMap_relation
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (e₁ e₂ : E) (f g c : R)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1) :
    localSerreExtensionLiftMap ι e₁ e₂ (localSerreRelation f g c) = 0 := by
  change (-g) • e₁ + f • e₂ + (-c) • ι 1 = 0
  rw [hrel]
  rw [← add_smul]
  simp

/-- The quotient of the lift map by its Serre relation. -/
noncomputable def localSerreExtensionLiftPresentationMap
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (e₁ e₂ : E) (f g c : R)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1) :
    localSerreExtensionPresentation f g c →ₗ[R] E :=
  Submodule.liftQ _ (localSerreExtensionLiftMap ι e₁ e₂) (by
    rw [Submodule.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact localSerreExtensionLiftMap_relation ι e₁ e₂ f g c hrel)

lemma localSerreExtensionLiftPresentationMap_mk
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (e₁ e₂ : E) (f g c : R)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (x : R × R × R) :
    localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel
      (Submodule.Quotient.mk x) =
    localSerreExtensionLiftMap ι e₁ e₂ x := by
  exact Submodule.liftQ_apply _ _ _

/-- The presentation map carries the standard canonical generator to the
actual canonical inclusion of the extension. -/
lemma localSerreExtensionLiftPresentationMap_fromRing
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (e₁ e₂ : E) (f g c : R)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1) (t : R) :
    localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel
      (localSerreExtensionFromRing f g c t) = ι t := by
  rw [show localSerreExtensionFromRing f g c t =
      Submodule.Quotient.mk (0, 0, t) by rfl]
  rw [localSerreExtensionLiftPresentationMap_mk]
  rw [localSerreExtensionLiftMap_apply]
  simp only [zero_smul, zero_add]
  simpa using (ι.map_smul t (1 : R)).symm

lemma localSerreExtensionLiftPresentationMap_surjective
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1) :
    Function.Surjective (localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel) := by
  intro y
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp (p y).property
  let q₀ : localSerreExtensionPresentation f g c := Submodule.Quotient.mk (a, b, 0)
  have hpq₀ : p (localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel q₀) = p y := by
    dsimp only [q₀]
    rw [localSerreExtensionLiftPresentationMap_mk]
    rw [localSerreExtensionLiftMap_apply]
    change p (a • e₁ + b • e₂ + 0 • ι 1) = p y
    rw [map_add]
    simp only [zero_smul]
    rw [map_add, map_smul, map_smul, hπ₁, hπ₂]
    apply Subtype.ext
    simpa [smul_eq_mul] using hab
  have hzero : p (y - localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel q₀) = 0 := by
    rw [map_sub, hpq₀, sub_self]
  obtain ⟨t, ht⟩ := (hexact _).mp hzero
  let q : localSerreExtensionPresentation f g c := Submodule.Quotient.mk (a, b, t)
  refine ⟨q, ?_⟩
  have ht' : t • ι 1 = y - (a • e₁ + b • e₂ + 0 • ι 1) := by
    calc
      t • ι 1 = ι t := by
        simpa using (ι.map_smul t (1 : R)).symm
      _ = y - localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel q₀ := ht
      _ = y - (a • e₁ + b • e₂ + 0 • ι 1) := by
        dsimp only [q₀]
        rw [localSerreExtensionLiftPresentationMap_mk]
        rw [localSerreExtensionLiftMap_apply]
        simp
  dsimp only [q]
  rw [localSerreExtensionLiftPresentationMap_mk]
  change (localSerreExtensionLiftMap ι e₁ e₂) (a, b, t) = y
  rw [localSerreExtensionLiftMap_apply]
  calc
    a • e₁ + b • e₂ + t • ι 1 =
        (a • e₁ + b • e₂ + 0 • ι 1) + t • ι 1 := by simp
    _ = (a • e₁ + b • e₂ + 0 • ι 1) +
        (y - (a • e₁ + b • e₂ + 0 • ι 1)) := by rw [ht']
    _ = y := by module

lemma localSerreExtensionLiftMap_projection
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (x : R × R × R) :
    p (localSerreExtensionLiftMap ι e₁ e₂ x) = localSerreIdealGeneratorMap f g x := by
  rw [localSerreExtensionLiftMap_apply]
  have hπι : p (ι 1) = 0 := hexact.apply_apply_eq_zero 1
  rw [map_add]
  simp only [map_add, map_smul, hπ₁, hπ₂, hπι, smul_zero, add_zero]
  apply Subtype.ext
  rfl

/-- The quotient lift map commutes with projection to the two-generator
ideal. -/
lemma localSerreExtensionLiftPresentationMap_projection
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (q : localSerreExtensionPresentation f g c) :
    p (localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel q) =
      localSerreExtensionToIdeal f g c q := by
  induction q using Submodule.Quotient.induction_on with
  | _ x =>
      rw [localSerreExtensionLiftPresentationMap_mk,
        localSerreExtensionToIdeal_mk,
        localSerreExtensionLiftMap_projection ι f g p e₁ e₂ hexact hπ₁ hπ₂]

lemma localSerreExtensionLiftPresentationMap_injective
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    Function.Injective (localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel) := by
  intro q q' hqq'
  have hq : localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel (q - q') = 0 := by
    rw [map_sub, hqq', sub_self]
  obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (q - q')
  rw [← hx] at hq
  rw [localSerreExtensionLiftPresentationMap_mk] at hq
  have hp : p (localSerreExtensionLiftMap ι e₁ e₂ x) = 0 := by
    rw [hq, map_zero]
  rw [localSerreExtensionLiftMap_projection ι f g p e₁ e₂ hexact hπ₁ hπ₂] at hp
  have hfg : localKoszulGeneratorMap f g (x.1, x.2.1) = 0 := by
    change x.1 * f + x.2.1 * g = 0
    exact congrArg Subtype.val hp
  have hxy : (x.1, x.2.1) ∈ Submodule.span R ({(-g, f)} : Set (R × R)) := by
    rw [← localKoszulGeneratorMap_ker f g hf hg]
    exact hfg
  rw [Submodule.mem_span_singleton] at hxy
  obtain ⟨d, hd⟩ := hxy
  have hscalar : d * c + x.2.2 = 0 := by
    apply hinj
    rw [map_zero]
    calc
      ι (d * c + x.2.2) = (d * c + x.2.2) • ι 1 := by
        simpa using (ι.map_smul (d * c + x.2.2) (1 : R))
      _ = d • ((-g) • e₁ + f • e₂) + x.2.2 • ι 1 := by
        rw [hrel]
        module
      _ = localSerreExtensionLiftMap ι e₁ e₂ x := by
        rw [localSerreExtensionLiftMap_apply]
        have h₁ := congrArg Prod.fst hd
        have h₂ := congrArg Prod.snd hd
        change d * -g = x.1 at h₁
        change d * f = x.2.1 at h₂
        rw [← h₁, ← h₂]
        module
      _ = 0 := hq
  apply sub_eq_zero.mp
  rw [← hx]
  rw [Submodule.Quotient.mk_eq_zero]
  rw [Submodule.mem_span_singleton]
  refine ⟨d, ?_⟩
  apply Prod.ext
  · have h₁ := congrArg Prod.fst hd
    change d * -g = x.1 at h₁
    exact h₁
  · apply Prod.ext
    · have h₂ := congrArg Prod.snd hd
      change d * f = x.2.1 at h₂
      exact h₂
    · change d * -c = x.2.2
      calc
        d * -c = -(d * c) := by ring
        _ = x.2.2 := neg_eq_iff_add_eq_zero.mpr hscalar

/-- An exact extension of the lci ideal `(f, g)` has the standard Serre local
presentation once two lifts satisfy the coordinate relation. -/
noncomputable def localSerreExtensionPresentationEquiv_of_exact_of_lifts
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    E ≃ₗ[R] localSerreExtensionPresentation f g c :=
  (LinearEquiv.ofBijective
    (localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel)
    ⟨localSerreExtensionLiftPresentationMap_injective ι f g c p e₁ e₂ hexact hinj
        hπ₁ hπ₂ hrel hf hg,
      localSerreExtensionLiftPresentationMap_surjective ι f g c p e₁ e₂ hexact
        hπ₁ hπ₂ hrel⟩).symm

/-- The presentation equivalence sends the canonical inclusion of the actual
extension to the standard canonical generator. -/
theorem localSerreExtensionPresentationEquiv_of_exact_of_lifts_apply_inclusion
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    localSerreExtensionPresentationEquiv_of_exact_of_lifts
      ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg (ι 1) =
      localSerreExtensionFromRing f g c 1 := by
  let q := localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg
  apply q.symm.injective
  dsimp [q, localSerreExtensionPresentationEquiv_of_exact_of_lifts]
  rw [LinearEquiv.apply_symm_apply]
  exact (localSerreExtensionLiftPresentationMap_fromRing ι e₁ e₂ f g c hrel 1).symm

/-- The presentation equivalence intertwines the entire canonical inclusion,
not only its value at `1`. -/
theorem localSerreExtensionPresentationEquiv_of_exact_of_lifts_inclusion
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (t : R) :
    localSerreExtensionPresentationEquiv_of_exact_of_lifts
        ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg (ι t) =
      localSerreExtensionFromRing f g c t := by
  let q := localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg
  apply q.symm.injective
  dsimp [q, localSerreExtensionPresentationEquiv_of_exact_of_lifts]
  rw [LinearEquiv.apply_symm_apply]
  exact (localSerreExtensionLiftPresentationMap_fromRing
    ι e₁ e₂ f g c hrel t).symm

/-- The presentation equivalence also commutes with the quotient maps to
the ideal `(f,g)`. -/
theorem localSerreExtensionPresentationEquiv_of_exact_of_lifts_projection
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (y : E) :
    localSerreExtensionToIdeal f g c
        (localSerreExtensionPresentationEquiv_of_exact_of_lifts
          ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg y) =
      p y := by
  let q := localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg
  have hproj := localSerreExtensionLiftPresentationMap_projection
    ι f g c p e₁ e₂ hexact hπ₁ hπ₂ hrel (q y)
  have hqy : localSerreExtensionLiftPresentationMap ι e₁ e₂ f g c hrel (q y) = y := by
    change q.symm (q y) = y
    exact q.symm_apply_apply y
  rw [hqy] at hproj
  exact hproj.symm

/-- The presentation equivalence gives a morphism from an arbitrary exact
local extension with compatible lifts to the standard local Serre complex. -/
noncomputable def localSerreExtensionComplexComparison_of_exact_of_lifts
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hzero : p.comp ι = 0)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    ShortComplex.moduleCatMk ι p hzero ⟶
      localSerreExtensionModuleComplex f g c := by
  let q := localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg
  refine ShortComplex.homMk (𝟙 _) (ModuleCat.ofHom q.toLinearMap) (𝟙 _) ?_ ?_
  · apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro t
    change localSerreExtensionFromRing f g c t = q (ι t)
    exact (localSerreExtensionPresentationEquiv_of_exact_of_lifts_inclusion
      ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg t).symm
  · apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    change localSerreExtensionToIdeal f g c (q y) = p y
    exact localSerreExtensionPresentationEquiv_of_exact_of_lifts_projection
      ι f g c p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg y

/-- Consequently, the extension class of any exact local extension equipped
with compatible lifts is the standard local Serre class with coefficient
`c`. -/
theorem localExtension_extClass_eq_localSerreExtClass_of_exact_of_lifts
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g c : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hzero : p.comp ι = 0)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (hrel : (-g) • e₁ + f • e₂ = c • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hS : (ShortComplex.moduleCatMk ι p hzero).ShortExact)
    [HasExt.{w} (ModuleCat R)] :
    hS.extClass =
      (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass := by
  have h := ShortComplex.ShortExact.extClass_naturality hS
    (localSerreExtensionModuleComplex_shortExact f g c hf hg)
    (localSerreExtensionComplexComparison_of_exact_of_lifts
      ι f g c p e₁ e₂ hzero hexact hinj hπ₁ hπ₂ hrel hf hg)
  change hS.extClass.comp (Ext.mk₀ (𝟙 _)) (add_zero 1) =
    (Ext.mk₀ (𝟙 _)).comp
      (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass
      (zero_add 1) at h
  simpa only [Ext.comp_mk₀_id, Ext.mk₀_id_comp] using h

/-- A short exact sequence identified, object by object, with the standard
local Serre extension has the corresponding transported extension class.
This is the form needed for a stalk sequence: its endpoint modules are only
canonically isomorphic to `R` and `(f,g)`, rather than definitionally equal
to them. -/
theorem localExtension_extClass_naturality_of_presentation
    {U E I : Type u} [AddCommGroup U] [AddCommGroup E] [AddCommGroup I]
    [Module R U] [Module R E] [Module R I]
    (i : U →ₗ[R] E) (p : E →ₗ[R] I) (hzero : p.comp i = 0)
    (f g c : R)
    (eU : U ≃ₗ[R] R)
    (eE : E ≃ₗ[R] localSerreExtensionPresentation f g c)
    (eI : I ≃ₗ[R] Ideal.span ({f, g} : Set R))
    (hi : eE.toLinearMap.comp i =
      (localSerreExtensionFromRing f g c).comp eU.toLinearMap)
    (hp : (localSerreExtensionToIdeal f g c).comp eE.toLinearMap =
      eI.toLinearMap.comp p)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hS : (ShortComplex.moduleCatMk i p hzero).ShortExact)
    [HasExt.{w} (ModuleCat R)] :
    hS.extClass.comp (Ext.mk₀ (ModuleCat.ofHom eU.toLinearMap)) (add_zero 1) =
      (Ext.mk₀ (ModuleCat.ofHom eI.toLinearMap)).comp
        (localSerreExtensionModuleComplex_shortExact f g c hf hg).extClass
        (zero_add 1) := by
  let a : ShortComplex.moduleCatMk i p hzero ⟶
      localSerreExtensionModuleComplex f g c :=
    ShortComplex.homMk
      (ModuleCat.ofHom eU.toLinearMap)
      (ModuleCat.ofHom eE.toLinearMap)
      (ModuleCat.ofHom eI.toLinearMap)
      (ModuleCat.hom_ext hi.symm) (ModuleCat.hom_ext hp)
  exact ShortComplex.ShortExact.extClass_naturality hS
    (localSerreExtensionModuleComplex_shortExact f g c hf hg) a

/-- If the local extension coordinate is a unit, the actual middle module has
free coordinates in which the canonical section cuts out exactly the quotient
ideal `(f, g)`.  This is the local scheme-theoretic zero-locus conclusion in
Serre's construction. -/
theorem exists_freeCoordinates_of_exact_of_lifts_of_unit_coordinate
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R)) (e₁ e₂ : E)
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hπ₁ : p e₁ = ⟨f, Ideal.subset_span (by simp)⟩)
    (hπ₂ : p e₂ = ⟨g, Ideal.subset_span (by simp)⟩)
    (u : Rˣ)
    (hrel : (-g) • e₁ + f • e₂ = (u : R) • ι 1)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    ∃ t : E ≃ₗ[R] R × R,
      Ideal.span ({(t (ι 1)).1, (t (ι 1)).2} : Set R) =
        Ideal.span ({f, g} : Set R) := by
  let q := localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g (u : R) p e₁ e₂ hexact hinj hπ₁ hπ₂ hrel hf hg
  let t := q.trans (localSerreExtensionFreeOfUnit f g u)
  refine ⟨t, ?_⟩
  have ht : t (ι 1) = localSerreCanonicalCoordinates f g u := by
    dsimp [t]
    rw [localSerreExtensionPresentationEquiv_of_exact_of_lifts_apply_inclusion]
    rfl
  rw [ht]
  exact ideal_span_localSerreCanonicalCoordinates f g u

/-- At an lci local point, a free exact extension has free coordinates in
which its canonical section cuts out precisely the quotient ideal.  The lifts
and unit extension coordinate are constructed from exactness, surjectivity,
and freeness, so this is the automatic local form of Serre's zero-locus
statement. -/
theorem exists_freeCoordinates_of_exact_of_surjective_of_free_at_lci_point
    [IsLocalRing R]
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R))
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hsurj : Function.Surjective p)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰)
    (hfm : f ∈ IsLocalRing.maximalIdeal R)
    (hgm : g ∈ IsLocalRing.maximalIdeal R)
    [Module.Free R E] :
    ∃ t : E ≃ₗ[R] R × R,
      Ideal.span ({(t (ι 1)).1, (t (ι 1)).2} : Set R) =
        Ideal.span ({f, g} : Set R) := by
  obtain ⟨e₁, he₁⟩ := hsurj ⟨f, Ideal.subset_span (by simp)⟩
  obtain ⟨e₂, he₂⟩ := hsurj ⟨g, Ideal.subset_span (by simp)⟩
  have hzero : p ((-g) • e₁ + f • e₂) = 0 := by
    rw [map_add, map_smul, map_smul, he₁, he₂]
    apply Subtype.ext
    change -g * f + f * g = 0
    ring
  obtain ⟨c, hc⟩ := (hexact _).mp hzero
  have hrel : (-g) • e₁ + f • e₂ = c • ι 1 := by
    rw [← hc]
    simpa using (ι.map_smul c (1 : R))
  let q := localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g c p e₁ e₂ hexact hinj he₁ he₂ hrel hf hg
  letI : Module.Free R (localSerreExtensionPresentation f g c) :=
    Module.Free.of_equiv q
  have hunit : IsUnit c :=
    (localSerreExtensionPresentation_free_iff_isUnit f g c hf hfm hgm).mp inferInstance
  let u := hunit.unit
  have hrelU : (-g) • e₁ + f • e₂ = (u : R) • ι 1 := by
    rw [hunit.unit_spec]
    exact hrel
  exact exists_freeCoordinates_of_exact_of_lifts_of_unit_coordinate
    ι f g p e₁ e₂ hexact hinj he₁ he₂ u hrelU hf hg

/-- Exactness of an extension and surjectivity onto a two-generator lci
ideal construct the two local lifts and their Serre relation automatically.
Thus the actual middle module has a standard local Serre presentation for
some extension coordinate; no separately chosen lifts are needed. -/
theorem exists_localSerreExtensionPresentationEquiv_of_exact_of_surjective
    {E : Type u} [AddCommGroup E] [Module R E]
    (ι : R →ₗ[R] E) (f g : R)
    (p : E →ₗ[R] Ideal.span ({f, g} : Set R))
    (hexact : Function.Exact ι p) (hinj : Function.Injective ι)
    (hsurj : Function.Surjective p)
    (hf : f ∈ R⁰)
    (hg : Ideal.Quotient.mk (Ideal.span {f}) g ∈ (R ⧸ Ideal.span {f})⁰) :
    ∃ c : R, Nonempty (E ≃ₗ[R] localSerreExtensionPresentation f g c) := by
  obtain ⟨e₁, he₁⟩ := hsurj ⟨f, Ideal.subset_span (by simp)⟩
  obtain ⟨e₂, he₂⟩ := hsurj ⟨g, Ideal.subset_span (by simp)⟩
  have hzero : p ((-g) • e₁ + f • e₂) = 0 := by
    rw [map_add, map_smul, map_smul, he₁, he₂]
    apply Subtype.ext
    change -g * f + f * g = 0
    ring
  obtain ⟨c, hc⟩ := (hexact _).mp hzero
  refine ⟨c, ⟨localSerreExtensionPresentationEquiv_of_exact_of_lifts
    ι f g c p e₁ e₂ hexact hinj he₁ he₂ ?_ hf hg⟩⟩
  rw [← hc]
  simpa using (ι.map_smul c (1 : R))

end

end PfaffianDescent
