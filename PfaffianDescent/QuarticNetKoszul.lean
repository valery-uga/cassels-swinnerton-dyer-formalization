import PfaffianDescent.ThreeGeneratorKoszul
import PfaffianDescent.HomogeneousProjection
import PfaffianDescent.LinearFactorPoint

/-!
# The graded ideal calculation for a net of quadrics

The algebraic step in Lemma 5.2 of `2-proofs.tex` only uses that a
homogeneous cubic lies in the ideal of three homogeneous quadrics.  Taking
the degree-three homogeneous component of an arbitrary ideal expression
produces the three linear coefficients required in the paper.
-/

namespace PfaffianDescent
namespace QuarticNet

open MvPolynomial

section
variable {K : Type*} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- A homogeneous cubic in the ideal generated by three homogeneous quadrics
is a linear combination of those quadrics with homogeneous linear
coefficients. -/
theorem cubic_decomposition_of_mem_three_quadrics
    (F Q₁ Q₂ Q₃ : MvPolynomial (Fin 4) K)
    (hF : F.IsHomogeneous 3)
    (hQ₁ : Q₁.IsHomogeneous 2) (hQ₂ : Q₂.IsHomogeneous 2)
    (hQ₃ : Q₃.IsHomogeneous 2)
    (hmem : F ∈ Ideal.span ({Q₁, Q₂, Q₃} : Set (MvPolynomial (Fin 4) K))) :
    ∃ H₁ H₂ H₃ : MvPolynomial (Fin 4) K,
      H₁.IsHomogeneous 1 ∧ H₂.IsHomogeneous 1 ∧ H₃.IsHomogeneous 1 ∧
        F = Q₁ * H₁ + Q₂ * H₂ + Q₃ * H₃ := by
  rw [← threeGeneratorLast_range] at hmem
  obtain ⟨⟨r, s, t⟩, hrst⟩ := hmem
  change Q₁ * r + Q₂ * s + Q₃ * t = F at hrst
  let r' := homogeneousComponent 1 r
  let s' := homogeneousComponent 1 s
  let t' := homogeneousComponent 1 t
  refine ⟨r', s', t', homogeneousComponent_isHomogeneous _ _,
    homogeneousComponent_isHomogeneous _ _, homogeneousComponent_isHomogeneous _ _, ?_⟩
  have hQr : homogeneousComponent 3 (Q₁ * r) = Q₁ * r' := by
    rw [show 3 = 2 + 1 by norm_num]
    exact homogeneousComponent_mul_left (q := r) hQ₁ 1
  have hQs : homogeneousComponent 3 (Q₂ * s) = Q₂ * s' := by
    rw [show 3 = 2 + 1 by norm_num]
    exact homogeneousComponent_mul_left (q := s) hQ₂ 1
  have hQt : homogeneousComponent 3 (Q₃ * t) = Q₃ * t' := by
    rw [show 3 = 2 + 1 by norm_num]
    exact homogeneousComponent_mul_left (q := t) hQ₃ 1
  rw [← hQr, ← hQs, ← hQt, ← map_add, ← map_add, hrst,
    homogeneousComponent_eq_self hF]

/-- A homogeneous quadric in an ideal generated by homogeneous quadrics has
a representation with scalar coefficients. -/
theorem quadric_decomposition_of_mem_quadrics
    {ι : Type*} [Fintype ι] (Q : ι → MvPolynomial σ K)
    (F : MvPolynomial σ K) (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (hF : F.IsHomogeneous 2) (hmem : F ∈ Ideal.span (Set.range Q)) :
    ∃ c : ι → K, F = ∑ i, C (c i) * Q i := by
  obtain ⟨A, hA⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  refine ⟨fun i => coeff 0 (A i), ?_⟩
  have h := congrArg (homogeneousComponent 2) hA
  rw [map_sum] at h
  have hcomponent (i : ι) :
      homogeneousComponent 2 (A i * Q i) = C (coeff 0 (A i)) * Q i := by
    simpa only [zero_add, homogeneousComponent_zero] using
      homogeneousComponent_mul_right (p := A i) (q := Q i) (hQ i) 0
  simp only [hcomponent] at h
  have hF' : homogeneousComponent 2 F = F := homogeneousComponent_eq_self hF
  exact (h.trans hF').symm

/-- Independent homogeneous quadrics which lie in the ideal of equally many
homogeneous quadrics generate that same ideal. -/
theorem quadric_ideal_eq_of_independent
    {ι : Type*} [Fintype ι] (Q G : ι → MvPolynomial σ K)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (hG : ∀ i, (G i).IsHomogeneous 2)
    (hmem : ∀ i, Q i ∈ Ideal.span (Set.range G))
    (hind : LinearIndependent K Q) :
    Ideal.span (Set.range Q) = Ideal.span (Set.range G) := by
  let VQ := Submodule.span K (Set.range Q)
  let VG := Submodule.span K (Set.range G)
  have hle : VQ ≤ VG := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    obtain ⟨c, hc⟩ := quadric_decomposition_of_mem_quadrics G (Q i) hG (hQ i) (hmem i)
    rw [hc]
    apply Submodule.sum_mem
    intro j _
    simpa only [smul_eq_C_mul] using
      Submodule.smul_mem VG (c j) (Submodule.subset_span (Set.mem_range_self j))
  letI : FiniteDimensional K VG :=
    FiniteDimensional.span_of_finite K (Set.finite_range G)
  have hVG : Module.finrank K VG ≤ Fintype.card ι := by
    rw [← Finset.card_univ]
    exact finrank_range_le_card G
  have hspan : VQ = VG := by
    apply Submodule.eq_of_le_of_finrank_le hle
    rw [show Module.finrank K VQ = Fintype.card ι by
      exact finrank_span_eq_card hind]
    exact hVG
  have hsub : VQ ≤ (Ideal.span (Set.range Q)).restrictScalars K := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span (Set.mem_range_self i)
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact hmem i
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply hsub
    rw [hspan]
    exact Submodule.subset_span (Set.mem_range_self i)

/-- Three linear functionals on a four-dimensional coordinate space have a
nonzero common zero. -/
theorem exists_nonzero_common_zero_of_three_linear_maps
    (H : Fin 3 → (Fin 4 → K) →ₗ[K] K) :
    ∃ x : Fin 4 → K, x ≠ 0 ∧ ∀ i, H i x = 0 := by
  let T : (Fin 4 → K) →ₗ[K] (Fin 3 → K) :=
    { toFun := fun x i => H i x
      map_add' := by
        intro x y
        funext i
        exact map_add (H i) x y
      map_smul' := by
        intro a x
        funext i
        exact map_smul (H i) a x }
  have hker : LinearMap.ker T ≠ ⊥ := T.ker_ne_bot_of_finrank_lt (by simp)
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
  refine ⟨x, hx0, ?_⟩
  intro i
  exact congrFun hx i

/-- The linear decomposition from the net-of-quadrics lemma gives a nonzero
affine-cone zero of the cubic. -/
theorem cubic_zero_of_linear_quadric_decomposition
    (F : MvPolynomial (Fin 4) K) (H : Fin 3 → MvPolynomial (Fin 4) K)
    (Q : Fin 3 → MvPolynomial (Fin 4) K)
    (hH : ∀ i, (H i).IsHomogeneous 1)
    (hdecomp : F = ∑ i, Q i * H i) :
    ∃ x : Fin 4 → K, x ≠ 0 ∧ MvPolynomial.eval x F = 0 := by
  choose E hE using fun i => homogeneous_linear_eval_exists (H i) (hH i)
  obtain ⟨x, hx, hEx⟩ := exists_nonzero_common_zero_of_three_linear_maps E
  refine ⟨x, hx, ?_⟩
  rw [hdecomp, MvPolynomial.eval_sum]
  apply Finset.sum_eq_zero
  intro i _
  rw [MvPolynomial.eval_mul, hE i x, hEx i, mul_zero]

/-- The polynomial form of the rational-point criterion in the first
subsection of Section 4.  It packages the graded ideal calculation with the
linear-algebra argument giving a common zero of three linear forms. -/
theorem cubic_has_nonzero_zero_of_mem_three_quadrics
    (F Q₁ Q₂ Q₃ : MvPolynomial (Fin 4) K)
    (hF : F.IsHomogeneous 3)
    (hQ₁ : Q₁.IsHomogeneous 2) (hQ₂ : Q₂.IsHomogeneous 2)
    (hQ₃ : Q₃.IsHomogeneous 2)
    (hmem : F ∈ Ideal.span ({Q₁, Q₂, Q₃} : Set (MvPolynomial (Fin 4) K))) :
    ∃ x : Fin 4 → K, x ≠ 0 ∧ MvPolynomial.eval x F = 0 := by
  obtain ⟨H₁, H₂, H₃, hH₁, hH₂, hH₃, hdecomp⟩ :=
    cubic_decomposition_of_mem_three_quadrics F Q₁ Q₂ Q₃ hF hQ₁ hQ₂ hQ₃ hmem
  let H : Fin 3 → MvPolynomial (Fin 4) K := ![H₁, H₂, H₃]
  let Q : Fin 3 → MvPolynomial (Fin 4) K := ![Q₁, Q₂, Q₃]
  apply cubic_zero_of_linear_quadric_decomposition F H Q
  · intro i
    fin_cases i <;> assumption
  · simpa [H, Q, Fin.sum_univ_three] using hdecomp

open AlgebraicGeometry CategoryTheory
open AllCharacteristics.HomogeneousProjective

/-- Scheme-theoretic form of the rational-point criterion in the first
subsection of Section 4. Once the three quadrics generate the ideal of the
length-eight base locus, the cubic surface has an actual rational section. -/
theorem cubic_section_of_mem_three_quadrics
    (F Q₁ Q₂ Q₃ : MvPolynomial (Fin 4) K)
    (hF : F.IsHomogeneous 3)
    (hQ₁ : Q₁.IsHomogeneous 2) (hQ₂ : Q₂.IsHomogeneous 2)
    (hQ₃ : Q₃.IsHomogeneous 2)
    (hmem : F ∈ Ideal.span ({Q₁, Q₂, Q₃} : Set (MvPolynomial (Fin 4) K))) :
    ∃ s : Spec (.of K) ⟶ hypersurface F hF,
      s ≫ hypersurfaceToBase F hF = 𝟙 _ := by
  obtain ⟨x, hx, hFx⟩ :=
    cubic_has_nonzero_zero_of_mem_three_quadrics F Q₁ Q₂ Q₃ hF hQ₁ hQ₂ hQ₃ hmem
  obtain ⟨s, hs⟩ := hypersurface_point_of_coordinates (RingHom.id K) F hF x hx hFx
  exact ⟨s, by simpa using hs⟩

end
