import PfaffianDescent.VoisinSmoothCubicTaylorChart
import PfaffianDescent.CubicFiniteSubschemeHyperplane

/-!
# Eliminating the normalized coordinate in a smooth cubic chart

The projective chart presentation has relations `p` and `X_j - 1`.
Evaluating `X_j` at one gives a polynomial algebra in the remaining
three variables, where the chart presentation becomes principal.
-/

namespace PfaffianDescent

open AlgebraicGeometry MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- The actual smooth-cubic chart has a surjective three-variable polynomial
presentation whose kernel is generated by the nonzero dehomogenized cubic. -/
theorem smoothCubic_eliminatedChartMap_surjective_and_kernel
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (hp0 : p ≠ 0) (j : Fin 4) :
    let I := equationIdeal p hp
    letI : Algebra K (ChartRing I j) := (chartBaseMap I j).toAlgebra
    let e : MvPolynomial {i : Fin 4 // i ≠ j} K →ₐ[K] ChartRing I j :=
      MvPolynomial.aeval (fun i => chartCoordinate I j i.1)
    Function.Surjective e ∧
      RingHom.ker e.toRingHom =
        Ideal.span ({coordinateOneEvaluation j p} :
          Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) ∧
      coordinateOneEvaluation j p ≠ 0 := by
  let I := equationIdeal p hp
  letI : Algebra K (ChartRing I j) := (chartBaseMap I j).toAlgebra
  let q : MvPolynomial (Fin 4) K →ₐ[K]
      MvPolynomial {i : Fin 4 // i ≠ j} K := coordinateOneEvaluation j
  let f : MvPolynomial (Fin 4) K →ₐ[K] ChartRing I j :=
    MvPolynomial.aeval (chartCoordinate I j)
  let e : MvPolynomial {i : Fin 4 // i ≠ j} K →ₐ[K] ChartRing I j :=
    MvPolynomial.aeval (fun i => chartCoordinate I j i.1)
  have hcomp : e.comp q = f := by
    apply MvPolynomial.algHom_ext
    intro i
    by_cases hi : i = j
    · subst i
      simp [q, e, f, coordinateOneEvaluation, chartCoordinate_self]
    · simp [q, e, f, coordinateOneEvaluation, hi]
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨x, hx⟩ := eval₂_chartCoordinate_surjective I j y
    exact ⟨x, by
      simpa only [f, MvPolynomial.aeval_eq_eval₂Hom,
        RingHom.algebraMap_toAlgebra] using hx⟩
  have he : Function.Surjective e := by
    intro y
    obtain ⟨x, hx⟩ := hf y
    have hcx : e (q x) = f x := by
      simpa only [AlgHom.comp_apply] using DFunLike.congr_fun hcomp x
    exact ⟨q x, hcx.trans hx⟩
  have hq : Function.Surjective q := by
    intro y
    obtain ⟨z, rfl⟩ :=
      (coordinateOneQuotientEquiv (R := K) j).surjective y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨x, by exact (coordinateOneQuotientEquiv_mk j x).symm⟩
  have hcomap : (RingHom.ker e.toRingHom).comap q.toRingHom =
      RingHom.ker f.toRingHom := by
    ext x
    change e (q x) = 0 ↔ f x = 0
    have hx := DFunLike.congr_fun hcomp x
    rw [AlgHom.comp_apply] at hx
    rw [hx]
  have hkerf : RingHom.ker f.toRingHom =
      Ideal.span ({p, X j - 1} : Set (MvPolynomial (Fin 4) K)) :=
    smoothCubic_chartAlgebraPresentation_ker_eq_span_pair p hp j
  have ht : q (X j - 1) = 0 := by
    simp [q, coordinateOneEvaluation]
  have hker : RingHom.ker e.toRingHom =
      Ideal.span ({q p} : Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) := by
    calc
      RingHom.ker e.toRingHom =
          ((RingHom.ker e.toRingHom).comap q.toRingHom).map q.toRingHom :=
        (Ideal.map_comap_of_surjective q.toRingHom hq _).symm
      _ = (RingHom.ker f.toRingHom).map q.toRingHom := by rw [hcomap]
      _ = (Ideal.span ({p, X j - 1} : Set (MvPolynomial (Fin 4) K))).map
          q.toRingHom := by rw [hkerf]
      _ = Ideal.span ({q p} :
          Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) := by
        rw [Ideal.map_span]
        simp only [Set.image_insert_eq, Set.image_singleton]
        have ht' : q.toRingHom (X j - 1) = 0 := ht
        rw [ht']
        exact Ideal.span_pair_zero _
  exact ⟨he, hker, coordinateOneEvaluation_ne_zero_of_homogeneous hp hp0 j⟩

end PfaffianDescent
