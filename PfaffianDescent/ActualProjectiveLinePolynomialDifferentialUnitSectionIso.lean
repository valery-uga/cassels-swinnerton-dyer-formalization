import PfaffianDescent.ActualProjectiveLineOriginalCoordinateDifferentialCoefficient
import PfaffianDescent.SchemeModuleNonzeroTopSectionMono

/-! SOURCE ONLY / UNVERIFIED. The unit morphism defined by the original
coordinate differential is the inverse of its actual polynomial-chart frame.
This identifies a whole local morphism, before any global Omega Iso descent. -/
noncomputable section
namespace PfaffianDescent
open AlgebraicGeometry CategoryTheory Opposite
open AllCharacteristics.HomogeneousProjective
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- Morphisms from the native unit are determined by the value of 1 on top. -/
private theorem unitHom_eq_of_originalTopValue001
    {Y : Scheme.{u}} (M : Y.Modules)
    (f g : SheafOfModules.unit Y.ringCatSheaf ⟶ M)
    (h : f.val.app (op ⊤) (1 : Γ(Y, ⊤)) =
      g.val.app (op ⊤) (1 : Γ(Y, ⊤))) : f = g := by
  apply M.unitHomEquiv.injective
  apply (schemeModuleSectionsEquivTop M).injective
  exact h

/-- A computed coefficient of 1 identifies the entire section morphism
with the inverse of the SAME frame, on every legitimate smaller open. -/
private theorem topSectionHom_eq_originalFrameInverse001
    {Y : Scheme.{u}} (M : Y.Modules)
    (e : M ≅ SheafOfModules.unit Y.ringCatSheaf)
    (x : M.val.obj (op ⊤))
    (hx : e.hom.val.app (op ⊤) x = (1 : Γ(Y, ⊤))) :
    schemeModuleTopSectionHom M x = e.inv := by
  apply unitHom_eq_of_originalTopValue001 M
  rw [schemeModuleTopSectionHom_value]
  have hcancel (z : M.val.obj (op ⊤)) :
      e.inv.val.app (op ⊤) (e.hom.val.app (op ⊤) z) = z :=
    ConcreteCategory.congr_hom
      (congrArg (fun f : M ⟶ M => f.val.app (op ⊤)) e.hom_inv_id) z
  apply Function.LeftInverse.injective hcancel
  rw [hx]
  have h := ConcreteCategory.congr_hom
    (congrArg (fun f : SheafOfModules.unit Y.ringCatSheaf ⟶
      SheafOfModules.unit Y.ringCatSheaf => f.val.app (op ⊤)) e.inv_hom_id)
    (1 : Γ(Y, ⊤))
  exact h.symm

attribute [local instance] MvPolynomial.gradedAlgebra
variable (K : Type u) [CommRing K]
local notation "Iline" => (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule Bool K))
local notation "Omega" => schemeRelativeDifferentials (projectiveLineProjToBase K)

/-- The WHOLE native unit morphism generated by the ORIGINAL coordinate
differential on the SAME polynomial chart. Its input is exactly the original
section, transported only by the chart's already proved image-top equality. -/
def actualProjectiveLinePolynomialCoordinateDifferentialUnitHom (b : Bool) :
    SheafOfModules.unit
        (Spec (.of (MvPolynomial {i : Bool // i ≠ b} K))).ringCatSheaf ⟶
      (Scheme.Modules.restrictFunctor
        (actualProjectiveLinePolynomialChartToLine K b)).obj Omega :=
  schemeModuleTopSectionHom
    ((Scheme.Modules.restrictFunctor
      (actualProjectiveLinePolynomialChartToLine K b)).obj Omega)
    ((Omega).val.map
      (eqToHom (actualProjectiveLinePolynomialChartToLine_image_top K b)).op
      (actualRelativeDifferentialSection (projectiveLineProjToBase K)
        (Proj.basicOpen (grading Iline) (coordinate Iline b))
        ((Proj.awayToSection (grading Iline) (coordinate Iline b)).hom
          (chartCoordinate Iline b (!b)))))

/-- The original coordinate differential defines the INVERSE of the actual
restriction frame. No local invertibility or normalization hypothesis is supplied. -/
theorem actualProjectiveLinePolynomialCoordinateDifferentialUnitHom_eq_frame_inv
    (b : Bool) :
    actualProjectiveLinePolynomialCoordinateDifferentialUnitHom K b =
      (actualProjectiveLinePolynomialDifferentialRestrictionFrameIso K b).inv := by
  have coefficient := actualProjectiveLinePolynomialDifferentialRestrictionFrameIso_coordinate K b
  exact topSectionHom_eq_originalFrameInverse001
    ((Scheme.Modules.restrictFunctor
      (actualProjectiveLinePolynomialChartToLine K b)).obj Omega)
    (actualProjectiveLinePolynomialDifferentialRestrictionFrameIso K b)
    ((Omega).val.map
      (eqToHom (actualProjectiveLinePolynomialChartToLine_image_top K b)).op
      (actualRelativeDifferentialSection (projectiveLineProjToBase K)
        (Proj.basicOpen (grading Iline) (coordinate Iline b))
        ((Proj.awayToSection (grading Iline) (coordinate Iline b)).hom
          (chartCoordinate Iline b (!b))))) coefficient

/-- Invertibility of the SAME original differential-generated local map,
over arbitrary CommRing K, including the zero ring and characteristic two. -/
theorem actualProjectiveLinePolynomialCoordinateDifferentialUnitHom_isIso
    (b : Bool) :
    IsIso (actualProjectiveLinePolynomialCoordinateDifferentialUnitHom K b) := by
  rw [actualProjectiveLinePolynomialCoordinateDifferentialUnitHom_eq_frame_inv]
  infer_instance

end PfaffianDescent
end
