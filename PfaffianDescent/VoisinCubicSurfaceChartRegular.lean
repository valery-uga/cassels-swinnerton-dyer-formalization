import PfaffianDescent.CubicFiniteSubschemeHyperplane
import PfaffianDescent.ProjectiveIdealCancellation

/-!
# Regular equations on the standard charts of a smooth cubic surface

The homogeneous coordinate ring of a smooth cubic surface is a domain. A
coordinate variable has degree one, so it remains nonzero modulo the cubic
equation. Consequently a section regular in the homogeneous quotient stays
regular after localization at any standard projective coordinate.
-/

namespace PfaffianDescent

open AlgebraicGeometry MvPolynomial
open AllCharacteristics.HomogeneousProjective
open HomogeneousLocalization

universe u

variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- A coordinate variable cannot belong to the ideal generated by a nonzero
homogeneous cubic. -/
theorem coordinate_not_mem_cubic_ideal
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3) (ha0 : a ≠ 0)
    (j : Fin 4) :
    X j ∉ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)) := by
  intro hj
  have hdiv : a ∣ X j := Ideal.mem_span_singleton.mp hj
  have hle := MvPolynomial.totalDegree_le_of_dvd_of_isDomain hdiv
    (MvPolynomial.X_ne_zero j)
  have hadeg : a.totalDegree = 3 := ha.totalDegree ha0
  simp only [MvPolynomial.totalDegree_X, hadeg] at hle
  omega

/-- On a smooth cubic, every standard coordinate denominator is regular in
the homogeneous coordinate quotient. -/
theorem coordinate_regular_mod_smooth_cubic
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3) (ha0 : a ≠ 0)
    [Smooth (hypersurfaceToBase a ha)] (j : Fin 4) :
    ∀ x : MvPolynomial (Fin 4) K,
      X j * x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)) := by
  have hprime := principalIdeal_prime_of_smooth_homogeneous_cubic a ha ha0
  intro x hx
  rcases hprime.mem_or_mem hx with hj | hx
  · exact (coordinate_not_mem_cubic_ideal a ha ha0 j hj).elim
  · exact hx

/-- A regular cubic section stays regular in each localized standard chart
of a smooth cubic surface. -/
theorem regular_section_on_smooth_cubic_standard_chart
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3) (ha0 : a ≠ 0)
    [Smooth (hypersurfaceToBase a ha)]
    (p : MvPolynomial (Fin 4) K)
    (hp : ∀ x : MvPolynomial (Fin 4) K,
      p * x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)))
    (j : Fin 4) :
    IsRegular (algebraMap
      (MvPolynomial (Fin 4) K ⧸ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)))
      (Localization (Submonoid.powers
        (Ideal.Quotient.mk
          (Ideal.span ({a} : Set (MvPolynomial (Fin 4) K))) (X j))))
        (Ideal.Quotient.mk
          (Ideal.span ({a} : Set (MvPolynomial (Fin 4) K))) p)) := by
  exact isRegular_localized_quotient_of_regular_mod_ideal
    _ (X j) p (coordinate_regular_mod_smooth_cubic a ha ha0 j) hp

/-- A homogeneous cubic section that is regular modulo the surface equation
defines a regular element in the actual degree-zero affine chart ring. -/
theorem regular_section_on_smooth_cubic_chartRing
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3) (ha0 : a ≠ 0)
    [Smooth (hypersurfaceToBase a ha)]
    (p : MvPolynomial (Fin 4) K) (hphom : p.IsHomogeneous 3)
    (hp : ∀ x : MvPolynomial (Fin 4) K,
      p * x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)))
    (j : Fin 4) :
    IsRegular (Away.mk (grading (equationIdeal a ha))
      (coordinate_mem (equationIdeal a ha) j) 3
      (Ideal.Quotient.mk (equationIdeal a ha).toIdeal p)
      (by
        simpa using
          (show Ideal.Quotient.mk (equationIdeal a ha).toIdeal p ∈
            grading (equationIdeal a ha) 3 from ⟨p, hphom, rfl⟩))) := by
  let I := equationIdeal a ha
  let z := coordinate I j
  let q := Ideal.Quotient.mk I.toIdeal p
  have hz : IsRegular z := by
    apply isRegular_iff_mem_nonZeroDivisors.mpr
    change Ideal.Quotient.mk (Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)))
      (X j) ∈ nonZeroDivisors _
    exact quotient_mk_mem_nonZeroDivisors_of_regular_mod_ideal _ _
      (coordinate_regular_mod_smooth_cubic a ha ha0 j)
  have hq : IsRegular q := by
    apply isRegular_iff_mem_nonZeroDivisors.mpr
    change Ideal.Quotient.mk (Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)))
      p ∈ nonZeroDivisors _
    exact quotient_mk_mem_nonZeroDivisors_of_regular_mod_ideal _ _ hp
  have hM : ∀ m ∈ Submonoid.powers z, IsRegular m := by
    intro m hm
    obtain ⟨n, rfl⟩ := hm
    exact hz.pow n
  have hloc : IsRegular
      (Localization.mk q ⟨z ^ 3, by use 3⟩ : Localization (.powers z)) := by
    rw [Localization.mk_eq_mk'_apply]
    exact (IsLocalization.isRegular_mk' (S := Localization (.powers z)) hM).mpr hq
  obtain ⟨hl, hr⟩ := (isRegular_iff_eq_zero_of_mul).mp hloc
  apply (isRegular_iff_eq_zero_of_mul).mpr
  constructor
  · intro x hx
    apply HomogeneousLocalization.val_injective (Submonoid.powers z)
    have hh : (Localization.mk q ⟨z ^ 3, by use 3⟩ : Localization (.powers z)) *
        x.val = 0 := by
      simpa only [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_zero,
        Away.val_mk] using congrArg HomogeneousLocalization.val hx
    simpa only [HomogeneousLocalization.val_zero] using hl x.val hh
  · intro x hx
    apply HomogeneousLocalization.val_injective (Submonoid.powers z)
    have hh : x.val *
        (Localization.mk q ⟨z ^ 3, by use 3⟩ : Localization (.powers z)) = 0 := by
      simpa only [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_zero,
        Away.val_mk] using congrArg HomogeneousLocalization.val hx
    simpa only [HomogeneousLocalization.val_zero] using hr x.val hh

/-- The normalized degree-three equation on a standard affine chart of a
cubic surface. -/
noncomputable def normalizedCubicSection
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3)
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (j : Fin 4) :
    ChartRing (equationIdeal a ha) j :=
  Away.mk (grading (equationIdeal a ha))
    (coordinate_mem (equationIdeal a ha) j) 3
    (Ideal.Quotient.mk (equationIdeal a ha).toIdeal p)
    (by simpa using
      (show Ideal.Quotient.mk (equationIdeal a ha).toIdeal p ∈
        grading (equationIdeal a ha) 3 from ⟨p, hp, rfl⟩))

theorem normalizedCubicSection_isRegular
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3) (ha0 : a ≠ 0)
    [Smooth (hypersurfaceToBase a ha)]
    (p : MvPolynomial (Fin 4) K) (hphom : p.IsHomogeneous 3)
    (hp : ∀ x : MvPolynomial (Fin 4) K,
      p * x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({a} : Set (MvPolynomial (Fin 4) K)))
    (j : Fin 4) :
    IsRegular (normalizedCubicSection a ha p hphom j) := by
  exact regular_section_on_smooth_cubic_chartRing a ha ha0 p hphom hp j

end PfaffianDescent
