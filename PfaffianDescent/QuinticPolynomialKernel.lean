import PfaffianDescent.QuinticHomogeneousKernel
import PfaffianDescent.QuinticMatrixHomogeneity
import PfaffianDescent.FrameResolution

namespace PfaffianDescent
open MvPolynomial
open scoped BigOperators
section
variable {K : Type*} [Field K]

/-- The full polynomial kernel of the explicit quintic matrix is generated by
its quadratic Pfaffian vector. This holds for every monic quintic, with no
separability or splitting-field hypothesis. -/
theorem quinticPolynomialMatrix_kernel (a : Vec K 5)
    (v : Fin 5 → MvPolynomial (Fin 4) K) (hv : (quinticPolynomialMatrix a).mulVec v = 0) :
    ∃ r : MvPolynomial (Fin 4) K, v = r • quinticRelations a := by
  classical
  have hd (d : ℕ) : ∃ r : MvPolynomial (Fin 4) K,
      (fun i => homogeneousComponent d (v i)) = r • quinticRelations a := by
    apply quintic_homogeneous_kernel a d
    · exact fun i => homogeneousComponent_isHomogeneous d (v i)
    · funext i
      rw [quinticPolynomialMatrix_component, hv]
      exact map_zero _
  choose r hr using hd
  let N := Finset.univ.sup (fun i : Fin 5 => (v i).totalDegree + 1)
  have hsum : (∑ d ∈ Finset.range N, fun i => homogeneousComponent d (v i)) = v := by
    funext i
    rw [Finset.sum_apply]
    apply homogeneousComponent_sum_of_bound
    exact Finset.le_sup (f := fun j : Fin 5 => (v j).totalDegree + 1) (Finset.mem_univ i)
  refine ⟨∑ d ∈ Finset.range N, r d, ?_⟩
  rw [← hsum]
  simp only [hr, Finset.sum_smul]

end
end PfaffianDescent
