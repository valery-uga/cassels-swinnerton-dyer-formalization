/-- The final two terms of the actual field-point Koszul resolution are
exact once the equations have no other common zero on the chosen open. -/
theorem fieldPointSectionRepresenterKoszul_augmented_exact
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f))
    (hspan : ∀ (y : X) (hy : y ∈ U), y ≠ i default →
      Ideal.span
        ({X.presheaf.germ U y hy q, X.presheaf.germ U y hy f} :
          Set (X.presheaf.stalk y)) = ⊤) :
    (sectionRepresenterKoszulAugmentedShortComplex X.ringCatSheaf U q f
      (closedImmersionIdealTwistSequence i T).X₃
      (fieldPointSectionRepresenterKoszulSection
        i T V hV eV U hx q f qM)
      (sectionRepresenterPointKoszulTransportedSection_q_smul
        X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
        (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
          i T V hV eV) qM)
      (sectionRepresenterPointKoszulTransportedSection_f_smul
        X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
        (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
          i T V hV eV) qM)).Exact := by
  exact sectionRepresenterPointKoszulTransported_augmented_exact
    X U (i default) hx (fieldPoint_image_isClosed i) q f
    (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM hspan

