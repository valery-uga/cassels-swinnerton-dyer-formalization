/-!
# Section-representer Koszul resolutions at closed field points

This file specializes the abstract closed-point skyscraper resolution to the
actual pushed-forward, line-bundle-twisted structure sheaf of a closed field
point.  The target is identified with the local complete-intersection
quotient by the already established point-skyscraper comparison.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian Opposite AlgebraicGeometry
open scoped nonZeroDivisors

namespace PfaffianDescent

universe u

attribute [local instance] CategoryTheory.Abelian.hasFiniteBiproducts

/-- A pointwise scalar coordinate detects that a coefficient section is not
in the two-generator Koszul boundary: every boundary coordinate lies in the
ideal generated by the two germs. -/
theorem sectionRepresenterKoszul_not_boundary_of_coordinate
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    (q f : Γ(X, U)) (Y : X.Modules) (y : Γ(Y, U))
    (rho : Γ(Y, U) →+ X.presheaf.stalk x)
    (hrho : ∀ (a : Γ(X, U)) (z : Γ(Y, U)),
      rho (a • z) = X.presheaf.germ U x hx a * rho z)
    (hy : rho y ∉ Ideal.span
      ({X.presheaf.germ U x hx q, X.presheaf.germ U x hx f} :
        Set (X.presheaf.stalk x))) :
    ¬ ∃ a b : Γ(Y, U), (-f) • a + q • b = y := by
  rintro ⟨a, b, hab⟩
  apply hy
  rw [← hab, map_add, hrho, hrho, map_neg]
  apply Ideal.add_mem
  · apply Ideal.mul_mem_right
    exact (Ideal.span
      ({X.presheaf.germ U x hx q, X.presheaf.germ U x hx f} :
        Set (X.presheaf.stalk x))).neg_mem
      (Ideal.subset_span (by simp))
  · apply Ideal.mul_mem_right
    exact Ideal.subset_span (by simp)

/-- The additive coordinate on sections obtained by taking a germ and then
trivializing the target stalk as the local ring. -/
noncomputable def schemeModuleSectionStalkCoordinateAddHom
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    (Y : X.Modules)
    (qY : (schemeModuleStalkModuleFunctor X x).obj Y ≅
      ModuleCat.of (X.presheaf.stalk x) (X.presheaf.stalk x)) :
    Γ(Y, U) →+ X.presheaf.stalk x := by
  letI : Module (X.presheaf.stalk x) (Y.presheaf.stalk x) :=
    schemeModuleStalkModule Y x
  let germ' : Γ(Y, U) →+
      (schemeModuleStalkModuleFunctor X x).obj Y :=
    { toFun := fun z ↦ Y.presheaf.germ U x hx z
      map_zero' := (Y.presheaf.germ U x hx).hom.map_zero
      map_add' := (Y.presheaf.germ U x hx).hom.map_add }
  exact qY.hom.hom.toAddMonoidHom.comp germ'

set_option backward.isDefEq.respectTransparency false in
/-- In the canonical structure-sheaf stalk coordinate, a section is sent to
its ordinary ring germ. -/
theorem schemeModuleSectionStalkCoordinateAddHom_unit
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    (r : Γ(X, U)) :
    schemeModuleSectionStalkCoordinateAddHom U x hx
      (SheafOfModules.unit X.ringCatSheaf) (schemeModuleUnitStalkIso X x) r =
      X.presheaf.germ U x hx r := by
  change (presheafOfModules_unitStalkAddEquiv X.presheaf x).symm
      ((show X.Modules from SheafOfModules.unit X.ringCatSheaf).presheaf.germ U x hx r) = _
  erw [← presheafOfModules_unitStalkAddEquiv_germ X.presheaf x U hx r]
  exact (presheafOfModules_unitStalkAddEquiv X.presheaf x).symm_apply_apply _

set_option backward.isDefEq.respectTransparency false in
/-- The section-to-stalk coordinate is semilinear with respect to taking the
germ of the scalar section. -/
theorem schemeModuleSectionStalkCoordinateAddHom_smul
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    (Y : X.Modules)
    (qY : (schemeModuleStalkModuleFunctor X x).obj Y ≅
      ModuleCat.of (X.presheaf.stalk x) (X.presheaf.stalk x))
    (a : Γ(X, U)) (z : Γ(Y, U)) :
    schemeModuleSectionStalkCoordinateAddHom U x hx Y qY (a • z) =
      X.presheaf.germ U x hx a *
        schemeModuleSectionStalkCoordinateAddHom U x hx Y qY z := by
  letI : Module (X.presheaf.stalk x) (Y.presheaf.stalk x) :=
    schemeModuleStalkModule Y x
  dsimp only [schemeModuleStalkModuleFunctor] at qY
  dsimp only [schemeModuleSectionStalkCoordinateAddHom]
  have hg := PresheafOfModules.germ_smul Y.val x U hx a z
  calc
    qY.hom (Y.presheaf.germ U x hx (a • z)) =
        qY.hom (X.presheaf.germ U x hx a •
          Y.presheaf.germ U x hx z) := congrArg qY.hom hg
    _ = X.presheaf.germ U x hx a *
        qY.hom (Y.presheaf.germ U x hx z) := qY.hom.hom.map_smul _ _

/-- A section with stalk coordinate one lies outside the ideal generated by
two functions vanishing at the point. -/
theorem schemeModuleSectionStalkCoordinateAddHom_not_mem_span_of_eq_one
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    (Y : X.Modules)
    (qY : (schemeModuleStalkModuleFunctor X x).obj Y ≅
      ModuleCat.of (X.presheaf.stalk x) (X.presheaf.stalk x))
    (q f : Γ(X, U)) (y : Γ(Y, U))
    (hq : X.presheaf.germ U x hx q ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hf : X.presheaf.germ U x hx f ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hy : schemeModuleSectionStalkCoordinateAddHom U x hx Y qY y = 1) :
    schemeModuleSectionStalkCoordinateAddHom U x hx Y qY y ∉
      Ideal.span
        ({X.presheaf.germ U x hx q, X.presheaf.germ U x hx f} :
          Set (X.presheaf.stalk x)) := by
  rw [hy]
  intro hone
  have hle : Ideal.span
      ({X.presheaf.germ U x hx q, X.presheaf.germ U x hx f} :
        Set (X.presheaf.stalk x)) ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
    apply Ideal.span_le.mpr
    intro a ha
    rcases ha with (rfl | rfl)
    · exact hq
    · exact hf
  exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) (hle hone)

/-- The actual point-supported quotient, identified with the skyscraper of
its two-generator local quotient. -/
noncomputable def fieldPointSectionRepresenterKoszulTargetIso
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f)) :
    (closedImmersionIdealTwistSequence i T).X₃ ≅
      sectionRepresenterPointKoszulSkyscraper
        X U (i default) hx q f :=
  sectionRepresenterPointKoszulTargetIso X U (i default) hx q f
    (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM

/-- The residue-class generator transported into the actual twisted
pushforward point sheaf. -/
noncomputable def fieldPointSectionRepresenterKoszulSection
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f)) :
    (closedImmersionIdealTwistSequence i T).X₃.val.obj (op U) :=
  sectionRepresenterPointKoszulTransportedSection
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM

