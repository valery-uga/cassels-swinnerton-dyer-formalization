/-- The independent global degree-two class supplied by the actual
field-point Koszul resolution.  Its construction uses only the checked
stalkwise resolution, not a global-to-stalk Ext surjectivity premise. -/
noncomputable def fieldPointSectionRepresenterKoszulDegreeTwoClass
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f))
    (hspan : ∀ (y : X) (hy : y ∈ U), y ≠ i default →
      Ideal.span
        ({X.presheaf.germ U y hy q, X.presheaf.germ U y hy f} :
          Set (X.presheaf.stalk y)) = ⊤)
    (hqreg : X.presheaf.germ U (i default) hx q ∈
      (X.presheaf.stalk (i default))⁰)
    (hfreg : Ideal.Quotient.mk
        (Ideal.span {X.presheaf.germ U (i default) hx q})
        (X.presheaf.germ U (i default) hx f) ∈
      ((X.presheaf.stalk (i default)) ⧸
        Ideal.span {X.presheaf.germ U (i default) hx q})⁰)
    [hExt : HasExt.{u} X.Modules] (Y : X.Modules) (y : Y.val.obj (op U)) :
    Ext (closedImmersionIdealTwistSequence i T).X₃ Y 2 := by
  let m := fieldPointSectionRepresenterKoszulSection
    i T V hV eV U hx q f qM
  let hmq := sectionRepresenterPointKoszulTransportedSection_q_smul
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM
  let hmf := sectionRepresenterPointKoszulTransportedSection_f_smul
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM
  let hexact₀ := fieldPointSectionRepresenterKoszul_augmented_exact
    i T V hV eV U hx q f qM hspan
  let hexact₁ := sectionRepresenterKoszul_exact_of_regularPairAtPoint
    X U q f (i default) hx hqreg hfreg hspan
  let hmono := sectionRepresenterKoszulFirst_mono_of_regularPairAtPoint
    X U q f (i default) hx hqreg hfreg hspan
  letI : Mono (sectionRepresenterKoszulFirst X.ringCatSheaf U q f) := hmono
  let hexact₂ := sectionRepresenterKoszul_zero_left_exact
    X.ringCatSheaf U q f
  let hepi := fieldPointSectionRepresenterKoszul_augmentation_epi
    i T V hV eV U hx q f qM
  letI : Epi (sectionRepresenterKoszulAugmentation X.ringCatSheaf U
      (closedImmersionIdealTwistSequence i T).X₃ m) := hepi
  exact @sectionRepresenterKoszulDegreeTwoClass X.Opens _ _
    X.ringCatSheaf _ _ hExt U q f
    (Commute.all q f) (closedImmersionIdealTwistSequence i T).X₃ Y
    m hmq hmf hexact₀ hexact₁ hexact₂ hepi y

set_option linter.style.haveILetI false in
/-- A coefficient section whose pointwise coordinate is outside the ideal of
the two local equations gives a nonzero global field-point class.  This is
the noncircular normalized-class existence criterion: it uses the explicit
global Koszul resolution rather than surjectivity of localization on Ext. -/
theorem fieldPointSectionRepresenterKoszulDegreeTwoClass_ne_zero
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f))
    (hspan : ∀ (z : X) (hz : z ∈ U), z ≠ i default →
      Ideal.span
        ({X.presheaf.germ U z hz q, X.presheaf.germ U z hz f} :
          Set (X.presheaf.stalk z)) = ⊤)
    (hqreg : X.presheaf.germ U (i default) hx q ∈
      (X.presheaf.stalk (i default))⁰)
    (hfreg : Ideal.Quotient.mk
        (Ideal.span {X.presheaf.germ U (i default) hx q})
        (X.presheaf.germ U (i default) hx f) ∈
      ((X.presheaf.stalk (i default)) ⧸
        Ideal.span {X.presheaf.germ U (i default) hx q})⁰)
    [hExt : HasExt.{u} X.Modules] (Y : X.Modules)
    [hacyclic : Subsingleton
      (@Ext _ _ _ hExt (sectionRepresenter X.ringCatSheaf U) Y 1)]
    (y : Γ(Y, U))
    (qY : (schemeModuleStalkModuleFunctor X (i default)).obj Y ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (X.presheaf.stalk (i default)))
    (hy : schemeModuleSectionStalkCoordinateAddHom
        U (i default) hx Y qY y ∉ Ideal.span
      ({X.presheaf.germ U (i default) hx q,
        X.presheaf.germ U (i default) hx f} :
        Set (X.presheaf.stalk (i default)))) :
    fieldPointSectionRepresenterKoszulDegreeTwoClass
      i T V hV eV U hx q f qM hspan hqreg hfreg Y y ≠ 0 := by
  let m := fieldPointSectionRepresenterKoszulSection
    i T V hV eV U hx q f qM
  let hmq := sectionRepresenterPointKoszulTransportedSection_q_smul
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM
  let hmf := sectionRepresenterPointKoszulTransportedSection_f_smul
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM
  let hexact₀ := fieldPointSectionRepresenterKoszul_augmented_exact
    i T V hV eV U hx q f qM hspan
  let hexact₁ := sectionRepresenterKoszul_exact_of_regularPairAtPoint
    X U q f (i default) hx hqreg hfreg hspan
  let hmono := sectionRepresenterKoszulFirst_mono_of_regularPairAtPoint
    X U q f (i default) hx hqreg hfreg hspan
  letI : Mono (sectionRepresenterKoszulFirst X.ringCatSheaf U q f) := hmono
  let hexact₂ := sectionRepresenterKoszul_zero_left_exact
    X.ringCatSheaf U q f
  let hepi := fieldPointSectionRepresenterKoszul_augmentation_epi
    i T V hV eV U hx q f qM
  letI : Epi (sectionRepresenterKoszulAugmentation X.ringCatSheaf U
      (closedImmersionIdealTwistSequence i T).X₃ m) := hepi
  apply @sectionRepresenterKoszulDegreeTwoClass_ne_zero X.Opens _ _
    X.ringCatSheaf _ _ hExt U q f (Commute.all q f)
    (closedImmersionIdealTwistSequence i T).X₃ Y m hmq hmf
    hexact₀ hexact₁ hexact₂ hepi hacyclic y
  exact sectionRepresenterKoszul_not_boundary_of_coordinate
    U (i default) hx q f Y y
    (schemeModuleSectionStalkCoordinateAddHom U (i default) hx Y qY)
    (schemeModuleSectionStalkCoordinateAddHom_smul
      U (i default) hx Y qY) hy

set_option linter.style.haveILetI false in
/-- On a noetherian affine open, a target trivialization supplies the Ext¹
vanishing required to detect the explicit global point class. -/
theorem fieldPointSectionRepresenterKoszulDegreeTwoClass_ne_zero_of_affineOpen
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hU : IsAffineOpen U)
    [IsNoetherianRing Γ((U : Scheme), ⊤)] (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f))
    (hspan : ∀ (z : X) (hz : z ∈ U), z ≠ i default →
      Ideal.span
        ({X.presheaf.germ U z hz q, X.presheaf.germ U z hz f} :
          Set (X.presheaf.stalk z)) = ⊤)
    (hqreg : X.presheaf.germ U (i default) hx q ∈
      (X.presheaf.stalk (i default))⁰)
    (hfreg : Ideal.Quotient.mk
        (Ideal.span {X.presheaf.germ U (i default) hx q})
        (X.presheaf.germ U (i default) hx f) ∈
      ((X.presheaf.stalk (i default)) ⧸
        Ideal.span {X.presheaf.germ U (i default) hx q})⁰)
    [hExt : HasExt.{u} X.Modules] (Y : X.Modules)
    (eY : (Scheme.Modules.restrictFunctor U.ι).obj Y ≅
      SheafOfModules.unit (U : Scheme).ringCatSheaf)
