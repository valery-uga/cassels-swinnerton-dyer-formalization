/-- The kernel of the actual affine point-class construction is precisely
the explicit two-equation boundary, with its Ext¹ vanishing proved. -/
theorem fieldPointSectionRepresenterKoszulDegreeTwoClass_eq_zero_iff_of_affineOpen
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hU : IsAffineOpen U)
    [IsNoetherianRing Γ((U : Scheme), ⊤)] (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f))
    (hspan : ∀ (z : X) (hz : z ∈ U), z ≠ i default →
      Ideal.span
        ({X.presheaf.germ U z hz q, X.presheaf.germ U z hz f} :
          Set (X.presheaf.stalk z)) = ⊤)
    (hqreg : X.presheaf.germ U (i default) hx q ∈
      (X.presheaf.stalk (i default))⁰)
    (hfreg : Ideal.Quotient.mk
        (Ideal.span {X.presheaf.germ U (i default) hx q})
        (X.presheaf.germ U (i default) hx f) ∈
      ((X.presheaf.stalk (i default)) ⧸
        Ideal.span {X.presheaf.germ U (i default) hx q})⁰)
    [hExt : HasExt.{u} X.Modules] (Y : X.Modules)
    (eY : (Scheme.Modules.restrictFunctor U.ι).obj Y ≅
      SheafOfModules.unit (U : Scheme).ringCatSheaf)
    (y : Γ(Y, U)) :
    fieldPointSectionRepresenterKoszulDegreeTwoClass
        i T V hV eV U hx q f qM hspan hqreg hfreg Y y = 0 ↔
      ∃ a b : Γ(Y, U), (-f) • a + q • b = y := by
  let hacyclic :=
    (sectionRepresenter_ext_one_and_two_subsingleton_of_affineOpen_of_restrictIsoUnit
      U hU Y eY).1
  let m := fieldPointSectionRepresenterKoszulSection
    i T V hV eV U hx q f qM
  let hmq := sectionRepresenterPointKoszulTransportedSection_q_smul
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM
  let hmf := sectionRepresenterPointKoszulTransportedSection_f_smul
    X U (i default) hx q f (closedImmersionIdealTwistSequence i T).X₃
    (fieldPointPushforwardTwist_skyscraperIso_of_coversTop_iso_unit
      i T V hV eV) qM
  let hexact₀ := fieldPointSectionRepresenterKoszul_augmented_exact
    i T V hV eV U hx q f qM hspan
  let hexact₁ := sectionRepresenterKoszul_exact_of_regularPairAtPoint
    X U q f (i default) hx hqreg hfreg hspan
  let hmono := sectionRepresenterKoszulFirst_mono_of_regularPairAtPoint
    X U q f (i default) hx hqreg hfreg hspan
  letI : Mono (sectionRepresenterKoszulFirst X.ringCatSheaf U q f) := hmono
  let hexact₂ := sectionRepresenterKoszul_zero_left_exact
    X.ringCatSheaf U q f
  let hepi := fieldPointSectionRepresenterKoszul_augmentation_epi
    i T V hV eV U hx q f qM
  letI : Epi (sectionRepresenterKoszulAugmentation X.ringCatSheaf U
      (closedImmersionIdealTwistSequence i T).X₃ m) := hepi
  exact @sectionRepresenterKoszulDegreeTwoClass_eq_zero_iff X.Opens _ _
    X.ringCatSheaf _ _ hExt U q f
    (Commute.all q f) (closedImmersionIdealTwistSequence i T).X₃ Y
    m hmq hmf hexact₀ hexact₁ hexact₂ hepi hacyclic y

