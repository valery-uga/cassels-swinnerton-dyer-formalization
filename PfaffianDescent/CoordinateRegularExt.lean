import Mathlib.RingTheory.Depth.Rees
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Algebra.Category.ModuleCat.Biproducts

/-!
# Low-degree Ext vanishing for the homogeneous coordinate ideal

The four coordinates of a polynomial ring in four variables form a regular
sequence.  Rees' theorem therefore gives the vanishing of the first four Ext
groups from the residue module at the homogeneous origin.  This is the
homological input needed to rule out an irrelevant socle in a three-quadric
complete intersection.
-/

namespace PfaffianDescent

open MvPolynomial RingTheory.Sequence
open CategoryTheory Abelian

section

variable {K σ : Type*} [Field K]

/-- If multiplication by a new variable lands in an ideal generated by a set
of different variables, the original polynomial already lies in that ideal. -/
lemma mem_span_X_image_of_X_mul {s : Set σ} {j : σ} (hj : j ∉ s)
    (p : MvPolynomial σ K)
    (hp : X j * p ∈ Ideal.span (X '' s : Set (MvPolynomial σ K))) :
    p ∈ Ideal.span (X '' s : Set (MvPolynomial σ K)) := by
  rw [MvPolynomial.mem_ideal_span_X_image] at hp ⊢
  intro m hm
  have hsupport : Finsupp.single j 1 + m ∈ (X j * p).support := by
    rw [mem_support_iff, coeff_X_mul]
    exact mem_support_iff.mp hm
  obtain ⟨i, hi, hmi⟩ := hp _ hsupport
  refine ⟨i, hi, ?_⟩
  intro hzero
  apply hmi
  rw [Finsupp.add_apply, hzero]
  have hij : i ≠ j := by
    intro e
    apply hj
    simpa [e] using hi
  simp [hij]

/-- A coordinate is regular modulo the ideal generated by any disjoint set of
coordinates. -/
lemma coordinate_isSMulRegular_mod_span {s : Set σ} {j : σ} (hj : j ∉ s) :
    let R := MvPolynomial σ K
    let I : Ideal R := Ideal.span (MvPolynomial.X '' s : Set R)
    IsSMulRegular (R := R) (R ⧸ I) (MvPolynomial.X j) := by
  dsimp
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  change X j * p ∈ Ideal.span (X '' s : Set (MvPolynomial σ K)) at hp
  exact mem_span_X_image_of_X_mul hj p hp

/-- The ideal generated by a finite list of coordinates, regarded as a module
subobject of the polynomial ring, is the corresponding coordinate ideal. -/
lemma coordinate_ofList_smul_top_eq_span (l : List σ) :
    let R := MvPolynomial σ K
    (Ideal.ofList (l.map fun i => MvPolynomial.X (R := K) i) •
      (⊤ : Submodule R R)) =
      Ideal.span (MvPolynomial.X (R := K) '' ({i | i ∈ l} : Set σ)) := by
  dsimp
  rw [Ideal.mul_top]
  apply congrArg Ideal.span
  ext r
  constructor
  · intro hr
    change r ∈ l.map (fun i => MvPolynomial.X (R := K) i) at hr
    rcases List.mem_map.mp hr with ⟨i, hi, rfl⟩
    exact ⟨i, hi, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    exact List.mem_map.mpr ⟨i, hi, rfl⟩

end

section

variable {K : Type*} [Field K]

abbrev CoordinateRing4 (K : Type*) [CommSemiring K] := MvPolynomial (Fin 4) K
noncomputable abbrev coordinate0 (K : Type*) [CommSemiring K] : CoordinateRing4 K :=
  MvPolynomial.X (R := K) 0
noncomputable abbrev coordinate1 (K : Type*) [CommSemiring K] : CoordinateRing4 K :=
  MvPolynomial.X (R := K) 1
noncomputable abbrev coordinate2 (K : Type*) [CommSemiring K] : CoordinateRing4 K :=
  MvPolynomial.X (R := K) 2
noncomputable abbrev coordinate3 (K : Type*) [CommSemiring K] : CoordinateRing4 K :=
  MvPolynomial.X (R := K) 3

/-- The four homogeneous coordinates of affine four-space form a regular
sequence. -/
lemma coordinate_sequence_regular :
    IsRegular (CoordinateRing4 K)
      [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] := by
  refine ⟨?_, ?_⟩
  · rw [isWeaklyRegular_iff_Fin]
    intro i
    fin_cases i
    · rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
      intro p hp
      have hp0 : MvPolynomial.X (R := K) (0 : Fin 4) * p = 0 := by
        simpa [Ideal.ofList_nil] using hp
      have : p = 0 :=
        (MvPolynomial.isRegular_X (R := K) (n := (0 : Fin 4))).left (by simpa using hp0)
      simpa [Ideal.ofList_nil] using this
    · simp only [List.take, List.length_cons, List.length_nil, Nat.zero_add]
      have hN := coordinate_ofList_smul_top_eq_span (K := K) ([0] : List (Fin 4))
      let e := Submodule.quotEquivOfEq _ _ hN
      exact (e.isSMulRegular_congr (coordinate1 K)).mpr
        (coordinate_isSMulRegular_mod_span (K := K)
          (s := ({i | i ∈ ([0] : List (Fin 4))} : Set (Fin 4)))
          (j := (1 : Fin 4)) (by simp))
    · simp only [List.take, List.length_cons, List.length_nil, Nat.zero_add]
      have hN := coordinate_ofList_smul_top_eq_span (K := K) ([0, 1] : List (Fin 4))
      let e := Submodule.quotEquivOfEq _ _ hN
      exact (e.isSMulRegular_congr (coordinate2 K)).mpr
        (coordinate_isSMulRegular_mod_span (K := K)
          (s := ({i | i ∈ ([0, 1] : List (Fin 4))} : Set (Fin 4)))
          (j := (2 : Fin 4)) (by simp))
    · simp only [List.take, List.length_cons, List.length_nil, Nat.zero_add]
      have hN := coordinate_ofList_smul_top_eq_span (K := K) ([0, 1, 2] : List (Fin 4))
      let e := Submodule.quotEquivOfEq _ _ hN
      exact (e.isSMulRegular_congr (coordinate3 K)).mpr
        (coordinate_isSMulRegular_mod_span (K := K)
          (s := ({i | i ∈ ([0, 1, 2] : List (Fin 4))} : Set (Fin 4)))
          (j := (3 : Fin 4)) (by simp))
  · intro htop
    have h1 : (1 : CoordinateRing4 K) ∈ Ideal.ofList
        [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] •
        (⊤ : Submodule (CoordinateRing4 K) (CoordinateRing4 K)) := by
      rw [← htop]
      exact Submodule.mem_top
    have hN := coordinate_ofList_smul_top_eq_span (K := K)
      ([0, 1, 2, 3] : List (Fin 4))
    have h1' : (1 : CoordinateRing4 K) ∈ Ideal.span
        (MvPolynomial.X (R := K) ''
          ({i | i ∈ ([0, 1, 2, 3] : List (Fin 4))} : Set (Fin 4))) := by
      exact hN ▸ h1
    rw [MvPolynomial.mem_ideal_span_X_image] at h1'
    obtain ⟨i, _, hi⟩ := h1' 0 (by simp)
    simp at hi

/-- The coordinate ideal generated by the four displayed coordinates is the
irrelevant homogeneous ideal. -/
lemma coordinate_ideal_eq_idealOfVars :
    Ideal.ofList [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] =
      MvPolynomial.idealOfVars (Fin 4) K := by
  apply congrArg Ideal.span
  ext r
  constructor
  · intro hr
    change r ∈ [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] at hr
    rcases List.mem_cons.mp hr with h | h
    · exact ⟨0, h.symm⟩
    rcases List.mem_cons.mp h with h | h
    · exact ⟨1, h.symm⟩
    rcases List.mem_cons.mp h with h | h
    · exact ⟨2, h.symm⟩
    rw [List.mem_singleton] at h
    exact ⟨3, h.symm⟩
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp [coordinate0, coordinate1, coordinate2, coordinate3]

/-- The residue module at the homogeneous origin has no Ext into the
polynomial ring in degrees below four. -/
lemma coordinate_ext_subsingleton (n : ℕ) (hn : n < 4) :
    Subsingleton (Ext
      (ModuleCat.of (CoordinateRing4 K)
        (CoordinateRing4 K ⧸ MvPolynomial.idealOfVars (Fin 4) K))
      (ModuleCat.of (CoordinateRing4 K) (CoordinateRing4 K)) n) := by
  let I : Ideal (CoordinateRing4 K) := MvPolynomial.idealOfVars (Fin 4) K
  let N := ModuleCat.of (CoordinateRing4 K) (CoordinateRing4 K ⧸ I)
  let M := ModuleCat.of (CoordinateRing4 K) (CoordinateRing4 K)
  have hreg := coordinate_sequence_regular (K := K)
  have hI : Ideal.ofList [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] = I :=
    coordinate_ideal_eq_idealOfVars (K := K)
  have hlt : I • (⊤ : Submodule (CoordinateRing4 K) (CoordinateRing4 K)) < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro heq
    apply hreg.top_ne_smul
    simpa only [hI] using heq.symm
  have hSupp : Module.support (CoordinateRing4 K) (CoordinateRing4 K ⧸ I) ⊆
      PrimeSpectrum.zeroLocus I := by
    rw [Module.support_eq_zeroLocus, Ideal.annihilator_quotient]
  have hmem : ∀ r ∈ [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K], r ∈ I := by
    intro r hr
    change r ∈ [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] at hr
    rcases List.mem_cons.mp hr with rfl | hr
    · exact Ideal.subset_span (Set.mem_range_self 0)
    rcases List.mem_cons.mp hr with rfl | hr
    · exact Ideal.subset_span (Set.mem_range_self 1)
    rcases List.mem_cons.mp hr with rfl | hr
    · exact Ideal.subset_span (Set.mem_range_self 2)
    rw [List.mem_singleton] at hr
    subst r
    exact Ideal.subset_span (Set.mem_range_self 3)
  exact ModuleCat.subsingleton_ext_of_exists_isRegular I N hSupp M hlt
    [coordinate0 K, coordinate1 K, coordinate2 K, coordinate3 K] hmem hreg n
    (by simpa using hn)

end

section

variable {R : Type*} [CommRing R] [HasExt (ModuleCat R)]
variable {X Y Y' : ModuleCat R} {n : ℕ}

/-- Postcomposition by an isomorphism is an additive equivalence of Ext
classes. -/
noncomputable def extPostcompIso (e : Y ≅ Y') : Ext X Y n ≃+ Ext X Y' n where
  toFun a := a.comp (Ext.mk₀ e.hom) (add_zero n)
  invFun b := b.comp (Ext.mk₀ e.inv) (add_zero n)
  left_inv a := by
    change (a.comp (Ext.mk₀ e.hom) (add_zero n)).comp (Ext.mk₀ e.inv) (add_zero n) = a
    rw [Ext.comp_assoc_of_second_deg_zero]
    simp
  right_inv b := by
    change (b.comp (Ext.mk₀ e.inv) (add_zero n)).comp (Ext.mk₀ e.hom) (add_zero n) = b
    rw [Ext.comp_assoc_of_second_deg_zero]
    simp
  map_add' a b := by simp

/-- Ext-vanishing is invariant under an isomorphism of the target module. -/
lemma ext_subsingleton_of_target_iso (e : Y ≅ Y') [Subsingleton (Ext X Y n)] :
    Subsingleton (Ext X Y' n) :=
  (extPostcompIso e).toEquiv.subsingleton_congr.mp inferInstance

/-- Ext-vanishing into two modules gives Ext-vanishing into their biproduct. -/
lemma ext_subsingleton_biprod {Y Z : ModuleCat R}
    [Subsingleton (Ext X Y n)] [Subsingleton (Ext X Z n)] :
    Subsingleton (Ext X (Y ⊞ Z) n) := by
  exact (Equiv.subsingleton_congr
    (Ext.addEquivBiprod (X := X) (Y₁ := Y) (Y₂ := Z) (n := n)).toEquiv).mpr inferInstance

/-- Ext-vanishing into the free rank-one module gives it for the free
rank-two module. -/
lemma ext_subsingleton_pair [Subsingleton (Ext X (ModuleCat.of R R) n)] :
    Subsingleton (Ext X (ModuleCat.of R (R × R)) n) := by
  let A := ModuleCat.of R R
  have hAA : Subsingleton (Ext X (A ⊞ A) n) := ext_subsingleton_biprod
  exact ext_subsingleton_of_target_iso (ModuleCat.biprodIsoProd A A)

/-- Ext-vanishing into the free rank-one module gives it for the free
rank-three module. -/
lemma ext_subsingleton_triple [Subsingleton (Ext X (ModuleCat.of R R) n)] :
    Subsingleton (Ext X (ModuleCat.of R (R × R × R)) n) := by
  let A := ModuleCat.of R R
  have hAA : Subsingleton (Ext X (A ⊞ A) n) := ext_subsingleton_biprod
  have hpair : Subsingleton (Ext X (ModuleCat.of R (R × R)) n) :=
    ext_subsingleton_of_target_iso (ModuleCat.biprodIsoProd A A)
  let B := ModuleCat.of R (R × R)
  have htripleB : Subsingleton (Ext X (A ⊞ B) n) := ext_subsingleton_biprod
  exact ext_subsingleton_of_target_iso (ModuleCat.biprodIsoProd A B)

end

section

variable {K : Type*} [Field K]

/-- The four coordinate-Ext vanishings used by the three-quadric Koszul
resolution. -/
lemma coordinate_ext_subsingleton_triple (n : ℕ) (hn : n < 4) :
    Subsingleton (Ext
      (ModuleCat.of (MvPolynomial (Fin 4) K)
        (MvPolynomial (Fin 4) K ⧸ Ideal.span
          (Set.range (MvPolynomial.X : Fin 4 → MvPolynomial (Fin 4) K))))
      (ModuleCat.of (MvPolynomial (Fin 4) K)
        (MvPolynomial (Fin 4) K × MvPolynomial (Fin 4) K × MvPolynomial (Fin 4) K)) n) := by
  letI : Subsingleton (Ext
      (ModuleCat.of (MvPolynomial (Fin 4) K)
        (MvPolynomial (Fin 4) K ⧸ MvPolynomial.idealOfVars (Fin 4) K))
      (ModuleCat.of (MvPolynomial (Fin 4) K) (MvPolynomial (Fin 4) K)) n) :=
    coordinate_ext_subsingleton n hn
  exact ext_subsingleton_triple

/-- The coordinate Ext vanishings also hold for the free rank-two module. -/
lemma coordinate_ext_subsingleton_pair (n : ℕ) (hn : n < 4) :
    Subsingleton (Ext
      (ModuleCat.of (MvPolynomial (Fin 4) K)
        (MvPolynomial (Fin 4) K ⧸ Ideal.span
          (Set.range (MvPolynomial.X : Fin 4 → MvPolynomial (Fin 4) K))))
      (ModuleCat.of (MvPolynomial (Fin 4) K)
        (MvPolynomial (Fin 4) K × MvPolynomial (Fin 4) K)) n) := by
  letI : Subsingleton (Ext
      (ModuleCat.of (MvPolynomial (Fin 4) K)
        (MvPolynomial (Fin 4) K ⧸ MvPolynomial.idealOfVars (Fin 4) K))
      (ModuleCat.of (MvPolynomial (Fin 4) K) (MvPolynomial (Fin 4) K)) n) :=
    coordinate_ext_subsingleton n hn
  exact ext_subsingleton_pair

end

end PfaffianDescent
