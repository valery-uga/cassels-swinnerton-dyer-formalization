import PfaffianDescent.FlatAffineIdealModuleSheaf
import PfaffianDescent.AffineClosedImmersionIdealKernel

/-! Flat base change preserves the regular-principal Cartier chart. -/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory
open scoped TensorProduct

universe u

/-- The base-changed quotient kernel is generated by the image of the
original regular equation, and that image remains a non-zero-divisor. -/
theorem flatBaseChange_regularPrincipal_kernel
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (hg : g.Flat) (z : A) (hz : IsRegular z) :
    letI : Algebra A B := g.toAlgebra
    IsRegular (g z) ∧
      RingHom.ker (Algebra.TensorProduct.includeLeft
        (R := A) (S := A) (A := B)
        (B := A ⧸ Ideal.span ({z} : Set A))).toRingHom =
        Ideal.span ({g z} : Set B) := by
  letI : Algebra A B := g.toAlgebra
  constructor
  · exact isRegular_map_of_ringHom_flat g hg z hz
  · rw [ideal_map_eq_ker_tensor_quotient g
      (Ideal.span ({z} : Set A)), Ideal.map_span, Set.image_singleton]
    rw [show algebraMap A B = g from rfl]

/-- On the base-changed affine scheme, the actual quotient-kernel ideal
sheaf has the rank-one trivialization induced by its regular equation. -/
noncomputable def flatBaseChange_regularPrincipal_kernelTildeIso
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (hg : g.Flat) (z : A) (hz : IsRegular z) :
    letI : Algebra A B := g.toAlgebra
    SheafOfModules.unit (Spec (CommRingCat.of B)).ringCatSheaf ≅
      (tilde.functor (CommRingCat.of B)).obj
        (ModuleCat.of B
          (RingHom.ker (Algebra.TensorProduct.includeLeft
            (R := A) (S := A) (A := B)
            (B := A ⧸ Ideal.span ({z} : Set A))).toRingHom)) := by
  letI : Algebra A B := g.toAlgebra
  obtain ⟨hreg, hker⟩ := flatBaseChange_regularPrincipal_kernel g hg z hz
  let e : B ≃ₗ[B]
      RingHom.ker (Algebra.TensorProduct.includeLeft
        (R := A) (S := A) (A := B)
        (B := A ⧸ Ideal.span ({z} : Set A))).toRingHom :=
    (regularPrincipalIdealLinearEquiv (g z) hreg).trans
      (LinearEquiv.ofEq (Ideal.span ({g z} : Set B) : Submodule B B)
        (RingHom.ker (Algebra.TensorProduct.includeLeft
          (R := A) (S := A) (A := B)
          (B := A ⧸ Ideal.span ({z} : Set A))).toRingHom) hker.symm)
  let m := ModuleCat.ofHom e.toLinearMap
  haveI : IsIso m :=
    (ConcreteCategory.isIso_iff_bijective m).mpr e.bijective
  exact (tildeSelf (R := CommRingCat.of B)).symm ≪≫
    (tilde.functor (CommRingCat.of B)).mapIso (asIso m)

end PfaffianDescent
