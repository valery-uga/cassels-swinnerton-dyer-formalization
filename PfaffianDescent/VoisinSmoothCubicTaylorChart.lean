import PfaffianDescent.VoisinSmoothCubicJacobianConverseStart
import PfaffianDescent.VoisinSquareZeroSectionRelation
import AllCharacteristics.HypersurfaceJacobianSmooth

/-!
# First-order relations in the actual normalized smooth-cubic chart

The chart evaluation kernel has exactly two generators: the cubic equation
and the equation setting the distinguished homogeneous coordinate to one.
Formal smoothness supplies a section of its square-zero thickening, to which
the general first-order Taylor relation applies.
-/

namespace PfaffianDescent

open AlgebraicGeometry MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- The kernel of the actual normalized chart evaluation map of a cubic
surface has precisely the cubic and normalization equations as generators. -/
theorem smoothCubic_chartEvaluation_ker_eq_span_pair
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (j : Fin 4) :
    RingHom.ker (eval₂Hom (chartBaseMap (equationIdeal p hp) j)
      (chartCoordinate (equationIdeal p hp) j)) =
      Ideal.span ({p, X j - 1} : Set (MvPolynomial (Fin 4) K)) := by
  rw [chartEvaluation_ker]
  simpa only [range_hypersurfaceChartRelations] using
    (span_range_hypersurfaceChartRelations p hp j).symm

/-- The same exact kernel statement for the algebra presentation used by
the formal-smoothness square-zero section. -/
theorem smoothCubic_chartAlgebraPresentation_ker_eq_span_pair
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (j : Fin 4) :
    let I := equationIdeal p hp
    letI : Algebra K (ChartRing I j) := (chartBaseMap I j).toAlgebra
    let f : MvPolynomial (Fin 4) K →ₐ[K] ChartRing I j :=
      MvPolynomial.aeval (chartCoordinate I j)
    RingHom.ker f.toRingHom =
      Ideal.span ({p, X j - 1} : Set (MvPolynomial (Fin 4) K)) := by
  let I := equationIdeal p hp
  letI : Algebra K (ChartRing I j) := (chartBaseMap I j).toAlgebra
  let f : MvPolynomial (Fin 4) K →ₐ[K] ChartRing I j :=
    MvPolynomial.aeval (chartCoordinate I j)
  have hf : f.toRingHom =
      eval₂Hom (chartBaseMap I j) (chartCoordinate I j) := by
    change eval₂Hom (algebraMap K (ChartRing I j)) (chartCoordinate I j) =
      eval₂Hom (chartBaseMap I j) (chartCoordinate I j)
    rw [RingHom.algebraMap_toAlgebra]
  change RingHom.ker f.toRingHom = _
  rw [hf]
  exact smoothCubic_chartEvaluation_ker_eq_span_pair p hp j

/-- Smoothness supplies a section of the actual chart presentation, and
every polynomial relation generated by the cubic and `X_j - 1` satisfies
the first-order Taylor equation in the square-zero thickening. This is the
concrete conormal relation from which the reverse Jacobian criterion must
extract a unit-ideal certificate. -/
theorem smoothCubic_chartPresentation_squareZero_TaylorRelations
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    [Smooth (hypersurfaceToBase p hp)] (j : Fin 4) :
    let I := equationIdeal p hp
    letI : Algebra K (ChartRing I j) := (chartBaseMap I j).toAlgebra
    let f : MvPolynomial (Fin 4) K →ₐ[K] ChartRing I j :=
      MvPolynomial.aeval (chartCoordinate I j)
    ∃ g : ChartRing I j →ₐ[K]
          MvPolynomial (Fin 4) K ⧸ RingHom.ker f.toRingHom ^ 2,
      f.kerSquareLift.comp g = AlgHom.id K _ ∧
        ∀ r ∈ Ideal.span ({p, X j - 1} : Set (MvPolynomial (Fin 4) K)),
          Ideal.Quotient.mk (RingHom.ker f.toRingHom ^ 2) r +
            ∑ i : Fin 4,
              (g (f (X i)) -
                  Ideal.Quotient.mk (RingHom.ker f.toRingHom ^ 2) (X i)) *
                Ideal.Quotient.mk (RingHom.ker f.toRingHom ^ 2)
                  (pderiv i r) = 0 := by
  let I := equationIdeal p hp
  letI : Algebra K (ChartRing I j) := (chartBaseMap I j).toAlgebra
  let f : MvPolynomial (Fin 4) K →ₐ[K] ChartRing I j :=
    MvPolynomial.aeval (chartCoordinate I j)
  obtain ⟨g, hg⟩ : ∃ g, f.kerSquareLift.comp g = AlgHom.id K _ :=
    smoothCubic_chartPresentation_squareZero_split p hp j
  refine ⟨g, hg, ?_⟩
  intro r hr
  have hker : RingHom.ker f.toRingHom =
      Ideal.span ({p, X j - 1} : Set (MvPolynomial (Fin 4) K)) :=
    smoothCubic_chartAlgebraPresentation_ker_eq_span_pair p hp j
  exact mvPolynomial_kerSquareLift_section_relation_of_mem f g hg r
    (hker.symm ▸ hr)

end PfaffianDescent
