/-- The literal original p/q curve maps to the literal original cubic by
the existing graded quotient morphism, with no chosen replacement curve. -/
def cubicSecondEquationCurveImmersion
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    scheme (projectiveIntersectionIdeal p q hp hq) ⟶ hypersurface p hp :=
  schemeQuotientMap (equationIdeal p hp) (projectiveIntersectionIdeal p q hp hq)
    (show (equationIdeal p hp).toIdeal ≤
      (projectiveIntersectionIdeal p q hp hq).toIdeal from le_sup_left)

instance cubicSecondEquationCurveImmersion_isClosedImmersion
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    IsClosedImmersion (cubicSecondEquationCurveImmersion p q hp n hq) := by
  exact schemeQuotientMap_closedImmersion (equationIdeal p hp)
    (projectiveIntersectionIdeal p q hp hq) le_sup_left

/-- The actual immersion preserves the ORIGINAL coefficient-field morphism. -/
theorem cubicSecondEquationCurveImmersion_toBase
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    cubicSecondEquationCurveImmersion p q hp n hq ≫ hypersurfaceToBase p hp =
      toBase (projectiveIntersectionIdeal p q hp hq) := by
  exact schemeQuotientMap_toBase (equationIdeal p hp)
    (projectiveIntersectionIdeal p q hp hq) le_sup_left

/-- Its composite with the actual cubic ambient immersion is exactly the
literal original intersection's canonical ambient immersion. -/
theorem cubicSecondEquationCurveImmersion_comp_ambient
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    cubicSecondEquationCurveImmersion p q hp n hq ≫ hypersurfaceToAmbient p hp =
      quotientProjMap (projectiveIntersectionIdeal p q hp hq) := by
  exact schemeQuotientMap_comp_quotientProjMap (equationIdeal p hp)
    (projectiveIntersectionIdeal p q hp hq) le_sup_left

/-- The ACTUAL graded factor map has kernel generated by the SAME original
q class. This is derived from literal (p,q), not a supplied kernel certificate. -/
theorem cubicSecondEquation_gradedQuotientMap_ker
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    RingHom.ker (gradedQuotientMap (equationIdeal p hp)
      (projectiveIntersectionIdeal p q hp hq) le_sup_left).toRingHom =
      Ideal.span ({(cubicSecondEquationHomogeneous p q hp n hq :
        CoordinateRing (equationIdeal p hp))} : Set _) := by
  change RingHom.ker (Ideal.Quotient.factor
    (show (equationIdeal p hp).toIdeal ≤
      (projectiveIntersectionIdeal p q hp hq).toIdeal from le_sup_left)) = _
  rw [Ideal.Quotient.factor_ker, projectiveIntersectionIdeal_toIdeal,
    Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  have hpzero : Ideal.Quotient.mk (equationIdeal p hp).toIdeal p = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton p))
  rw [hpzero, Ideal.span_insert_zero]
  rfl

private theorem cubicGrading_irrelevant_le_span_degreeOne
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) :
    (HomogeneousIdeal.irrelevant (grading (equationIdeal p hp))).toIdeal ≤
      Ideal.span (Set.range (fun f : grading (equationIdeal p hp) 1 =>
        (f : CoordinateRing (equationIdeal p hp)))) := by
  rw [irrelevant_eq_coordinateIdeal]
  apply Ideal.span_le.mpr
  rintro _ ⟨j, rfl⟩
  exact Ideal.subset_span ⟨⟨coordinate (equationIdeal p hp) j,
    coordinate_mem (equationIdeal p hp) j⟩, rfl⟩

/-- Ordinary exactness transport, isolated from native scheme/stalk
encodings. Its geometric caller supplies actual compatibility and actual
zero detection; neither certificate is an additional public premise. -/
private theorem cubicSecondEquation_exact_of_equiv_and_zero_detection
    {S M N S' M' N' : Type*} [Zero N] [Zero N']
    (f : S → M) (g : M → N) (F : S' → M') (G : M' → N')
    (a : S ≃ S') (b : M ≃ M')
    (hcompat : ∀ z, b (f z) = F (a z))
    (hzero : ∀ v, g v = 0 ↔ G (b v) = 0)
    (hFG : Function.Exact F G) : Function.Exact f g := by
  intro v
  constructor
  · intro hv
    obtain ⟨w, hw⟩ := (hFG (b v)).mp ((hzero v).mp hv)
    obtain ⟨z, rfl⟩ := a.surjective w
    exact ⟨z, b.injective ((hcompat z).trans hw)⟩
  · rintro ⟨z, rfl⟩
    apply (hzero (f z)).mpr
    apply (hFG (b (f z))).mpr
    exact ⟨a z, (hcompat z).symm⟩

private theorem cubicSecondEquation_unitRestriction_stalk_exact_image
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) (y : scheme (projectiveIntersectionIdeal p q hp hq)) :
    Function.Exact
      (schemeModuleStalkLinearMap (mulHomogeneousToUnit (grading (equationIdeal p hp))
        (cubicSecondEquationHomogeneous p q hp n hq)) (cubicSecondEquationCurveImmersion p q hp n hq y))
      (schemeModuleStalkLinearMap (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
        (cubicSecondEquationCurveImmersion p q hp n hq)) (cubicSecondEquationCurveImmersion p q hp n hq y)) := by
  let I := equationIdeal p hp
  let J := projectiveIntersectionIdeal p q hp hq
  let 𝒜 := grading I
  let ℬ := grading J
  let f := gradedQuotientMap I J le_sup_left
  let hf := gradedQuotientMap_surjective I J le_sup_left
  let h := gradedSurjective_irrelevant_le f hf
  let i := cubicSecondEquationCurveImmersion p q hp n hq
  let s := cubicSecondEquationHomogeneous p q hp n hq
  let fA := schemeModuleStalkLinearMap (mulHomogeneousToUnit 𝒜 s) (i y)
  let gA := schemeModuleStalkLinearMap
    (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit i) (i y)
  change Function.Exact fA gA
  let u := presheafOfModules_unitStalkLinearEquiv
    (ProjectiveSpectrum.Proj.structureSheaf 𝒜).presheaf (i y)
  let P := Proj.stalkIso' 𝒜 (i y)
  let Q := Proj.stalkIso' ℬ y
  let t := stalkAddEquivFractionModule 𝒜 (0 + n) (i y)
  let F := fun z : stalkSubmodule 𝒜 (pointIdeal 𝒜 (i y)) (0 + n) =>
    (atPrimeLinearEquivZeroTwistStalk 𝒜 (pointIdeal 𝒜 (i y))).symm
      (mulHomogeneousStalk 𝒜 (pointIdeal 𝒜 (i y)) s 0 z)
  let G := HomogeneousLocalization.localRingHom f
    (pointIdeal 𝒜 (i y)) (pointIdeal ℬ y) rfl
  have hlocal : Function.Exact F G :=
    gradedPrincipal_localRing_exact 𝒜 ℬ f hf s
      (cubicSecondEquation_gradedQuotientMap_ker p q hp n hq) y
  have hcompat : ∀ z, P (u.symm (fA z)) = F (t z) := by
    intro z
    exact gradedPrincipal_mulToUnit_stalkMap_compat 𝒜 s (i y) z
  have hzero : ∀ v, gA v = 0 ↔ G (P (u.symm v)) = 0 := by
    intro v
    obtain ⟨r, rfl⟩ := u.surjective v
    have hunit : gA (u r) = 0 ↔ i.stalkMap y r = 0 :=
      closedImmersionUnitToPushforwardUnit_stalkMap_eq_zero_iff
        i i.isClosedEmbedding.isInducing y r
    have hproj : Q.symm (G (P r)) = i.stalkMap y r :=
      Proj.localRingHom_comp_stalkIso_apply f h y r
    have hstalk : i.stalkMap y r = 0 ↔ G (P r) = 0 := by
      constructor
      · intro hr
        apply Q.symm.injective
        calc
          Q.symm (G (P r)) = i.stalkMap y r := hproj
          _ = 0 := hr
          _ = Q.symm 0 := (map_zero Q.symm).symm
      · intro hG
        exact hproj.symm.trans ((congrArg Q.symm hG).trans (map_zero Q.symm))
    simpa only [u.symm_apply_apply] using hunit.trans hstalk
  exact cubicSecondEquation_exact_of_equiv_and_zero_detection
    fA gA F G t.toEquiv (u.symm.toEquiv.trans P.toEquiv) hcompat hzero hlocal

private theorem cubicSecondEquation_unitRestriction_stalk_exact_off_range
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) (x : hypersurface p hp)
    (hx : x ∉ Set.range (cubicSecondEquationCurveImmersion p q hp n hq)) :
    Function.Exact
      (schemeModuleStalkLinearMap (mulHomogeneousToUnit (grading (equationIdeal p hp))
        (cubicSecondEquationHomogeneous p q hp n hq)) x)
      (schemeModuleStalkLinearMap (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
        (cubicSecondEquationCurveImmersion p q hp n hq)) x) := by
  let I := equationIdeal p hp
  let J := projectiveIntersectionIdeal p q hp hq
  let 𝒜 := grading I
  let ℬ := grading J
  let f := gradedQuotientMap I J le_sup_left
  let hf := gradedQuotientMap_surjective I J le_sup_left
  let h := gradedSurjective_irrelevant_le f hf
  let i := cubicSecondEquationCurveImmersion p q hp n hq
  let s := cubicSecondEquationHomogeneous p q hp n hq
  let fA := schemeModuleStalkLinearMap (mulHomogeneousToUnit 𝒜 s) x
  let gA := schemeModuleStalkLinearMap
    (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit i) x
  change Function.Exact fA gA
  have hsnot : (s : CoordinateRing I) ∉ (pointIdeal 𝒜 x) := by
    intro hs
    apply hx
    change x ∈ Set.range (Proj.map f h)
    rw [projectiveMap_mem_range_iff f hf x,
      cubicSecondEquation_gradedQuotientMap_ker p q hp n hq, Ideal.span_le]
    exact Set.singleton_subset_iff.mpr hs
  let e := unitIsoZeroTwist 𝒜
  let T := schemeModuleStalkFunctor (Proj 𝒜) x
  have htwist : IsIso (T.map (mulHomogeneous 𝒜 s 0)) := by
    change IsIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
      (mulHomogeneousPresheaf 𝒜 s 0))
    exact mulHomogeneous_stalkMap_isIso_of_mem_primeCompl_of_irrelevant_le_span
      𝒜 s 0 x hsnot (cubicGrading_irrelevant_le_span_degreeOne p hp)
  letI : IsIso (T.map (mulHomogeneous 𝒜 s 0)) := htwist
  haveI : IsIso (T.map (mulHomogeneousToUnit 𝒜 s)) := by
    change IsIso (T.map (mulHomogeneous 𝒜 s 0 ≫ e.inv))
    rw [Functor.map_comp]
    infer_instance
  have hsurj : Function.Surjective fA :=
    (ConcreteCategory.bijective_of_isIso (T.map (mulHomogeneousToUnit 𝒜 s))).surjective
  letI : Subsingleton (((Scheme.Modules.pushforward i).obj
      (SheafOfModules.unit (scheme J).ringCatSheaf)).presheaf.stalk x) :=
    schemeModulePushforward_stalk_subsingleton_off_range i
      (SheafOfModules.unit (scheme J).ringCatSheaf) x hx
  intro v
  constructor
  · intro _
    exact hsurj v
  · intro _
    exact Subsingleton.elim _ _

/-- Exactness on every ACTUAL categorical cubic stalk of the original
q multiplication followed by canonical restriction to the literal curve.
No domain/reducedness/integrality hypothesis on that curve is needed. -/
theorem cubicSecondEquation_unitRestriction_stalk_exact
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) (x : hypersurface p hp) :
    Function.Exact
      (schemeModuleStalkLinearMap (mulHomogeneousToUnit (grading (equationIdeal p hp))
        (cubicSecondEquationHomogeneous p q hp n hq)) x)
      (schemeModuleStalkLinearMap (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
        (cubicSecondEquationCurveImmersion p q hp n hq)) x) := by
  by_cases hx : x ∈ Set.range (cubicSecondEquationCurveImmersion p q hp n hq)
  · obtain ⟨y, rfl⟩ := hx
    exact cubicSecondEquation_unitRestriction_stalk_exact_image p q hp n hq y
  · exact cubicSecondEquation_unitRestriction_stalk_exact_off_range p q hp n hq x hx

/-- The actual q multiplication vanishes after the canonical unit map to
the SAME literal curve. This uses the proved stalk calculation. -/
theorem cubicSecondEquation_mulToUnit_comp_curveUnit_zero
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    mulHomogeneousToUnit (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq) ≫
      IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
        (cubicSecondEquationCurveImmersion p q hp n hq) = 0 := by
  apply schemeModule_hom_ext_of_stalkMap_eq
  intro x
  let T := schemeModuleStalkFunctor (hypersurface p hp) x
  letI : T.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_additive T
  change T.map (mulHomogeneousToUnit (grading (equationIdeal p hp))
    (cubicSecondEquationHomogeneous p q hp n hq) ≫
      IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
        (cubicSecondEquationCurveImmersion p q hp n hq)) = T.map 0
  rw [T.map_comp, T.map_zero]
  apply ConcreteCategory.hom_ext
  intro z
  exact (cubicSecondEquation_unitRestriction_stalk_exact p q hp n hq x _).mpr ⟨z, rfl⟩

/-- The original q sequence ending in the actual literal curve unit. -/
def cubicSecondEquation_unitRestrictionSequence
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    ShortComplex (hypersurface p hp).Modules :=
  ShortComplex.mk
    (mulHomogeneousToUnit (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq))
    (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
      (cubicSecondEquationCurveImmersion p q hp n hq))
    (cubicSecondEquation_mulToUnit_comp_curveUnit_zero p q hp n hq)

/-- Exactness is proved on the actual stalks and reflected to the actual
sheaf-module category; it is not an input of the primitive curve caller. -/
theorem cubicSecondEquation_unitRestrictionSequence_exact
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (n : ℕ) (hq : q.IsHomogeneous n) :
    (cubicSecondEquation_unitRestrictionSequence p q hp n hq).Exact := by
  let S := cubicSecondEquation_unitRestrictionSequence p q hp n hq
  let T := SheafOfModules.toSheaf.{u} (hypersurface p hp).ringCatSheaf
  letI : T.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_additive T
  apply Functor.reflects_exact_of_faithful T
  apply (TopCat.Sheaf.exact_iff_stalkFunctor_map_exact (S.map T)).mpr
  intro x
  change (S.map (schemeModuleStalkFunctor (hypersurface p hp) x)).Exact
  exact (ShortComplex.ab_exact_iff_function_exact _).mpr
    (cubicSecondEquation_unitRestriction_stalk_exact p q hp n hq x)

/-- Ordinary smooth cubic/nonmembership inputs give the genuine short exact
restriction sequence. Curve integrality and target-domain certificates are
unnecessary, and empty curve targets are included. -/
theorem cubicSecondEquation_unitRestrictionSequence_shortExact
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    (cubicSecondEquation_unitRestrictionSequence p q hp n hq).ShortExact := by
  letI : (equationIdeal p hp).toIdeal.IsPrime :=
    principalIdeal_prime_of_smooth_homogeneous_cubic p hp hp0
  letI : IsDomain (CoordinateRing (equationIdeal p hp)) := inferInstance
  refine
    { exact := cubicSecondEquation_unitRestrictionSequence_exact p q hp n hq
      mono_f := ?_
      epi_g := ?_ }
  · change Mono (mulHomogeneousToUnit (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq))
    exact mulHomogeneousToUnit_mono (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq)
      (cubicSecondEquationHomogeneous_ne_zero p q hp n hq hnot)
  · change Epi (IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
      (cubicSecondEquationCurveImmersion p q hp n hq))
    infer_instance

/-- The cokernel of the original q multiplication INTO THE UNIT is the
actual pushed-forward unit of the literal original p/q curve. -/
def cubicSecondEquation_unitCokernelIsoCurveUnit
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    cokernel (mulHomogeneousToUnit (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq)) ≅
      (Scheme.Modules.pushforward (cubicSecondEquationCurveImmersion p q hp n hq)).obj
        (SheafOfModules.unit (scheme (projectiveIntersectionIdeal p q hp hq)).ringCatSheaf) := by
  let S := cubicSecondEquation_unitRestrictionSequence p q hp n hq
  have hS := cubicSecondEquation_unitRestrictionSequence_shortExact p q hp hp0 n hq hnot
  exact IsColimit.coconePointUniqueUpToIso (cokernelIsCokernel S.f) hS.gIsCokernel

theorem cubicSecondEquation_unitCokernelIsoCurveUnit_π
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    cokernel.π (mulHomogeneousToUnit (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq)) ≫
      (cubicSecondEquation_unitCokernelIsoCurveUnit p q hp hp0 n hq hnot).hom =
      IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
        (cubicSecondEquationCurveImmersion p q hp n hq) := by
  let S := cubicSecondEquation_unitRestrictionSequence p q hp n hq
  have hS := cubicSecondEquation_unitRestrictionSequence_shortExact p q hp hp0 n hq hnot
  exact IsColimit.comp_coconePointUniqueUpToIso_hom
    (cokernelIsCokernel S.f) hS.gIsCokernel WalkingParallelPair.one

/-- The exact ORIGINAL m=0 cokernel used by the finite-cohomology producer,
without changing its multiplication or projection, is the literal curve unit
pushforward. The zero twist is identified with the unit by its actual iso. -/
def cubicSecondEquation_zeroCokernelIsoCurveUnit
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    cokernel (mulHomogeneous (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq) 0) ≅
      (Scheme.Modules.pushforward (cubicSecondEquationCurveImmersion p q hp n hq)).obj
        (SheafOfModules.unit (scheme (projectiveIntersectionIdeal p q hp hq)).ringCatSheaf) := by
  let 𝒜 := grading (equationIdeal p hp)
  let s := cubicSecondEquationHomogeneous p q hp n hq
  let f := mulHomogeneous 𝒜 s 0
  let g := mulHomogeneousToUnit 𝒜 s
  let e := unitIsoZeroTwist 𝒜
  have w : f ≫ e.inv = (Iso.refl _).hom ≫ g := (Category.id_comp g).symm
  exact cokernel.mapIso f g (Iso.refl _) e.symm w ≪≫
    cubicSecondEquation_unitCokernelIsoCurveUnit p q hp hp0 n hq hnot

theorem cubicSecondEquation_zeroCokernelIsoCurveUnit_π
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    cokernel.π (mulHomogeneous (grading (equationIdeal p hp))
      (cubicSecondEquationHomogeneous p q hp n hq) 0) ≫
      (cubicSecondEquation_zeroCokernelIsoCurveUnit p q hp hp0 n hq hnot).hom =
      (unitIsoZeroTwist (grading (equationIdeal p hp))).inv ≫
        IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
          (cubicSecondEquationCurveImmersion p q hp n hq) := by
  let 𝒜 := grading (equationIdeal p hp)
  let s := cubicSecondEquationHomogeneous p q hp n hq
  let f := mulHomogeneous 𝒜 s 0
  let g := mulHomogeneousToUnit 𝒜 s
  let e := unitIsoZeroTwist 𝒜
  let c := cubicSecondEquation_unitCokernelIsoCurveUnit p q hp hp0 n hq hnot
  have w : f ≫ e.inv = (Iso.refl _).hom ≫ g := (Category.id_comp g).symm
  have hmap : cokernel.π f ≫ (cokernel.mapIso f g (Iso.refl _) e.symm w).hom =
      e.inv ≫ cokernel.π g :=
    cokernel.π_desc f (e.inv ≫ cokernel.π g)
      ((Category.assoc f e.inv (cokernel.π g)).symm.trans (cokernel.condition g))
  change cokernel.π f ≫ ((cokernel.mapIso f g (Iso.refl _) e.symm w).hom ≫ c.hom) =
    e.inv ≫ IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
      (cubicSecondEquationCurveImmersion p q hp n hq)
  calc
    _ = (cokernel.π f ≫ (cokernel.mapIso f g (Iso.refl _) e.symm w).hom) ≫ c.hom :=
      (Category.assoc _ _ _).symm
    _ = (e.inv ≫ cokernel.π g) ≫ c.hom :=
      congrArg (fun k => k ≫ c.hom) hmap
    _ = e.inv ≫ (cokernel.π g ≫ c.hom) := Category.assoc _ _ _
    _ = _ := congrArg (fun k => e.inv ≫ k)
      (cubicSecondEquation_unitCokernelIsoCurveUnit_π p q hp hp0 n hq hnot)

/-- The required ambient identification of the SAME original q-cokernel
pushforward with the unit pushed along the SAME literal ambient immersion. -/
def cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    (Scheme.Modules.pushforward (hypersurfaceToAmbient p hp)).obj
      (cokernel (mulHomogeneous (grading (equationIdeal p hp))
        (cubicSecondEquationHomogeneous p q hp n hq) 0)) ≅
      (Scheme.Modules.pushforward (quotientProjMap (projectiveIntersectionIdeal p q hp hq))).obj
        (SheafOfModules.unit (scheme (projectiveIntersectionIdeal p q hp hq)).ringCatSheaf) :=
  (Scheme.Modules.pushforward (hypersurfaceToAmbient p hp)).mapIso
    (cubicSecondEquation_zeroCokernelIsoCurveUnit p q hp hp0 n hq hnot) ≪≫
    (Scheme.Modules.pushforwardComp (cubicSecondEquationCurveImmersion p q hp n hq)
      (hypersurfaceToAmbient p hp)).app _ ≪≫
    (Scheme.Modules.pushforwardCongr
      (cubicSecondEquationCurveImmersion_comp_ambient p q hp n hq)).app _

/-- The ambient iso retains the ACTUAL original cokernel projection. Its
right side is the canonical unit restriction and the actual embedding
composition transports; no arbitrary comparison map enters. -/
theorem cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit_π
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    (Scheme.Modules.pushforward (hypersurfaceToAmbient p hp)).map
      (cokernel.π (mulHomogeneous (grading (equationIdeal p hp))
        (cubicSecondEquationHomogeneous p q hp n hq) 0)) ≫
      (cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit p q hp hp0 n hq hnot).hom =
      (Scheme.Modules.pushforward (hypersurfaceToAmbient p hp)).map
        ((unitIsoZeroTwist (grading (equationIdeal p hp))).inv ≫
          IdealSheafDataModule.closedImmersionUnitToPushforwardUnit
            (cubicSecondEquationCurveImmersion p q hp n hq)) ≫
        (Scheme.Modules.pushforwardComp (cubicSecondEquationCurveImmersion p q hp n hq)
          (hypersurfaceToAmbient p hp)).hom.app _ ≫
        (Scheme.Modules.pushforwardCongr
          (cubicSecondEquationCurveImmersion_comp_ambient p q hp n hq)).hom.app _ := by
  dsimp only [cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit, Iso.trans_hom,
    Functor.mapIso_hom]
  rw [← Category.assoc, ← Functor.map_comp,
    cubicSecondEquation_zeroCokernelIsoCurveUnit_π]
  rfl

/-- The ambient comparison also retains the ORIGINAL ambient unit map:
restricting a regular function through the cubic and its q cokernel is
exactly restriction along the original literal curve immersion. -/
theorem cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit_unit_comp
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [Smooth (hypersurfaceToBase p hp)] (n : ℕ) (hq : q.IsHomogeneous n)
    (hnot : q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) :
    SheafOfModules.unitToPushforwardObjUnit (hypersurfaceToAmbient p hp).toRingCatSheafHom ≫
      (Scheme.Modules.pushforward (hypersurfaceToAmbient p hp)).map
        ((unitIsoZeroTwist (grading (equationIdeal p hp))).hom ≫
          cokernel.π (mulHomogeneous (grading (equationIdeal p hp))
            (cubicSecondEquationHomogeneous p q hp n hq) 0)) ≫
      (cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit p q hp hp0 n hq hnot).hom =
      SheafOfModules.unitToPushforwardObjUnit
        (quotientProjMap (projectiveIntersectionIdeal p q hp hq)).toRingCatSheafHom := by
  let F := Scheme.Modules.pushforward (hypersurfaceToAmbient p hp)
  let e := unitIsoZeroTwist (grading (equationIdeal p hp))
  let f := mulHomogeneous (grading (equationIdeal p hp))
    (cubicSecondEquationHomogeneous p q hp n hq) 0
  let c := cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit p q hp hp0 n hq hnot
  have hπ := cubicSecondEquation_zeroCokernelAmbientIsoCurveUnit_π p q hp hp0 n hq hnot
  let i := hypersurfaceToAmbient p hp
  let j := cubicSecondEquationCurveImmersion p q hp n hq
  let O := SheafOfModules.unit (scheme (projectiveIntersectionIdeal p q hp hq)).ringCatSheaf
  let u := SheafOfModules.unitToPushforwardObjUnit i.toRingCatSheafHom
  let v := SheafOfModules.unitToPushforwardObjUnit j.toRingCatSheafHom
  let C := (Scheme.Modules.pushforwardComp j i).hom.app O
  let E := (Scheme.Modules.pushforwardCongr
    (cubicSecondEquationCurveImmersion_comp_ambient p q hp n hq)).hom.app O
  change u ≫ F.map (e.hom ≫ cokernel.π f) ≫ c.hom = _
  have hπ' : F.map (cokernel.π f) ≫ c.hom = F.map (e.inv ≫ v) ≫ C ≫ E := hπ
  calc
    u ≫ F.map (e.hom ≫ cokernel.π f) ≫ c.hom =
        u ≫ F.map e.hom ≫ (F.map (cokernel.π f) ≫ c.hom) := by
      rw [Functor.map_comp]
      simp only [Category.assoc]
    _ = u ≫ F.map e.hom ≫ (F.map (e.inv ≫ v) ≫ C ≫ E) := by rw [hπ']
    _ = u ≫ F.map (e.hom ≫ e.inv ≫ v) ≫ C ≫ E := by
      simp only [Functor.map_comp, Category.assoc]
    _ = u ≫ F.map v ≫ C ≫ E := by rw [e.hom_inv_id_assoc]
    _ = SheafOfModules.unitToPushforwardObjUnit (j ≫ i).toRingCatSheafHom ≫ E := by
      rw [affineSource_unit_comp]
      simp only [Category.assoc]
      rfl
    _ = _ := affineSource_unit_congr (cubicSecondEquationCurveImmersion_comp_ambient p q hp n hq)

end PfaffianDescent.Coray
