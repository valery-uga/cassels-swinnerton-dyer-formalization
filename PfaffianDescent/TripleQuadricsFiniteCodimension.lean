import PfaffianDescent.ArtinianQuotientMaximal
import PfaffianDescent.MvPolynomialMaximalHeight
import PfaffianDescent.TripleQuadricsDehomogenizedArtinian

/-!
# Codimension of finite three-quadric charts

For a finite projective intersection of three homogeneous quadrics, each
nonempty dehomogenized chart has codimension three in its three-variable
polynomial ring.
-/

namespace PfaffianDescent

open AlgebraicGeometry MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u

section

variable {K : Type u} [Field K] {a b c : ℕ}
attribute [local instance] MvPolynomial.gradedAlgebra

private lemma height_span_pair_le_two
    {σ : Type*} [Fintype σ] (f g : MvPolynomial σ K)
    (hproper : Ideal.span ({f, g} : Set (MvPolynomial σ K)) ≠ ⊤) :
    (Ideal.span ({f, g} : Set (MvPolynomial σ K))).height ≤ 2 := by
  let I : Ideal (MvPolynomial σ K) := Ideal.span ({f, g} : Set _)
  have hfin : ↑I.spanFinrank ≤ ({f, g} : Set (MvPolynomial σ K)).encard := by
    simpa [I] using Submodule.spanFinrank_span_le_encard
      ({f, g} : Set (MvPolynomial σ K))
  have hcard : ({f, g} : Set (MvPolynomial σ K)).encard ≤ 2 := by
    calc
      ({f, g} : Set (MvPolynomial σ K)).encard ≤ ({g} : Set _).encard + 1 :=
        Set.encard_insert_le ({g} : Set (MvPolynomial σ K)) f
      _ = 2 := by norm_num
  change I.height ≤ _
  exact (Ideal.height_le_spanFinrank I hproper).trans (hfin.trans hcard)

/-- A prime containing the three dehomogenized quadrics has height three when
its projective intersection is finite. -/
theorem tripleCompleteIntersection_dehomogenized_prime_height_of_finite
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (j : Fin 4) (P : Ideal (MvPolynomial {i : Fin 4 // i ≠ j} K))
    [P.IsPrime] (hP : tripleCompleteIntersectionDehomogenizedIdeal p q r j ≤ P) :
    P.height = 3 := by
  let I := tripleCompleteIntersectionDehomogenizedIdeal p q r j
  have hArtinian : IsArtinianRing (MvPolynomial {i : Fin 4 // i ≠ j} K ⧸ I) :=
    tripleCompleteIntersection_dehomogenized_isArtinian_of_finite p q r hp hq hr j
  have hPmax : P.IsMaximal :=
    ideal_isMaximal_of_isArtinian_quotient I P (by simpa [I] using hP)
  have hheight := mvPolynomial_maximal_height_of_fintype P
  simpa [Fintype.card_subtype_compl] using hheight

/-- A nonempty dehomogenized chart of a finite projective three-quadric
intersection has ideal height three. -/
theorem tripleCompleteIntersection_dehomogenized_height_of_finite
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (j : Fin 4)
    (hproper : tripleCompleteIntersectionDehomogenizedIdeal p q r j ≠ ⊤) :
    (tripleCompleteIntersectionDehomogenizedIdeal p q r j).height = 3 := by
  classical
  let I := tripleCompleteIntersectionDehomogenizedIdeal p q r j
  obtain ⟨P, hP⟩ := Ideal.nonempty_minimalPrimes hproper
  have hPprime : P.IsPrime := hP.isPrime
  have hPheight : P.height = 3 :=
    tripleCompleteIntersection_dehomogenized_prime_height_of_finite p q r hp hq hr j P hP.1.2
  change I.height = _
  rw [I.height_eq_inf_minimalPrimes]
  apply le_antisymm
  · exact (iInf₂_le P hP).trans_eq hPheight
  · refine le_iInf₂ fun Q hQ => ?_
    have hQprime : Q.IsPrime := hQ.isPrime
    exact (tripleCompleteIntersection_dehomogenized_prime_height_of_finite
      p q r hp hq hr j Q hQ.1.2).ge

/-- A finite nonempty projective three-quadric intersection has a standard
affine chart of codimension three. -/
theorem exists_tripleCompleteIntersection_dehomogenized_height_of_finite_of_nonempty
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (hX : Nonempty (scheme (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))):
    ∃ j : Fin 4, (tripleCompleteIntersectionDehomogenizedIdeal p q r j).height = 3 := by
  obtain ⟨j, hj⟩ :=
    exists_tripleCompleteIntersection_dehomogenized_proper_of_nonempty p q r hp hq hr hX
  exact ⟨j, tripleCompleteIntersection_dehomogenized_height_of_finite p q r hp hq hr j hj⟩

/-- No dehomogenized quadric is generated by the other two on a nonempty
finite three-quadric chart. -/
theorem tripleCompleteIntersection_dehomogenized_first_not_mem_span_of_finite
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (j : Fin 4)
    (hproper : tripleCompleteIntersectionDehomogenizedIdeal p q r j ≠ ⊤) :
    coordinateOneEvaluation j p ∉ Ideal.span
      ({coordinateOneEvaluation j q, coordinateOneEvaluation j r} :
        Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) := by
  intro hpqr
  let f := coordinateOneEvaluation j p
  let g := coordinateOneEvaluation j q
  let h := coordinateOneEvaluation j r
  let I := tripleCompleteIntersectionDehomogenizedIdeal p q r j
  change I ≠ ⊤ at hproper
  let J : Ideal (MvPolynomial {i : Fin 4 // i ≠ j} K) := Ideal.span ({g, h} : Set _)
  have hIJ : I = J := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hx | hx | hx
      · subst x
        exact hpqr
      · subst x
        simpa [J] using (Ideal.subset_span (show g ∈ ({g, h} : Set _) by simp))
      · subst x
        simpa [J] using (Ideal.subset_span (show h ∈ ({g, h} : Set _) by simp))
    · apply Ideal.span_mono
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
      rcases hx with hx | hx
      · exact Or.inr (Or.inl hx)
      · exact Or.inr (Or.inr hx)
  have hJproper : J ≠ ⊤ := by
    intro hJtop
    apply hproper
    rw [hIJ, hJtop]
  have hIheight : I.height = 3 :=
    tripleCompleteIntersection_dehomogenized_height_of_finite p q r hp hq hr j hproper
  have hJheight : J.height ≤ 2 := by
    change (Ideal.span ({g, h} : Set _)).height ≤ _
    apply height_span_pair_le_two g h
    simpa [J] using hJproper
  have hcontra : (3 : ℕ∞) ≤ 2 := by
    rw [← hIheight, hIJ]
    exact hJheight
  norm_num at hcontra

/-- Height three for a proper ideal generated by three polynomials makes each
generator indispensable.  This is the two-generator form of Krull's height
bound used below for all orders of the finite net. -/
private theorem first_not_mem_span_of_height_three
    {σ : Type*} [Fintype σ] (f g h : MvPolynomial σ K)
    (hproper : Ideal.span ({f, g, h} : Set (MvPolynomial σ K)) ≠ ⊤)
    (hheight : (Ideal.span ({f, g, h} : Set (MvPolynomial σ K))).height = 3) :
    f ∉ Ideal.span ({g, h} : Set (MvPolynomial σ K)) := by
  intro hfg
  let I : Ideal (MvPolynomial σ K) := Ideal.span ({f, g, h} : Set _)
  let J : Ideal (MvPolynomial σ K) := Ideal.span ({g, h} : Set _)
  have hIJ : I = J := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hx | hx | hx
      · subst x
        exact hfg
      · subst x
        simpa [J] using (Ideal.subset_span (show g ∈ ({g, h} : Set _) by simp))
      · subst x
        simpa [J] using (Ideal.subset_span (show h ∈ ({g, h} : Set _) by simp))
    · apply Ideal.span_mono
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
      rcases hx with hx | hx
      · exact Or.inr (Or.inl hx)
      · exact Or.inr (Or.inr hx)
  have hJproper : J ≠ ⊤ := by
    intro hJtop
    apply hproper
    simp [I, hIJ, hJtop]
  have hJheight : J.height ≤ 2 := by
    change (Ideal.span ({g, h} : Set _)).height ≤ _
    apply height_span_pair_le_two g h
    simpa [J] using hJproper
  have hcontra : (3 : ℕ∞) ≤ 2 := by
    rw [← hheight]
    change I.height ≤ _
    rw [hIJ]
    exact hJheight
  norm_num at hcontra

/-- Every generator of a finite three-quadric chart is indispensable.  This
includes the degree-two minimality assertion in the net-of-quadrics lemma,
without yet using the stronger regular-sequence conclusion. -/
theorem tripleCompleteIntersection_dehomogenized_generators_minimal_of_finite
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (j : Fin 4)
    (hproper : tripleCompleteIntersectionDehomogenizedIdeal p q r j ≠ ⊤) :
    coordinateOneEvaluation j p ∉ Ideal.span
      ({coordinateOneEvaluation j q, coordinateOneEvaluation j r} :
        Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) ∧
      coordinateOneEvaluation j q ∉ Ideal.span
        ({coordinateOneEvaluation j p, coordinateOneEvaluation j r} :
          Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) ∧
      coordinateOneEvaluation j r ∉ Ideal.span
        ({coordinateOneEvaluation j p, coordinateOneEvaluation j q} :
          Set (MvPolynomial {i : Fin 4 // i ≠ j} K)) := by
  let f := coordinateOneEvaluation j p
  let g := coordinateOneEvaluation j q
  let h := coordinateOneEvaluation j r
  let I := tripleCompleteIntersectionDehomogenizedIdeal p q r j
  have hI : I = Ideal.span ({f, g, h} : Set _) := rfl
  have hIproper : I ≠ ⊤ := by simpa [I] using hproper
  have hheight : I.height = 3 :=
    tripleCompleteIntersection_dehomogenized_height_of_finite p q r hp hq hr j hIproper
  have hproper' : Ideal.span ({f, g, h} : Set _) ≠ ⊤ := by rwa [← hI]
  have hheight' : (Ideal.span ({f, g, h} : Set _)).height = 3 := by rwa [← hI]
  have hgf : Ideal.span ({g, f, h} : Set _) = Ideal.span ({f, g, h} : Set _) := by
    apply le_antisymm <;> apply Ideal.span_mono <;>
      intro x hx <;>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢ <;>
      tauto
  have hfg : Ideal.span ({h, f, g} : Set _) = Ideal.span ({f, g, h} : Set _) := by
    apply le_antisymm <;> apply Ideal.span_mono <;>
      intro x hx <;>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢ <;>
      tauto
  refine ⟨first_not_mem_span_of_height_three f g h hproper' hheight', ?_, ?_⟩
  · apply first_not_mem_span_of_height_three g f h
    · rwa [hgf]
    · rwa [hgf]
  · apply first_not_mem_span_of_height_three h f g
    · rwa [hfg]
    · rwa [hfg]

/-- Three polynomials are linearly independent when none lies in the ideal
generated by the other two. -/
private theorem triple_linearIndependent_of_generators_minimal
    {σ : Type*} [Fintype σ] (f g h : MvPolynomial σ K)
    (hf : f ∉ Ideal.span ({g, h} : Set (MvPolynomial σ K)))
    (hg : g ∉ Ideal.span ({f, h} : Set (MvPolynomial σ K)))
    (hh : h ∉ Ideal.span ({f, g} : Set (MvPolynomial σ K))) :
    LinearIndependent K ![f, g, h] := by
  rw [Fintype.linearIndependent_iff]
  intro a hsum i
  rw [Fin.sum_univ_three] at hsum
  have hsum' : a 0 • f + a 1 • g + a 2 • h = 0 := by
    simpa using hsum
  have ha0 : a 0 = 0 := by
    by_contra ha0
    apply hf
    let I : Ideal (MvPolynomial σ K) := Ideal.span ({g, h} : Set _)
    have hmem : a 0 • f ∈ I := by
      have hright : a 1 • g + a 2 • h ∈ I := by
        apply I.add_mem
        · rw [smul_eq_C_mul]
          exact I.mul_mem_left _ (Ideal.subset_span (by simp))
        · rw [smul_eq_C_mul]
          exact I.mul_mem_left _ (Ideal.subset_span (by simp))
      have heq : a 0 • f = -(a 1 • g + a 2 • h) := by
        linear_combination hsum'
      rw [heq]
      exact I.neg_mem hright
    have heq : f = (a 0)⁻¹ • (a 0 • f) := by
      calc
        f = 1 • f := (one_smul K f).symm
        _ = ((a 0)⁻¹ * a 0) • f := by rw [inv_mul_cancel₀ ha0]
        _ = (a 0)⁻¹ • (a 0 • f) := (smul_smul _ _ _).symm
    rw [heq, smul_eq_C_mul]
    exact I.mul_mem_left _ hmem
  have ha1 : a 1 = 0 := by
    by_contra ha1
    apply hg
    let I : Ideal (MvPolynomial σ K) := Ideal.span ({f, h} : Set _)
    have hmem : a 1 • g ∈ I := by
      have hright : a 0 • f + a 2 • h ∈ I := by
        apply I.add_mem
        · rw [smul_eq_C_mul]
          exact I.mul_mem_left _ (Ideal.subset_span (by simp))
        · rw [smul_eq_C_mul]
          exact I.mul_mem_left _ (Ideal.subset_span (by simp))
      have heq : a 1 • g = -(a 0 • f + a 2 • h) := by
        linear_combination hsum'
      rw [heq]
      exact I.neg_mem hright
    have heq : g = (a 1)⁻¹ • (a 1 • g) := by
      calc
        g = 1 • g := (one_smul K g).symm
        _ = ((a 1)⁻¹ * a 1) • g := by rw [inv_mul_cancel₀ ha1]
        _ = (a 1)⁻¹ • (a 1 • g) := (smul_smul _ _ _).symm
    rw [heq, smul_eq_C_mul]
    exact I.mul_mem_left _ hmem
  have ha2 : a 2 = 0 := by
    by_contra ha2
    apply hh
    let I : Ideal (MvPolynomial σ K) := Ideal.span ({f, g} : Set _)
    have hmem : a 2 • h ∈ I := by
      have hright : a 0 • f + a 1 • g ∈ I := by
        apply I.add_mem
        · rw [smul_eq_C_mul]
          exact I.mul_mem_left _ (Ideal.subset_span (by simp))
        · rw [smul_eq_C_mul]
          exact I.mul_mem_left _ (Ideal.subset_span (by simp))
      have heq : a 2 • h = -(a 0 • f + a 1 • g) := by
        linear_combination hsum'
      rw [heq]
      exact I.neg_mem hright
    have heq : h = (a 2)⁻¹ • (a 2 • h) := by
      calc
        h = 1 • h := (one_smul K h).symm
        _ = ((a 2)⁻¹ * a 2) • h := by rw [inv_mul_cancel₀ ha2]
        _ = (a 2)⁻¹ • (a 2 • h) := (smul_smul _ _ _).symm
    rw [heq, smul_eq_C_mul]
    exact I.mul_mem_left _ hmem
  fin_cases i <;> assumption

/-- On every nonempty finite chart, the three dehomogenized quadrics are
linearly independent over the ground field. -/
theorem tripleCompleteIntersection_dehomogenized_linearIndependent_of_finite
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (j : Fin 4)
    (hproper : tripleCompleteIntersectionDehomogenizedIdeal p q r j ≠ ⊤) :
    LinearIndependent K ![coordinateOneEvaluation j p, coordinateOneEvaluation j q,
      coordinateOneEvaluation j r] := by
  obtain ⟨h₁, h₂, h₃⟩ :=
    tripleCompleteIntersection_dehomogenized_generators_minimal_of_finite
      p q r hp hq hr j hproper
  exact triple_linearIndependent_of_generators_minimal _ _ _ h₁ h₂ h₃

/-- The finite projective net itself consists of three linearly independent
quadrics whenever one of its affine charts is nonempty. -/
theorem tripleCompleteIntersection_linearIndependent_of_finite
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (j : Fin 4)
    (hproper : tripleCompleteIntersectionDehomogenizedIdeal p q r j ≠ ⊤) :
    LinearIndependent K ![p, q, r] := by
  have hlocal := tripleCompleteIntersection_dehomogenized_linearIndependent_of_finite
    p q r hp hq hr j hproper
  rw [Fintype.linearIndependent_iff]
  intro a hsum i
  rw [Fin.sum_univ_three] at hsum
  have hsum'' : a 0 • p + a 1 • q + a 2 • r = 0 := by
    simpa using hsum
  have hsum' := congrArg (coordinateOneEvaluation j) hsum''
  apply (Fintype.linearIndependent_iff.mp hlocal) a
  rw [Fin.sum_univ_three]
  simpa using hsum'

/-- A finite nonempty projective net of three quadrics is linearly
independent, with the nonempty affine chart selected automatically. -/
theorem tripleCompleteIntersection_linearIndependent_of_finite_of_nonempty
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))]
    (hX : Nonempty (scheme (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))) :
    LinearIndependent K ![p, q, r] := by
  obtain ⟨j, hj⟩ :=
    exists_tripleCompleteIntersection_dehomogenized_proper_of_nonempty p q r hp hq hr hX
  exact tripleCompleteIntersection_linearIndependent_of_finite p q r hp hq hr j hj

end

end PfaffianDescent
