import PfaffianDescent.AmbientPointKoszulBasisCharts

/-! # The actual point and augmentation of an invertible coordinate basis -/

noncomputable section
open AlgebraicGeometry CategoryTheory HomogeneousLocalization MvPolynomial
open AllCharacteristics.HomogeneousProjective

namespace PfaffianDescent
universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra
local notation "PS" => homogeneousSubmodule (Fin 4) K

set_option backward.isDefEq.respectTransparency false in
theorem ambientPointKoszul_basisChartEquiv_base
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) (j : Fin 4) (a : K) :
    ambientPointKoszul_basisChartEquiv M hM j
      (AllCharacteristics.GradedChart.baseMap PS (z := X j) a) =
    AllCharacteristics.GradedChart.baseMap PS (z := (ambientPointKoszul_basis M j).val) a := by
  apply val_injective
  change Localization.mk (linearSubstitution M (algebraMap K (MvPolynomial (Fin 4) K) a))
      ⟨ambientPointKoszul_basisGradedHom M 1, _⟩ =
    Localization.mk (algebraMap K (MvPolynomial (Fin 4) K) a) 1
  rw [AlgHom.commutes]
  exact congrArg (Localization.mk (algebraMap K (MvPolynomial (Fin 4) K) a))
    (Subtype.ext (map_one (ambientPointKoszul_basisGradedHom M)))

/-- The actual restriction on the point-containing basis chart, obtained
by transporting the standard affine origin. -/
def ambientPointKoszul_basisChartMap
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    Away PS (ambientPointKoszul_basis M 0).val →+* K :=
  (ambientPointKoszul_chartMap K).comp
    (ambientPointKoszul_basisChartEquiv M hM 0).symm.toRingHom

set_option backward.isDefEq.respectTransparency false in
theorem ambientPointKoszul_basisChartMap_base
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) (a : K) :
    ambientPointKoszul_basisChartMap M hM
      (AllCharacteristics.GradedChart.baseMap PS (z := (ambientPointKoszul_basis M 0).val) a) = a := by
  have h := ambientPointKoszul_basisChartEquiv_base M hM 0 a
  change ambientPointKoszul_chartMap K
    ((ambientPointKoszul_basisChartEquiv M hM 0).symm _) = a
  rw [← h, RingEquiv.symm_apply_apply]
  exact ambientPointKoszul_chartMap_base K a

set_option backward.isDefEq.respectTransparency false in
theorem ambientPointKoszul_basisChartMap_coordinate
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) (i : Fin 4) :
    ambientPointKoszul_basisChartMap M hM
      (ambientPointKoszul_basisChartCoordinate M 0 i) = ambientPointKoszul_vector K i := by
  change ambientPointKoszul_chartMap K
    ((ambientPointKoszul_basisChartEquiv M hM 0).symm _) = _
  rw [← ambientPointKoszul_basisChartEquiv_coordinate M hM 0 i, RingEquiv.symm_apply_apply]
  exact ambientPointKoszul_chartMap_coordinate K i

theorem ambientPointKoszul_basisChartMap_surjective
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    Function.Surjective (ambientPointKoszul_basisChartMap M hM) :=
  fun a => ⟨_, ambientPointKoszul_basisChartMap_base M hM a⟩

set_option backward.isDefEq.respectTransparency false in
/-- The actual point ideal in its basis chart is generated by the three
normalized basis coordinates. -/
theorem ambientPointKoszul_basisChartMap_ker
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    RingHom.ker (ambientPointKoszul_basisChartMap M hM) =
      Ideal.span {ambientPointKoszul_basisChartCoordinate M 0 1,
        ambientPointKoszul_basisChartCoordinate M 0 2,
        ambientPointKoszul_basisChartCoordinate M 0 3} := by
  let e := ambientPointKoszul_basisChartEquiv M hM 0
  have hmap : (RingHom.ker (ambientPointKoszul_chartMap K)).map e.toRingHom =
      Ideal.span {ambientPointKoszul_basisChartCoordinate M 0 1,
        ambientPointKoszul_basisChartCoordinate M 0 2,
        ambientPointKoszul_basisChartCoordinate M 0 3} := by
    have h := congrArg (fun I => I.map e.toRingHom) (ambientPointKoszul_chartMap_ker K)
    simp only [e, Ideal.map_span, Set.image_insert_eq, Set.image_singleton,
      RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      ambientPointKoszul_basisChartEquiv_coordinate] at h
    exact h
  exact (Ideal.map_comap_of_equiv e).symm.trans hmap

/-- The actual ambient rational point where the basis values are `[1,0,0,0]`. -/
def ambientPointKoszul_basisPoint
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) : Spec (.of K) ⟶ Proj PS :=
  Spec.map (CommRingCat.ofHom (ambientPointKoszul_basisChartMap M hM)) ≫
    Proj.awayι PS (ambientPointKoszul_basis M 0).val
      (ambientPointKoszul_basis M 0).property (by decide : 0 < 1)

set_option backward.isDefEq.respectTransparency false in
theorem ambientPointKoszul_basisPoint_toBase
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    ambientPointKoszul_basisPoint M hM ≫ ambientToBase = 𝟙 (Spec (.of K)) := by
  unfold ambientPointKoszul_basisPoint ambientToBase
  rw [Category.assoc, ← Category.assoc
    (Proj.awayι PS (ambientPointKoszul_basis M 0).val
      (ambientPointKoszul_basis M 0).property (by decide : 0 < 1)),
    Proj.awayι_toSpecZero, ← Spec.map_comp, ← Spec.map_comp]
  have h : (ambientPointKoszul_basisChartMap M hM).comp
      (AllCharacteristics.GradedChart.baseMap PS (z := (ambientPointKoszul_basis M 0).val)) =
        RingHom.id K := by
    ext a
    exact ambientPointKoszul_basisChartMap_base M hM a
  change Spec.map (CommRingCat.ofHom ((ambientPointKoszul_basisChartMap M hM).comp
    (AllCharacteristics.GradedChart.baseMap PS (z := (ambientPointKoszul_basis M 0).val)))) = _
  rw [h]
  exact Spec.map_id _

instance ambientPointKoszul_basisPoint_isClosedImmersion
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    IsClosedImmersion (ambientPointKoszul_basisPoint M hM) :=
  isClosedImmersion_of_comp_eq_id ambientToBase (ambientPointKoszul_basisPoint M hM)
    (ambientPointKoszul_basisPoint_toBase M hM)

theorem ambientPointKoszul_basisPoint_mem_basicOpen
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) (k : Spec (.of K)) :
    ambientPointKoszul_basisPoint M hM k ∈ Proj.basicOpen PS (ambientPointKoszul_basis M 0).val := by
  rw [← Proj.opensRange_awayι PS (ambientPointKoszul_basis M 0).val
    (ambientPointKoszul_basis M 0).property (by decide : 0 < 1)]
  exact ⟨_, rfl⟩

abbrev ambientPointKoszul_basisPointModule
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) : (Proj PS).Modules :=
  (Scheme.Modules.pushforward (ambientPointKoszul_basisPoint M hM)).obj
    (SheafOfModules.unit (Spec (.of K)).ringCatSheaf)

/-- The actual closed-immersion augmentation at the basis point. -/
def ambientPointKoszul_basisAugmentation
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    SheafOfModules.unit (Proj PS).ringCatSheaf ⟶ ambientPointKoszul_basisPointModule M hM :=
  IdealSheafDataModule.closedImmersionUnitToPushforwardUnit (ambientPointKoszul_basisPoint M hM)

instance ambientPointKoszul_basisAugmentation_epi
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det) :
    Epi (ambientPointKoszul_basisAugmentation M hM) := by
  unfold ambientPointKoszul_basisAugmentation
  infer_instance

end PfaffianDescent
