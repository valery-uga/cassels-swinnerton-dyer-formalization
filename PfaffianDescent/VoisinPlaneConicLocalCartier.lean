import PfaffianDescent.VoisinPlaneConicActualImmersion
import Mathlib.Algebra.MvPolynomial.PDeriv

/-!
# Local Cartier algebra for a plane conic on a cubic

The standard coordinate charts of a smooth cubic need not make either
coefficient in `p = ell * a + q * b` globally invertible. At a local point,
however, the smoothness calculation is expected to show that the four
values `ell, q, a, b` cannot all lie in the maximal ideal. The lemmas below
turn that local unit cover into a regular-principal equation for the conic
ideal, including the complementary opens where `ell` or `q` is a unit.
-/

namespace PfaffianDescent

universe u

open MvPolynomial

/-- Every partial derivative of `p = ell * a + q * b` lies in the ideal
generated by the conic equations and their cubic coefficients. Thus a
Jacobian unit-ideal certificate on the cubic implies that these four
functions cover the cubic by principal opens. -/
theorem cubic_pderiv_mem_planeConic_coefficientIdeal
    {K : Type u} [Field K]
    (p ell q a b : MvPolynomial (Fin 4) K)
    (h : p = ell * a + q * b) (i : Fin 4) :
    pderiv i p ∈ Ideal.span
      ({ell, q, a, b} : Set (MvPolynomial (Fin 4) K)) := by
  let J : Ideal (MvPolynomial (Fin 4) K) := Ideal.span ({ell, q, a, b} : Set _)
  have hell : ell ∈ J := Ideal.subset_span (by simp)
  have hq : q ∈ J := Ideal.subset_span (by simp)
  have ha : a ∈ J := Ideal.subset_span (by simp)
  have hb : b ∈ J := Ideal.subset_span (by simp)
  rw [h]
  simp only [map_add, pderiv_mul]
  exact J.add_mem
    (J.add_mem (J.mul_mem_left (pderiv i ell) ha)
      (J.mul_mem_right (pderiv i a) hell))
    (J.add_mem (J.mul_mem_left (pderiv i q) hb)
      (J.mul_mem_right (pderiv i b) hq))

/-- If the images of the four partial derivatives generate the unit ideal,
then the images of the conic equations and cubic coefficients do as well.
This is the exact algebraic implication needed to pass from a Jacobian
smoothness certificate to the four principal-open cover. -/
theorem planeConic_coefficientIdeal_top_of_jacobian_top
    {K : Type u} [Field K] {A : Type u} [CommRing A]
    (p ell q a b : MvPolynomial (Fin 4) K)
    (h : p = ell * a + q * b)
    (φ : MvPolynomial (Fin 4) K →+* A)
    (hjac : Ideal.span
      (Set.range (fun i : Fin 4 => φ (pderiv i p))) = ⊤) :
    Ideal.span ({φ ell, φ q, φ a, φ b} : Set A) = ⊤ := by
  let J : Ideal (MvPolynomial (Fin 4) K) := Ideal.span ({ell, q, a, b} : Set _)
  let L : Ideal A := Ideal.span ({φ ell, φ q, φ a, φ b} : Set A)
  have hmap : J.map φ = L := by
    simp only [J, L, Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  have hderiv (i : Fin 4) : φ (pderiv i p) ∈ L := by
    rw [← hmap]
    exact Ideal.mem_map_of_mem φ
      (cubic_pderiv_mem_planeConic_coefficientIdeal p ell q a b h i)
  have hle : Ideal.span
      (Set.range (fun i : Fin 4 => φ (pderiv i p))) ≤ L := by
    apply Ideal.span_le.mpr
    rintro x ⟨i, rfl⟩
    exact hderiv i
  exact top_unique (hjac ▸ hle)

/-- A four-term unit-ideal certificate gives a unit among the four elements
in a local ring. This is the algebraic form of the desired principal-open
cover. -/
theorem local_four_generator_unit_cover
    {A : Type u} [CommRing A] [IsLocalRing A]
    (ell q a b u v w t : A)
    (h : ell * u + (q * v + (a * w + b * t)) = 1) :
    IsUnit ell ∨ IsUnit q ∨ IsUnit a ∨ IsUnit b := by
  have hfirst : IsUnit (ell * u + (q * v + (a * w + b * t))) := by
    rw [h]
    exact isUnit_one
  rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hfirst with h₁ | hrest
  · exact Or.inl (IsUnit.mul_iff.mp h₁).1
  rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hrest with h₂ | hrest
  · exact Or.inr (Or.inl (IsUnit.mul_iff.mp h₂).1)
  rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hrest with h₃ | h₄
  · exact Or.inr (Or.inr (Or.inl (IsUnit.mul_iff.mp h₃).1))
  · exact Or.inr (Or.inr (Or.inr (IsUnit.mul_iff.mp h₄).1))

/-- The same unit-cover conclusion from the intrinsic statement that the
four displayed sections generate the unit ideal. -/
theorem local_four_generator_unit_cover_of_span_top
    {A : Type u} [CommRing A] [IsLocalRing A]
    (ell q a b : A)
    (hcover : Ideal.span ({ell, q, a, b} : Set A) = ⊤) :
    IsUnit ell ∨ IsUnit q ∨ IsUnit a ∨ IsUnit b := by
  classical
  by_cases hell : IsUnit ell
  · exact Or.inl hell
  by_cases hq : IsUnit q
  · exact Or.inr (Or.inl hq)
  by_cases ha : IsUnit a
  · exact Or.inr (Or.inr (Or.inl ha))
  by_cases hb : IsUnit b
  · exact Or.inr (Or.inr (Or.inr hb))
  have hle : Ideal.span ({ell, q, a, b} : Set A) ≤
      IsLocalRing.maximalIdeal A := by
    apply Ideal.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact (IsLocalRing.mem_maximalIdeal _).mpr hell
    · exact (IsLocalRing.mem_maximalIdeal _).mpr hq
    · exact (IsLocalRing.mem_maximalIdeal _).mpr ha
    · exact (IsLocalRing.mem_maximalIdeal _).mpr hb
  have htop : (⊤ : Ideal A) ≤ IsLocalRing.maximalIdeal A := by
    simpa only [hcover] using hle
  exact False.elim ((IsLocalRing.maximalIdeal.isMaximal A).1.1 (top_unique htop))

/-- If at least one of the four natural principal opens contains a point,
the plane-conic ideal has a regular principal equation there. The domain
and nonzero-ideal assumptions guarantee that the chosen equation is a
non-zero-divisor. -/
theorem conicIdeal_regularPrincipal_of_unit_cover
    {A : Type u} [CommRing A] [IsDomain A]
    (ell q a b : A)
    (h : ell * a + q * b = 0)
    (hnonzero : ell ≠ 0 ∨ q ≠ 0)
    (hunit : IsUnit ell ∨ IsUnit q ∨ IsUnit a ∨ IsUnit b) :
    ∃ z : A, IsRegular z ∧
      Ideal.span ({ell, q} : Set A) = Ideal.span ({z} : Set A) := by
  rcases hunit with hellUnit | hqUnit | haUnit | hbUnit
  · refine ⟨1, isRegular_one, ?_⟩
    have htop : Ideal.span ({ell, q} : Set A) = ⊤ := by
      apply top_unique
      rw [← Ideal.span_singleton_eq_top.mpr hellUnit]
      exact Ideal.span_mono (by simp)
    simpa only [htop, Ideal.span_singleton_one]
  · refine ⟨1, isRegular_one, ?_⟩
    have htop : Ideal.span ({ell, q} : Set A) = ⊤ := by
      apply top_unique
      rw [← Ideal.span_singleton_eq_top.mpr hqUnit]
      exact Ideal.span_mono (by simp)
    simpa only [htop, Ideal.span_singleton_one]
  · have hqne : q ≠ 0 := by
      intro hqzero
      have hellzero : ell = 0 := by
        have heq : ell * a = 0 := by simpa [hqzero] using h
        exact (mul_eq_zero.mp heq).resolve_right haUnit.ne_zero
      exact hnonzero.elim (fun hellne => hellne hellzero)
        (fun hqne => hqne hqzero)
    exact ⟨q, IsRegular.of_ne_zero' hqne,
      conicIdeal_eq_span_quadratic_of_unit_linear_coefficient
        ell q a b h haUnit⟩
  · have hellne : ell ≠ 0 := by
      intro hellzero
      have hqzero : q = 0 := by
        have heq : q * b = 0 := by simpa [hellzero] using h
        exact (mul_eq_zero.mp heq).resolve_right hbUnit.ne_zero
      exact hnonzero.elim (fun hellne => hellne hellzero)
        (fun hqne => hqne hqzero)
    exact ⟨ell, IsRegular.of_ne_zero' hellne,
      conicIdeal_eq_span_linear_of_unit_quadratic_coefficient
        ell q a b h hbUnit⟩

/-- In a local domain, a unit-ideal witness for the four values gives a
regular principal generator of the conic ideal. -/
theorem conicIdeal_regularPrincipal_of_local_unimodular
    {A : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    (ell q a b u v w t : A)
    (h : ell * a + q * b = 0)
    (hnonzero : ell ≠ 0 ∨ q ≠ 0)
    (hcover : ell * u + (q * v + (a * w + b * t)) = 1) :
    ∃ z : A, IsRegular z ∧
      Ideal.span ({ell, q} : Set A) = Ideal.span ({z} : Set A) :=
  conicIdeal_regularPrincipal_of_unit_cover ell q a b h hnonzero
    (local_four_generator_unit_cover ell q a b u v w t hcover)

/-- Local Cartier criterion stated directly as generation of the unit
ideal, with no choice of a Bézout witness. -/
theorem conicIdeal_regularPrincipal_of_local_span_top
    {A : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    (ell q a b : A)
    (h : ell * a + q * b = 0)
    (hnonzero : ell ≠ 0 ∨ q ≠ 0)
    (hcover : Ideal.span ({ell, q, a, b} : Set A) = ⊤) :
    ∃ z : A, IsRegular z ∧
      Ideal.span ({ell, q} : Set A) = Ideal.span ({z} : Set A) :=
  conicIdeal_regularPrincipal_of_unit_cover ell q a b h hnonzero
    (local_four_generator_unit_cover_of_span_top ell q a b hcover)

/-- Local Cartier equation for a conic on a cubic from an explicit
Jacobian unit-ideal certificate. It applies to a local chart or stalk map
`φ` and uses the actual images of the two homogeneous conic equations. -/
theorem planeConic_localCartier_of_jacobian_top
    {K : Type u} [Field K] {A : Type u}
    [CommRing A] [IsDomain A] [IsLocalRing A]
    (p ell q a b : MvPolynomial (Fin 4) K)
    (h : p = ell * a + q * b)
    (φ : MvPolynomial (Fin 4) K →+* A)
    (hpzero : φ p = 0)
    (hnonzero : φ ell ≠ 0 ∨ φ q ≠ 0)
    (hjac : Ideal.span
      (Set.range (fun i : Fin 4 => φ (pderiv i p))) = ⊤) :
    ∃ z : A, IsRegular z ∧
      Ideal.span ({φ ell, φ q} : Set A) = Ideal.span ({z} : Set A) := by
  have hrel : φ ell * φ a + φ q * φ b = 0 := by
    rw [h, map_add, map_mul, map_mul] at hpzero
    exact hpzero
  exact conicIdeal_regularPrincipal_of_local_span_top
    (φ ell) (φ q) (φ a) (φ b) hrel hnonzero
    (planeConic_coefficientIdeal_top_of_jacobian_top
      p ell q a b h φ hjac)

end PfaffianDescent
