import PfaffianDescent.VoisinProjectiveCubicCohomology
import AllCharacteristics.HomogeneousProjectiveAmbient

/-!
# Stalk exactness for a projective hypersurface restriction sequence

This file proves the local algebra behind the identification of the cokernel
of multiplication by a homogeneous equation with the pushed-forward
structure sheaf of the corresponding projective hypersurface.
-/

noncomputable section

namespace PfaffianDescent

open scoped DirectSum Pointwise
open DirectSum SetLike Localization
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopCat
  TopologicalSpace
open AllCharacteristics AllCharacteristics.HomogeneousProjective

universe u

namespace ProjectiveNegativeTwist

attribute [local instance] MvPolynomial.gradedAlgebra

variable {K : Type u} {σ : Type} [Field K]
local notation "𝒜" => MvPolynomial.homogeneousSubmodule σ K

set_option backward.isDefEq.respectTransparency.types false in
/-- A homogeneous local-ring fraction whose numerator contains a factor
annihilated by a graded map maps to zero. -/
theorem localRingHom_eq_zero_of_val_eq_algebraMap_mul
    {C τ : Type*} [CommRing C] [SetLike τ C] [AddSubgroupClass τ C]
    (ℭ : ℕ → τ) [GradedRing ℭ]
    (f : 𝒜 →+*ᵍ ℭ) (P : Ideal (MvPolynomial σ K)) [P.IsPrime]
    (Q : Ideal C) [Q.IsPrime] (hPQ : P = Ideal.comap f Q)
    (a : MvPolynomial σ K) (ha : f a = 0)
    (z : HomogeneousLocalization.AtPrime 𝒜 P)
    (w : Localization P.primeCompl)
    (hz : z.val = algebraMap (MvPolynomial σ K)
      (Localization P.primeCompl) a * w) :
    HomogeneousLocalization.localRingHom f P Q hPQ z = 0 := by
  apply HomogeneousLocalization.val_injective Q.primeCompl
  rw [HomogeneousLocalization.val_localRingHom, hz, map_mul]
  have hmapA :
      Localization.localRingHom P Q f hPQ
        (algebraMap (MvPolynomial σ K) (Localization P.primeCompl) a) = 0 := by
    rw [← Localization.mk_one_eq_algebraMap]
    simp only [Localization.localRingHom_mk,
      GradedRingHom.toRingHom_eq_toRingHom, GradedRingHom.coe_toRingHom,
      ha, Localization.mk_zero]
  rw [hmapA, zero_mul]
  exact HomogeneousLocalization.val_zero.symm

set_option backward.isDefEq.respectTransparency.types false in
/-- Over a domain, vanishing of a homogeneous fraction after a local-ring
map forces its homogeneous numerator to vanish under the graded map. -/
theorem map_num_eq_zero_of_localRingHom_mk_eq_zero
    {C τ : Type*} [CommRing C] [IsDomain C]
    [SetLike τ C] [AddSubgroupClass τ C]
    (ℭ : ℕ → τ) [GradedRing ℭ]
    (f : 𝒜 →+*ᵍ ℭ) (P : Ideal (MvPolynomial σ K)) [P.IsPrime]
    (Q : Ideal C) [Q.IsPrime] (hPQ : P = Ideal.comap f Q)
    (c : HomogeneousLocalization.NumDenSameDeg 𝒜 P.primeCompl)
    (hzero : HomogeneousLocalization.localRingHom f P Q hPQ
      (HomogeneousLocalization.mk c) = 0) :
    f c.num = 0 := by
  have hval := congrArg HomogeneousLocalization.val hzero
  rw [HomogeneousLocalization.val_localRingHom,
    HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero,
    Localization.localRingHom_mk, Localization.mk_eq_mk'] at hval
  obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hval
  have hmne : (m : C) ≠ 0 := by
    intro hm0
    exact m.2 (hm0 ▸ Q.zero_mem)
  exact (mul_eq_zero.mp hm).resolve_left hmne

/-- If a homogeneous element belongs to the principal ideal generated by a
homogeneous element, then its quotient can be chosen in the complementary
degree. If the generator's degree is too large, the element is zero. -/
theorem homogeneous_mem_span_singleton_factor
    {i d : ℕ} (p : 𝒜 d) (a : 𝒜 i)
    (ha : (a : MvPolynomial σ K) ∈
      Ideal.span ({(p : MvPolynomial σ K)} : Set _)) :
    (d ≤ i → ∃ c : 𝒜 (i - d), (p : MvPolynomial σ K) * c = a) ∧
      (¬ d ≤ i → (a : MvPolynomial σ K) = 0) := by
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp ha
  constructor
  · intro hdi
    refine ⟨DirectSum.decompose 𝒜 r (i - d), ?_⟩
    rw [← DirectSum.coe_decompose_mul_of_left_mem_of_le 𝒜 p.2 hdi]
    rw [← hr]
    exact DirectSum.decompose_of_mem_same 𝒜 a.2
  · intro hdi
    rw [← DirectSum.decompose_of_mem_same 𝒜 a.2, hr]
    exact DirectSum.coe_decompose_mul_of_left_mem_of_not_le 𝒜 p.2 hdi

/-- At a point of a projective hypersurface whose homogeneous coordinate
ring is a domain, the kernel of the ambient-to-hypersurface local-ring map is
exactly the image of multiplication by the defining equation from
`O(-d)`. -/
theorem hypersurface_localRing_exact
    (p : MvPolynomial σ K) {d : ℕ} (hp : p.IsHomogeneous d)
    [IsDomain (CoordinateRing (equationIdeal p hp))]
    (y : ProjectiveSpectrum (grading (equationIdeal p hp))) :
    let I := equationIdeal p hp
    let ℬ := grading I
    let q := quotientGradedRingHom I
    let x := ProjectiveSpectrum.comap q
      (irrelevant_le_map_quotientGradedRingHom I) y
    Function.Exact
      (fun z : stalkSubmodule 𝒜 x.asHomogeneousIdeal.toIdeal (0 + d) =>
        (atPrimeLinearEquivZeroTwistStalk 𝒜 x.asHomogeneousIdeal.toIdeal).symm
          (mulHomogeneousStalk 𝒜 x.asHomogeneousIdeal.toIdeal ⟨p, hp⟩ 0 z))
      (HomogeneousLocalization.localRingHom q
        x.asHomogeneousIdeal.toIdeal y.asHomogeneousIdeal.toIdeal rfl) := by
  dsimp only
  let I := equationIdeal p hp
  let ℬ := grading I
  let q := quotientGradedRingHom I
  let x := ProjectiveSpectrum.comap q
    (irrelevant_le_map_quotientGradedRingHom I) y
  letI : y.asHomogeneousIdeal.toIdeal.IsPrime := y.isPrime
  letI : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
  let F := fun z : stalkSubmodule 𝒜 x.asHomogeneousIdeal.toIdeal (0 + d) =>
    (atPrimeLinearEquivZeroTwistStalk 𝒜 x.asHomogeneousIdeal.toIdeal).symm
      (mulHomogeneousStalk 𝒜 x.asHomogeneousIdeal.toIdeal ⟨p, hp⟩ 0 z)
  let G := HomogeneousLocalization.localRingHom q
    x.asHomogeneousIdeal.toIdeal y.asHomogeneousIdeal.toIdeal rfl
  change Function.Exact F G
  intro z
  constructor
  · intro hz
    obtain ⟨c, hc⟩ := HomogeneousLocalization.mk_surjective z
    have hzc : G (HomogeneousLocalization.mk c) = 0 := by
      rw [hc]
      exact hz
    have hqnum : q c.num = 0 :=
      map_num_eq_zero_of_localRingHom_mk_eq_zero ℬ q
        x.asHomogeneousIdeal.toIdeal y.asHomogeneousIdeal.toIdeal rfl c hzc
    have hmem : (c.num : MvPolynomial σ K) ∈
        Ideal.span ({p} : Set (MvPolynomial σ K)) :=
      Ideal.Quotient.eq_zero_iff_mem.mp hqnum
    have hfactor := homogeneous_mem_span_singleton_factor
      ⟨p, hp⟩ c.num hmem
    by_cases hdi : d ≤ c.deg
    · obtain ⟨a, ha⟩ := hfactor.1 hdi
      let den : 𝒜 ((c.deg - d) + (0 + d)) := ⟨c.den, by
        simpa [Nat.sub_add_cancel hdi] using c.den_mem_deg⟩
      have hden : (den : MvPolynomial σ K) ∈
          x.asHomogeneousIdeal.toIdeal.primeCompl := by
        simpa [den] using c.den_mem
      let w : stalkSubmodule 𝒜 x.asHomogeneousIdeal.toIdeal (0 + d) :=
        ⟨Localization.mk (a : MvPolynomial σ K)
            ⟨(den : MvPolynomial σ K), hden⟩,
          Or.inr ⟨c.deg - d, a, den, hden, rfl⟩⟩
      refine ⟨w, ?_⟩
      rw [← hc]
      let e := atPrimeLinearEquivZeroTwistStalk 𝒜
        x.asHomogeneousIdeal.toIdeal
      apply e.injective
      rw [e.apply_symm_apply]
      apply Subtype.ext
      change algebraMap (MvPolynomial σ K)
          (Localization x.asHomogeneousIdeal.toIdeal.primeCompl) p *
          Localization.mk (a : MvPolynomial σ K)
            ⟨(den : MvPolynomial σ K), hden⟩ =
        (HomogeneousLocalization.mk c).val
      rw [HomogeneousLocalization.val_mk,
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul]
      rw [ha]
      congr 1
      apply Subtype.ext
      simp [den]
    · have hnum : (c.num : MvPolynomial σ K) = 0 := hfactor.2 hdi
      refine ⟨0, ?_⟩
      rw [← hc]
      let e := atPrimeLinearEquivZeroTwistStalk 𝒜
        x.asHomogeneousIdeal.toIdeal
      apply e.injective
      dsimp only [F]
      rw [e.apply_symm_apply, map_zero]
      apply Subtype.ext
      change (0 : Localization x.asHomogeneousIdeal.toIdeal.primeCompl) =
        (HomogeneousLocalization.mk c).val
      rw [HomogeneousLocalization.val_mk, hnum, Localization.mk_zero]
  · intro hzrange
    obtain ⟨w, hw⟩ := hzrange
    have hwzero : G (F w) = 0 := by
      let e := atPrimeLinearEquivZeroTwistStalk 𝒜
        x.asHomogeneousIdeal.toIdeal
      let t := mulHomogeneousStalk 𝒜 x.asHomogeneousIdeal.toIdeal
        ⟨p, hp⟩ 0 w
      have hval : (e.symm t).val =
          algebraMap (MvPolynomial σ K)
            (Localization x.asHomogeneousIdeal.toIdeal.primeCompl) p * w.1 := by
        have h := congrArg Subtype.val (e.apply_symm_apply t)
        exact h
      have hpzero : q p = 0 := by
        exact Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.subset_span (Set.mem_singleton p))
      exact localRingHom_eq_zero_of_val_eq_algebraMap_mul ℬ q
        x.asHomogeneousIdeal.toIdeal y.asHomogeneousIdeal.toIdeal rfl
        p hpzero (e.symm t) w.1 hval
    exact (congrArg G hw).symm.trans hwzero

end ProjectiveNegativeTwist

end PfaffianDescent
