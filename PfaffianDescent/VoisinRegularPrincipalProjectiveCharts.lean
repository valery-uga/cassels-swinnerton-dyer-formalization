import PfaffianDescent.VoisinLocalPointIntersectionFlat

/-!
# Regular principal presentations of projective intersections

The inverse image of a standard chart under a homogeneous quotient is the
corresponding quotient chart (`isPullback_schemeQuotientMap_chart`).  This
predicate records the extra Cartier condition: the chart quotient kernel
is generated by a non-zero-divisor.  It is stated for the actual projective
closed immersion `schemeQuotientMap`, rather than only for its equation.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial
open AllCharacteristics.HomogeneousProjective
open AllCharacteristics.UniversalHomogeneous

universe u
attribute [local instance] MvPolynomial.gradedAlgebra

/-- A homogeneous quotient immersion has a regular principal equation on
each of its standard affine charts. -/
def HasRegularPrincipalStandardCharts
    {R : Type u} {σ : Type} [CommRing R]
    (I J : HomogeneousIdeal (homogeneousSubmodule σ R))
    (hIJ : I.toIdeal ≤ J.toIdeal) : Prop :=
  ∀ j : σ, ∃ x : ChartRing I j,
    IsRegular x ∧
      RingHom.ker (chartQuotientMap I J hIJ j) =
        Ideal.span ({x} : Set (ChartRing I j))

/-- The regular-principal chart is the actual inverse-image chart of the
projective closed immersion. -/
theorem HasRegularPrincipalStandardCharts.chartPullback
    {R : Type u} {σ : Type} [CommRing R]
    {I J : HomogeneousIdeal (homogeneousSubmodule σ R)}
    {hIJ : I.toIdeal ≤ J.toIdeal}
    (H : HasRegularPrincipalStandardCharts I J hIJ) (j : σ) :
    IsPullback
      (Spec.map (CommRingCat.ofHom (chartQuotientMap I J hIJ j)))
      (chartι J j) (chartι I j) (schemeQuotientMap I J hIJ) ∧
    ∃ x : ChartRing I j,
      IsRegular x ∧
        RingHom.ker (chartQuotientMap I J hIJ j) =
          Ideal.span ({x} : Set (ChartRing I j)) :=
  ⟨isPullback_schemeQuotientMap_chart I J hIJ j, H j⟩

/-- A closed immersion presented on an affine open cover by surjections
whose kernels are generated by non-zero-divisors. This is the scheme-level
effective-Cartier condition needed here, stated directly because Mathlib
has no effective-Cartier-divisor structure for schemes. -/
structure RegularPrincipalImmersion
    {X Z : Scheme.{u}} (f : Z ⟶ X) where
  Index : Type
  A : Index → CommRingCat.{u}
  B : Index → CommRingCat.{u}
  target : ∀ j, Spec (A j) ⟶ X
  source : ∀ j, Spec (B j) ⟶ Z
  ringMap : ∀ j, A j ⟶ B j
  ringMap_surjective : ∀ j, Function.Surjective (ringMap j).hom
  targetOpen : ∀ j, IsOpenImmersion (target j)
  cover : ∀ x : X, ∃ j, ∃ y : Spec (A j), target j y = x
  cartesian : ∀ j,
    IsPullback (Spec.map (ringMap j)) (source j) (target j) f
  principal : ∀ j, ∃ x : A j,
    IsRegular x ∧ RingHom.ker (ringMap j).hom =
      Ideal.span ({x} : Set (A j))

/-- Regular-principal standard charts give a genuine scheme-level local
presentation of the homogeneous quotient immersion. -/
noncomputable def HasRegularPrincipalStandardCharts.toImmersion
    {R : Type u} {σ : Type} [CommRing R]
    {I J : HomogeneousIdeal (homogeneousSubmodule σ R)}
    {hIJ : I.toIdeal ≤ J.toIdeal}
    (H : HasRegularPrincipalStandardCharts I J hIJ) :
    RegularPrincipalImmersion (schemeQuotientMap I J hIJ) where
  Index := σ
  A j := .of (ChartRing I j)
  B j := .of (ChartRing J j)
  target j := chartι I j
  source j := chartι J j
  ringMap j := CommRingCat.ofHom (chartQuotientMap I J hIJ j)
  ringMap_surjective j := chartQuotientMap_surjective I J hIJ j
  targetOpen j := inferInstance
  cover x := exists_coordinate_chart I x
  cartesian j := isPullback_schemeQuotientMap_chart I J hIJ j
  principal j := H j

/-- A regular-principal immersion is invariant under isomorphisms of both
its source and its target. -/
noncomputable def RegularPrincipalImmersion.ofIso
    {X Z X' Z' : Scheme.{u}} {f : Z ⟶ X} {f' : Z' ⟶ X'}
    (H : RegularPrincipalImmersion f)
    (eX : X' ≅ X) (eZ : Z' ≅ Z)
    (h : eZ.hom ≫ f = f' ≫ eX.hom) :
    RegularPrincipalImmersion f' where
  Index := H.Index
  A := H.A
  B := H.B
  target j := H.target j ≫ eX.inv
  source j := H.source j ≫ eZ.inv
  ringMap := H.ringMap
  ringMap_surjective := H.ringMap_surjective
  targetOpen j := by
    letI : IsOpenImmersion (H.target j) := H.targetOpen j
    exact IsOpenImmersion.comp (H.target j) eX.inv
  cover x := by
    obtain ⟨j, y, hy⟩ := H.cover (eX.hom x)
    refine ⟨j, y, ?_⟩
    change eX.inv (H.target j y) = x
    rw [hy]
    change (eX.hom ≫ eX.inv) x = x
    rw [eX.hom_inv_id]
    rfl
  cartesian j := by
    apply (H.cartesian j).of_iso'
      (Iso.refl _) (Iso.refl _) eZ eX
    · simp
    · simp
    · simp
    · exact h
  principal j := H.principal j

/-- The intersection of the fixed cubic with a cubic regular on its
residue-field coordinate ring has a regular-principal projective closed
immersion over the whole local parameter ring. -/
theorem fixedCubicIntersection_hasRegularPrincipalStandardCharts
    {K T : Type u} [Field K] [CommRing T] [Algebra K T]
    [IsLocalRing T]
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3)
    (p : MvPolynomial (Fin 4) T) (hp : p.IsHomogeneous 3)
    (hreg : IsRegular (Ideal.Quotient.mk
      (equationIdeal (a.map (algebraMap K (IsLocalRing.ResidueField T)))
        (ha.map (algebraMap K (IsLocalRing.ResidueField T)))).toIdeal
      (p.map (algebraMap T (IsLocalRing.ResidueField T))))) :
    let J := equationIdeal (a.map (algebraMap K T))
      (ha.map (algebraMap K T))
    HasRegularPrincipalStandardCharts J (J ⊔ equationIdeal p hp)
      (by rw [HomogeneousIdeal.toIdeal_sup]; exact le_sup_left) := by
  dsimp only [HasRegularPrincipalStandardCharts]
  intro i
  let J := equationIdeal (a.map (algebraMap K T))
    (ha.map (algebraMap K T))
  let x := p.eval₂ (chartBaseMap J i) (chartCoordinate J i)
  exact ⟨x, fixedCubicIntersectionChart_regular_principalKernel_of_residue_regular
    a ha p hp hreg i⟩

/-- Every local point of Voisin's nontrivial moving-equation family has
an actual projective intersection whose closed immersion into the fixed
cubic has regular principal standard charts. -/
theorem flatGradedNontrivialOpen_localPoint_hasRegularPrincipalStandardCharts
    {K R T : Type u} [Field K] [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [Algebra K R]
    [CommRing T] [IsLocalRing T] [Algebra R T]
    [Algebra K T] [IsScalarTower K R T]
    (J : HomogeneousIdeal (homogeneousSubmodule (Fin 4) R))
    [Module.Flat R (CoordinateRing J)]
    (r q : ℕ) (e : Fin (r + q) ≃ Monomials (Fin 4) 3)
    (hRank : ∀ x : PrimeSpectrum R,
      Module.rankAtStalk (grading J 3) x = q)
    (a : MvPolynomial (Fin 4) K) (ha : a.IsHomogeneous 3) (ha0 : a ≠ 0)
    [Smooth (hypersurfaceToBase
      (a.map (algebraMap K (IsLocalRing.ResidueField T)))
      (ha.map (algebraMap K (IsLocalRing.ResidueField T))))]
    (n : Spec (.of T) ⟶
      flatGradedProjectiveFamilyNontrivialOpen J r q e hRank a ha ha0)
    (hn : n ≫ flatGradedProjectiveFamilyNontrivialOpenToBase
        J r q e hRank a ha ha0 =
      Spec.map (CommRingCat.ofHom (algebraMap R T))) :
    ∃ (j : Monomials (Fin 4) 3)
      (f : ParameterChartRing K (Fin 4) 3 j →+* T),
      Spec.map (CommRingCat.ofHom f) ≫ parameterChartι K (Fin 4) 3 j =
        n ≫ flatGradedNontrivialOpenToGlobalParameters
          a ha J r q e hRank ha0 ∧
      let p := (normalizedForm K (Fin 4) 3 j).map f
      let hp := (normalizedForm_isHomogeneous K (Fin 4) 3 j).map f
      let Jₐ := equationIdeal (a.map (algebraMap K T))
        (ha.map (algebraMap K T))
      HasRegularPrincipalStandardCharts Jₐ (Jₐ ⊔ equationIdeal p hp)
        (by rw [HomogeneousIdeal.toIdeal_sup]; exact le_sup_left) := by
  obtain ⟨j, f, hf, hcharts⟩ :=
    flatGradedNontrivialOpen_localPoint_intersectionCharts_regular_principalKernel
      J r q e hRank a ha ha0 n hn
  refine ⟨j, f, hf, ?_⟩
  dsimp only [HasRegularPrincipalStandardCharts]
  intro i
  let p := (normalizedForm K (Fin 4) 3 j).map f
  let Jₐ := equationIdeal (a.map (algebraMap K T))
    (ha.map (algebraMap K T))
  let x := p.eval₂ (chartBaseMap Jₐ i) (chartCoordinate Jₐ i)
  exact ⟨x, hcharts i⟩

end PfaffianDescent
