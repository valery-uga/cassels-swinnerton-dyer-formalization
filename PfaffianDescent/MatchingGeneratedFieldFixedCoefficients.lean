import PfaffianDescent.GaloisPairQuadraticCoefficientField

/-! SOURCE ONLY, UNVERIFIED. Exact fixed-coefficient criterion for the
field GENERATED by the actual edge-sum coordinates. This prepares descent
of the actual line projector; no projector invariance is assumed here. -/
noncomputable section
namespace PfaffianDescent
universe u v
variable {k K : Type u} [Field k] [Field K] [Algebra k K] [IsGalois k K]

theorem generatedCoordinateField_fixingSubgroup_iff
    {J : Type v} (x : J → K) (g : K ≃ₐ[k] K) :
    g ∈ (IntermediateField.adjoin k (Set.range x)).fixingSubgroup ↔
      ∀ i, g (x i) = x i := by
  constructor
  · intro h i
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp h (x i)
      (IntermediateField.subset_adjoin k _ ⟨i, rfl⟩)
  · intro h
    apply (IntermediateField.mem_fixingSubgroup_iff _ _).mpr
    intro z hz
    apply IntermediateField.adjoin_induction k (p := fun z _ => g z = z)
      (fun z hz => by obtain ⟨i, rfl⟩ := hz; exact h i)
      (fun c => g.commutes c)
      (fun z w _ _ hz hw => by rw [map_add, hz, hw])
      (fun z _ hz => by rw [map_inv₀, hz])
      (fun z w _ _ hz hw => by rw [map_mul, hz, hw]) hz

/-- To define a projector entry over the actual quadratic field, it is
ENOUGH to prove its invariance under the actual edge stabilizer. The equality
of generated/fixed fields is proved internally by infinite Galois theory. -/
theorem mem_generatedCoordinateField_iff_fixed_by_coordinate_stabilizer
    {J : Type v} (x : J → K) (z : K) :
    z ∈ IntermediateField.adjoin k (Set.range x) ↔
      ∀ g : K ≃ₐ[k] K, (∀ i, g (x i) = x i) → g z = z := by
  rw [← InfiniteGalois.fixedField_fixingSubgroup
    (IntermediateField.adjoin k (Set.range x))]
  rw [IntermediateField.mem_fixedField_iff]
  constructor
  · intro h g hg
    exact h g ((generatedCoordinateField_fixingSubgroup_iff x g).mpr hg)
  · intro h g hg
    exact h g ((generatedCoordinateField_fixingSubgroup_iff x g).mp hg)

end PfaffianDescent
