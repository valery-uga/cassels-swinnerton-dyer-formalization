import PfaffianDescent.CorayOriginalCubicThirdCoordinateAlgebraicity

/-! Exact original-coordinate generation closes the algebraicity and
transcendence-degree join. SOURCE ONLY / UNCOMPILED. -/
noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics.HomogeneousProjective
open scoped IntermediateField.algebraAdjoinAdjoin
universe u v

/-- A field generated by the given tuple is algebraic over the field of
its remaining coordinates when the removed coordinate is algebraic.
The whole-field conclusion is derived by field-adjoin induction. -/
theorem coordinateGeneratedField_isAlgebraic_of_removedCoordinate
    {K F : Type u} {σ : Type v} [Field K] [Field F] [Algebra K F]
    (x : σ → F) (t : σ)
    (hgen : IntermediateField.adjoin K (Set.range x) = ⊤)
    (ht : IsAlgebraic (IntermediateField.adjoin K
      (Set.range (fun i : {i : σ // i ≠ t} => x i.1))) (x t)) :
    Algebra.IsAlgebraic (IntermediateField.adjoin K
      (Set.range (fun i : {i : σ // i ≠ t} => x i.1))) F := by
  classical
  let E := IntermediateField.adjoin K
    (Set.range (fun i : {i : σ // i ≠ t} => x i.1))
  have hx : ∀ i, IsAlgebraic E (x i) := by
    intro i
    by_cases hi : i = t
    · simpa only [hi] using ht
    · exact isAlgebraic_algebraMap (⟨x i,
        IntermediateField.subset_adjoin K _ ⟨⟨i, hi⟩, rfl⟩⟩ : E)
  refine ⟨fun z => ?_⟩
  have hz : z ∈ IntermediateField.adjoin K (Set.range x) := by rw [hgen]; trivial
  exact IntermediateField.adjoin_induction K
    (p := fun z _ => IsAlgebraic E z)
    (fun z hz => by obtain ⟨i, rfl⟩ := hz; exact hx i)
    (fun c => isAlgebraic_algebraMap
      (⟨algebraMap K F c, E.algebraMap_mem c⟩ : E))
    (fun _ _ _ _ hz hw => hz.add hw)
    (fun _ _ hz => hz.inv)
    (fun _ _ _ _ hz hw => hz.mul hw) hz

/-- Coordinate generation and the constructed algebraicity witness make
the independent remaining family a genuine transcendence basis. -/
theorem coordinateGeneratedField_trdeg_eq_remainingCard
    {K F : Type u} {σ : Type} [Field K] [Field F] [Algebra K F]
    (x : σ → F) (t : σ)
    (hgen : IntermediateField.adjoin K (Set.range x) = ⊤)
    (hx : AlgebraicIndependent K (fun i : {i : σ // i ≠ t} => x i.1))
    (ht : IsAlgebraic (IntermediateField.adjoin K
      (Set.range (fun i : {i : σ // i ≠ t} => x i.1))) (x t)) :
    Algebra.trdeg K F = Cardinal.lift.{u} (Cardinal.mk {i : σ // i ≠ t}) := by
  have halg := coordinateGeneratedField_isAlgebraic_of_removedCoordinate x t hgen ht
  have halg' : Algebra.IsAlgebraic (Algebra.adjoin K
      (Set.range (fun i : {i : σ // i ≠ t} => x i.1))) F :=
    IntermediateField.isAlgebraic_adjoin_iff_top.mp halg
  have hb : IsTranscendenceBasis K (fun i : {i : σ // i ≠ t} => x i.1) :=
    hx.isTranscendenceBasis_iff_isAlgebraic.mpr halg'
  simpa only [Cardinal.lift_id'] using hb.lift_cardinalMk_eq_trdeg.symm

attribute [local instance] MvPolynomial.gradedAlgebra
section ActualOriginalChart
variable {K : Type u} [Field K]
variable (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
  [IsIntegral (hypersurface p hp)] (j : Fin 4)
  [hchart : Nonempty (chartι (equationIdeal p hp) j).opensRange]

/-- Dropping the chart coordinate equal to one preserves actual original
field generation. The accepted four-coordinate theorem is used literally. -/
theorem cubicOriginalReducedChartGenericCoordinates_adjoin_eq_top :
    letI : Algebra K (hypersurface p hp).functionField :=
      (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
    IntermediateField.adjoin K
      (Set.range (cubicOriginalReducedChartGenericCoordinates p hp j)) = ⊤ := by
  classical
  letI : Algebra K (hypersurface p hp).functionField :=
    (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
  let g := @affineChartGenericEvaluation
    (ChartRing (equationIdeal p hp) j)
    (inferInstance : CommRing (ChartRing (equationIdeal p hp) j))
    (hypersurface p hp) (inferInstance : IsIntegral (hypersurface p hp))
    (chartι (equationIdeal p hp) j)
    (isOpenImmersion_chartι (equationIdeal p hp) j)
    (inferInstance : Nonempty (chartι (equationIdeal p hp) j).opensRange)
  let E := IntermediateField.adjoin K
    (Set.range (cubicOriginalReducedChartGenericCoordinates p hp j))
  have hgen := cubicOriginalChartGenericCoordinates_adjoin_eq_top p hp j
  have hle : IntermediateField.adjoin K
      (Set.range (fun i : Fin 4 => g (chartCoordinate (equationIdeal p hp) j i))) ≤ E := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨i, rfl⟩
    by_cases hi : i = j
    · subst i
      change g (chartCoordinate (equationIdeal p hp) j j) ∈ E
      rw [chartCoordinate_self, map_one]
      exact E.one_mem
    · exact IntermediateField.subset_adjoin K _ ⟨⟨i, hi⟩, rfl⟩
  change E = ⊤
  apply top_unique
  exact hgen ▸ hle

include j hchart in
/-- ORIGINAL cubic function-field transcendence degree is exactly two,
with its literal original-K coefficient hom. The upper bound comes from
an actual cubic relation and internally constructed algebraicity. -/
theorem cubicOriginalFunctionField_trdeg_eq_two (hp0 : p ≠ 0) :
    letI : Algebra K (hypersurface p hp).functionField :=
      (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
    Algebra.trdeg K (hypersurface p hp).functionField = 2 := by
  letI : Algebra K (hypersurface p hp).functionField :=
    (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
  obtain ⟨t, hcard, hind, halg⟩ :=
    cubicOriginalChart_exists_two_independent_and_algebraic_third p hp j hp0
  have h := coordinateGeneratedField_trdeg_eq_remainingCard
    (cubicOriginalReducedChartGenericCoordinates p hp j) t
    (cubicOriginalReducedChartGenericCoordinates_adjoin_eq_top p hp j) hind halg
  simpa only [Cardinal.mk_fintype, hcard, Cardinal.lift_natCast, Cardinal.lift_ofNat, Nat.cast_ofNat] using h

end ActualOriginalChart
end PfaffianDescent.Coray
end
