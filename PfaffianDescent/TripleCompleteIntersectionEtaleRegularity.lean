import PfaffianDescent.TripleQuadricsFiniteCodimension
import PfaffianDescent.TripleQuadricsGlobalThirdRegularity
import PfaffianDescent.VoisinSectionChoice
import Mathlib.AlgebraicGeometry.ZariskisMainTheorem
import Mathlib.RingTheory.Unramified.LocalStructure

/-!
# Regularity forced by an étale projective complete intersection

An étale projective triple complete intersection over a field is finite.  If
it is nonempty, its three defining forms are linearly independent.  For three
forms of the same degree this implies that the third form is outside the ideal
generated by the first two.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics HomogeneousProjective

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-- A proper étale morphism is finite.  Mathlib supplies the ring-level fact
that an essentially finite-type formally unramified algebra is quasi-finite;
this wrapper applies it on affine charts and then uses Zariski's main
theorem. -/
theorem isFinite_of_isProper_of_etale
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] [Etale f] : IsFinite f := by
  letI : LocallyQuasiFinite f := by
    constructor
    intro U hU V hV e
    let g : Γ(Y, U) →+* Γ(X, V) := (f.appLE U V e).hom
    have hg : g.Etale := f.etale_appLE hU hV e
    algebraize [g]
    haveI : Algebra.Etale _ _ := hg
    change Algebra.QuasiFinite _ _
    infer_instance
  exact IsFinite.of_isProper_of_locallyQuasiFinite f

/-- If a nonempty projective triple intersection of three same-degree forms
is étale over the ground field, then the third form does not lie in the ideal
generated by the first two. -/
theorem tripleCompleteIntersection_third_not_mem_span_pair_of_etale_of_nonempty
    {K : Type u} [Field K] [Infinite K]
    (p q r : MvPolynomial (Fin 4) K) {d : ℕ}
    (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous d) (hr : r.IsHomogeneous d)
    (hetale : Etale (toBase
      (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr)))
    (hX : Nonempty
      (scheme (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))) :
    r ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  letI : Etale (toBase I) := hetale
  letI : IsProper (toBase I) := by infer_instance
  letI : IsFinite (toBase I) := isFinite_of_isProper_of_etale (toBase I)
  have hli : LinearIndependent K ![p, q, r] :=
    tripleCompleteIntersection_linearIndependent_of_finite_of_nonempty
      p q r hp hq hr hX
  intro hrmem
  obtain ⟨a, b, hab⟩ := homogeneous_mem_span_pair_eq_span_smul hp hq hr hrmem
  have hsum : ∑ i, (![(-a), (-b), 1] : Fin 3 → K) i •
      (![p, q, r] : Fin 3 → MvPolynomial (Fin 4) K) i = 0 := by
    rw [Fin.sum_univ_three]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two]
    change (-a) • p + (-b) • q + (1 : K) • r = 0
    rw [neg_smul, neg_smul, one_smul, ← neg_add, hab, neg_add_cancel]
  have hcoeff := (Fintype.linearIndependent_iff.mp hli)
    (![(-a), (-b), 1] : Fin 3 → K) hsum 2
  simpa using hcoeff

/-- In a nonempty étale projective intersection of three homogeneous forms,
the third form is a non-zero-divisor modulo the first two. The first and third
degrees are positive; the three degrees need not be equal. -/
theorem tripleCompleteIntersection_third_regular_of_etale_of_nonempty_degrees
    {K : Type u} [Field K]
    (p q r : MvPolynomial (Fin 4) K) {a b c : ℕ}
    (hp : p.IsHomogeneous a) (hq : q.IsHomogeneous b) (hr : r.IsHomogeneous c)
    (ha : 0 < a) (hc : 0 < c)
    (hetale : Etale (toBase
      (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr)))
    (hX : Nonempty
      (scheme (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr)))
    (F : MvPolynomial (Fin 4) K)
    (hF : r * F ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))) :
    F ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  letI : Etale (toBase I) := hetale
  letI : IsProper (toBase I) := by infer_instance
  letI : IsFinite (toBase I) := isFinite_of_isProper_of_etale (toBase I)
  exact third_regular_of_finite_degrees p q r hp hq hr ha hc hX F hF

/-- Equal-degree specialization used by the cubic restriction-kernel
construction. -/
theorem tripleCompleteIntersection_third_regular_of_etale_of_nonempty
    {K : Type u} [Field K]
    (p q r : MvPolynomial (Fin 4) K) {d : ℕ}
    (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous d) (hr : r.IsHomogeneous d)
    (hd : 0 < d)
    (hetale : Etale (toBase
      (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr)))
    (hX : Nonempty
      (scheme (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr)))
    (F : MvPolynomial (Fin 4) K)
    (hF : r * F ∈ Ideal.span ({p,q} : Set (MvPolynomial (Fin 4) K))) :
    F ∈ Ideal.span ({p,q} : Set (MvPolynomial (Fin 4) K)) :=
  tripleCompleteIntersection_third_regular_of_etale_of_nonempty_degrees
    p q r hp hq hr hd hd hetale hX F hF

end PfaffianDescent
