import Mathlib.FieldTheory.Galois.GaloisClosure
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Projective

/-!
# Finite Galois coordinate fields inside a Galois extension

A finite family of coefficients in any Galois extension lies in a finite
Galois intermediate field.  This version is independent of perfectness and
is used when the coefficients lie in the separable closure of the ground
field.
-/

namespace PfaffianDescent.QuarticNet

open Matrix
open scoped MatrixGroups

universe u v

variable {K : Type u} {E : Type v} [Field K] [Field E] [Algebra K E] [IsGalois K E]

/-- The finite Galois intermediate field generated by a finite family of
coordinates in a Galois extension. -/
noncomputable abbrev finiteGaloisCoordinateFieldIn {ι : Type*} [Fintype ι]
    (z : ι → E) :=
  IntermediateField.normalClosure K
    (IntermediateField.adjoin K (Set.range z)) E

instance finiteGaloisCoordinateFieldIn_finiteDimensional {ι : Type*} [Fintype ι]
    (z : ι → E) :
    FiniteDimensional K (finiteGaloisCoordinateFieldIn (K := K) z) := by
  letI : FiniteDimensional K (IntermediateField.adjoin K (Set.range z)) :=
    IntermediateField.finiteDimensional_adjoin (fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic x).isIntegral)
  exact normalClosure.is_finiteDimensional K
    (IntermediateField.adjoin K (Set.range z)) E

instance finiteGaloisCoordinateFieldIn_isGalois {ι : Type*} [Fintype ι]
    (z : ι → E) :
    IsGalois K (finiteGaloisCoordinateFieldIn (K := K) z) := ⟨⟩

/-- The given coordinates, viewed inside their finite Galois coordinate
field. -/
noncomputable def finiteGaloisCoordinateLiftIn {ι : Type*} [Fintype ι]
    (z : ι → E) :
    ι → finiteGaloisCoordinateFieldIn (K := K) z := fun i =>
  ⟨z i, IntermediateField.le_normalClosure _
    ((IntermediateField.subset_adjoin K (Set.range z)) (Set.mem_range_self i))⟩

@[simp] theorem finiteGaloisCoordinateLiftIn_coe {ι : Type*} [Fintype ι]
    (z : ι → E) (i : ι) :
    ((finiteGaloisCoordinateLiftIn (K := K) z i :
      finiteGaloisCoordinateFieldIn (K := K) z) : E) = z i := by
  simp [finiteGaloisCoordinateLiftIn]

/-- The finite Galois coordinate field contains every prescribed coefficient. -/
theorem finiteGaloisCoordinateFieldIn_spec {ι : Type*} [Fintype ι]
    (z : ι → E) :
    FiniteDimensional K (finiteGaloisCoordinateFieldIn (K := K) z) ∧
      IsGalois K (finiteGaloisCoordinateFieldIn (K := K) z) ∧
      ∀ i, ∃ zi : finiteGaloisCoordinateFieldIn (K := K) z, (zi : E) = z i :=
  ⟨inferInstance, inferInstance, fun i =>
    ⟨finiteGaloisCoordinateLiftIn (K := K) z i,
      finiteGaloisCoordinateLiftIn_coe (K := K) z i⟩⟩

/-- The finite Galois coordinate field generated by all entries of a matrix
over a Galois extension. -/
noncomputable abbrev finiteGaloisMatrixFieldIn {n : ℕ}
    (X : Matrix (Fin n) (Fin n) E) :=
  finiteGaloisCoordinateFieldIn (K := K) (fun ij : Fin n × Fin n => X ij.1 ij.2)

/-- Entrywise lifting of a matrix to the finite Galois field generated by its
entries. -/
noncomputable def finiteGaloisMatrixLiftIn {n : ℕ}
    (X : Matrix (Fin n) (Fin n) E) :
    Matrix (Fin n) (Fin n) (finiteGaloisMatrixFieldIn (K := K) X) := fun i j =>
  finiteGaloisCoordinateLiftIn (K := K)
    (fun ij : Fin n × Fin n => X ij.1 ij.2) (i, j)

@[simp] theorem finiteGaloisMatrixLiftIn_map {n : ℕ}
    (X : Matrix (Fin n) (Fin n) E) :
    (finiteGaloisMatrixLiftIn (K := K) X).map
      (algebraMap (finiteGaloisMatrixFieldIn (K := K) X) E) = X := by
  ext i j
  exact finiteGaloisCoordinateLiftIn_coe (K := K)
    (fun ij : Fin n × Fin n => X ij.1 ij.2) (i, j)

/-- An invertible matrix over a Galois extension is already defined over the
finite Galois field generated by its entries. -/
noncomputable def finiteGaloisGLLiftIn {n : ℕ}
    (X : GL (Fin n) E) :
    GL (Fin n) (finiteGaloisMatrixFieldIn (K := K)
      (X : Matrix (Fin n) (Fin n) E)) :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero
    (finiteGaloisMatrixLiftIn (K := K) (X : Matrix (Fin n) (Fin n) E)) (by
      intro hzero
      have hdetzero : (X : Matrix (Fin n) (Fin n) E).det = 0 := by
        calc
          (X : Matrix (Fin n) (Fin n) E).det =
              ((finiteGaloisMatrixLiftIn (K := K)
                (X : Matrix (Fin n) (Fin n) E)).map
                  (algebraMap (finiteGaloisMatrixFieldIn (K := K)
                    (X : Matrix (Fin n) (Fin n) E)) E)).det := by
                rw [finiteGaloisMatrixLiftIn_map]
          _ = algebraMap (finiteGaloisMatrixFieldIn (K := K)
                (X : Matrix (Fin n) (Fin n) E)) E
              (finiteGaloisMatrixLiftIn (K := K)
                (X : Matrix (Fin n) (Fin n) E)).det :=
                (RingHom.map_det _ _).symm
          _ = 0 := by rw [hzero, map_zero]
      apply Units.ne_zero X.det
      rw [Matrix.GeneralLinearGroup.val_det_apply]
      exact hdetzero)

@[simp] theorem finiteGaloisGLLiftIn_map {n : ℕ}
    (X : GL (Fin n) E) :
    Matrix.GeneralLinearGroup.map
      (algebraMap (finiteGaloisMatrixFieldIn (K := K)
        (X : Matrix (Fin n) (Fin n) E)) E)
      (finiteGaloisGLLiftIn (K := K) X) = X := by
  apply Units.ext
  change (finiteGaloisMatrixLiftIn (K := K) (X : Matrix (Fin n) (Fin n) E)).map
      (algebraMap (finiteGaloisMatrixFieldIn (K := K)
        (X : Matrix (Fin n) (Fin n) E)) E) =
        (X : Matrix (Fin n) (Fin n) E)
  apply finiteGaloisMatrixLiftIn_map

end PfaffianDescent.QuarticNet
