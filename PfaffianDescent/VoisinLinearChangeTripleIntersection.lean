import PfaffianDescent.ProjectiveLinearCoordinateSchemeIso
import PfaffianDescent.TripleCompleteIntersectionHilbert

/-!
# Cubic--two-quadric intersections under projective coordinate change

Linear substitution carries the three-generator homogeneous ideal to the
ideal generated by the substituted equations.  The resulting projective
scheme isomorphism is over the coefficient field, so finiteness and
étaleness transport to the changed intersection.
-/

namespace PfaffianDescent

open MvPolynomial AlgebraicGeometry CategoryTheory
open AllCharacteristics.HomogeneousProjective

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

/-- Linear substitution carries a three-generator ideal to the ideal
generated by the three substituted polynomials. -/
theorem tripleCompleteIntersectionIdeal_map_linearSubstitution
    {K : Type u} [Field K]
    (M : Matrix (Fin 4) (Fin 4) K) (p q r : MvPolynomial (Fin 4) K) :
    (tripleCompleteIntersectionIdeal p q r).map
      (linearSubstitution M).toRingHom =
      tripleCompleteIntersectionIdeal (linearSubstitution M p)
        (linearSubstitution M q) (linearSubstitution M r) := by
  rw [tripleCompleteIntersectionIdeal, Ideal.map_span]
  congr 1
  ext z
  constructor
  · rintro ⟨w, (rfl | rfl | rfl), rfl⟩
    · simp
    · simp
    · simp
  · simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rintro (rfl | rfl | rfl)
    · exact ⟨p, by simp, rfl⟩
    · exact ⟨q, by simp, rfl⟩
    · exact ⟨r, by simp, rfl⟩

/-- Finiteness over the coefficient field is invariant under an invertible
linear projective coordinate change. -/
theorem linearCoordinateChange_isFinite
    {K : Type u} [Field K]
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det)
    (I J : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (hIJ : J.toIdeal = I.toIdeal.map (linearSubstitutionEquiv M hM).toRingHom)
    (hfinite : IsFinite (toBase I)) : IsFinite (toBase J) := by
  let e := linearCoordinateChangeSchemeIso M hM I J hIJ
  have hb : e.hom ≫ toBase J = toBase I :=
    linearCoordinateChangeSchemeIso_hom_toBase M hM I J hIJ
  have hinv : e.inv ≫ toBase I = toBase J := by
    rw [← hb, ← Category.assoc, e.inv_hom_id, Category.id_comp]
  haveI : IsFinite (toBase I) := hfinite
  haveI : IsFinite e.inv := inferInstance
  haveI : IsFinite (e.inv ≫ toBase I) := inferInstance
  rw [← hinv]
  infer_instance

/-- Étaleness over the coefficient field is invariant under an invertible
linear projective coordinate change. -/
theorem linearCoordinateChange_etale
    {K : Type u} [Field K]
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det)
    (I J : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (hIJ : J.toIdeal = I.toIdeal.map (linearSubstitutionEquiv M hM).toRingHom)
    (hEtale : Etale (toBase I)) : Etale (toBase J) := by
  let e := linearCoordinateChangeSchemeIso M hM I J hIJ
  have hb : e.hom ≫ toBase J = toBase I :=
    linearCoordinateChangeSchemeIso_hom_toBase M hM I J hIJ
  have hinv : e.inv ≫ toBase I = toBase J := by
    rw [← hb, ← Category.assoc, e.inv_hom_id, Category.id_comp]
  haveI : Etale (toBase I) := hEtale
  haveI : Etale e.inv := inferInstance
  haveI : Etale (e.inv ≫ toBase I) := inferInstance
  rw [← hinv]
  infer_instance

/-- An invertible substitution preserves finiteness of a cubic--two-quadric
complete intersection. -/
theorem tripleCompleteIntersection_isFinite_linearSubstitution
    {K : Type u} [Field K]
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det)
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (hr : r.IsHomogeneous 2)
    (hfinite : IsFinite (toBase
      (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))) :
    IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal
      (linearSubstitution M p) (linearSubstitution M q)
      (linearSubstitution M r)
      (linearSubstitution_homogeneous M hp)
      (linearSubstitution_homogeneous M hq)
      (linearSubstitution_homogeneous M hr))) := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  let J := tripleCompleteIntersectionHomogeneousIdeal
    (linearSubstitution M p) (linearSubstitution M q)
    (linearSubstitution M r)
    (linearSubstitution_homogeneous M hp)
    (linearSubstitution_homogeneous M hq)
    (linearSubstitution_homogeneous M hr)
  have hIJ : J.toIdeal = I.toIdeal.map
      (linearSubstitutionEquiv M hM).toRingHom := by
    change tripleCompleteIntersectionIdeal
      (linearSubstitution M p) (linearSubstitution M q)
        (linearSubstitution M r) =
      (tripleCompleteIntersectionIdeal p q r).map
        (linearSubstitutionEquiv M hM).toRingHom
    have hE : (linearSubstitutionEquiv M hM).toRingHom =
        (linearSubstitution M).toRingHom := rfl
    rw [hE]
    exact (tripleCompleteIntersectionIdeal_map_linearSubstitution M p q r).symm
  exact linearCoordinateChange_isFinite M hM I J hIJ hfinite

/-- An invertible substitution preserves étaleness of a cubic--two-quadric
complete intersection. -/
theorem tripleCompleteIntersection_etale_linearSubstitution
    {K : Type u} [Field K]
    (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det)
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (hr : r.IsHomogeneous 2)
    (hEtale : Etale (toBase
      (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr))) :
    Etale (toBase (tripleCompleteIntersectionHomogeneousIdeal
      (linearSubstitution M p) (linearSubstitution M q)
      (linearSubstitution M r)
      (linearSubstitution_homogeneous M hp)
      (linearSubstitution_homogeneous M hq)
      (linearSubstitution_homogeneous M hr))) := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  let J := tripleCompleteIntersectionHomogeneousIdeal
    (linearSubstitution M p) (linearSubstitution M q)
    (linearSubstitution M r)
    (linearSubstitution_homogeneous M hp)
    (linearSubstitution_homogeneous M hq)
    (linearSubstitution_homogeneous M hr)
  have hIJ : J.toIdeal = I.toIdeal.map
      (linearSubstitutionEquiv M hM).toRingHom := by
    change tripleCompleteIntersectionIdeal
      (linearSubstitution M p) (linearSubstitution M q)
        (linearSubstitution M r) =
      (tripleCompleteIntersectionIdeal p q r).map
        (linearSubstitutionEquiv M hM).toRingHom
    have hE : (linearSubstitutionEquiv M hM).toRingHom =
        (linearSubstitution M).toRingHom := rfl
    rw [hE]
    exact (tripleCompleteIntersectionIdeal_map_linearSubstitution M p q r).symm
  exact linearCoordinateChange_etale M hM I J hIJ hEtale

end PfaffianDescent
