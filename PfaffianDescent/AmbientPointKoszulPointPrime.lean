import PfaffianDescent.AmbientPointKoszulUnitStalk

/-! # The affine prime and maximal ideal of the actual standard coordinate point -/

noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits HomogeneousLocalization MvPolynomial
open AllCharacteristics.HomogeneousProjective

namespace PfaffianDescent

universe u
variable (K : Type u) [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra
local notation "PS" => homogeneousSubmodule (Fin 4) K

set_option backward.isDefEq.respectTransparency false in
private theorem chartIso_hom_base (j : Fin 4) :
    (Proj.basicOpenIsoSpec PS (X j) (isHomogeneous_X K j) (by decide : 0 < 1)).hom.base =
      (ProjectiveSpectrum.Proj.toSpec PS (X j)).base := by
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- The actual point, read in its native standard chart, is the prime
obtained from the actual chart-evaluation homomorphism. -/
theorem ambientPointKoszul_point_chart_coordinate (k : Spec (.of K)) :
    (ProjectiveSpectrum.Proj.toSpec PS (X (0 : Fin 4))).base
      ⟨ambientPointKoszul_point K k, ambientPointKoszul_point_mem_basicOpen K k⟩ =
    (Spec.map (CommRingCat.ofHom (ambientPointKoszul_chartMap K))) k := by
  let e := Proj.basicOpenIsoSpec PS (X (0 : Fin 4))
    (isHomogeneous_X K 0) (by decide : 0 < 1)
  let q := (Spec.map (CommRingCat.ofHom (ambientPointKoszul_chartMap K))) k
  have hx : (⟨ambientPointKoszul_point K k, ambientPointKoszul_point_mem_basicOpen K k⟩ :
      Proj.basicOpen PS (X (0 : Fin 4))) = e.inv q := by
    apply Subtype.ext
    rfl
  rw [hx, ← chartIso_hom_base]
  exact ConcreteCategory.congr_hom
    (congrArg (fun f : Spec (.of (Away PS (X (0 : Fin 4)))) ⟶
      Spec (.of (Away PS (X (0 : Fin 4)))) => f.base) e.inv_hom_id) q

set_option backward.isDefEq.respectTransparency false in
/-- The actual point has the chart prime generated by the three normalized
coordinates, with no point-ideal identification premise. -/
theorem ambientPointKoszul_point_chartPrime (k : Spec (.of K)) :
    ((ProjectiveSpectrum.Proj.toSpec PS (X (0 : Fin 4))).base
      ⟨ambientPointKoszul_point K k, ambientPointKoszul_point_mem_basicOpen K k⟩).asIdeal =
      RingHom.ker (ambientPointKoszul_chartMap K) := by
  rw [ambientPointKoszul_point_chart_coordinate]
  change Ideal.comap (ambientPointKoszul_chartMap K) (k : PrimeSpectrum K).asIdeal = _
  have hk : (k : PrimeSpectrum K).asIdeal = ⊥ :=
    congrArg (fun p : PrimeSpectrum K => p.asIdeal)
      (Subsingleton.elim (k : PrimeSpectrum K) (⊥ : PrimeSpectrum K))
  rw [hk]
  rfl

namespace ProjectiveNegativeTwist

local instance ambientPointKoszul_pointPrime_prime (x : Proj PS) :
    (pointIdeal PS x).IsPrime := ProjectiveSpectrum.isPrime x

set_option backward.isDefEq.respectTransparency false in
/-- At the actual standard point, the three coefficients of the actual
last Koszul differential generate the native homogeneous maximal ideal. -/
theorem ambientPointKoszul_point_stalk_parameters_span_maximal
    (k : Spec (.of K)) :
    let x := ambientPointKoszul_point K k
    let hx : X (0 : Fin 4) ∈ (pointIdeal PS x).primeCompl :=
      ambientPointKoszul_point_mem_basicOpen K k
    Ideal.span {ambientPointKoszul_stalkParameter K 1 0 x hx,
      ambientPointKoszul_stalkParameter K 2 0 x hx,
      ambientPointKoszul_stalkParameter K 3 0 x hx} =
      IsLocalRing.maximalIdeal (AtPrime PS (pointIdeal PS x)) := by
  dsimp only
  let x := ambientPointKoszul_point K k
  let hx : X (0 : Fin 4) ∈ (pointIdeal PS x).primeCompl :=
    ambientPointKoszul_point_mem_basicOpen K k
  let R := Away PS (X (0 : Fin 4))
  let S := AtPrime PS (pointIdeal PS x)
  let p := ((ProjectiveSpectrum.Proj.toSpec PS (X (0 : Fin 4))).base ⟨x, hx⟩).asIdeal
  letI : Algebra R S := (ambientPointKoszul_chartToStalk K 0 x hx).toAlgebra
  letI : p.IsPrime := PrimeSpectrum.isPrime _
  letI : IsLocalization p.primeCompl S := ambientPointKoszul_chartToStalk_isLocalization K 0 x hx
  have hp : p = RingHom.ker (ambientPointKoszul_chartMap K) := ambientPointKoszul_point_chartPrime K k
  have hm := IsLocalization.AtPrime.map_eq_maximalIdeal p S
  rw [hp, ambientPointKoszul_chartMap_ker, Ideal.map_span] at hm
  change Ideal.span ((ambientPointKoszul_chartToStalk K 0 x hx) ''
    {ambientChartCoordinate (R := K) (σ := Fin 4) 0 1,
      ambientChartCoordinate (R := K) (σ := Fin 4) 0 2,
      ambientChartCoordinate (R := K) (σ := Fin 4) 0 3}) = _ at hm
  rw [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at hm
  simpa only [ambientPointKoszul_chartToStalk_coordinate] using hm

end ProjectiveNegativeTwist

end PfaffianDescent
