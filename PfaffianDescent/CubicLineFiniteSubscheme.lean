/-!
# Finite subschemes from cubic line intersections

The root algebra of a line section of a cubic is generated by the normalized
projective coordinates.  Consequently the line-section construction gives an
actual finite closed subscheme, not merely its fundamental zero-cycle.
-/

open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics
open AllCharacteristics.HomogeneousProjective
open PfaffianDescent

namespace PfaffianDescent

universe u
attribute [local instance] MvPolynomial.gradedAlgebra

/-- If one projective coordinate is the root parameter, the resulting
line-intersection coordinates generate the root algebra. -/
theorem eval₂_line_coordinate_surjective
    {K : Type u} [Field K] {n : ℕ} (F : Polynomial K) (i : Fin n)
    (x : Fin n → AdjoinRoot F) (hxi : x i = AdjoinRoot.root F) :
    Function.Surjective (eval₂Hom (algebraMap K (AdjoinRoot F)) x) := by
  intro a
  obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective a
  refine ⟨Polynomial.aeval (R := K) (MvPolynomial.X i) P, ?_⟩
  let e : MvPolynomial (Fin n) K →ₐ[K] AdjoinRoot F := MvPolynomial.aeval x
  have he : e.toRingHom = eval₂Hom (algebraMap K (AdjoinRoot F)) x := by
    apply RingHom.ext
    intro p
    exact (MvPolynomial.aeval_eq_eval₂Hom (f := x) p).symm
  rw [← he]
  have hcomp : e.comp (Polynomial.aeval (R := K) (MvPolynomial.X i)) =
      Polynomial.aeval (R := K) (AdjoinRoot.root F) := by
    apply Polynomial.algHom_ext'
    · ext
    · simp [e, hxi]
  calc
    e.toRingHom (Polynomial.aeval (R := K) (MvPolynomial.X i) P) =
        Polynomial.aeval (R := K) (AdjoinRoot.root F) P :=
      congrArg (fun h => h P) hcomp
    _ = AdjoinRoot.mk F P := AdjoinRoot.aeval_eq P

/-- A degree-one homogeneous polynomial evaluates linearly along an affine
line, after any extension of the coefficient ring. -/
theorem eval₂_homogeneous_degree_one_line
    {K A sigma : Type*} [CommRing K] [CommRing A]
    (f : K →+* A) (ell : MvPolynomial sigma K) (hell : ell.IsHomogeneous 1)
    (a b : sigma → K) (t : A) :
    ell.eval₂ f (t • (fun i ↦ f (a i)) + (fun i ↦ f (b i))) =
      t * f (ell.eval a) + f (ell.eval b) := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ (show ell ∈ Submodule.span K (Set.range X) by
    rw [← MvPolynomial.homogeneousSubmodule_one_eq_span_X]
    exact hell)
  · rintro x ⟨i, rfl⟩
    simp [Pi.smul_apply]
  · simp
  · intro x y hx hy hpx hpy
    rw [eval₂_add, hpx, hpy]
    simp only [map_add]
    ring
  · intro r x hx hpx
    simp only [smul_eq_C_mul, eval₂_mul, eval₂_C, hpx, eval_C, map_mul]
    ring

/-- A cubic line section whose leading endpoint does not lie on the cubic is
an embedded finite closed subscheme of rank three of the cubic hypersurface.
The root algebra is generated by its normalized projective coordinates. -/
theorem cubic_line_intersection_closed_immersion
    {K : Type u} [Field K] {n : ℕ} (i j : Fin n) (hij : i ≠ j)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3)
    (c : Cubic K n) (hc : c.toMvPolynomial = p)
    (hi : c.eval (Pi.single i 1) ≠ 0) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Module.Finite K A)
      (q : Spec (.of A) ⟶ hypersurface p hp),
      IsClosedImmersion q ∧
        q ≫ hypersurfaceToBase p hp = Spec.map (CommRingCat.ofHom (algebraMap K A)) ∧
        ∃ _ : IsFinite (q ≫ hypersurfaceToBase p hp),
          AllCharacteristics.finiteSchemeRank (q ≫ hypersurfaceToBase p hp) = 3 := by
  let a : Vec K n := Pi.single i 1
  let b : Vec K n := Pi.single j 1
  let F := AllCharacteristics.cubicLinePolynomial c a b
  have hd : F.natDegree = 3 := AllCharacteristics.cubicLinePolynomial_natDegree c a b hi
  have hF : F ≠ 0 := by
    intro h
    simp [h] at hd
  let A := AdjoinRoot F
  let pb := AdjoinRoot.powerBasis hF
  letI : Module.Finite K A := Module.Finite.of_basis pb.basis
  have hdim : Module.finrank K A = 3 := pb.finrank.trans hd
  let x : Fin n → A :=
    AdjoinRoot.root F • (fun l ↦ algebraMap K A (a l)) +
      (fun l ↦ algebraMap K A (b l))
  have hxj : x j = 1 := by
    simp [x, a, b, Pi.single_eq_of_ne hij.symm]
  have hxi : x i = AdjoinRoot.root F := by
    simp [x, a, b, Pi.single_eq_of_ne hij]
  have hcx : (c.map (algebraMap K A)).eval x = 0 := by
    rw [← AllCharacteristics.cubicLinePolynomial_eval₂ (algebraMap K A) c a b
      (AdjoinRoot.root F)]
    exact AdjoinRoot.eval₂_root F
  have hpx : p.eval₂ (algebraMap K A) x = 0 := by
    rw [← hc, Cubic.eval_toMvPolynomial]
    exact hcx
  let I := equationIdeal p hp
  have hI : ∀ r ∈ I.toIdeal, r.eval₂ (algebraMap K A) x = 0 := by
    have hle : I.toIdeal ≤ RingHom.ker (eval₂Hom (algebraMap K A) x) := by
      apply Ideal.span_le.mpr
      intro r hr
      have hr' : r = p := Set.mem_singleton_iff.mp hr
      subst r
      exact hpx
    intro r hr
    exact hle hr
  obtain ⟨q, hq, hqbase⟩ := closed_point_of_normalized_coordinates I x j hxj hI
    (eval₂_line_coordinate_surjective F i x hxi)
  let q' : Spec (.of A) ⟶ hypersurface p hp := q
  have hq' : IsClosedImmersion q' := by
    change IsClosedImmersion q
    exact hq
  have hq'base : q' ≫ hypersurfaceToBase p hp =
      Spec.map (CommRingCat.ofHom (algebraMap K A)) := by
    change q ≫ toBase (equationIdeal p hp) = _
    exact hqbase
  have hqfinite : IsFinite (q' ≫ hypersurfaceToBase p hp) := by
    rw [hq'base]
    exact (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  letI : IsFinite (q' ≫ hypersurfaceToBase p hp) := hqfinite
  refine ⟨A, inferInstance, inferInstance, inferInstance, q', hq', hq'base, hqfinite, ?_⟩
  rw [AllCharacteristics.finiteSchemeRank_eq_finrank, hq'base,
    Scheme.Hom.finrank_SpecMap_algebraMap]
  exact (congrFun (Module.rankAtStalk_eq_finrank_of_free (R := K) (M := A)) _).trans hdim

/-- The same line-section construction supplies an actual ideal-defined
finite flat subscheme of constant rank three. -/
theorem cubic_line_intersection_finite_subscheme
    {K : Type u} [Field K] {n : ℕ} (i j : Fin n) (hij : i ≠ j)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3)
    (c : Cubic K n) (hc : c.toMvPolynomial = p)
    (hi : c.eval (Pi.single i 1) ≠ 0) :
    Nonempty (AllCharacteristics.FiniteSubschemeDatum (hypersurfaceToBase p hp) 3) := by
  obtain ⟨A, _, _, _, q, hq, hqbase, hqfinite, hqrank⟩ :=
    cubic_line_intersection_closed_immersion i j hij p hp c hc hi
  letI : IsClosedImmersion q := hq
  letI : IsFinite (q ≫ hypersurfaceToBase p hp) := hqfinite
  haveI : Flat (q ≫ hypersurfaceToBase p hp) := by
    rw [hqbase]
    exact Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
  haveI : Module.FinitePresentation K A := Module.finitePresentation_of_finite K A
  haveI : Algebra.FinitePresentation K A :=
    Algebra.FinitePresentation.of_finitePresentation K A
  haveI : LocallyOfFinitePresentation (q ≫ hypersurfaceToBase p hp) := by
    rw [hqbase]
    exact (LocallyOfFinitePresentation.SpecMap_iff _).mpr
      (RingHom.finitePresentation_algebraMap.mpr inferInstance)
  apply Nonempty.intro
  exact AllCharacteristics.finiteSubschemeDatumOfClosedImmersion q
    (hypersurfaceToBase p hp) 3 (fun s ↦ by
      have hs : s = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      subst s
      exact (AllCharacteristics.finiteSchemeRank_eq_finrank
        (q ≫ hypersurfaceToBase p hp)).symm.trans hqrank)

/-- A line section through a point with a chosen nonzero coordinate has the
same rank-three finite-subscheme realization.  The normalization uses the
linear form `X j - a j * X i`, so the leading endpoint need not be a
coordinate point. -/
theorem cubic_line_intersection_closed_immersion_normalized
    {K : Type u} [Field K] {n : ℕ} (i j : Fin n) (hij : i ≠ j)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3)
    (c : Cubic K n) (hc : c.toMvPolynomial = p)
    (a : Vec K n) (hai : a i = 1) (ha : c.eval a ≠ 0) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Module.Finite K A)
      (q : Spec (.of A) ⟶ hypersurface p hp),
      IsClosedImmersion q ∧
        q ≫ hypersurfaceToBase p hp = Spec.map (CommRingCat.ofHom (algebraMap K A)) ∧
        ∃ _ : IsFinite (q ≫ hypersurfaceToBase p hp),
          AllCharacteristics.finiteSchemeRank (q ≫ hypersurfaceToBase p hp) = 3 := by
  let b : Vec K n := Pi.single j 1
  let F := AllCharacteristics.cubicLinePolynomial c a b
  have hd : F.natDegree = 3 := AllCharacteristics.cubicLinePolynomial_natDegree c a b ha
  have hF : F ≠ 0 := by
    intro h
    simp [h] at hd
  let A := AdjoinRoot F
  let pb := AdjoinRoot.powerBasis hF
  letI : Module.Finite K A := Module.Finite.of_basis pb.basis
  have hdim : Module.finrank K A = 3 := pb.finrank.trans hd
  let x : Fin n → A :=
    AdjoinRoot.root F • (fun l ↦ algebraMap K A (a l)) +
      (fun l ↦ algebraMap K A (b l))
  have hxj : x j = AdjoinRoot.root F * algebraMap K A (a j) + 1 := by
    simp [x, b]
  have hxi : x i = AdjoinRoot.root F := by
    simp [x, b, Pi.single_eq_of_ne hij, hai]
  have hcx : (c.map (algebraMap K A)).eval x = 0 := by
    rw [← AllCharacteristics.cubicLinePolynomial_eval₂ (algebraMap K A) c a b
      (AdjoinRoot.root F)]
    exact AdjoinRoot.eval₂_root F
  have hpx : p.eval₂ (algebraMap K A) x = 0 := by
    rw [← hc, Cubic.eval_toMvPolynomial]
    exact hcx
  let I := equationIdeal p hp
  have hI : ∀ r ∈ I.toIdeal, r.eval₂ (algebraMap K A) x = 0 := by
    have hle : I.toIdeal ≤ RingHom.ker (eval₂Hom (algebraMap K A) x) := by
      apply Ideal.span_le.mpr
      intro r hr
      have hr' : r = p := Set.mem_singleton_iff.mp hr
      subst r
      exact hpx
    intro r hr
    exact hle hr
  let ell : MvPolynomial (Fin n) K := X j - C (a j) * X i
  have hell : ell.IsHomogeneous 1 := by
    dsimp [ell]
    exact (MvPolynomial.isHomogeneous_X K j).sub
      (by simpa using MvPolynomial.isHomogeneous_C_mul_X (a j) i)
  have hxell : ell.eval₂ (algebraMap K A) x = 1 := by
    rw [show ell.eval₂ (algebraMap K A) x =
        x j - algebraMap K A (a j) * x i by simp [ell]]
    rw [hxj, hxi]
    ring
  obtain ⟨q, hq, hqbase⟩ := closed_point_of_linear_normalized_coordinates I x ell hell hxell hI
    (eval₂_line_coordinate_surjective F i x hxi)
  let q' : Spec (.of A) ⟶ hypersurface p hp := q
  have hq' : IsClosedImmersion q' := by
    change IsClosedImmersion q
    exact hq
  have hq'base : q' ≫ hypersurfaceToBase p hp =
      Spec.map (CommRingCat.ofHom (algebraMap K A)) := by
    change q ≫ toBase (equationIdeal p hp) = _
    exact hqbase
  have hqfinite : IsFinite (q' ≫ hypersurfaceToBase p hp) := by
    rw [hq'base]
    exact (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  letI : IsFinite (q' ≫ hypersurfaceToBase p hp) := hqfinite
  refine ⟨A, inferInstance, inferInstance, inferInstance, q', hq', hq'base, hqfinite, ?_⟩
  rw [AllCharacteristics.finiteSchemeRank_eq_finrank, hq'base,
    Scheme.Hom.finrank_SpecMap_algebraMap]
  exact (congrFun (Module.rankAtStalk_eq_finrank_of_free (R := K) (M := A)) _).trans hdim

