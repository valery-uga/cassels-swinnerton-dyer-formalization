/-- A cubic line section can be normalized by any linear form which vanishes
at the leading point and is one at the second point.  This removes the need
to put either endpoint on a coordinate axis. -/
theorem cubic_line_intersection_closed_immersion_linear_normalized
    {K : Type u} [Field K] {n : ℕ} (i : Fin n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3)
    (c : Cubic K n) (hc : c.toMvPolynomial = p)
    (a b : Vec K n) (hai : a i = 1) (hbi : b i = 0)
    (ell : MvPolynomial (Fin n) K) (hell : ell.IsHomogeneous 1)
    (hella : ell.eval a = 0) (hellb : ell.eval b = 1)
    (ha : c.eval a ≠ 0) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Module.Finite K A)
      (q : Spec (.of A) ⟶ hypersurface p hp),
      IsClosedImmersion q ∧
        q ≫ hypersurfaceToBase p hp = Spec.map (CommRingCat.ofHom (algebraMap K A)) ∧
        ∃ _ : IsFinite (q ≫ hypersurfaceToBase p hp),
          AllCharacteristics.finiteSchemeRank (q ≫ hypersurfaceToBase p hp) = 3 := by
  let F := AllCharacteristics.cubicLinePolynomial c a b
  have hd : F.natDegree = 3 := AllCharacteristics.cubicLinePolynomial_natDegree c a b ha
  have hF : F ≠ 0 := by
    intro h
    simp [h] at hd
  let A := AdjoinRoot F
  let pb := AdjoinRoot.powerBasis hF
  letI : Module.Finite K A := Module.Finite.of_basis pb.basis
  have hdim : Module.finrank K A = 3 := pb.finrank.trans hd
  let x : Fin n → A :=
    AdjoinRoot.root F • (fun l ↦ algebraMap K A (a l)) +
      (fun l ↦ algebraMap K A (b l))
  have hxi : x i = AdjoinRoot.root F := by
    simp [x, hai, hbi]
  have hcx : (c.map (algebraMap K A)).eval x = 0 := by
    rw [← AllCharacteristics.cubicLinePolynomial_eval₂ (algebraMap K A) c a b
      (AdjoinRoot.root F)]
    exact AdjoinRoot.eval₂_root F
  have hpx : p.eval₂ (algebraMap K A) x = 0 := by
    rw [← hc, Cubic.eval_toMvPolynomial]
    exact hcx
  let I := equationIdeal p hp
  have hI : ∀ r ∈ I.toIdeal, r.eval₂ (algebraMap K A) x = 0 := by
    have hle : I.toIdeal ≤ RingHom.ker (eval₂Hom (algebraMap K A) x) := by
      apply Ideal.span_le.mpr
      intro r hr
      have hr' : r = p := Set.mem_singleton_iff.mp hr
      subst r
      exact hpx
    intro r hr
    exact hle hr
  have hxell : ell.eval₂ (algebraMap K A) x = 1 := by
    rw [show ell.eval₂ (algebraMap K A) x =
      ell.eval₂ (algebraMap K A)
        (AdjoinRoot.root F • (fun l ↦ algebraMap K A (a l)) +
          (fun l ↦ algebraMap K A (b l))) by rfl]
    rw [eval₂_homogeneous_degree_one_line (algebraMap K A) ell hell a b
      (AdjoinRoot.root F), hella, hellb]
    simp
  obtain ⟨q, hq, hqbase⟩ := closed_point_of_linear_normalized_coordinates I x ell hell hxell hI
    (eval₂_line_coordinate_surjective F i x hxi)
  let q' : Spec (.of A) ⟶ hypersurface p hp := q
  have hq' : IsClosedImmersion q' := by
    change IsClosedImmersion q
    exact hq
  have hq'base : q' ≫ hypersurfaceToBase p hp =
      Spec.map (CommRingCat.ofHom (algebraMap K A)) := by
    change q ≫ toBase (equationIdeal p hp) = _
    exact hqbase
  have hqfinite : IsFinite (q' ≫ hypersurfaceToBase p hp) := by
    rw [hq'base]
    exact (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  letI : IsFinite (q' ≫ hypersurfaceToBase p hp) := hqfinite
  refine ⟨A, inferInstance, inferInstance, inferInstance, q', hq', hq'base, hqfinite, ?_⟩
  rw [AllCharacteristics.finiteSchemeRank_eq_finrank, hq'base,
    Scheme.Hom.finrank_SpecMap_algebraMap]
  exact (congrFun (Module.rankAtStalk_eq_finrank_of_free (R := K) (M := A)) _).trans hdim

/-- The line section with arbitrary linear normalization gives actual
rank-three finite-subscheme data. -/
theorem cubic_line_intersection_finite_subscheme_linear_normalized
    {K : Type u} [Field K] {n : ℕ} (i : Fin n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3)
    (c : Cubic K n) (hc : c.toMvPolynomial = p)
    (a b : Vec K n) (hai : a i = 1) (hbi : b i = 0)
    (ell : MvPolynomial (Fin n) K) (hell : ell.IsHomogeneous 1)
    (hella : ell.eval a = 0) (hellb : ell.eval b = 1)
    (ha : c.eval a ≠ 0) :
    Nonempty (AllCharacteristics.FiniteSubschemeDatum (hypersurfaceToBase p hp) 3) := by
  obtain ⟨A, _, _, _, q, hq, hqbase, hqfinite, hqrank⟩ :=
    cubic_line_intersection_closed_immersion_linear_normalized
      i p hp c hc a b hai hbi ell hell hella hellb ha
  letI : IsClosedImmersion q := hq
  letI : IsFinite (q ≫ hypersurfaceToBase p hp) := hqfinite
  haveI : Flat (q ≫ hypersurfaceToBase p hp) := by
    rw [hqbase]
    exact Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
  haveI : Module.FinitePresentation K A := Module.finitePresentation_of_finite K A
  haveI : Algebra.FinitePresentation K A :=
    Algebra.FinitePresentation.of_finitePresentation K A
  haveI : LocallyOfFinitePresentation (q ≫ hypersurfaceToBase p hp) := by
    rw [hqbase]
    exact (LocallyOfFinitePresentation.SpecMap_iff _).mpr
      (RingHom.finitePresentation_algebraMap.mpr inferInstance)
  apply Nonempty.intro
  exact AllCharacteristics.finiteSubschemeDatumOfClosedImmersion q
    (hypersurfaceToBase p hp) 3 (fun s ↦ by
      have hs : s = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      subst s
      exact (AllCharacteristics.finiteSchemeRank_eq_finrank
        (q ≫ hypersurfaceToBase p hp)).symm.trans hqrank)

private theorem exists_normalized_nonzero_cubic_line_parameters
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    (c : Cubic K n) (hc : c.toMvPolynomial = p) :
    ∃ (i j : Fin n) (a : Vec K n), i ≠ j ∧ a i = 1 ∧ c.eval a ≠ 0 := by
  classical
  have heval : ∃ a : Vec K n, c.eval a ≠ 0 := by
    by_contra h
    push Not at h
    apply hp0
    apply hp.eq_zero_of_forall_eval_eq_zero
    intro a
    rw [← hc]
    change MvPolynomial.eval₂ (RingHom.id K) a c.toMvPolynomial = 0
    rw [Cubic.eval_toMvPolynomial]
    exact h a
  obtain ⟨a, ha⟩ := heval
  have ha0 : a ≠ 0 := by
    intro h
    subst a
    simp at ha
  have hcoordinate : ∃ i : Fin n, a i ≠ 0 := by
    by_contra h
    push Not at h
    apply ha0
    funext i
    exact h i
  obtain ⟨i, hi⟩ := hcoordinate
  let zero : Fin n := ⟨0, by omega⟩
  let one : Fin n := ⟨1, by omega⟩
  have hzero_one : zero ≠ one := by
    intro h
    have hval := congrArg Fin.val h
    simp [zero, one] at hval
  obtain ⟨j, hij⟩ : ∃ j : Fin n, i ≠ j := by
    by_cases hi0 : i = zero
    · refine ⟨one, ?_⟩
      intro h
      apply hzero_one
      calc
        zero = i := hi0.symm
        _ = one := h
    · exact ⟨zero, hi0⟩
  let a' : Vec K n := (a i)⁻¹ • a
  have ha'i : a' i = 1 := by
    simp [a', hi]
  have ha' : c.eval a' ≠ 0 := by
    change c.eval ((a i)⁻¹ • a) ≠ 0
    rw [Cubic.eval_smul]
    exact mul_ne_zero (pow_ne_zero 3 (inv_ne_zero hi)) ha
  exact ⟨i, j, a', hij, ha'i, ha'⟩

/-- Every nonzero homogeneous cubic in at least two variables has a
rank-three finite flat closed subscheme.  A nonvanishing affine evaluation is
first normalized in one of its nonzero coordinates, then intersected with a
line through a different coordinate point. -/
theorem nonempty_rankThree_finiteSubscheme_of_nonzero_homogeneous_cubic
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    (c : Cubic K n) (hc : c.toMvPolynomial = p) :
    Nonempty (AllCharacteristics.FiniteSubschemeDatum (hypersurfaceToBase p hp) 3) := by
  obtain ⟨i, j, a, hij, hai, ha⟩ :=
    exists_normalized_nonzero_cubic_line_parameters hn p hp hp0 c hc
  exact cubic_line_intersection_finite_subscheme_normalized i j hij p hp c hc a hai ha

/-- The preceding construction can retain its affine coordinate algebra and
closed immersion.  This is the form used when rank-three components must be
combined into a larger disjoint finite subscheme. -/
theorem exists_rankThree_closed_immersion_of_nonzero_homogeneous_cubic
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    (c : Cubic K n) (hc : c.toMvPolynomial = p) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Module.Finite K A)
      (q : Spec (.of A) ⟶ hypersurface p hp),
      IsClosedImmersion q ∧
        q ≫ hypersurfaceToBase p hp = Spec.map (CommRingCat.ofHom (algebraMap K A)) ∧
        ∃ _ : IsFinite (q ≫ hypersurfaceToBase p hp),
          AllCharacteristics.finiteSchemeRank (q ≫ hypersurfaceToBase p hp) = 3 := by
  obtain ⟨i, j, a, hij, hai, ha⟩ :=
    exists_normalized_nonzero_cubic_line_parameters hn p hp hp0 c hc
  exact cubic_line_intersection_closed_immersion_normalized i j hij p hp c hc a hai ha

/-- Equation-only version of the affine rank-three construction.  It applies
directly to a nonzero cubic hypersurface without a separately chosen tensor
of cubic coefficients. -/
theorem exists_rankThree_closed_immersion_of_nonzero_homogeneous_cubic_equation
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Module.Finite K A)
      (q : Spec (.of A) ⟶ hypersurface p hp),
      IsClosedImmersion q ∧
        q ≫ hypersurfaceToBase p hp = Spec.map (CommRingCat.ofHom (algebraMap K A)) ∧
        ∃ _ : IsFinite (q ≫ hypersurfaceToBase p hp),
          AllCharacteristics.finiteSchemeRank (q ≫ hypersurfaceToBase p hp) = 3 := by
  obtain ⟨c, hc⟩ := AllCharacteristics.homogeneous_cubic_has_tensor_any_characteristic p hp
  exact exists_rankThree_closed_immersion_of_nonzero_homogeneous_cubic hn p hp hp0 c hc

/-- The rank-three line-section construction depends only on a nonzero
homogeneous cubic equation; its coefficient tensor is supplied without any
restriction on the characteristic. -/
theorem nonempty_rankThree_finiteSubscheme_of_nonzero_homogeneous_cubic_equation
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0) :
    Nonempty (AllCharacteristics.FiniteSubschemeDatum (hypersurfaceToBase p hp) 3) := by
  obtain ⟨c, hc⟩ := AllCharacteristics.homogeneous_cubic_has_tensor_any_characteristic p hp
  exact nonempty_rankThree_finiteSubscheme_of_nonzero_homogeneous_cubic hn p hp hp0 c hc

/-- A canonical rank-three datum obtained from a finite line section of a
nonzero cubic hypersurface. -/
noncomputable def cubicLineSectionDatum
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0) :
    AllCharacteristics.FiniteSubschemeDatum (hypersurfaceToBase p hp) 3 :=
  Classical.choice
    (nonempty_rankThree_finiteSubscheme_of_nonzero_homogeneous_cubic_equation
      hn p hp hp0)

/-- A canonical degree-three effective cycle obtained from the actual closed
subscheme in `cubicLineSectionDatum`, using its intrinsic fundamental cycle. -/
noncomputable def cubicLineSectionCycle
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0) :
    EffectiveZeroCycle (hypersurface p hp) :=
  AllCharacteristics.finiteSubschemeDatumCycle (hypersurfaceToBase p hp)
    (cubicLineSectionDatum hn p hp hp0)

/-- The line-section reference cycle has degree three. -/
theorem cubicLineSectionCycle_degree
    {K : Type u} [Field K] [Infinite K] {n : ℕ} (hn : 2 ≤ n)
    (p : MvPolynomial (Fin n) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0) :
    EffectiveZeroCycle.degree (hypersurfaceToBase p hp)
      (cubicLineSectionCycle hn p hp hp0) = 3 := by
  exact AllCharacteristics.finiteSubschemeDatumCycle_degree _ _

end PfaffianDescent
