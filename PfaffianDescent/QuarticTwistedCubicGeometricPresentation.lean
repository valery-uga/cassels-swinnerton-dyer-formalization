import PfaffianDescent.QuarticTwistedCubicAlgebraicClosureDescent
import PfaffianDescent.HomogeneousIdealPieces

/-!
# Geometric presentations of twisted cubics

This file packages the coordinate hypothesis which occurs after identifying a
projective curve in `P³` geometrically with the standard twisted cubic.  It
separates that algebraic descent statement from the still-unformalized
intrinsic theory of smooth projective curves and their linear series.
-/

namespace PfaffianDescent.QuarticNet

open MvPolynomial Matrix AlgebraicGeometry CategoryTheory
open AllCharacteristics.HomogeneousProjective
open scoped MatrixGroups

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] MvPolynomial.algebraMvPolynomial

universe u

variable {K : Type u} [Field K]

/-- A homogeneous ideal has a geometric standard twisted-cubic presentation
when it is generated by three quadratic equations and, after base change to
the algebraic closure and an invertible linear coordinate change, those
equations define the standard twisted cubic. -/
def GeometricStandardTwistedCubicPresentation
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)) : Prop :=
  ∃ (Q : Fin 3 → MvPolynomial (Fin 4) K),
    (∀ i, (Q i).IsHomogeneous 2) ∧
    I.toIdeal = Ideal.span (Set.range Q) ∧
    ∃ M : GL (Fin 4) (AlgebraicClosure K),
      (Ideal.span (Set.range (fun i => MvPolynomial.map
        (algebraMap K (AlgebraicClosure K)) (Q i)))).map
        (linearSubstitution (M : Matrix (Fin 4) (Fin 4) (AlgebraicClosure K))).toRingHom =
        standardTwistedCubicIdeal (AlgebraicClosure K)

/-- A ground-field projective threefold coordinate presentation is a twisted
cubic when an invertible linear coordinate change carries its ideal to the
standard twisted-cubic ideal. -/
def GroundTwistedCubicPresentation
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)) : Prop :=
  ∃ M : GL (Fin 4) K,
    I.toIdeal.map
      (linearSubstitution (M : Matrix (Fin 4) (Fin 4) K)).toRingHom =
      standardTwistedCubicIdeal K

/-- The ideal of a curve in projective three-space has a three-quadric
presentation. -/
def ThreeQuadraticPresentation
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)) : Prop :=
  ∃ (Q : Fin 3 → MvPolynomial (Fin 4) K),
    (∀ i, (Q i).IsHomogeneous 2) ∧ I.toIdeal = Ideal.span (Set.range Q)

/-- The intrinsic statement that the ideal is generated by a
three-dimensional quadratic piece supplies the three equations needed for a
twisted-cubic presentation. -/
theorem threeQuadraticPresentation_of_quadraticPieceGenerates
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hgen : quadraticPieceGenerates I)
    (hI : Module.finrank K (homogeneousIdealPiece I 2) = 3) :
    ThreeQuadraticPresentation I :=
  exists_three_quadrics_generating_of_quadraticPieceGenerates I hgen hI

/-- After base change to the algebraic closure, the projective curve is the
standard twisted cubic up to an invertible linear coordinate change. -/
def GeometricallyStandardTwistedCubic
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)) : Prop :=
  ∃ M : GL (Fin 4) (AlgebraicClosure K),
    (I.toIdeal.map (MvPolynomial.map (algebraMap K (AlgebraicClosure K)))).map
      (linearSubstitution (M : Matrix (Fin 4) (Fin 4) (AlgebraicClosure K))).toRingHom =
        standardTwistedCubicIdeal (AlgebraicClosure K)

/-- A three-quadric ideal whose algebraic-closure ideal is linearly standard
has a geometric standard twisted-cubic presentation. -/
theorem geometricStandardTwistedCubicPresentation_of_threeQuadrics
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hQ : ThreeQuadraticPresentation I)
    (hgeo : GeometricallyStandardTwistedCubic I) :
    GeometricStandardTwistedCubicPresentation I := by
  rcases hQ with ⟨Q, hQ, hIQ⟩
  rcases hgeo with ⟨M, hM⟩
  refine ⟨Q, hQ, hIQ, M, ?_⟩
  have hbase : I.toIdeal.map (MvPolynomial.map (algebraMap K (AlgebraicClosure K))) =
      Ideal.span (Set.range (fun i => MvPolynomial.map
        (algebraMap K (AlgebraicClosure K)) (Q i))) := by
    rw [hIQ, Ideal.map_span]
    congr 1
    ext p
    constructor
    · rintro ⟨q, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨Q i, ⟨i, rfl⟩, rfl⟩
  rw [← hbase]
  exact hM

variable [PerfectField K]

/-- The geometric standard presentation descends to a ground-field standard
twisted-cubic presentation over a perfect field. -/
theorem GeometricStandardTwistedCubicPresentation.toGround
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hI : GeometricStandardTwistedCubicPresentation I) :
    GroundTwistedCubicPresentation I := by
  rcases hI with ⟨Q, hQ, hQspan, M, hM⟩
  obtain ⟨Y, hY⟩ := algebraicClosure_standardPresentation_descends Q M hM
  exact ⟨Y, by rwa [hQspan]⟩

/-- The two algebraic assertions extracted from the geometric hypothesis give
a ground-field twisted-cubic presentation over a perfect field. -/
theorem groundTwistedCubicPresentation_of_threeQuadrics
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hQ : ThreeQuadraticPresentation I)
    (hgeo : GeometricallyStandardTwistedCubic I) :
    GroundTwistedCubicPresentation I :=
  (geometricStandardTwistedCubicPresentation_of_threeQuadrics hQ hgeo).toGround

/-- A ground twisted-cubic presentation gives an actual isomorphism of its
projective curve with the standard projective line. -/
noncomputable def GroundTwistedCubicPresentation.schemeIsoProjectiveLine
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hI : GroundTwistedCubicPresentation I) :
    scheme I ≅ projectiveLineProj K := by
  let M : GL (Fin 4) K := Classical.choose hI
  have hM : I.toIdeal.map
      (linearSubstitution (M : Matrix (Fin 4) (Fin 4) K)).toRingHom =
      standardTwistedCubicIdeal K := Classical.choose_spec hI
  have hdet : IsUnit ((M : Matrix (Fin 4) (Fin 4) K).det) :=
    (Matrix.isUnit_iff_isUnit_det _).mp (Units.isUnit M)
  have hIJ : (standardTwistedCubicHomogeneousIdeal (K := K)).toIdeal =
      I.toIdeal.map
        (linearSubstitutionEquiv (M : Matrix (Fin 4) (Fin 4) K) hdet).toRingHom := by
    change standardTwistedCubicIdeal K = I.toIdeal.map
      (linearSubstitutionEquiv (M : Matrix (Fin 4) (Fin 4) K) hdet).toRingHom
    exact hM.symm
  exact linearCoordinateChangeSchemeIso
      (M : Matrix (Fin 4) (Fin 4) K) hdet I
      (standardTwistedCubicHomogeneousIdeal (K := K)) hIJ ≪≫
    standardTwistedCubicProjectiveLineProjIso (K := K)

/-- A geometric standard twisted-cubic presentation defines the projective
line over the ground field. -/
noncomputable def GeometricStandardTwistedCubicPresentation.schemeIsoProjectiveLine
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hI : GeometricStandardTwistedCubicPresentation I) :
    scheme I ≅ projectiveLineProj K :=
  (hI.toGround).schemeIsoProjectiveLine

/-- A projective three-quadric curve that is geometrically a standard twisted
cubic is the ground projective line. -/
noncomputable def schemeIsoProjectiveLine_of_threeQuadrics
    {I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)}
    (hQ : ThreeQuadraticPresentation I)
    (hgeo : GeometricallyStandardTwistedCubic I) :
    scheme I ≅ projectiveLineProj K :=
  (groundTwistedCubicPresentation_of_threeQuadrics hQ hgeo).schemeIsoProjectiveLine

end PfaffianDescent.QuarticNet
