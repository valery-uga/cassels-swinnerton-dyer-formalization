import PfaffianDescent.VoisinDegreeEightFixedCurveScheme
import PfaffianDescent.VoisinBaseLocusNumerics

/-!
# Hilbert growth of a cubic--quadric fixed curve

The homogeneous prime curve extracted from a common cubic--quadric component
contains both defining equations. This file compares its quotient Hilbert
function with that of the complete-intersection equations and transports any
eventual affine-linear degree bound through that comparison.
-/

namespace PfaffianDescent

open MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The homogeneous ideal generated by one cubic and one quadric. -/
noncomputable def cubicQuadricEquationHomogeneousIdeal
    {K : Type u} [Field K]
    (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2) :
    HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K) :=
  ⟨Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)), by
    apply Ideal.homogeneous_span
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨3, hp⟩
    · exact ⟨2, hq⟩⟩

theorem cubicQuadricEquationHomogeneousIdeal_toIdeal
    {K : Type u} [Field K]
    (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2) :
    (cubicQuadricEquationHomogeneousIdeal p q hp hq).toIdeal =
      Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  rfl

/-- The equation ideal is the cubic--quadric ideal itself. -/
theorem cubicQuadric_span_le_equationHomogeneousIdeal
    {K : Type u} [Field K]
    (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2) :
    Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) ≤
      (cubicQuadricEquationHomogeneousIdeal p q hp hq).toIdeal := by
  exact le_rfl

/-- A homogeneous fixed curve containing the cubic and quadric has a
degreewise smaller quotient Hilbert function than the cubic--quadric
complete-intersection quotient. -/
theorem finrank_grading_fixedCurve_le_cubicQuadric_quotient
    {K : Type u} [Field K]
    (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (C : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (hcontain : Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) ≤ C.toIdeal)
    (d : ℕ) :
    Module.finrank K (grading C d) ≤
      Module.finrank K (grading
        (cubicQuadricEquationHomogeneousIdeal p q hp hq) d) := by
  apply finrank_grading_antitone_of_homogeneousIdeal_le
    (cubicQuadricEquationHomogeneousIdeal p q hp hq) C _ d
  exact hcontain

/-- Eventual affine-linear Hilbert growth transfers the curve-degree bound
from the cubic--quadric quotient to any homogeneous fixed curve containing
its equations. -/
theorem eventual_affine_hilbert_slope_fixedCurve_le_cubicQuadric
    {K : Type u} [Field K]
    (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (C : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (hcontain : Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) ≤ C.toIdeal)
    (NI NC a b c d : ℕ)
    (hI : ∀ n, NI ≤ n →
      Module.finrank K
        (grading (cubicQuadricEquationHomogeneousIdeal p q hp hq) n) = a * n + b)
    (hC : ∀ n, NC ≤ n → Module.finrank K (grading C n) = c * n + d) :
    c ≤ a := by
  exact eventual_affine_hilbert_slope_le
    (fun n => Module.finrank K (grading C n))
    (fun n => Module.finrank K
      (grading (cubicQuadricEquationHomogeneousIdeal p q hp hq) n))
    (max NI NC) c d a b
    (fun n hn => hC n (le_trans (le_max_right _ _) hn))
    (fun n hn => hI n (le_trans (le_max_left _ _) hn))
    (fun n hn => finrank_grading_fixedCurve_le_cubicQuadric_quotient
      p q hp hq C hcontain n)

end PfaffianDescent
