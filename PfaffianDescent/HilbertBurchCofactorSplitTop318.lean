import Mathlib.RingTheory.Ideal.BigOperators
import PfaffianDescent.HilbertBurchCofactorLift318
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
import Mathlib.Tactic.Abel

/-!
The determinantal ideal of a split exact rectangular matrix is the unit
ideal. The signed maximal minors use the adjugate convention of
`hilbertBurchCofactors318`.
-/

noncomputable section

namespace PfaffianDescent

open Matrix

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- Adjoining a section column to a split exact presentation yields an
invertible square matrix.  Cramer's rule expresses its unit determinant in
the ideal generated by the original signed maximal minors. -/
theorem hilbertBurchCofactorIdeal_eq_top_of_split_exact006
    (M : Matrix (Option ι) ι R)
    (f : (Option ι → R) →ₗ[R] R)
    (hg : Function.Injective M.mulVecLin)
    (hgf : LinearMap.range M.mulVecLin = LinearMap.ker f)
    (v : Option ι → R) (hv : f v = 1) :
    Ideal.span (Set.range (hilbertBurchCofactors318 M)) = ⊤ := by
  let A := (hilbertBurchAugment318 M).updateCol none v
  have hA (z : Option ι → R) :
      A *ᵥ z = z none • v + M *ᵥ (fun j ↦ z (some j)) := by
    ext i
    simp [A, Matrix.mulVec, dotProduct, Fintype.sum_option,
      Matrix.updateCol_apply, hilbertBurchAugment318, smul_eq_mul, mul_comm]
  have hfg (u : ι → R) : f (M *ᵥ u) = 0 := by
    apply LinearMap.mem_ker.mp
    rw [← hgf]
    exact ⟨u, rfl⟩
  have hbij : Function.Bijective A.mulVec := by
    constructor
    · intro z w hzw
      have hzero : z none = w none := by
        simpa only [hA, map_add, map_smul, hv, hfg, smul_eq_mul,
          mul_one, add_zero] using congrArg f hzw
      have hsome : (fun j ↦ z (some j)) = (fun j ↦ w (some j)) := by
        apply hg
        change M *ᵥ (fun j ↦ z (some j)) = M *ᵥ (fun j ↦ w (some j))
        have h := hzw
        rw [hA, hA, hzero] at h
        exact add_left_cancel h
      funext i
      cases i with
      | none => exact hzero
      | some j => exact congrFun hsome j
    · intro z
      have hk : z - f z • v ∈ LinearMap.ker f := by
        rw [LinearMap.mem_ker]
        simp only [map_sub, map_smul, hv, smul_eq_mul, mul_one, sub_self]
      rw [← hgf] at hk
      obtain ⟨u, hu⟩ := hk
      refine ⟨fun i ↦ Option.elim i (f z) u, ?_⟩
      rw [hA]
      change f z • v + M *ᵥ u = z
      rw [show M *ᵥ u = z - f z • v from hu]
      abel
  have hlin : IsUnit A.toLin' := by
    apply (Module.End.isUnit_iff _).mpr
    simpa only [Matrix.toLin'_apply', Matrix.coe_mulVecLin] using hbij
  have hdet : IsUnit A.det :=
    (Matrix.isUnit_iff_isUnit_det A).mp (Matrix.isUnit_toLin'_iff.mp hlin)
  have hexpand : A.det = ∑ i, hilbertBurchCofactors318 M i * v i := by
    have h := congrFun
      (Matrix.cramer_eq_adjugate_mulVec (hilbertBurchAugment318 M) v) none
    simpa only [Matrix.cramer_apply, A, Matrix.mulVec, dotProduct,
      hilbertBurchCofactors318] using h
  apply Ideal.eq_top_of_isUnit_mem _ ?_ hdet
  rw [hexpand]
  apply Ideal.sum_mem
  intro i _
  exact Ideal.mul_mem_right (v i) _ (Ideal.subset_span (Set.mem_range_self i))

end PfaffianDescent
