import PfaffianDescent.AmbientPointKoszulBasisStalkExactness

/-! # The affine prime and maximal ideal of the actual invertible-basis point -/

noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits HomogeneousLocalization MvPolynomial
open AllCharacteristics.HomogeneousProjective

namespace PfaffianDescent

universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra
local notation "PS" => homogeneousSubmodule (Fin 4) K
variable (M : Matrix (Fin 4) (Fin 4) K) (hM : IsUnit M.det)

set_option backward.isDefEq.respectTransparency false in
private theorem basisChartIso_hom_base (j : Fin 4) :
    (Proj.basicOpenIsoSpec PS (ambientPointKoszul_basis M j).val (ambientPointKoszul_basis M j).property (by decide : 0 < 1)).hom.base =
      (ProjectiveSpectrum.Proj.toSpec PS (ambientPointKoszul_basis M j).val).base := by
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- The actual point, read in its native standard chart, is the prime
obtained from the actual chart-evaluation homomorphism. -/
theorem ambientPointKoszul_basisPoint_chart_coordinate (k : Spec (.of K)) :
    (ProjectiveSpectrum.Proj.toSpec PS (ambientPointKoszul_basis M 0).val).base
      ⟨ambientPointKoszul_basisPoint M hM k, ambientPointKoszul_basisPoint_mem_basicOpen M hM k⟩ =
    (Spec.map (CommRingCat.ofHom (ambientPointKoszul_basisChartMap M hM))) k := by
  let e := Proj.basicOpenIsoSpec PS (ambientPointKoszul_basis M 0).val
    (ambientPointKoszul_basis M 0).property (by decide : 0 < 1)
  let q := (Spec.map (CommRingCat.ofHom (ambientPointKoszul_basisChartMap M hM))) k
  have hx : (⟨ambientPointKoszul_basisPoint M hM k, ambientPointKoszul_basisPoint_mem_basicOpen M hM k⟩ :
      Proj.basicOpen PS (ambientPointKoszul_basis M 0).val) = e.inv q := by
    apply Subtype.ext
    rfl
  rw [hx, ← basisChartIso_hom_base M]
  exact ConcreteCategory.congr_hom
    (congrArg (fun f : Spec (.of (Away PS (ambientPointKoszul_basis M 0).val)) ⟶
      Spec (.of (Away PS (ambientPointKoszul_basis M 0).val)) => f.base) e.inv_hom_id) q

set_option backward.isDefEq.respectTransparency false in
/-- The actual point has the chart prime generated by the three normalized
coordinates, with no point-ideal identification premise. -/
theorem ambientPointKoszul_basisPoint_chartPrime (k : Spec (.of K)) :
    ((ProjectiveSpectrum.Proj.toSpec PS (ambientPointKoszul_basis M 0).val).base
      ⟨ambientPointKoszul_basisPoint M hM k, ambientPointKoszul_basisPoint_mem_basicOpen M hM k⟩).asIdeal =
      RingHom.ker (ambientPointKoszul_basisChartMap M hM) := by
  rw [ambientPointKoszul_basisPoint_chart_coordinate]
  change Ideal.comap (ambientPointKoszul_basisChartMap M hM) (k : PrimeSpectrum K).asIdeal = _
  have hk : (k : PrimeSpectrum K).asIdeal = ⊥ :=
    congrArg (fun p : PrimeSpectrum K => p.asIdeal)
      (Subsingleton.elim (k : PrimeSpectrum K) (⊥ : PrimeSpectrum K))
  rw [hk]
  rfl

namespace ProjectiveNegativeTwist

local instance ambientPointKoszul_basisPointPrime_prime (x : Proj PS) :
    (pointIdeal PS x).IsPrime := ProjectiveSpectrum.isPrime x

set_option backward.isDefEq.respectTransparency false in
/-- At the actual standard point, the three coefficients of the actual
last Koszul differential generate the native homogeneous maximal ideal. -/
theorem ambientPointKoszul_basisPoint_stalk_parameters_span_maximal
    (k : Spec (.of K)) :
    let x := ambientPointKoszul_basisPoint M hM k
    let hx : (ambientPointKoszul_basis M 0).val ∈ (pointIdeal PS x).primeCompl :=
      ambientPointKoszul_basisPoint_mem_basicOpen M hM k
    Ideal.span {ambientPointKoszul_basisStalkParameter M 1 0 x hx,
      ambientPointKoszul_basisStalkParameter M 2 0 x hx,
      ambientPointKoszul_basisStalkParameter M 3 0 x hx} =
      IsLocalRing.maximalIdeal (AtPrime PS (pointIdeal PS x)) := by
  dsimp only
  let x := ambientPointKoszul_basisPoint M hM k
  let hx : (ambientPointKoszul_basis M 0).val ∈ (pointIdeal PS x).primeCompl :=
    ambientPointKoszul_basisPoint_mem_basicOpen M hM k
  let R := Away PS (ambientPointKoszul_basis M 0).val
  let S := AtPrime PS (pointIdeal PS x)
  let p := ((ProjectiveSpectrum.Proj.toSpec PS (ambientPointKoszul_basis M 0).val).base ⟨x, hx⟩).asIdeal
  letI : Algebra R S := (ambientPointKoszul_basisChartToStalk M 0 x hx).toAlgebra
  letI : p.IsPrime := PrimeSpectrum.isPrime _
  letI : IsLocalization p.primeCompl S := ambientPointKoszul_basisChartToStalk_isLocalization M 0 x hx
  have hp : p = RingHom.ker (ambientPointKoszul_basisChartMap M hM) := ambientPointKoszul_basisPoint_chartPrime M hM k
  have hm := IsLocalization.AtPrime.map_eq_maximalIdeal p S
  rw [hp, ambientPointKoszul_basisChartMap_ker, Ideal.map_span] at hm
  change Ideal.span ((ambientPointKoszul_basisChartToStalk M 0 x hx) ''
    {ambientPointKoszul_basisChartCoordinate M 0 1,
      ambientPointKoszul_basisChartCoordinate M 0 2,
      ambientPointKoszul_basisChartCoordinate M 0 3}) = _ at hm
  rw [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at hm
  simpa only [ambientPointKoszul_basisChartToStalk_coordinate] using hm

end ProjectiveNegativeTwist

end PfaffianDescent
