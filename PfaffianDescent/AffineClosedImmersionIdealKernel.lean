import PfaffianDescent.RegularPrincipalIdealFree
import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
import Mathlib.RingTheory.Flat.TorsionFree

/-!
# The ideal sheaf of an affine quotient map

For a morphism between affine spectra, its ideal sheaf on the whole
target is the kernel of the underlying ring map, transported through the
canonical isomorphism from global sections to the target ring. This is
the bridge from Cartier chart algebra to the actual ideal sheaf.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

/-- A flat ring map preserves non-zero-divisors. -/
theorem isRegular_map_of_ringHom_flat
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (hg : g.Flat) (x : A) (hx : IsRegular x) :
    IsRegular (g x) := by
  letI : Algebra A B := g.toAlgebra
  letI : Module.Flat A B := hg
  have hsmul : IsSMulRegular B x :=
    Module.Flat.isSMulRegular_of_isRegular hx
  have hmul : Function.Injective (fun b : B => g x * b) := by
    change Function.Injective (fun b : B => (algebraMap A B) x * b) at hsmul
    simpa only [show algebraMap A B = g from rfl] using hsmul
  constructor
  · exact hmul
  · change Function.Injective (fun b : B => b * g x)
    simpa only [mul_comm] using hmul

/-- A regular section of an affine open remains regular after restricting
to any of its principal affine opens. -/
theorem isRegular_affineBasicOpen_restriction
    {X : Scheme.{u}} (U : X.Opens) (hU : IsAffineOpen U)
    (r z : Γ(X, U)) (hz : IsRegular z) :
    IsRegular (X.presheaf.map (homOfLE (X.basicOpen_le r)).op z) := by
  letI : IsLocalization.Away r Γ(X, X.basicOpen r) :=
    hU.isLocalization_basicOpen r
  have hflat : Module.Flat (Γ(X, U)) (Γ(X, X.basicOpen r)) :=
    IsLocalization.flat _ (Submonoid.powers r)
  have hg : (X.presheaf.map (homOfLE (X.basicOpen_le r)).op).hom.Flat := by
    exact RingHom.flat_algebraMap_iff.mpr hflat
  exact isRegular_map_of_ringHom_flat _ hg z hz

/-- A principal ideal with a regular generator descends across a ring
isomorphism from its comap. -/
theorem ideal_regularPrincipal_of_comap_ringEquiv
    {A B : Type u} [CommRing A] [CommRing B]
    (e : A ≃+* B) (I : Ideal B) (x : A) (hx : IsRegular x)
    (hI : I.comap e.toRingHom = Ideal.span ({x} : Set A)) :
    IsRegular (e x) ∧ I = Ideal.span ({e x} : Set B) := by
  constructor
  · apply isRegular_iff_mem_nonZeroDivisors.mpr
    have hpre : IsRegular (e.symm (e x)) := by simpa using hx
    exact mem_nonZeroDivisors_of_injective e.symm.injective
      (isRegular_iff_mem_nonZeroDivisors.mp hpre)
  · calc
      I = (I.comap e.toRingHom).map e.toRingHom :=
        (Ideal.map_comap_of_surjective e.toRingHom e.surjective I).symm
      _ = Ideal.span ({e x} : Set B) := by
        rw [hI, Ideal.map_span, Set.image_singleton]
        rfl

theorem specMap_ker_ideal_top
    (A B : CommRingCat.{u}) (g : A ⟶ B) :
    (Spec.map g).ker.ideal
        (⟨⊤, isAffineOpen_top (Spec A)⟩ : (Spec A).affineOpens) =
      (RingHom.ker g.hom).comap (Scheme.ΓSpecIso A).hom.hom := by
  rw [Scheme.Hom.ker_apply]
  change RingHom.ker (Spec.map g).appTop.hom = _
  rw [← RingHom.ker_equiv_comp _
    (Scheme.ΓSpecIso B).commRingCatIsoToRingEquiv]
  rw [RingHom.comap_ker]
  congr 1
  exact congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso_naturality g)

/-- A regular principal kernel of an affine map is the regular principal
ideal of its actual closed-immersion ideal sheaf on the whole affine
target, with the generator transported through `Γ(Spec A) ≅ A`. -/
theorem specMap_ker_ideal_top_regularPrincipal
    (A B : CommRingCat.{u}) (g : A ⟶ B)
    (x : A) (hx : IsRegular x)
    (hker : RingHom.ker g.hom = Ideal.span ({x} : Set A)) :
    ∃ y : Γ(Spec A, ⊤),
      IsRegular y ∧
      (Spec.map g).ker.ideal
          (⟨⊤, isAffineOpen_top (Spec A)⟩ : (Spec A).affineOpens) =
        Ideal.span ({y} : Set Γ(Spec A, ⊤)) := by
  let e := (Scheme.ΓSpecIso A).commRingCatIsoToRingEquiv
  let y : Γ(Spec A, ⊤) := e.symm x
  have hy : IsRegular y := by
    apply isRegular_iff_mem_nonZeroDivisors.mpr
    apply mem_nonZeroDivisors_of_injective e.injective
    simpa only [y, e.apply_symm_apply] using
      (isRegular_iff_mem_nonZeroDivisors.mp hx)
  refine ⟨y, hy, ?_⟩
  rw [specMap_ker_ideal_top, hker]
  apply Ideal.ext
  intro z
  simp only [Ideal.mem_comap, Ideal.mem_span_singleton]
  have he : e z = (Scheme.ΓSpecIso A).hom.hom z := rfl
  constructor
  · intro hz
    rw [← he] at hz
    have h := map_dvd e.symm hz
    simpa only [y, e.symm_apply_apply] using h
  · intro hz
    have h := map_dvd e hz
    rw [he] at h
    simpa only [y, e.apply_symm_apply] using h

/-- On each affine chart of a regular-principal immersion, the ideal
sheaf of the cartesian chart morphism is generated by an actual regular
global section of that affine chart. -/
theorem RegularPrincipalImmersion.chartIdealSheaf_regularPrincipal
    {X Z : Scheme.{u}} {f : Z ⟶ X}
    (H : RegularPrincipalImmersion f) (j : H.Index) :
    ∃ y : Γ(Spec (H.A j), ⊤),
      IsRegular y ∧
      (Spec.map (H.ringMap j)).ker.ideal
          (⟨⊤, isAffineOpen_top (Spec (H.A j))⟩ :
            (Spec (H.A j)).affineOpens) =
        Ideal.span ({y} : Set Γ(Spec (H.A j), ⊤)) := by
  obtain ⟨x, hx, hker⟩ := H.principal j
  exact specMap_ker_ideal_top_regularPrincipal
    (H.A j) (H.B j) (H.ringMap j) x hx hker

/-- On an affine target chart of a regular-principal immersion, the
restriction of the immersion's own ideal sheaf is generated by a regular
section after identifying sections with those on the chart. -/
theorem RegularPrincipalImmersion.idealSheaf_restriction_regularPrincipal
    {X Z : Scheme.{u}} {f : Z ⟶ X} [QuasiCompact f]
    (H : RegularPrincipalImmersion f) (j : H.Index)
    [IsOpenImmersion (H.target j)] :
    let W : (Spec (H.A j)).affineOpens :=
      ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
    ∃ y : Γ(Spec (H.A j), ⊤),
      IsRegular y ∧
      (f.ker.ideal
        ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩).comap
          ((H.target j).appIso W).inv.hom =
        Ideal.span ({y} : Set Γ(Spec (H.A j), ⊤)) := by
  dsimp only
  obtain ⟨y, hy, hker⟩ := H.chartIdealSheaf_regularPrincipal j
  refine ⟨y, hy, ?_⟩
  have hrestrict := Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
    f (Spec.map (H.ringMap j)) (H.source j) (H.target j)
    (H.cartesian j)
    (⟨⊤, isAffineOpen_top (Spec (H.A j))⟩ :
      (Spec (H.A j)).affineOpens)
  exact hrestrict.symm.trans hker

/-- The original immersion's ideal sheaf, transported to any affine chart
of a regular-principal presentation, is a free rank-one module over that
chart's ring of sections. -/
theorem RegularPrincipalImmersion.idealSheaf_restriction_moduleFree
    {X Z : Scheme.{u}} {f : Z ⟶ X} [QuasiCompact f]
    (H : RegularPrincipalImmersion f) (j : H.Index)
    [IsOpenImmersion (H.target j)] :
    let W : (Spec (H.A j)).affineOpens :=
      ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
    Module.Free (Γ(Spec (H.A j), ⊤))
      ((f.ker.ideal
        ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩).comap
          ((H.target j).appIso W).inv.hom) := by
  obtain ⟨y, hy, hker⟩ := H.idealSheaf_restriction_regularPrincipal j
  dsimp only
  rw [hker]
  exact Module.Free.of_equiv (regularPrincipalIdealLinearEquiv y hy)

/-- On the affine open in the original target corresponding to a chart,
the original immersion's ideal is itself generated by a regular section. -/
theorem RegularPrincipalImmersion.idealSheaf_affineOpen_regularPrincipal
    {X Z : Scheme.{u}} {f : Z ⟶ X} [QuasiCompact f]
    (H : RegularPrincipalImmersion f) (j : H.Index)
    [IsOpenImmersion (H.target j)] :
    let W : (Spec (H.A j)).affineOpens :=
      ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
    let U : X.affineOpens :=
      ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩
    ∃ z : Γ(X, U.1),
      IsRegular z ∧ f.ker.ideal U = Ideal.span ({z} : Set Γ(X, U.1)) := by
  dsimp only
  let W : (Spec (H.A j)).affineOpens :=
    ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
  let U : X.affineOpens :=
    ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩
  let e := ((H.target j).appIso W).symm.commRingCatIsoToRingEquiv
  obtain ⟨y, hy, hker⟩ := H.idealSheaf_restriction_regularPrincipal j
  have h : (f.ker.ideal U).comap e.toRingHom =
      Ideal.span ({y} : Set Γ(Spec (H.A j), ⊤)) := by
    exact hker
  obtain ⟨hz, hprincipal⟩ :=
    ideal_regularPrincipal_of_comap_ringEquiv e (f.ker.ideal U) y hy h
  exact ⟨e y, hz, hprincipal⟩

/-- A chart's regular defining section generates the original immersion's
ideal not only on the chart, but after restriction to every smaller affine
open. This is the compatibility needed for a sheaf-level trivialization. -/
theorem RegularPrincipalImmersion.idealSheaf_affineOpen_generatesOnSubopens
    {X Z : Scheme.{u}} {f : Z ⟶ X} [QuasiCompact f]
    (H : RegularPrincipalImmersion f) (j : H.Index)
    [IsOpenImmersion (H.target j)] :
    let W : (Spec (H.A j)).affineOpens :=
      ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
    let U : X.affineOpens :=
      ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩
    ∃ z : Γ(X, U.1), IsRegular z ∧
      ∀ (V : X.affineOpens) (hVU : V.1 ≤ U.1),
        f.ker.ideal V =
          Ideal.span ({X.presheaf.map (homOfLE hVU).op z} : Set Γ(X, V.1)) := by
  dsimp only
  let W : (Spec (H.A j)).affineOpens :=
    ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
  let U : X.affineOpens :=
    ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩
  obtain ⟨z, hz, hprincipal⟩ := H.idealSheaf_affineOpen_regularPrincipal j
  refine ⟨z, hz, ?_⟩
  intro V hVU
  calc
    f.ker.ideal V = (f.ker.ideal U).map
        (X.presheaf.map (homOfLE hVU).op).hom :=
      (f.ker.map_ideal hVU).symm
    _ = Ideal.span
        ({X.presheaf.map (homOfLE hVU).op z} : Set Γ(X, V.1)) := by
      rw [hprincipal, Ideal.map_span, Set.image_singleton]

/-- The original immersion's ideal is free rank one on every principal
affine open inside a regular-principal chart. -/
theorem RegularPrincipalImmersion.idealSheaf_basicOpen_moduleFree
    {X Z : Scheme.{u}} {f : Z ⟶ X} [QuasiCompact f]
    (H : RegularPrincipalImmersion f) (j : H.Index)
    [IsOpenImmersion (H.target j)] :
    let W : (Spec (H.A j)).affineOpens :=
      ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
    let U : X.affineOpens :=
      ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩
    ∀ r : Γ(X, U.1),
      let V : X.affineOpens := ⟨X.basicOpen r, U.2.basicOpen r⟩
      Module.Free (Γ(X, V.1)) (f.ker.ideal V) := by
  dsimp only
  let W : (Spec (H.A j)).affineOpens :=
    ⟨⊤, isAffineOpen_top (Spec (H.A j))⟩
  let U : X.affineOpens :=
    ⟨H.target j ''ᵁ W, W.2.image_of_isOpenImmersion _⟩
  obtain ⟨z, hz, hgen⟩ := H.idealSheaf_affineOpen_generatesOnSubopens j
  intro r
  let V : X.affineOpens := ⟨X.basicOpen r, U.2.basicOpen r⟩
  have hreg : IsRegular (X.presheaf.map (homOfLE (X.basicOpen_le r)).op z) :=
    isRegular_affineBasicOpen_restriction U.1 U.2 r z hz
  have hprincipal := hgen V (X.basicOpen_le r)
  rw [hprincipal]
  exact Module.Free.of_equiv (regularPrincipalIdealLinearEquiv _ hreg)

end PfaffianDescent
