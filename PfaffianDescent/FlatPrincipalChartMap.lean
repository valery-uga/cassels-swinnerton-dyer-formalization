import AllCharacteristics.FlatPrincipalQuotient
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Flatness of an actual surjective principal chart map

The algebraic flatness criterion for a principal quotient is transferred
to any surjective chart map whose kernel is generated by that principal
equation. The remaining geometric task is to prove that the equation
stays regular after every base-ideal reduction.
-/

namespace PfaffianDescent

open scoped nonZeroDivisors

universe u v w

theorem flat_comp_of_surjective_principal_kernel
    {R : Type u} {A : Type v} {B : Type w}
    [CommRing R] [CommRing A] [CommRing B]
    (φ : R →+* A) (hφ : φ.Flat)
    (f : A →+* B) (hf : Function.Surjective f)
    (p : A) (hker : RingHom.ker f = Ideal.span {p})
    (hp : ∀ I : Ideal R,
      Ideal.Quotient.mk (I.map φ) p ∈ (A ⧸ I.map φ)⁰) :
    (f.comp φ).Flat := by
  let _ : Algebra R A := φ.toAlgebra
  let _ : Module.Flat R A := hφ
  have hflat : Module.Flat R (A ⧸ Ideal.span {p}) :=
    AllCharacteristics.quotient_flat_of_nonZeroDivisors_mod_base_ideals p hp
  have hquot : ((Ideal.Quotient.mk (Ideal.span {p})).comp φ).Flat := by
    rw [← RingHom.flat_algebraMap_iff] at hflat
    exact hflat
  let e : (A ⧸ Ideal.span {p}) ≃+* B :=
    (Ideal.quotEquivOfEq hker.symm).trans
      (RingHom.quotientKerEquivOfSurjective hf)
  have he : e.toRingHom.Flat := RingHom.Flat.of_bijective e.bijective
  have hcomp : e.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {p})) = f := by
    apply RingHom.ext
    intro a
    change e (Ideal.Quotient.mk (Ideal.span {p}) a) = f a
    simp only [e, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
    rfl
  have hh := RingHom.Flat.comp hquot he
  rw [← RingHom.comp_assoc, hcomp] at hh
  exact hh

end PfaffianDescent
