import PfaffianDescent.CorayOriginalCubicFunctionFieldTrdeg
import PfaffianDescent.CorayOriginalBasisRatioField
import Mathlib.FieldTheory.Perfect
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Algebra.CharP.IntermediateField
import Mathlib.SetTheory.Cardinal.Arithmetic

/-! The genuine SAME-ratio-field trdeg2 branch gives algebraic, finite and
(in characteristic zero) separable ORIGINAL function-field extension.
Finiteness comes from the actual finite coordinate tuple, not an assumed
finite type original function field as a K-algebra. SOURCE ONLY / HELD. -/
noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory MvPolynomial Module
open AllCharacteristics.HomogeneousProjective
universe u v

/-- Equal finite transcendence degree in the literal intermediate-field
tower forces algebraicity. Cardinal cancellation is restricted to the
finite degree, so no invalid cancellation of infinite cardinals occurs. -/
theorem intermediateField_isAlgebraic_of_equal_finite_trdeg
    {K F : Type u} [Field K] [Field F] [Algebra K F]
    (E : IntermediateField K F) (d : ℕ)
    (hF : Algebra.trdeg K F = d) (hE : Algebra.trdeg K E = d) :
    Algebra.IsAlgebraic E F := by
  have hsum : (d : Cardinal) + Algebra.trdeg E F = d := by
    simpa only [hF, hE] using trdeg_add_eq (A := F) K E
  have hz : Algebra.trdeg E F = 0 := by
    rcases Cardinal.add_eq_left_iff.mp hsum with hbad | hz
    · exact False.elim (Cardinal.natCast_lt_aleph0.not_ge
        ((le_max_left _ _).trans hbad))
    · exact hz
  exact trdeg_eq_zero_iff.mp hz

/-- A field generated by a finite actual tuple over K is finite over each
literal intermediate field E over which it is algebraic. The same tuple
also generates over E; its entries are integral and their finite adjoin
surjects to F by the literal inclusion. -/
theorem finiteCoordinateGeneratedField_finite_over_intermediate
    {K F : Type u} {ι : Type v} [Field K] [Field F] [Algebra K F] [Finite ι]
    (x : ι → F) (hgen : IntermediateField.adjoin K (Set.range x) = ⊤)
    (E : IntermediateField K F) [Algebra.IsAlgebraic E F] : Module.Finite E F := by
  let H := IntermediateField.adjoin E (Set.range x)
  have hgenE : H = ⊤ := IntermediateField.adjoin_eq_top_of_adjoin_eq_top K hgen
  letI : Finite (Set.range x) := (Set.finite_range x).to_subtype
  letI : Module.Finite E H := IntermediateField.finiteDimensional_adjoin
    (fun z hz => (Algebra.IsAlgebraic.isAlgebraic (R := E) z).isIntegral)
  have hsurj : Function.Surjective H.val := by
    intro z
    refine ⟨⟨z, ?_⟩, rfl⟩
    rw [hgenE]
    trivial
  exact Module.Finite.of_surjective H.val.toLinearMap hsurj

attribute [local instance] MvPolynomial.gradedAlgebra
section ActualOriginalChart
variable {K : Type u} [Field K]
variable (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
  [IsIntegral (hypersurface p hp)] (j : Fin 4)
  [hchart : Nonempty (chartι (equationIdeal p hp) j).opensRange]
local notation "F" => Scheme.functionField (hypersurface p hp)
local notation "φ" => schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)

include j hchart in
/-- Original F/E algebraicity in the genuine trdeg(E)=2 branch. The
original F trdeg2 outcome is proved internally from the cubic equation. -/
theorem cubicOriginalFunctionField_isAlgebraic_over_of_trdeg_two (hp0 : p ≠ 0) :
    letI : Algebra K F := RingHom.toAlgebra φ
    ∀ E : IntermediateField K F, Algebra.trdeg K E = 2 → Algebra.IsAlgebraic E F := by
  letI : Algebra K F := RingHom.toAlgebra φ
  intro E hE
  exact intermediateField_isAlgebraic_of_equal_finite_trdeg E 2
    (cubicOriginalFunctionField_trdeg_eq_two p hp j hp0) hE

include j hchart in
/-- Actual original normalized coordinates give finite F/E in the
trdeg(E)=2 branch. Algebraicity and generation are both derived. -/
theorem cubicOriginalFunctionField_finite_over_of_trdeg_two (hp0 : p ≠ 0) :
    letI : Algebra K F := RingHom.toAlgebra φ
    ∀ E : IntermediateField K F, Algebra.trdeg K E = 2 → Module.Finite E F := by
  letI : Algebra K F := RingHom.toAlgebra φ
  intro E hE
  letI : Algebra.IsAlgebraic E F :=
    cubicOriginalFunctionField_isAlgebraic_over_of_trdeg_two p hp j hp0 E hE
  exact finiteCoordinateGeneratedField_finite_over_intermediate
    (cubicOriginalReducedChartGenericCoordinates p hp j)
    (cubicOriginalReducedChartGenericCoordinates_adjoin_eq_top p hp j) E

include j hchart in
/-- Characteristic zero of the ORIGINAL ground field passes through its
literal coefficient inclusion into E. Perfectness then gives separability
of the derived finite extension ORIGINAL F/E. -/
theorem cubicOriginalFunctionField_finite_separable_over_of_trdeg_two
    [CharZero K] (hp0 : p ≠ 0) :
    letI : Algebra K F := RingHom.toAlgebra φ
    ∀ E : IntermediateField K F, Algebra.trdeg K E = 2 →
      Module.Finite E F ∧ Algebra.IsSeparable E F := by
  letI : Algebra K F := RingHom.toAlgebra φ
  intro E hE
  letI : CharZero E := charZero_of_injective_algebraMap (algebraMap K E).injective
  letI : PerfectField E := PerfectField.ofCharZero
  letI : Algebra.IsAlgebraic E F :=
    cubicOriginalFunctionField_isAlgebraic_over_of_trdeg_two p hp j hp0 E hE
  exact ⟨cubicOriginalFunctionField_finite_over_of_trdeg_two p hp j hp0 E hE,
    Algebra.IsAlgebraic.isSeparable_of_perfectField⟩

end ActualOriginalChart

/-- The literal SAME original bounded-family basis-ratio field is the
base field of the finite separable extension in its trdeg2 branch. All
n/y/j/b/a data and the original coefficient action remain exact. -/
theorem cubicThroughPointOriginalBasisRatioField_finite_separable_of_trdeg_two
    {K L : Type u} [Field K] [CharZero K] [CommRing L] [Algebra K L]
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hp0 : p ≠ 0)
    [IsIntegral (hypersurface p hp)]
    (n : ℕ) (y : Fin 4 → L) (hpy : p.eval₂ (algebraMap K L) y = 0)
    (j : Fin 4) [Nonempty (chartι (equationIdeal p hp) j).opensRange]
    {m : ℕ} (b : Basis (Fin m) K (cubicThroughCoordinateSections p hp n y hpy))
    (a : Fin m) :
    letI : Algebra K (hypersurface p hp).functionField :=
      (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
    Algebra.trdeg K (cubicThroughPointOriginalBasisRatioField p hp n y hpy j b a) = 2 →
      Module.Finite (cubicThroughPointOriginalBasisRatioField p hp n y hpy j b a)
        (hypersurface p hp).functionField ∧
      Algebra.IsSeparable (cubicThroughPointOriginalBasisRatioField p hp n y hpy j b a)
        (hypersurface p hp).functionField := by
  letI : Algebra K (hypersurface p hp).functionField :=
    (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
  exact cubicOriginalFunctionField_finite_separable_over_of_trdeg_two p hp j hp0
    (cubicThroughPointOriginalBasisRatioField p hp n y hpy j b a)

end PfaffianDescent.Coray
end
