import PfaffianDescent.QuarticDescent
import PfaffianDescent.CubicProjection
import Mathlib.FieldTheory.RatFunc.IntermediateField
import Mathlib.Tactic.ComputeDegree

namespace PfaffianDescent
open Polynomial Module
open scoped BigOperators RatFunc

section
variable {B : Type*} [Field B]

/-- The nonconstant part of a monic quartic, with its three free coefficients. -/
noncomputable def quarticParameterPolynomial (a : Vec B 3) : B[X] :=
  X^4 + C (a 2) * X^3 + C (a 1) * X^2 + C (a 0) * X

theorem quarticParameterPolynomial_degree (a : Vec B 3) :
    (quarticParameterPolynomial a).natDegree = 4 := by
  unfold quarticParameterPolynomial
  compute_degree!

/-- The field generated by the fourth quartic coefficient inside `B(t)`.
This gives an explicit quartic extension without an irreducibility hypothesis. -/
noncomputable abbrev QuartetField (a : Vec B 3) : IntermediateField B B⟮X⟯ :=
  IntermediateField.adjoin B {algebraMap B[X] B⟮X⟯ (quarticParameterPolynomial a)}

theorem quartetField_degree (a : Vec B 3) : finrank (QuartetField a) B⟮X⟯ = 4 := by
  rw [RatFunc.finrank_eq_max_natDegree, RatFunc.num_algebraMap, RatFunc.denom_algebraMap,
    quarticParameterPolynomial_degree, natDegree_one]
  rfl

noncomputable instance quartetField_finite (a : Vec B 3) :
    FiniteDimensional (QuartetField a) B⟮X⟯ :=
  Module.finite_of_finrank_pos (by rw [quartetField_degree]; decide)

/-- Polynomial interpolation supplies the two remaining coordinates of an affine quartet. -/
noncomputable def quartetInterpolation (b : Vec B 4) : B⟮X⟯ :=
  ∑ i, RatFunc.C (b i) * RatFunc.X^(i : ℕ)

noncomputable def quartetCoordinates (b d : Vec B 4) : Vec B⟮X⟯ 4 :=
  ![1, RatFunc.X, quartetInterpolation b, quartetInterpolation d]

theorem quartetCoordinates_ne_zero (b d : Vec B 4) : quartetCoordinates b d ≠ 0 := by
  intro h
  have hh := congrFun h 0
  exact one_ne_zero hh

end

section
variable {B : Type*} [Field B] [CharZero B]

/-- The powers of `t` are a basis over the explicit quartet field. -/
theorem quartetField_power_basis (a : Vec B 3) :
    ∃ b : Basis (Fin 4) (QuartetField a) B⟮X⟯, ∀ i, b i = RatFunc.X^(i : ℕ) :=
  primitive_power_basis (quartetField_degree a) RatFunc.X
    (RatFunc.IntermediateField.adjoin_X (QuartetField a))

noncomputable def quartetBasis (a : Vec B 3) : Basis (Fin 4) (QuartetField a) B⟮X⟯ :=
  (quartetField_power_basis a).choose

theorem quartetBasis_apply (a : Vec B 3) (i : Fin 4) :
    quartetBasis a i = RatFunc.X^(i : ℕ) := (quartetField_power_basis a).choose_spec i

/-- Four coordinate monomials evaluating to the four powers of `t`. -/
noncomputable def quartetEvaluationFrame (a : Vec B 3) : Fin 4 → Cubic (QuartetField a) 4 :=
  ![Pi.single (0, 0, 0) 1, Pi.single (0, 0, 1) 1,
    Pi.single (0, 1, 1) 1, Pi.single (1, 1, 1) 1]

theorem quartetEvaluationFrame_value (a : Vec B 3) (b d : Vec B 4) (i : Fin 4) :
    cubicEvaluation (quartetCoordinates b d) (quartetEvaluationFrame a i) = quartetBasis a i := by
  rw [quartetBasis_apply]
  have hv (j : Fin 4 × Fin 4 × Fin 4) :
      cubicEvaluation (quartetCoordinates b d) (Pi.single j (1 : QuartetField a)) =
        quartetCoordinates b d j.1 * quartetCoordinates b d j.2.1 * quartetCoordinates b d j.2.2 := by
    simp only [cubicEvaluation, Fintype.linearCombination_apply_single, one_smul]
  fin_cases i
  · change cubicEvaluation (quartetCoordinates b d) (Pi.single (0, 0, 0) (1 : QuartetField a)) = RatFunc.X^0
    rw [hv]
    change (1 : B⟮X⟯) * 1 * 1 = RatFunc.X^0
    simp
  · change cubicEvaluation (quartetCoordinates b d) (Pi.single (0, 0, 1) (1 : QuartetField a)) = RatFunc.X^1
    rw [hv]
    change (1 : B⟮X⟯) * 1 * RatFunc.X = RatFunc.X^1
    simp
  · change cubicEvaluation (quartetCoordinates b d) (Pi.single (0, 1, 1) (1 : QuartetField a)) = RatFunc.X^2
    rw [hv]
    change (1 : B⟮X⟯) * RatFunc.X * RatFunc.X = RatFunc.X^2
    ring
  · change cubicEvaluation (quartetCoordinates b d) (Pi.single (1, 1, 1) (1 : QuartetField a)) = RatFunc.X^3
    rw [hv]
    change (RatFunc.X : B⟮X⟯) * RatFunc.X * RatFunc.X = RatFunc.X^3
    ring

/-- A family of all cubic equations through the quartet in this arithmetic chart. -/
noncomputable def quartetCubic (a : Vec B 3) (b d : Vec B 4) (c : Cubic (QuartetField a) 4) :
    Cubic (QuartetField a) 4 :=
  cubicProjection (quartetCoordinates b d) (quartetBasis a) (quartetEvaluationFrame a) c

theorem quartetCubic_vanishes (a : Vec B 3) (b d : Vec B 4) (c : Cubic (QuartetField a) 4) :
    ((quartetCubic a b d c).map (algebraMap (QuartetField a) B⟮X⟯)).eval (quartetCoordinates b d) = 0 :=
  cubicProjection_vanishes _ _ _ (quartetEvaluationFrame_value a b d) c

/-- Every cubic through the quartet is obtained from the coefficient projection. -/
theorem quartetCubic_eq_self (a : Vec B 3) (b d : Vec B 4) (c : Cubic (QuartetField a) 4)
    (hF : (c.map (algebraMap (QuartetField a) B⟮X⟯)).eval (quartetCoordinates b d) = 0) :
    quartetCubic a b d c = c := cubicProjection_eq_self _ _ _ c hF

/-- The explicit quartic-function-field family has a rational projective point.
Identification of this arithmetic chart with the universal symmetric-power scheme
is a separate geometric assertion. -/
theorem quartetCubic_has_point (a : Vec B 3) (b d : Vec B 4) (c : Cubic (QuartetField a) 4) :
    ∃ x : Vec (QuartetField a) 4, x ≠ 0 ∧ (quartetCubic a b d c).eval x = 0 :=
  cubic_degree_four_descent (quartetField_degree a) (quartetCubic a b d c)
    (quartetCoordinates b d) (quartetCoordinates_ne_zero b d) (quartetCubic_vanishes a b d c)

end
end PfaffianDescent
