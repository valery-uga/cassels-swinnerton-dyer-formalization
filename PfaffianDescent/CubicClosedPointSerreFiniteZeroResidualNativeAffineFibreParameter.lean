import PfaffianDescent.CubicClosedPointSerreFiniteZeroResidualNativeAffineFibre

/-! # Actual fibre stalk quotients by literal pulled-back base parameters -/
noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
namespace PfaffianDescent
universe u
set_option backward.isDefEq.respectTransparency false

theorem cubicClosedPointSerreFiniteZeroResidual_spec_stalkMap_parameter
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (x : Spec (.of B)) (t : A) :
    (Spec.map (CommRingCat.ofHom g)).stalkMap x
      ((Spec (.of A)).presheaf.germ ⊤ ((Spec.map (CommRingCat.ofHom g)) x) (by trivial)
        ((Scheme.ΓSpecIso (.of A)).inv t)) =
      (Spec (.of B)).presheaf.germ ⊤ x (by trivial)
        ((Scheme.ΓSpecIso (.of B)).inv (g t)) := by
  rw [Scheme.Hom.germ_stalkMap_apply]
  have h := congrArg (fun h : CommRingCat.of A ⟶ Γ(Spec (.of B), ⊤) => h t)
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom g))
  have happ : (Spec.map (CommRingCat.ofHom g)).appTop
      ((Scheme.ΓSpecIso (.of A)).inv t) = (Scheme.ΓSpecIso (.of B)).inv (g t) := h.symm
  change (Spec (.of B)).presheaf.germ ⊤ x (by trivial) _ = _
  exact congrArg (fun r : Γ(Spec (.of B), ⊤) =>
    (Spec (.of B)).presheaf.germ ⊤ x (by trivial) r) happ

/-- On an actual affine closed fibre, the actual fibre stalk-map kernel is
generated by the literal image of the base parameter under the ambient stalk map. -/
theorem cubicClosedPointSerreFiniteZeroResidual_nativeAffineFibre_parameter_kernel
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (y : Spec (.of A)) [y.asIdeal.IsMaximal]
    (t : A) (ht : y.asIdeal = Ideal.span {t})
    (z : (Spec.map (CommRingCat.ofHom g)).fiber y) :
    let i := (Spec.map (CommRingCat.ofHom g)).fiberι y
    let f := Spec.map (CommRingCat.ofHom g)
    RingHom.ker (i.stalkMap z).hom = Ideal.span
      ({f.stalkMap (i z) ((Spec (.of A)).presheaf.germ ⊤ (f (i z)) (by trivial)
        ((Scheme.ΓSpecIso (.of A)).inv t))} : Set ((Spec (.of B)).presheaf.stalk (i z))) := by
  let i := (Spec.map (CommRingCat.ofHom g)).fiberι y
  letI : IsClosedImmersion ((Spec (.of A)).fromSpecResidueField y) :=
    isClosed_singleton_iff_isClosedImmersion.mp
      ((PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mpr inferInstance)
  letI : IsClosedImmersion i := by change IsClosedImmersion (pullback.fst _ _); infer_instance
  let e := (Scheme.ΓSpecIso (.of B)).commRingCatIsoToRingEquiv
  have hk := cubicClosedPointSerreFiniteZeroResidual_nativeAffineFibre_kernel_top g y
  have hspan : i.ker.ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span ({e.symm (g t)} : Set Γ(Spec (.of B), ⊤)) := by
    rw [hk, ht, Ideal.map_span, Set.image_singleton]
    change (Ideal.span {g t}).comap e.toRingHom = _
    calc
      _ = (Ideal.span {g t}).map e.symm := (Ideal.map_symm e).symm
      _ = _ := by rw [Ideal.map_span, Set.image_singleton]
  dsimp only
  rw [cubicClosedPointSerreFiniteZeroResidual_spec_stalkMap_parameter,
    ← cubicClosedPointSerreFiniteZeroResidual_affineIdeal_germ_eq_stalkMap_kernel
      i ⟨⊤, isAffineOpen_top _⟩ z (by trivial), hspan,
    Ideal.map_span, Set.image_singleton]
  rfl

/-- The corresponding literal parameter quotient is the actual fibre stalk. -/
def cubicClosedPointSerreFiniteZeroResidual_nativeAffineFibre_parameter_stalkRingEquiv
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (y : Spec (.of A)) [y.asIdeal.IsMaximal]
    (t : A) (ht : y.asIdeal = Ideal.span {t})
    (z : (Spec.map (CommRingCat.ofHom g)).fiber y) :
    let i := (Spec.map (CommRingCat.ofHom g)).fiberι y
    let f := Spec.map (CommRingCat.ofHom g)
    ((Spec (.of B)).presheaf.stalk (i z) ⧸ Ideal.span
      ({f.stalkMap (i z) ((Spec (.of A)).presheaf.germ ⊤ (f (i z)) (by trivial)
        ((Scheme.ΓSpecIso (.of A)).inv t))} : Set ((Spec (.of B)).presheaf.stalk (i z)))) ≃+*
      ((Spec.map (CommRingCat.ofHom g)).fiber y).presheaf.stalk z := by
  let i := (Spec.map (CommRingCat.ofHom g)).fiberι y
  letI : IsClosedImmersion ((Spec (.of A)).fromSpecResidueField y) :=
    isClosed_singleton_iff_isClosedImmersion.mp
      ((PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mpr inferInstance)
  letI : IsClosedImmersion i := by change IsClosedImmersion (pullback.fst _ _); infer_instance
  exact (Ideal.quotEquivOfEq
    (cubicClosedPointSerreFiniteZeroResidual_nativeAffineFibre_parameter_kernel g y t ht z).symm).trans
    ((i.stalkMap z).hom.quotientKerEquivOfSurjective (i.stalkMap_surjective z))

end PfaffianDescent
