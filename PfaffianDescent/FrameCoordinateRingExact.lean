import PfaffianDescent.FrameNormalForm
import Mathlib.Algebra.Regular.Basic

namespace PfaffianDescent.FrameCoordinateRing
open Polynomial
open scoped BigOperators

section
variable {K : Type*} [Field K]

/-- The five homogeneous evaluations detect every normal-form coefficient. -/
theorem normalData_eq_zero_of_evaluations (a : NormalData K)
    (h : ∀ p : Option (Fin 4), atLine p (normalMap a) = 0) : a = 0 := by
  have haxis (j : Fin 4) : C a.1 + X * a.2.1 j = 0 := by
    rw [← atAxis_normalMap]
    exact h (some j)
  have hc : a.1 = 0 := by
    have he := congrArg (fun p : K[X] => p.coeff 0) (haxis 0)
    simpa only [coeff_add, coeff_C_zero, coeff_X_mul_zero, coeff_zero, add_zero] using he
  have hp (j : Fin 4) : a.2.1 j = 0 := by
    have he := haxis j
    rw [hc, map_zero, zero_add] at he
    exact (mul_eq_zero.mp he).resolve_left X_ne_zero
  have hm : a.2.2 = 0 := by
    have he := h none
    rw [atDiagonal_normalMap, hc, map_zero] at he
    simp only [hp, mul_zero, Finset.sum_const_zero, zero_add] at he
    exact (mul_eq_zero.mp he).resolve_left (pow_ne_zero 2 X_ne_zero)
  exact Prod.ext hc (Prod.ext (funext hp) hm)

theorem normalMap_injective : Function.Injective (normalMap (K := K)) := by
  apply (injective_iff_map_eq_zero normalMap).mpr
  intro a ha
  apply normalData_eq_zero_of_evaluations a
  intro p
  rw [ha, map_zero]

/-- The normal-form coefficients give an actual vector-space decomposition. -/
noncomputable def normalEquiv : NormalData K ≃ₗ[K] FrameCoordinateRing K :=
  LinearEquiv.ofBijective normalMap ⟨normalMap_injective, normalMap_surjective⟩

/-- The quadratic quotient embeds in the product of the five line coordinate rings. -/
theorem lineEvaluation_injective : Function.Injective (lineEvaluation (K := K)) := by
  apply (injective_iff_map_eq_zero lineEvaluation).mpr
  intro z hz
  obtain ⟨a, rfl⟩ := normalMap_surjective z
  have ha : a = 0 := normalData_eq_zero_of_evaluations a (fun p => congrFun hz p)
  rw [ha, map_zero]

/-- Precisely the polynomials vanishing identically on the five frame lines lie in the
ideal generated by the five displayed quadrics. -/
theorem mem_frameIdeal_iff (f : MvPolynomial (Fin 4) K) :
    f ∈ frameIdeal ↔ ∀ p : Option (Fin 4),
      MvPolynomial.aeval (frameLineVariable (K := K) p) f = 0 := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  constructor
  · intro h p
    have he := congrArg (atLine (K := K) p) h
    rw [map_zero] at he
    change MvPolynomial.aeval (frameLineVariable (K := K) p) f = 0 at he
    exact he
  · intro h
    apply lineEvaluation_injective
    funext p
    change MvPolynomial.aeval (frameLineVariable (K := K) p) f = 0
    exact h p

/-- The linear form used for the Artinian reduction. -/
noncomputable def ell : FrameCoordinateRing K := ∑ i : Fin 4, x i

theorem atAxis_ell (j : Fin 4) : atLine (K := K) (some j) ell = X := by
  classical
  simp only [ell, map_sum, atLine_x, frameLineVariable, Finset.sum_ite_eq',
    Finset.mem_univ, ↓reduceIte]

theorem atDiagonal_ell : atLine (K := K) none ell = 4 * X := by
  simp only [ell, map_sum, atLine_x, frameLineVariable, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  norm_num

/-- Multiplication by the chosen linear form is injective in characteristic zero. -/
theorem ell_isRegular [CharZero K] : IsRegular (ell (K := K)) := by
  have he (p : Option (Fin 4)) : atLine (K := K) p ell ≠ 0 := by
    cases p with
    | none =>
        rw [atDiagonal_ell]
        exact mul_ne_zero (by norm_num) X_ne_zero
    | some j => rw [atAxis_ell]; exact X_ne_zero
  have hleft : IsLeftRegular (ell (K := K)) := by
    intro a b hab
    apply lineEvaluation_injective
    funext p
    have hm := congrArg (atLine (K := K) p) hab
    simp only [map_mul] at hm
    exact mul_left_cancel₀ (he p) hm
  exact ⟨hleft, fun a b h => hleft (by simpa only [mul_comm] using h)⟩

end
end PfaffianDescent.FrameCoordinateRing
