import PfaffianDescent.CubicSurfacePointEvaluation
import PfaffianDescent.VoisinSectionLinearAlgebra
import PfaffianDescent.VoisinGenericSixteenFixedCurveCubicSections

/-!
# Cubic sections containing a plane conic

A plane conic has ideal generated by one linear and one quadratic equation.
In degree three, that ideal is the sum of the linear-times-quadratic and
quadratic-times-linear systems.  These have dimensions at most ten and four,
share the nonzero product of the generators, and contain the defining cubic
of the surface.  Consequently their image on the cubic surface has dimension
at most twelve, the conic bound used in the direct proof of Voisin's Lemma
3.3.
-/

namespace PfaffianDescent

open MvPolynomial Module
open AllCharacteristics.HomogeneousProjective

universe u

variable {K : Type u} [Field K]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Multiply a quadratic form by a fixed linear form. -/
noncomputable def linearTimesQuadratic
    (ell : homogeneousSubmodule (Fin 4) K 1) :
    homogeneousSubmodule (Fin 4) K 2 →ₗ[K]
      homogeneousSubmodule (Fin 4) K 3 where
  toFun q := ⟨ell.1 * q.1, by simpa using ell.2.mul q.2⟩
  map_add' q q' := by
    ext
    simp [mul_add]
  map_smul' a q := by
    ext
    simp [smul_eq_C_mul, mul_assoc, mul_comm]

/-- Multiply a linear form by a fixed quadratic form. -/
noncomputable def quadraticTimesLinear
    (q : homogeneousSubmodule (Fin 4) K 2) :
    homogeneousSubmodule (Fin 4) K 1 →ₗ[K]
      homogeneousSubmodule (Fin 4) K 3 where
  toFun ell := ⟨q.1 * ell.1, by simpa using q.2.mul ell.2⟩
  map_add' ell ell' := by
    ext
    simp [mul_add]
  map_smul' a ell := by
    ext
    simp [smul_eq_C_mul, mul_assoc, mul_comm]

/-- The degree-three part of the ideal generated by a plane equation and a
conic equation, before passage to the cubic surface coordinate ring. -/
noncomputable def planeConicCubicPolynomialSystem
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (q : homogeneousSubmodule (Fin 4) K 2) :
    Submodule K (homogeneousSubmodule (Fin 4) K 3) :=
  LinearMap.range (linearTimesQuadratic ell) ⊔
    LinearMap.range (quadraticTimesLinear q)

/-- Every homogeneous cubic in the ideal of the plane conic is a sum of a
linear equation times a quadratic and its quadratic equation times a
linear form.  Taking homogeneous components removes any higher-degree
coefficients in an arbitrary ideal-membership witness. -/
theorem mem_planeConicCubicPolynomialSystem_of_mem_ideal
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (q : homogeneousSubmodule (Fin 4) K 2)
    (r : homogeneousSubmodule (Fin 4) K 3)
    (hr : r.1 ∈ Ideal.span ({ell.1, q.1} : Set (MvPolynomial (Fin 4) K))) :
    r ∈ planeConicCubicPolynomialSystem ell q := by
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hr
  let A : homogeneousSubmodule (Fin 4) K 2 :=
    ⟨homogeneousComponent 2 a, homogeneousComponent_isHomogeneous _ _⟩
  let B : homogeneousSubmodule (Fin 4) K 1 :=
    ⟨homogeneousComponent 1 b, homogeneousComponent_isHomogeneous _ _⟩
  have hellA : homogeneousComponent 3 (ell.1 * a) = ell.1 * A.1 := by
    exact homogeneousComponent_mul_left ell.2 2
  have hqB : homogeneousComponent 3 (q.1 * b) = q.1 * B.1 := by
    exact homogeneousComponent_mul_left q.2 1
  have hab' : ell.1 * a + q.1 * b = r.1 := by
    simpa only [mul_comm] using hab
  have hrAB : ell.1 * A.1 + q.1 * B.1 = r.1 := by
    have h := congrArg (homogeneousComponent 3) hab'
    rw [map_add, hellA, hqB, homogeneousComponent_eq_self r.2] at h
    exact h
  apply Submodule.mem_sup.mpr
  refine ⟨linearTimesQuadratic ell A, ⟨A, rfl⟩,
    quadraticTimesLinear q B, ⟨B, rfl⟩, ?_⟩
  apply Subtype.ext
  exact hrAB

/-- Multiplying the plane equation by a quadratic stays in the cubic ideal
piece of any homogeneous ideal containing the plane equation. -/
theorem linearTimesQuadratic_range_le_homogeneousIdealPiece
    (C : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K))
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (hell : ell.1 ∈ C.toIdeal) :
    LinearMap.range (linearTimesQuadratic ell) ≤ homogeneousIdealPiece C 3 := by
  rintro r ⟨a, rfl⟩
  apply (mem_homogeneousIdealPiece_iff C 3 _).mpr
  exact C.toIdeal.mul_mem_right a.1 hell

/-- Multiplying the quadratic equation by a linear form stays in the cubic
ideal piece of any homogeneous ideal containing the quadratic equation. -/
theorem quadraticTimesLinear_range_le_homogeneousIdealPiece
    (C : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K))
    (q : homogeneousSubmodule (Fin 4) K 2)
    (hq : q.1 ∈ C.toIdeal) :
    LinearMap.range (quadraticTimesLinear q) ≤ homogeneousIdealPiece C 3 := by
  rintro r ⟨b, rfl⟩
  apply (mem_homogeneousIdealPiece_iff C 3 _).mpr
  exact C.toIdeal.mul_mem_right b.1 hq

/-- The explicit degree-three multiplication system is exactly the cubic
piece of a homogeneous plane-conic ideal. -/
theorem planeConicCubicPolynomialSystem_eq_homogeneousIdealPiece
    (C : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K))
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (q : homogeneousSubmodule (Fin 4) K 2)
    (hC : C.toIdeal = Ideal.span
      ({ell.1, q.1} : Set (MvPolynomial (Fin 4) K))) :
    planeConicCubicPolynomialSystem ell q = homogeneousIdealPiece C 3 := by
  apply le_antisymm
  · change LinearMap.range (linearTimesQuadratic ell) ⊔
      LinearMap.range (quadraticTimesLinear q) ≤ homogeneousIdealPiece C 3
    apply sup_le
    · apply linearTimesQuadratic_range_le_homogeneousIdealPiece
      rw [hC]
      exact Ideal.subset_span (Or.inl rfl)
    · apply quadraticTimesLinear_range_le_homogeneousIdealPiece
      rw [hC]
      exact Ideal.subset_span (Or.inr rfl)
  · intro r hr
    apply mem_planeConicCubicPolynomialSystem_of_mem_ideal
    rw [← hC]
    exact (mem_homogeneousIdealPiece_iff C 3 r).mp hr

/-- The projected cubic system containing a plane conic has dimension at
most twelve whenever the defining cubic of the surface belongs to that
degree-three ideal piece. -/
theorem planeConicCubicSurfaceSystem_finrank_le_twelve
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (hp0 : p ≠ 0)
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (q : homogeneousSubmodule (Fin 4) K 2)
    (hell : ell.1 ≠ 0) (hq : q.1 ≠ 0)
    (hpconic : p ∈ Ideal.span
      ({ell.1, q.1} : Set (MvPolynomial (Fin 4) K))) :
    finrank K ((planeConicCubicPolynomialSystem ell q).map
      (cubicSurfaceHomogeneousCoordinateProjection p hp 3)) ≤ 12 := by
  let f := linearTimesQuadratic ell
  let g := quadraticTimesLinear q
  let π := cubicSurfaceHomogeneousCoordinateProjection p hp 3
  have hA : finrank K (homogeneousSubmodule (Fin 4) K 2) ≤ 10 := by
    rw [four_variable_homogeneous_finrank]
    decide
  have hB : finrank K (homogeneousSubmodule (Fin 4) K 1) ≤ 4 := by
    rw [four_variable_homogeneous_finrank]
    decide
  have hcommon : ∃ h : homogeneousSubmodule (Fin 4) K 3,
      h ≠ 0 ∧ h ∈ LinearMap.range f ∧ h ∈ LinearMap.range g := by
    let h : homogeneousSubmodule (Fin 4) K 3 := f q
    refine ⟨h, ?_, ⟨q, rfl⟩, ?_⟩
    · intro hz
      have hz' : ell.1 * q.1 = 0 := congrArg Subtype.val hz
      exact (mul_ne_zero hell hq) hz'
    · refine ⟨ell, ?_⟩
      apply Subtype.ext
      exact mul_comm _ _
  have hπp : π (⟨p, hp⟩ : homogeneousSubmodule (Fin 4) K 3) = 0 := by
    apply Subtype.ext
    change (Ideal.Quotient.mk (equationIdeal p hp).toIdeal p) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    change p ∈ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))
    exact Ideal.subset_span (by simp)
  have hkilled : ∃ h : homogeneousSubmodule (Fin 4) K 3,
      h ≠ 0 ∧ h ∈ LinearMap.range f ⊔ LinearMap.range g ∧ π h = 0 :=
    ⟨⟨p, hp⟩, by intro h; exact hp0 (congrArg Subtype.val h),
      mem_planeConicCubicPolynomialSystem_of_mem_ideal ell q ⟨p, hp⟩ hpconic,
      hπp⟩
  exact two_cubic_systems_projected_finrank_le_twelve
    f g π hA hB hcommon hkilled

/-- The intrinsic cubic system of the conic on the surface is precisely the
image of the explicit two-generator polynomial system. -/
theorem fixedCurveCubicSurfaceSystem_eq_planeConicCubicPolynomialSystem_map
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (C : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K))
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (q : homogeneousSubmodule (Fin 4) K 2)
    (hC : C.toIdeal = Ideal.span
      ({ell.1, q.1} : Set (MvPolynomial (Fin 4) K))) :
    fixedCurveCubicSurfaceSystem p hp C =
      (planeConicCubicPolynomialSystem ell q).map
        (cubicSurfaceHomogeneousCoordinateProjection p hp 3) := by
  unfold fixedCurveCubicSurfaceSystem
  rw [planeConicCubicPolynomialSystem_eq_homogeneousIdealPiece C ell q hC]

/-- The intrinsic cubic system of a homogeneous plane-conic ideal has at
most twelve sections on the cubic surface. -/
theorem fixedCurveCubicSurfaceSystem_finrank_le_twelve_of_plane_conic
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (hp0 : p ≠ 0)
    (C : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K))
    (ell : homogeneousSubmodule (Fin 4) K 1)
    (q : homogeneousSubmodule (Fin 4) K 2)
    (hell : ell.1 ≠ 0) (hq : q.1 ≠ 0)
    (hC : C.toIdeal = Ideal.span
      ({ell.1, q.1} : Set (MvPolynomial (Fin 4) K)))
    (hpC : p ∈ C.toIdeal) :
    finrank K (fixedCurveCubicSurfaceSystem p hp C) ≤ 12 := by
  rw [fixedCurveCubicSurfaceSystem_eq_planeConicCubicPolynomialSystem_map
    p hp C ell q hC]
  exact planeConicCubicSurfaceSystem_finrank_le_twelve p hp hp0 ell q
    hell hq (hC ▸ hpC)

end PfaffianDescent
