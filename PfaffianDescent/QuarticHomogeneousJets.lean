import PfaffianDescent.QuarticAffineTangentSelection
import PfaffianDescent.HomogeneousDimensions
import PfaffianDescent.NormalizedProjectiveClosedPoint
import PfaffianDescent.HomogeneousQuotientMap
import AllCharacteristics.FiniteFlatCycle
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Homogeneous quadrics through the selected affine jet

The ten affine quadratic coefficients are homogenized explicitly.  This
identifies the three-dimensional kernel produced by the trace construction
with three independent homogeneous quadrics through the corresponding
projective tangent double point.
-/

namespace PfaffianDescent
namespace QuarticNet

open MvPolynomial Module TrivSqZeroExt AlgebraicGeometry CategoryTheory
open AllCharacteristics.HomogeneousProjective

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

section

variable {k : Type u} [Field k]

/-- The homogeneous ideal generated by three quadrics through a selected
jet. -/
noncomputable def jetQuadricIdeal (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2) :
    HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) k) :=
  ⟨Ideal.span (Set.range Q), Ideal.homogeneous_span _ _ (by
    intro q hq
    obtain ⟨i, rfl⟩ := hq
    exact ⟨2, hQ i⟩)⟩

/-- The projective scheme-theoretic intersection of the chosen quadric net
and a homogeneous cubic. -/
noncomputable def jetQuadricCubicIntersectionIdeal
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3) :
    HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) k) :=
  jetQuadricIdeal Q hQ ⊔ equationIdeal F hF

theorem equationIdeal_le_jetQuadricCubicIntersectionIdeal
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3) :
    (equationIdeal F hF).toIdeal ≤
      (jetQuadricCubicIntersectionIdeal Q hQ F hF).toIdeal :=
  le_sup_right

/-- The complete quadric--cubic intersection is a closed projective
subscheme of the cubic hypersurface. -/
noncomputable def jetQuadricCubicIntersectionToHypersurface
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3) :
    scheme (jetQuadricCubicIntersectionIdeal Q hQ F hF) ⟶ hypersurface F hF :=
  schemeQuotientMap (equationIdeal F hF) (jetQuadricCubicIntersectionIdeal Q hQ F hF)
    (equationIdeal_le_jetQuadricCubicIntersectionIdeal Q hQ F hF)

instance jetQuadricCubicIntersectionToHypersurface_isClosedImmersion
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3) :
    IsClosedImmersion (jetQuadricCubicIntersectionToHypersurface Q hQ F hF) :=
  schemeQuotientMap_closedImmersion (equationIdeal F hF)
    (jetQuadricCubicIntersectionIdeal Q hQ F hF)
    (equationIdeal_le_jetQuadricCubicIntersectionIdeal Q hQ F hF)

theorem jetQuadricCubicIntersectionToHypersurface_toBase
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3) :
    jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫ hypersurfaceToBase F hF =
      toBase (jetQuadricCubicIntersectionIdeal Q hQ F hF) :=
  schemeQuotientMap_toBase (equationIdeal F hF)
    (jetQuadricCubicIntersectionIdeal Q hQ F hF)
    (equationIdeal_le_jetQuadricCubicIntersectionIdeal Q hQ F hF)

end

noncomputable def homogeneousAffineQuadricExponent : Fin 10 → (Fin 4 →₀ ℕ) :=
  ![Finsupp.single 0 2, Finsupp.single 0 1 + Finsupp.single 1 1,
    Finsupp.single 0 1 + Finsupp.single 2 1, Finsupp.single 0 1 + Finsupp.single 3 1,
    Finsupp.single 1 2, Finsupp.single 1 1 + Finsupp.single 2 1,
    Finsupp.single 1 1 + Finsupp.single 3 1, Finsupp.single 2 2,
    Finsupp.single 2 1 + Finsupp.single 3 1, Finsupp.single 3 2]

theorem homogeneousAffineQuadricExponent_degree (i : Fin 10) :
    (homogeneousAffineQuadricExponent i).degree = 2 := by
  fin_cases i <;> simp [homogeneousAffineQuadricExponent]

theorem homogeneousAffineQuadricExponent_injective :
    Function.Injective homogeneousAffineQuadricExponent := by
  intro i j h
  have h0 := congrArg (fun f : Fin 4 →₀ ℕ => f 0) h
  have h1 := congrArg (fun f : Fin 4 →₀ ℕ => f 1) h
  have h2 := congrArg (fun f : Fin 4 →₀ ℕ => f 2) h
  have h3 := congrArg (fun f : Fin 4 →₀ ℕ => f 3) h
  fin_cases i <;> fin_cases j
  all_goals solve
    | rfl
    | norm_num [homogeneousAffineQuadricExponent, Finsupp.single_apply, Fin.ext_iff] at h0
    | norm_num [homogeneousAffineQuadricExponent, Finsupp.single_apply, Fin.ext_iff] at h1
    | norm_num [homogeneousAffineQuadricExponent, Finsupp.single_apply, Fin.ext_iff] at h2
    | norm_num [homogeneousAffineQuadricExponent, Finsupp.single_apply, Fin.ext_iff] at h3

section

variable {k L : Type u} [Field k] [Field L] [Algebra k L]

/-- Homogenization of the ten affine quadratic monomials in the chart
`x₀ = 1`. -/
noncomputable def homogeneousAffineQuadrics : (Fin 10 → k) →ₗ[k] MvPolynomial (Fin 4) k :=
  Fintype.linearCombination k (fun i => monomial (homogeneousAffineQuadricExponent i) 1)

theorem homogeneousAffineQuadrics_coeff (q : Fin 10 → k) (i : Fin 10) :
    coeff (homogeneousAffineQuadricExponent i) (homogeneousAffineQuadrics q) = q i := by
  simp [homogeneousAffineQuadrics, Fintype.linearCombination_apply, coeff_sum, coeff_smul,
    coeff_monomial, homogeneousAffineQuadricExponent_injective.eq_iff]

theorem homogeneousAffineQuadrics_injective :
    Function.Injective (homogeneousAffineQuadrics (k := k)) := by
  intro q r h
  funext i
  simpa only [homogeneousAffineQuadrics_coeff] using
    congrArg (coeff (homogeneousAffineQuadricExponent i)) h

theorem homogeneousAffineQuadrics_homogeneous (q : Fin 10 → k) :
    (homogeneousAffineQuadrics q).IsHomogeneous 2 := by
  change (∑ i, q i • monomial (homogeneousAffineQuadricExponent i) 1) ∈
    homogeneousSubmodule (Fin 4) k 2
  apply (homogeneousSubmodule (Fin 4) k 2).sum_mem
  intro i _
  exact (homogeneousSubmodule (Fin 4) k 2).smul_mem (q i)
    (isHomogeneous_monomial 1 (homogeneousAffineQuadricExponent_degree i))

/-- The ten displayed monomials span the full degree-two homogeneous piece.
This uses its already-computed dimension, avoiding a separate enumeration of
all degree-two exponent vectors. -/
theorem homogeneousAffineQuadrics_exhaustive (G : MvPolynomial (Fin 4) k)
    (hG : G.IsHomogeneous 2) :
    ∃ q : Fin 10 → k, homogeneousAffineQuadrics q = G := by
  letI : FiniteDimensional k (MvPolynomial.homogeneousSubmodule (Fin 4) k 2) :=
    Module.Finite.iff_fg.mpr (MvPolynomial.homogeneousSubmodule_fg (Fin 4) k 2)
  let f : (Fin 10 → k) →ₗ[k] MvPolynomial.homogeneousSubmodule (Fin 4) k 2 :=
    (homogeneousAffineQuadrics (k := k)).codRestrict _ homogeneousAffineQuadrics_homogeneous
  have hinj : Function.Injective f := by
    intro q r h
    exact homogeneousAffineQuadrics_injective (congrArg Subtype.val h)
  have hfin : Module.finrank k (Fin 10 → k) =
      Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin 4) k 2) := by
    rw [four_variable_homogeneous_finrank]
    simp only [Module.finrank_pi_fintype, finrank_self, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, smul_eq_mul, mul_one]
    decide
  obtain ⟨q, hq⟩ :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin).mp hinj ⟨G, hG⟩
  exact ⟨q, congrArg Subtype.val hq⟩

/-- The homogeneous dual point in the chart `x₀ = 1`. -/
noncomputable def homogeneousAffineDualPoint (p v : Fin 3 → L) : Fin 4 → DualNumber L :=
  ![1,
    TrivSqZeroExt.inl (p 0) + TrivSqZeroExt.inr (v 0),
    TrivSqZeroExt.inl (p 1) + TrivSqZeroExt.inr (v 1),
    TrivSqZeroExt.inl (p 2) + TrivSqZeroExt.inr (v 2)]

/-- Dehomogenization in the chart `x₀ = 1`. -/
noncomputable def dehomogenizeAtZero : MvPolynomial (Fin 4) k →ₐ[k] AffineThreeRing k :=
  MvPolynomial.aeval ![1, X 0, X 1, X 2]

/-- Homogenization by the variables `x₁,x₂,x₃` is a right inverse to
dehomogenization on the chart `x₀ = 1`. -/
theorem dehomogenizeAtZero_rename_succ (G : AffineThreeRing k) :
    dehomogenizeAtZero (k := k) (MvPolynomial.rename Fin.succ G) = G := by
  induction G using MvPolynomial.induction_on with
  | C r => simp [dehomogenizeAtZero]
  | add G H hG hH => simpa only [map_add, hG, hH]
  | mul_X G i hG =>
    rw [map_mul, map_mul, hG]
    fin_cases i <;> simp [dehomogenizeAtZero]

theorem affineFirstJet_dehomogenize (p v : Fin 3 → L) (G : MvPolynomial (Fin 4) k) :
    affineFirstJet p v (dehomogenizeAtZero G) =
      MvPolynomial.aeval (homogeneousAffineDualPoint p v) G := by
  have h : (affineFirstJet (k := k) p v).comp (dehomogenizeAtZero (k := k)) =
      MvPolynomial.aeval (homogeneousAffineDualPoint p v) := by
    ext i : 1
    fin_cases i <;>
      simp [dehomogenizeAtZero, affineFirstJet, homogeneousAffineDualPoint]
  exact AlgHom.congr_fun h G

/-- Homogeneous coordinates of an affine dual-number jet evaluate the
homogenization of an affine polynomial exactly as the original affine jet. -/
theorem homogeneousAffineDualPoint_eval_rename_succ
    (p v : Fin 3 → L) (G : AffineThreeRing k) :
    MvPolynomial.aeval (homogeneousAffineDualPoint p v)
      (MvPolynomial.rename Fin.succ G) = affineFirstJet p v G := by
  rw [← affineFirstJet_dehomogenize,
    dehomogenizeAtZero_rename_succ]

/-- The four homogeneous coordinates of a nontrivial separable affine jet
generate its dual-number algebra. -/
theorem homogeneousAffineDualPoint_eval_surjective
    [Algebra.IsSeparable k L] (p v : Fin 3 → L)
    (hp : Function.Surjective (MvPolynomial.aeval p : AffineThreeRing k →ₐ[k] L))
    (hv : v ≠ 0) :
    Function.Surjective (MvPolynomial.eval₂Hom (algebraMap k (DualNumber L))
      (homogeneousAffineDualPoint p v)) := by
  intro y
  obtain ⟨G, hG⟩ := affineFirstJet_surjective p v hp hv y
  refine ⟨MvPolynomial.rename Fin.succ G, ?_⟩
  change MvPolynomial.aeval (homogeneousAffineDualPoint p v)
    (MvPolynomial.rename Fin.succ G) = y
  rw [homogeneousAffineDualPoint_eval_rename_succ]
  exact hG

/-- A dual-number algebra over a finite field extension is finite over the
ground field. -/
theorem dualNumber_moduleFinite [FiniteDimensional k L] :
    Module.Finite k (DualNumber L) := by
  let f : (L × L) →ₗ[k] DualNumber L :=
    { toFun := fun z => TrivSqZeroExt.inl z.1 + TrivSqZeroExt.inr z.2
      map_add' := by
        intro x y
        apply TrivSqZeroExt.ext <;> simp
      map_smul' := by
        intro a x
        apply TrivSqZeroExt.ext <;>
          simp [Algebra.smul_def, TrivSqZeroExt.algebraMap_eq_inl'] }
  apply Module.Finite.of_surjective f
  intro x
  refine ⟨(x.fst, x.snd), ?_⟩
  exact TrivSqZeroExt.inl_fst_add_inr_snd_eq x

/-- Any homogeneous projective scheme containing the homogeneous affine jet
contains it as an actual closed rank-eight subscheme whenever the residue
point is separable of degree four. -/
theorem homogeneousAffineJet_closedImmersion_of_vanishing
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) k))
    (p v : Fin 3 → L)
    (hp : Function.Surjective (MvPolynomial.aeval p : AffineThreeRing k →ₐ[k] L))
    (hv : v ≠ 0)
    (hI : ∀ q : MvPolynomial (Fin 4) k, q ∈ I.toIdeal →
      MvPolynomial.aeval (homogeneousAffineDualPoint p v) q = 0) :
    ∃ j : Spec (.of (DualNumber L)) ⟶ scheme I,
      IsClosedImmersion j ∧
      j ≫ toBase I = Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
  letI : Module.Finite k (DualNumber L) := dualNumber_moduleFinite
  exact closed_point_of_normalized_coordinates I (homogeneousAffineDualPoint p v) 0
    (by simp [homogeneousAffineDualPoint]) hI
    (homogeneousAffineDualPoint_eval_surjective p v hp hv)

/-- A vanishing homogeneous cubic contains the projectivized affine
dual-number jet as a closed subscheme. -/
theorem homogeneousAffineJet_closedImmersion_into_hypersurface
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (p v : Fin 3 → L)
    (hp : Function.Surjective (MvPolynomial.aeval p : AffineThreeRing k →ₐ[k] L))
    (hv : v ≠ 0)
    (hjet : MvPolynomial.aeval (homogeneousAffineDualPoint p v) F = 0) :
    ∃ j : Spec (.of (DualNumber L)) ⟶ hypersurface F hF,
      IsClosedImmersion j ∧
      j ≫ hypersurfaceToBase F hF =
        Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
  apply homogeneousAffineJet_closedImmersion_of_vanishing (equationIdeal F hF) p v hp hv
  intro q hq
  have hle : (equationIdeal F hF).toIdeal ≤
      RingHom.ker (MvPolynomial.aeval (homogeneousAffineDualPoint p v)).toRingHom := by
    change Ideal.span {F} ≤ _
    apply Ideal.span_le.2
    intro r hr
    obtain rfl := Set.mem_singleton_iff.mp hr
    exact hjet
  exact hle hq

/-- If three homogeneous quadrics and a cubic vanish on the projectivized
affine jet, that jet is a closed subscheme of their scheme-theoretic
intersection. -/
theorem homogeneousAffineJet_closedImmersion_into_quadricCubicIntersection
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (p v : Fin 3 → L)
    (hp : Function.Surjective (MvPolynomial.aeval p : AffineThreeRing k →ₐ[k] L))
    (hv : v ≠ 0)
    (hQjet : ∀ i, MvPolynomial.aeval (homogeneousAffineDualPoint p v) (Q i) = 0)
    (hFjet : MvPolynomial.aeval (homogeneousAffineDualPoint p v) F = 0) :
    ∃ j : Spec (.of (DualNumber L)) ⟶ scheme
        (jetQuadricCubicIntersectionIdeal Q hQ F hF),
      IsClosedImmersion j ∧
      j ≫ toBase (jetQuadricCubicIntersectionIdeal Q hQ F hF) =
        Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
  apply homogeneousAffineJet_closedImmersion_of_vanishing
    (jetQuadricCubicIntersectionIdeal Q hQ F hF) p v hp hv
  intro q hq
  have hQle : (jetQuadricIdeal Q hQ).toIdeal ≤
      RingHom.ker (MvPolynomial.aeval (homogeneousAffineDualPoint p v)).toRingHom := by
    change Ideal.span (Set.range Q) ≤ _
    apply Ideal.span_le.2
    intro r hr
    obtain ⟨i, rfl⟩ := hr
    exact hQjet i
  have hFle : (equationIdeal F hF).toIdeal ≤
      RingHom.ker (MvPolynomial.aeval (homogeneousAffineDualPoint p v)).toRingHom := by
    change Ideal.span {F} ≤ _
    apply Ideal.span_le.2
    intro r hr
    obtain rfl := Set.mem_singleton_iff.mp hr
    exact hFjet
  change q ∈ ((jetQuadricIdeal Q hQ).toIdeal ⊔ (equationIdeal F hF).toIdeal) at hq
  exact (sup_le hQle hFle) hq

/-- A projective point with dual-number coordinate algebra has scheme rank
equal to the ground-field dimension of that algebra. -/
theorem dualNumberProjectivePoint_finiteSchemeRank
    [FiniteDimensional k L]
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) k))
    (j : Spec (.of (DualNumber L)) ⟶ scheme I)
    (hbase : j ≫ toBase I =
      Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))))
    [IsFinite (j ≫ toBase I)] :
    AllCharacteristics.finiteSchemeRank (j ≫ toBase I) =
      Module.finrank k (DualNumber L) := by
  letI : Module.Finite k (DualNumber L) := dualNumber_moduleFinite
  rw [AllCharacteristics.finiteSchemeRank_eq_finrank]
  rw [hbase, Scheme.Hom.finrank_SpecMap_algebraMap]
  exact congrFun (Module.rankAtStalk_eq_finrank_of_free
    (R := k) (M := DualNumber L)) _

/-- The projective affine jet has the same finite rank as its dual-number
coordinate algebra. -/
theorem homogeneousAffineJet_finiteSchemeRank
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (p v : Fin 3 → L)
    (j : Spec (.of (DualNumber L)) ⟶ hypersurface F hF)
    (hbase : j ≫ hypersurfaceToBase F hF =
      Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))))
    [IsFinite (j ≫ hypersurfaceToBase F hF)] :
    AllCharacteristics.finiteSchemeRank (j ≫ hypersurfaceToBase F hF) =
      Module.finrank k (DualNumber L) := by
  letI : Module.Finite k (DualNumber L) := dualNumber_moduleFinite
  rw [AllCharacteristics.finiteSchemeRank_eq_finrank]
  rw [hbase, Scheme.Hom.finrank_SpecMap_algebraMap]
  exact congrFun (Module.rankAtStalk_eq_finrank_of_free
    (R := k) (M := DualNumber L)) _

/-- A projectivized affine dual-number jet on a cubic is an actual closed
subscheme of length eight whenever its coordinate algebra has ground-field
rank eight. -/
theorem homogeneousAffineJet_rank_eight_in_hypersurface
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (p v : Fin 3 → L)
    (hp : Function.Surjective (MvPolynomial.aeval p : AffineThreeRing k →ₐ[k] L))
    (hv : v ≠ 0)
    (hjet : MvPolynomial.aeval (homogeneousAffineDualPoint p v) F = 0)
    (hrank : Module.finrank k (DualNumber L) = 8) :
    ∃ (j : Spec (.of (DualNumber L)) ⟶ hypersurface F hF),
      IsClosedImmersion j ∧ ∃ hfinite : IsFinite (j ≫ hypersurfaceToBase F hF),
      @AllCharacteristics.finiteSchemeRank k _ _ (j ≫ hypersurfaceToBase F hF) hfinite = 8 ∧
      j ≫ hypersurfaceToBase F hF =
        Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
  obtain ⟨j, hj, hbase⟩ :=
    homogeneousAffineJet_closedImmersion_into_hypersurface F hF p v hp hv hjet
  letI : Module.Finite k (DualNumber L) := dualNumber_moduleFinite
  let hfinite : IsFinite (j ≫ hypersurfaceToBase F hF) := by
    rw [hbase]
    exact (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  letI : IsFinite (j ≫ hypersurfaceToBase F hF) := hfinite
  refine ⟨j, hj, hfinite, ?_, hbase⟩
  exact (homogeneousAffineJet_finiteSchemeRank F hF p v j hbase).trans hrank

/-- The selected affine dual-number jet is a length-eight closed subscheme
of the complete intersection of any three quadrics and cubic that contain
it. -/
theorem homogeneousAffineJet_rank_eight_in_quadricCubicIntersection
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (Q : Fin 3 → MvPolynomial (Fin 4) k)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (p v : Fin 3 → L)
    (hp : Function.Surjective (MvPolynomial.aeval p : AffineThreeRing k →ₐ[k] L))
    (hv : v ≠ 0)
    (hQjet : ∀ i, MvPolynomial.aeval (homogeneousAffineDualPoint p v) (Q i) = 0)
    (hFjet : MvPolynomial.aeval (homogeneousAffineDualPoint p v) F = 0)
    (hrank : Module.finrank k (DualNumber L) = 8) :
    ∃ (j : Spec (.of (DualNumber L)) ⟶ scheme
        (jetQuadricCubicIntersectionIdeal Q hQ F hF)),
      IsClosedImmersion j ∧ ∃ hfinite : IsFinite
        (j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
          hypersurfaceToBase F hF),
      @AllCharacteristics.finiteSchemeRank k _ _
        (j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
          hypersurfaceToBase F hF) hfinite = 8 ∧
      j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
        hypersurfaceToBase F hF =
          Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
  obtain ⟨j, hj, hjbase⟩ :=
    homogeneousAffineJet_closedImmersion_into_quadricCubicIntersection
      Q hQ F hF p v hp hv hQjet hFjet
  have hbase : j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
      hypersurfaceToBase F hF =
      Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
    rw [jetQuadricCubicIntersectionToHypersurface_toBase]
    exact hjbase
  letI : Module.Finite k (DualNumber L) := dualNumber_moduleFinite
  let hfinite : IsFinite (j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
      hypersurfaceToBase F hF) := by
    rw [hbase]
    exact (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  letI : IsFinite (j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
      hypersurfaceToBase F hF) := hfinite
  refine ⟨j, hj, hfinite, ?_, hbase⟩
  rw [AllCharacteristics.finiteSchemeRank_eq_finrank]
  rw [hbase, Scheme.Hom.finrank_SpecMap_algebraMap]
  exact (congrFun (Module.rankAtStalk_eq_finrank_of_free
    (R := k) (M := DualNumber L)) _).trans hrank

theorem homogeneousAffineDualPoint_vanishes_of_affineFirstJet
    (p v : Fin 3 → L) (G : MvPolynomial (Fin 4) k)
    (hG : affineFirstJet p v (dehomogenizeAtZero G) = 0) :
    MvPolynomial.aeval (homogeneousAffineDualPoint p v) G = 0 := by
  rw [← affineFirstJet_dehomogenize]
  exact hG

/-- The trace-selected tangent direction from a separable degree-four point
produces an actual projective closed length-eight subscheme of the cubic. -/
theorem affine_length_eight_projectivized
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (b : Basis (Fin 4) k L) (hb : b 0 = 1)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (hpoint : MvPolynomial.aeval b F = 0)
    (hsmooth : affineDifferential (fun i : Fin 3 => b i.succ)
      (dehomogenizeAtZero F) ≠ 0) :
    ∃ (v : Fin 3 → L), v ≠ 0 ∧
      ∃ (j : Spec (.of (DualNumber L)) ⟶ hypersurface F hF),
        IsClosedImmersion j ∧ ∃ hfinite : IsFinite (j ≫ hypersurfaceToBase F hF),
        @AllCharacteristics.finiteSchemeRank k _ _ (j ≫ hypersurfaceToBase F hF) hfinite = 8 ∧
        j ≫ hypersurfaceToBase F hF =
          Spec.map (CommRingCat.ofHom (algebraMap k (DualNumber L))) := by
  have hpoint_affine : MvPolynomial.aeval (fun i : Fin 3 => b i.succ)
      (dehomogenizeAtZero F) = 0 := by
    have hcomp : (MvPolynomial.aeval (fun i : Fin 3 => b i.succ)).comp
        (dehomogenizeAtZero (k := k)) = MvPolynomial.aeval b := by
      ext i : 1
      fin_cases i <;> simp [dehomogenizeAtZero, hb]
    change ((MvPolynomial.aeval (fun i : Fin 3 => b i.succ)).comp
      (dehomogenizeAtZero (k := k))) F = 0
    rw [hcomp]
    exact hpoint
  obtain ⟨v, hjet, hv, -, -, hrank, -⟩ :=
    affine_length_eight_construction b hb (dehomogenizeAtZero F) hpoint_affine hsmooth
  have hhom : MvPolynomial.aeval
      (homogeneousAffineDualPoint (fun i : Fin 3 => b i.succ) v) F = 0 :=
    homogeneousAffineDualPoint_vanishes_of_affineFirstJet
      (fun i : Fin 3 => b i.succ) v F hjet
  obtain ⟨j, hj, hfinite, hlength, hbase⟩ :=
    homogeneousAffineJet_rank_eight_in_hypersurface F hF
      (fun i : Fin 3 => b i.succ) v
      (affineResidueEvaluation_surjective b hb) hv hhom hrank
  exact ⟨v, hv, j, hj, hfinite, hlength, hbase⟩

theorem homogeneousAffineQuadrics_eval_dual (p v : Fin 3 → L) (q : Fin 10 → k) :
    MvPolynomial.aeval (homogeneousAffineDualPoint p v) (homogeneousAffineQuadrics q) =
      affineFirstJet p v (affineQuadrics q) := by
  change MvPolynomial.aeval (homogeneousAffineDualPoint p v)
      (∑ i, q i • monomial (homogeneousAffineQuadricExponent i) 1) =
    MvPolynomial.aeval
      (fun i => (TrivSqZeroExt.inl (p i) + TrivSqZeroExt.inr (v i) : DualNumber L))
      (∑ i, q i • monomial (affineQuadricExponent i) 1)
  simp only [map_sum, map_smul]
  apply Finset.sum_congr rfl
  intro i _
  fin_cases i <;>
    simp [homogeneousAffineDualPoint, homogeneousAffineQuadricExponent,
      affineQuadricExponent, aeval_monomial, Finsupp.prod_add_index,
      Finsupp.prod_single_index, Fin.prod_univ_four, Fin.prod_univ_three,
      Finsupp.single_apply, pow_two] <;> ring

/-- Coefficient vectors whose homogeneous quadrics vanish on the dual point. -/
noncomputable def homogeneousAffineJetQuadrics (p v : Fin 3 → L) : Submodule k (Fin 10 → k) :=
  LinearMap.ker ((MvPolynomial.aeval (homogeneousAffineDualPoint p v)).toLinearMap.comp
    homogeneousAffineQuadrics)

theorem homogeneousAffineJetQuadrics_eq_affineJetQuadrics (p v : Fin 3 → L) :
    homogeneousAffineJetQuadrics (k := k) p v = affineJetQuadrics p v := by
  ext q
  change MvPolynomial.aeval (homogeneousAffineDualPoint p v) (homogeneousAffineQuadrics q) = 0 ↔
    affineFirstJet p v (affineQuadrics q) = 0
  rw [homogeneousAffineQuadrics_eval_dual]

/-- The trace-selected jet yields three independent homogeneous quadrics
through the associated projective tangent double point. -/
theorem exists_three_homogeneous_quadrics_of_affine_jet_dimension
    (p v : Fin 3 → L)
    (hdim : 3 ≤ Module.finrank k (affineJetQuadrics (k := k) p v)) :
    ∃ Q : Fin 3 → MvPolynomial (Fin 4) k, LinearIndependent k Q ∧
      (∀ i, (Q i).IsHomogeneous 2) ∧
      ∀ i, MvPolynomial.aeval (homogeneousAffineDualPoint p v) (Q i) = 0 := by
  let S := homogeneousAffineJetQuadrics (k := k) p v
  have hS : 3 ≤ Module.finrank k S := by
    let e : S ≃ₗ[k] affineJetQuadrics p v := LinearEquiv.ofEq _ _ (by
      dsimp [S]
      exact homogeneousAffineJetQuadrics_eq_affineJetQuadrics p v)
    have hfin : Module.finrank k S = Module.finrank k (affineJetQuadrics p v) :=
      e.finrank_eq
    omega
  obtain ⟨q, hq⟩ := exists_linearIndependent_of_le_finrank (R := k) (M := S) hS
  let f : S →ₗ[k] MvPolynomial (Fin 4) k := homogeneousAffineQuadrics.comp S.subtype
  let Q : Fin 3 → MvPolynomial (Fin 4) k := fun i => f (q i)
  have hQ : LinearIndependent k Q := by
    have hf : Function.Injective f := homogeneousAffineQuadrics_injective.comp Subtype.val_injective
    exact hq.map_injOn f hf.injOn
  refine ⟨Q, hQ, ?_, ?_⟩
  · intro i
    change (homogeneousAffineQuadrics (q i).val).IsHomogeneous 2
    exact homogeneousAffineQuadrics_homogeneous (q i).val
  · intro i
    change MvPolynomial.aeval (homogeneousAffineDualPoint p v)
      (homogeneousAffineQuadrics (q i).val) = 0
    exact (q i).property

/-- The trace-selected direction comes with three independent homogeneous
quadrics through its projective dual point. -/
theorem good_affine_tangent_direction_with_homogeneous_quadrics
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (b : Basis (Fin 4) k L) (hb : b 0 = 1) (F : AffineThreeRing k)
    (hF : affineDifferential (fun i : Fin 3 => b i.succ) F ≠ 0) :
    ∃ v : Fin 3 → L, v ≠ 0 ∧
      affineDifferential (fun i : Fin 3 => b i.succ) F v = 0 ∧
      ∃ Q : Fin 3 → MvPolynomial (Fin 4) k, LinearIndependent k Q ∧
        (∀ i, (Q i).IsHomogeneous 2) ∧
        ∀ i, MvPolynomial.aeval
          (homogeneousAffineDualPoint (fun i : Fin 3 => b i.succ) v) (Q i) = 0 := by
  obtain ⟨v, hv, ht, hdim⟩ := good_affine_tangent_direction b hb F hF
  obtain ⟨Q, hQ, hhom, hvan⟩ :=
    exists_three_homogeneous_quadrics_of_affine_jet_dimension
      (fun i : Fin 3 => b i.succ) v hdim
  exact ⟨v, hv, ht, Q, hQ, hhom, hvan⟩

/-- Proposition 4.3 in projective scheme form: a separable degree-four
point on the affine chart supplies a length-eight tangent subscheme inside
the intersection of the cubic with three independent ground-field
quadrics. -/
theorem affine_length_eight_quadricCubicIntersection
    [FiniteDimensional k L] [Algebra.IsSeparable k L]
    (b : Basis (Fin 4) k L) (hb : b 0 = 1)
    (F : MvPolynomial (Fin 4) k) (hF : F.IsHomogeneous 3)
    (hpoint : MvPolynomial.aeval b F = 0)
    (hsmooth : affineDifferential (fun i : Fin 3 => b i.succ)
      (dehomogenizeAtZero F) ≠ 0) :
    ∃ (v : Fin 3 → L) (Q : Fin 3 → MvPolynomial (Fin 4) k), v ≠ 0 ∧
      LinearIndependent k Q ∧ ∃ hQ : ∀ i, (Q i).IsHomogeneous 2,
      ∃ (j : Spec (.of (DualNumber L)) ⟶ scheme
          (jetQuadricCubicIntersectionIdeal Q hQ F hF)),
        IsClosedImmersion j ∧ ∃ hfinite : IsFinite
          (j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
            hypersurfaceToBase F hF),
        @AllCharacteristics.finiteSchemeRank k _ _
          (j ≫ jetQuadricCubicIntersectionToHypersurface Q hQ F hF ≫
            hypersurfaceToBase F hF) hfinite = 8 := by
  have hpoint_affine : MvPolynomial.aeval (fun i : Fin 3 => b i.succ)
      (dehomogenizeAtZero F) = 0 := by
    have hcomp : (MvPolynomial.aeval (fun i : Fin 3 => b i.succ)).comp
        (dehomogenizeAtZero (k := k)) = MvPolynomial.aeval b := by
      ext i : 1
      fin_cases i <;> simp [dehomogenizeAtZero, hb]
    change ((MvPolynomial.aeval (fun i : Fin 3 => b i.succ)).comp
      (dehomogenizeAtZero (k := k))) F = 0
    rw [hcomp]
    exact hpoint
  obtain ⟨v, hjet, hv, -, -, hrank, hdim⟩ :=
    affine_length_eight_construction b hb (dehomogenizeAtZero F)
      hpoint_affine hsmooth
  obtain ⟨Q, hQind, hQhom, hQjet⟩ :=
    exists_three_homogeneous_quadrics_of_affine_jet_dimension
      (fun i : Fin 3 => b i.succ) v hdim
  have hFjet : MvPolynomial.aeval
      (homogeneousAffineDualPoint (fun i : Fin 3 => b i.succ) v) F = 0 :=
    homogeneousAffineDualPoint_vanishes_of_affineFirstJet
      (fun i : Fin 3 => b i.succ) v F hjet
  obtain ⟨j, hj, hfinite, hlength, -⟩ :=
    homogeneousAffineJet_rank_eight_in_quadricCubicIntersection Q hQhom F hF
      (fun i : Fin 3 => b i.succ) v
      (affineResidueEvaluation_surjective b hb) hv hQjet hFjet hrank
  exact ⟨v, Q, hv, hQind, hQhom, j, hj, hfinite, hlength⟩

