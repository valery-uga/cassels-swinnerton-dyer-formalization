import PfaffianDescent.CoraySelectedEquationNativeFirstJetRegularity
import PfaffianDescent.CubicClosedPointSerreFiniteZeroResidualNativeStalkQuotient
import PfaffianDescent.AffineClosedImmersionIdealKernel
import AllCharacteristics.RegularAffineStalks
import Mathlib.AlgebraicGeometry.Stalk

/-! Source only. Literal affine principal cut regularity from an actual
first-jet ring map at the SAME source point. The native source stalk map,
its jet map and its principal kernel are constructed. -/
noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory TrivSqZeroExt
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- The full first jet has its own local-ring structure. -/
private def nativeSpecFirstJetLocalRing001
    (M : Type u) [Field M] : IsLocalRing (TrivSqZeroExt M (Fin 2 → M)) :=
  IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun a => by
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self a.fst with h | h
    · exact Or.inl (TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr h)
    · exact Or.inr (TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr
        (by simpa only [TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_one] using h))

attribute [local instance] nativeSpecFirstJetLocalRing001

/-- The actual equality-of-points stalk transport preserves literal germs. -/
private theorem nativeSpec_pointStalkIso_germ_top001
    (X : Scheme.{u}) (x y : X) (h : x = y) (a : Γ(X, ⊤)) :
    (eqToIso (congrArg X.presheaf.stalk h)).hom
      (X.presheaf.germ ⊤ x (by trivial) a) =
        X.presheaf.germ ⊤ y (by trivial) a := by
  subst y
  rfl

/-- The exact native stalk kernel of a surjective affine principal cut is
generated by the actual germ of its actual equation. No stalk kernel is supplied. -/
theorem nativeSpec_surjectivePrincipal_stalkMap_kernel001
    {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : Function.Surjective f) (q : R)
    (hKernel : RingHom.ker f = Ideal.span ({q} : Set R))
    (z : Spec (.of S)) :
    let i := Spec.map (CommRingCat.ofHom f)
    RingHom.ker (i.stalkMap z).hom = Ideal.span
      ({((Spec (.of R)).presheaf.germ ⊤ (i z) (by trivial))
        ((Scheme.ΓSpecIso (.of R)).inv q)} : Set ((Spec (.of R)).presheaf.stalk (i z))) := by
  let i : Spec (.of S) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom f)
  letI : IsClosedImmersion i := IsClosedImmersion.spec_of_surjective _ hf
  let e := (Scheme.ΓSpecIso (.of R)).commRingCatIsoToRingEquiv
  have hTop : i.ker.ideal (⟨⊤, isAffineOpen_top (Spec (.of R))⟩ : (Spec (.of R)).affineOpens) =
      Ideal.span ({e.symm q} : Set Γ(Spec (.of R), ⊤)) := by
    rw [specMap_ker_ideal_top]
    change (RingHom.ker f).comap e.toRingHom = _
    rw [hKernel]
    calc
      _ = (Ideal.span {q}).map e.symm := (Ideal.map_symm e).symm
      _ = _ := by rw [Ideal.map_span, Set.image_singleton]
  dsimp only
  rw [← cubicClosedPointSerreFiniteZeroResidual_affineIdeal_germ_eq_stalkMap_kernel
    i ⟨⊤, isAffineOpen_top _⟩ z (by trivial), hTop,
    Ideal.map_span, Set.image_singleton]
  rfl

/-- Actual nonzero jet of the affine principal equation yields regularity
of the SAME cut point. The local jet map is constructed from stalkClosedPointTo
and actual source-point transport, and the native kernel is derived internally.
The point equality is literal source-map incidence, not a regularity certificate. -/
theorem nativeSpec_surjectivePrincipal_regular_of_actualFirstJet001
    {R S M : Type u} [CommRing R] [IsRegularRing R] [CommRing S] [Field M]
    (f : R →+* S) (hf : Function.Surjective f) (q : R)
    (hKernel : RingHom.ker f = Ideal.span ({q} : Set R))
    (g : R →+* TrivSqZeroExt M (Fin 2 → M))
    (hqvalue : (g q).fst = 0) (hqderivative : (g q).snd ≠ 0)
    (z : Spec (.of S))
    (hPoint : Spec.map (CommRingCat.ofHom f) z =
      Spec.map (CommRingCat.ofHom g)
        (IsLocalRing.closedPoint (TrivSqZeroExt M (Fin 2 → M)))) :
    IsRegularLocalRing ((Spec (.of S)).presheaf.stalk z) := by
  let i : Spec (.of S) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom f)
  let r : Spec (.of (TrivSqZeroExt M (Fin 2 → M))) ⟶ Spec (.of R) :=
    Spec.map (CommRingCat.ofHom g)
  let a := (Scheme.ΓSpecIso (.of R)).inv q
  let q₀ := (Spec (.of R)).presheaf.germ ⊤ (i z) (by trivial) a
  let e : (Spec (.of R)).presheaf.stalk (i z) ≅
      (Spec (.of R)).presheaf.stalk
        (r (IsLocalRing.closedPoint (TrivSqZeroExt M (Fin 2 → M)))) :=
    eqToIso (congrArg (Spec (.of R)).presheaf.stalk hPoint)
  let ψ := e.hom ≫ Scheme.stalkClosedPointTo r
  let φ := ψ.hom
  letI : IsLocalHom e.hom.hom := _root_.isLocalHom_of_iso e
  letI : IsLocalHom φ := by
    change IsLocalHom ((Scheme.stalkClosedPointTo r).hom.comp e.hom.hom)
    exact RingHom.isLocalHom_comp _ _
  letI : IsRegularLocalRing ((Spec (.of R)).presheaf.stalk (i z)) :=
    AllCharacteristics.isRegularLocalRing_spec_stalk R (i z)
  letI : IsClosedImmersion i := IsClosedImmersion.spec_of_surjective _ hf
  have hEval : φ q₀ = g q := by
    change Scheme.stalkClosedPointTo r
      (e.hom ((Spec (.of R)).presheaf.germ ⊤ (i z) (by trivial) a)) = g q
    rw [nativeSpec_pointStalkIso_germ_top001 (Spec (.of R)) (i z)
      (r (IsLocalRing.closedPoint (TrivSqZeroExt M (Fin 2 → M)))) hPoint a]
    have h := ConcreteCategory.congr_hom
      (Scheme.germ_stalkClosedPointTo_Spec (CommRingCat.ofHom g)) a
    change Scheme.stalkClosedPointTo r
      ((Spec (.of R)).presheaf.germ ⊤ _ (by trivial) a) =
        g ((Scheme.ΓSpecIso (.of R)).hom a) at h
    simpa only [a, Iso.inv_hom_id_apply] using h
  have hNativeKernel : RingHom.ker (i.stalkMap z).hom =
      Ideal.span ({q₀} : Set ((Spec (.of R)).presheaf.stalk (i z))) :=
    nativeSpec_surjectivePrincipal_stalkMap_kernel001 f hf q hKernel z
  apply nativeFirstJet_nonzero_derivative_regular_actualPrincipalTarget001
    (i.stalkMap z).hom (i.stalkMap_surjective z) φ q₀ hNativeKernel
  · simpa only [hEval] using hqvalue
  · simpa only [hEval] using hqderivative

end PfaffianDescent.Coray
