import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Algebra.MvPolynomial.NoZeroDivisors
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Nullstellensatz
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

/-! SOURCE ONLY / UNVERIFIED150. Actual THREE-variable homogeneous-factor
intersection: two generators force height at most TWO, whereas the actual
irrelevant ideal has a THREE-step coordinate-prime chain. No Fin4 height is
relabelled and no common-point conclusion is a final-caller premise. -/
noncomputable section
namespace PfaffianDescent.Coray
open MvPolynomial
universe u

/-- The affine origin has exactly the irrelevant ideal as its vanishing ideal.
Together with the Nullstellensatz, this identifies the algebraic obstruction
to a projective common zero of two homogeneous factors. -/
theorem plane_vanishingIdeal_origin_eq_idealOfVars
    {K : Type u} [Field K] :
    MvPolynomial.vanishingIdeal K ({0} : Set (Fin 3 → K)) =
      MvPolynomial.idealOfVars (Fin 3) K := by
  ext p
  rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
  change MvPolynomial.aeval (0 : Fin 3 → K) p = 0 ↔
    p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 3 → MvPolynomial (Fin 3) K))
  rw [MvPolynomial.aeval_zero]
  constructor
  · intro hp
    rw [← Set.image_univ]
    apply MvPolynomial.mem_ideal_span_X_image.mpr
    intro m hm
    by_contra h
    push Not at h
    have hm0 : m = 0 := by
      ext i
      exact h i (Set.mem_univ _)
    rw [hm0] at hm
    rw [Algebra.algebraMap_self, RingHom.id_apply, MvPolynomial.constantCoeff_eq] at hp
    exact (MvPolynomial.mem_support_iff.mp hm) hp
  · intro hp
    rw [← Set.image_univ] at hp
    obtain h := MvPolynomial.mem_ideal_span_X_image.mp hp
    by_contra hp0
    have hsupp : (0 : Fin 3 →₀ ℕ) ∈ p.support :=
      MvPolynomial.mem_support_iff.mpr hp0
    obtain ⟨i, -, hi⟩ := h 0 hsupp
    exact hi rfl

/-- The irrelevant ideal in a polynomial ring over a field is prime. -/
theorem plane_idealOfVars_isPrime
    {K : Type u} [Field K] :
    (MvPolynomial.idealOfVars (Fin 3) K).IsPrime := by
  rw [← plane_vanishingIdeal_origin_eq_idealOfVars (K := K)]
  infer_instance

/-- If the affine zero locus of an ideal over an algebraically closed field
contains only the origin, its radical is the irrelevant ideal.  The remaining
projective-intersection step will rule this out for an ideal generated by two
positive-degree factors in three variables. -/
theorem plane_radical_eq_idealOfVars_of_zeroLocus_subset_origin
    {K : Type u} [Field K] [IsAlgClosed K]
    (I : Ideal (MvPolynomial (Fin 3) K))
    (hzero : (0 : Fin 3 → K) ∈ MvPolynomial.zeroLocus K I)
    (honly : MvPolynomial.zeroLocus K I ≤ ({0} : Set (Fin 3 → K))) :
    I.radical = MvPolynomial.idealOfVars (Fin 3) K := by
  have hEq : MvPolynomial.zeroLocus K I = ({0} : Set (Fin 3 → K)) := by
    apply Set.Subset.antisymm honly
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact hzero
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := K) (k := K) I, hEq,
    plane_vanishingIdeal_origin_eq_idealOfVars (K := K)]

/-- When an ideal has the irrelevant ideal as its radical, that ideal is its
unique minimal prime. -/
theorem plane_idealOfVars_mem_minimalPrimes_of_radical_eq
    {K : Type u} [Field K] (I : Ideal (MvPolynomial (Fin 3) K))
    (hrad : I.radical = MvPolynomial.idealOfVars (Fin 3) K) :
    MvPolynomial.idealOfVars (Fin 3) K ∈ I.minimalPrimes := by
  rw [← Ideal.radical_minimalPrimes, hrad]
  letI : (MvPolynomial.idealOfVars (Fin 3) K).IsPrime := plane_idealOfVars_isPrime
  simp only [Ideal.minimalPrimes_eq_subsingleton_self, Set.mem_singleton_iff]

/-- An ideal generated by two elements cannot have the irrelevant ideal as a
minimal prime of height greater than two.  This is the Krull-height half of
the projective intersection argument for two factors. -/
theorem plane_height_idealOfVars_le_two_of_radical_eq_span_pair
    {K : Type u} [Field K] (a b : MvPolynomial (Fin 3) K)
    (hrad : (Ideal.span ({a, b} : Set (MvPolynomial (Fin 3) K))).radical =
      MvPolynomial.idealOfVars (Fin 3) K) :
    (MvPolynomial.idealOfVars (Fin 3) K).height ≤ 2 := by
  have hminimal := plane_idealOfVars_mem_minimalPrimes_of_radical_eq
    (Ideal.span ({a, b} : Set (MvPolynomial (Fin 3) K))) hrad
  have hbound := Ideal.height_le_card_of_mem_minimalPrimes_span
    (p := MvPolynomial.idealOfVars (Fin 3) K)
    (s := ({a, b} : Set (MvPolynomial (Fin 3) K))) (by simp) hminimal
  exact hbound.trans <| by
    exact_mod_cast
      (calc
        ({a, b} : Set (MvPolynomial (Fin 3) K)).ncard ≤ ({b} : Set _).ncard + 1 :=
          Set.ncard_insert_le _ _
        _ = 2 := by simp)

private noncomputable def plane_irrelevantProjection₁ {K : Type u} [Field K] :
    MvPolynomial (Fin 3) K →+* MvPolynomial (Fin 2) K :=
  MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0, MvPolynomial.X 1]

private noncomputable def plane_irrelevantProjection₂ {K : Type u} [Field K] :
    MvPolynomial (Fin 3) K →+* MvPolynomial (Fin 1) K :=
  MvPolynomial.eval₂Hom MvPolynomial.C ![0, 0, MvPolynomial.X 0]

private noncomputable def plane_irrelevantProjection₃ {K : Type u} [Field K] :
    MvPolynomial (Fin 3) K →+* K :=
  MvPolynomial.eval₂Hom (RingHom.id K) 0

private noncomputable def plane_irrelevantStep₁₂ {K : Type u} [Field K] :
    MvPolynomial (Fin 2) K →+* MvPolynomial (Fin 1) K :=
  MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0]

private noncomputable def plane_irrelevantStep₂₃ {K : Type u} [Field K] :
    MvPolynomial (Fin 1) K →+* K :=
  MvPolynomial.eval₂Hom (RingHom.id K) 0

private theorem plane_irrelevantProjection₂_comp {K : Type u} [Field K] :
    plane_irrelevantProjection₂ (K := K) =
      (plane_irrelevantStep₁₂ (K := K)).comp (plane_irrelevantProjection₁ (K := K)) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [plane_irrelevantProjection₁, plane_irrelevantProjection₂, plane_irrelevantStep₁₂]
  · intro i
    fin_cases i <;>
      simp [plane_irrelevantProjection₁, plane_irrelevantProjection₂, plane_irrelevantStep₁₂]

private theorem plane_irrelevantProjection₃_comp {K : Type u} [Field K] :
    plane_irrelevantProjection₃ (K := K) =
      (plane_irrelevantStep₂₃ (K := K)).comp (plane_irrelevantProjection₂ (K := K)) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [plane_irrelevantProjection₂, plane_irrelevantProjection₃, plane_irrelevantStep₂₃]
  · intro i
    fin_cases i <;>
      simp [plane_irrelevantProjection₂, plane_irrelevantProjection₃, plane_irrelevantStep₂₃]

private theorem plane_irrelevant_bot_lt_ker₁ {K : Type u} [Field K] :
    (⊥ : Ideal (MvPolynomial (Fin 3) K)) <
      RingHom.ker (plane_irrelevantProjection₁ (K := K)) := by
  apply lt_of_le_of_ne bot_le
  intro h
  have hmem : MvPolynomial.X (0 : Fin 3) ∈
      RingHom.ker (plane_irrelevantProjection₁ (K := K)) := by
    change plane_irrelevantProjection₁ (K := K) (MvPolynomial.X (0 : Fin 3)) = 0
    simp [plane_irrelevantProjection₁]
  have hnot : MvPolynomial.X (0 : Fin 3) ∉
      (⊥ : Ideal (MvPolynomial (Fin 3) K)) := by simp
  exact hnot (h ▸ hmem)

private theorem plane_irrelevant_ker_lt_ker₁₂ {K : Type u} [Field K] :
    RingHom.ker (plane_irrelevantProjection₁ (K := K)) <
      RingHom.ker (plane_irrelevantProjection₂ (K := K)) := by
  apply lt_of_le_of_ne
  · intro p hp
    change plane_irrelevantProjection₂ (K := K) p = 0
    rw [plane_irrelevantProjection₂_comp]
    simp only [RingHom.comp_apply]
    rw [show plane_irrelevantProjection₁ (K := K) p = 0 from hp]
    exact map_zero _
  · intro h
    have hmem : MvPolynomial.X (1 : Fin 3) ∈
        RingHom.ker (plane_irrelevantProjection₂ (K := K)) := by
      change plane_irrelevantProjection₂ (K := K) (MvPolynomial.X (1 : Fin 3)) = 0
      simp [plane_irrelevantProjection₂]
    have hnot : MvPolynomial.X (1 : Fin 3) ∉
        RingHom.ker (plane_irrelevantProjection₁ (K := K)) := by
      change plane_irrelevantProjection₁ (K := K) (MvPolynomial.X (1 : Fin 3)) ≠ 0
      simp [plane_irrelevantProjection₁]
    exact hnot (h ▸ hmem)

private theorem plane_irrelevant_ker_lt_ker₂₃ {K : Type u} [Field K] :
    RingHom.ker (plane_irrelevantProjection₂ (K := K)) <
      RingHom.ker (plane_irrelevantProjection₃ (K := K)) := by
  apply lt_of_le_of_ne
  · intro p hp
    change plane_irrelevantProjection₃ (K := K) p = 0
    rw [plane_irrelevantProjection₃_comp]
    simp only [RingHom.comp_apply]
    rw [show plane_irrelevantProjection₂ (K := K) p = 0 from hp]
    exact map_zero _
  · intro h
    have hmem : MvPolynomial.X (2 : Fin 3) ∈
        RingHom.ker (plane_irrelevantProjection₃ (K := K)) := by
      change plane_irrelevantProjection₃ (K := K) (MvPolynomial.X (2 : Fin 3)) = 0
      simp [plane_irrelevantProjection₃]
    have hnot : MvPolynomial.X (2 : Fin 3) ∉
        RingHom.ker (plane_irrelevantProjection₂ (K := K)) := by
      change plane_irrelevantProjection₂ (K := K) (MvPolynomial.X (2 : Fin 3)) ≠ 0
      simp [plane_irrelevantProjection₂]
    exact hnot (h ▸ hmem)

private theorem plane_irrelevant_ker₃_eq_idealOfVars {K : Type u} [Field K] :
    RingHom.ker (plane_irrelevantProjection₃ (K := K)) =
      MvPolynomial.idealOfVars (Fin 3) K := by
  rw [← plane_vanishingIdeal_origin_eq_idealOfVars (K := K)]
  ext p
  rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
  change MvPolynomial.eval₂ (RingHom.id K) 0 p = 0 ↔
    plane_irrelevantProjection₃ (K := K) p = 0
  rfl

/-- The actual three-variable irrelevant ideal has height at least THREE,
from the displayed strict chain (0)<ker(Y0=0)<ker(Y0=Y1=0)<origin. -/
theorem plane_three_le_height_idealOfVars {K : Type u} [Field K] :
    (3 : ℕ∞) ≤ (MvPolynomial.idealOfVars (Fin 3) K).height := by
  let p₁ := RingHom.ker (plane_irrelevantProjection₁ (K := K))
  let p₂ := RingHom.ker (plane_irrelevantProjection₂ (K := K))
  let p₃ := RingHom.ker (plane_irrelevantProjection₃ (K := K))
  letI : (⊥ : Ideal (MvPolynomial (Fin 3) K)).IsPrime := by infer_instance
  letI : p₁.IsPrime := RingHom.ker_isPrime _
  letI : p₂.IsPrime := RingHom.ker_isPrime _
  letI : p₃.IsPrime := RingHom.ker_isPrime _
  have h₀₁ : (⊥ : Ideal (MvPolynomial (Fin 3) K)) < p₁ := plane_irrelevant_bot_lt_ker₁
  have h₁₂ : p₁ < p₂ := plane_irrelevant_ker_lt_ker₁₂
  have h₂₃ : p₂ < p₃ := plane_irrelevant_ker_lt_ker₂₃
  have h1 : (1 : ℕ∞) ≤ p₁.height := by
    simpa [Ideal.height_bot] using Ideal.height_add_one_le_of_lt_of_isPrime h₀₁
  have h2 : (2 : ℕ∞) ≤ p₂.height := by
    calc
      (2 : ℕ∞) = 1 + 1 := by norm_num
      _ ≤ p₁.height + 1 := by simpa [add_comm] using add_le_add_left h1 1
      _ ≤ p₂.height := Ideal.height_add_one_le_of_lt_of_isPrime h₁₂
  have h3 : (3 : ℕ∞) ≤ p₃.height := by
    calc
      (3 : ℕ∞) = 2 + 1 := by norm_num
      _ ≤ p₂.height + 1 := by simpa [add_comm] using add_le_add_left h2 1
      _ ≤ p₃.height := Ideal.height_add_one_le_of_lt_of_isPrime h₂₃
  simpa only [p₃, plane_irrelevant_ker₃_eq_idealOfVars] using h3

/-- A positive-degree homogeneous polynomial vanishes at the affine origin. -/
theorem plane_aeval_zero_eq_zero_of_homogeneous_pos
    {K : Type u} [Field K] (p : MvPolynomial (Fin 3) K) {n : ℕ}
    (hp : p.IsHomogeneous n) (hn : 0 < n) :
    MvPolynomial.aeval (0 : Fin 3 → K) p = 0 := by
  rw [MvPolynomial.aeval_zero, Algebra.algebraMap_self, RingHom.id_apply,
    MvPolynomial.constantCoeff_eq]
  apply hp.coeff_eq_zero
  simpa using Ne.symm hn.ne'

/-- Two positive-degree homogeneous forms in three variables over an
algebraically closed field have a common nonzero zero.  If there were none,
their affine zero locus would be the origin; the Nullstellensatz and the
three-step coordinate-prime chain would then contradict Krull's height theorem. -/
theorem plane_exists_nonzero_common_zero_of_homogeneous_pos
    {K : Type u} [Field K] [IsAlgClosed K]
    (a b : MvPolynomial (Fin 3) K) {m n : ℕ}
    (ha : a.IsHomogeneous m) (hb : b.IsHomogeneous n)
    (hm : 0 < m) (hn : 0 < n) :
    ∃ x : Fin 3 → K, x ≠ 0 ∧
      MvPolynomial.aeval x a = 0 ∧ MvPolynomial.aeval x b = 0 := by
  classical
  by_contra h
  have ha0 : MvPolynomial.aeval (0 : Fin 3 → K) a = 0 :=
    plane_aeval_zero_eq_zero_of_homogeneous_pos a ha hm
  have hb0 : MvPolynomial.aeval (0 : Fin 3 → K) b = 0 :=
    plane_aeval_zero_eq_zero_of_homogeneous_pos b hb hn
  have hzero : (0 : Fin 3 → K) ∈
      MvPolynomial.zeroLocus K (Ideal.span ({a, b} : Set (MvPolynomial (Fin 3) K))) := by
    rw [MvPolynomial.mem_zeroLocus_iff]
    let f : MvPolynomial (Fin 3) K →+* K :=
      (MvPolynomial.aeval (0 : Fin 3 → K)).toRingHom
    have hspan : Ideal.span ({a, b} : Set (MvPolynomial (Fin 3) K)) ≤ RingHom.ker f := by
      apply Ideal.span_le.2
      rintro z (rfl | rfl)
      · exact ha0
      · exact hb0
    intro p hp
    exact hspan hp
  have honly : MvPolynomial.zeroLocus K (Ideal.span ({a, b} : Set (MvPolynomial (Fin 3) K))) ≤
      ({0} : Set (Fin 3 → K)) := by
    intro x hx
    rw [Set.mem_singleton_iff]
    by_contra hx0
    have hvan := MvPolynomial.mem_zeroLocus_iff.mp hx
    have hax : MvPolynomial.aeval x a = 0 :=
      hvan a (Ideal.subset_span (by simp))
    have hbx : MvPolynomial.aeval x b = 0 :=
      hvan b (Ideal.subset_span (by simp))
    exact h ⟨x, hx0, hax, hbx⟩
  have hrad := plane_radical_eq_idealOfVars_of_zeroLocus_subset_origin
    (I := Ideal.span ({a, b} : Set (MvPolynomial (Fin 3) K))) hzero honly
  have hle := plane_height_idealOfVars_le_two_of_radical_eq_span_pair a b hrad
  have hge := plane_three_le_height_idealOfVars (K := K)
  have hbad : (3 : ℕ∞) ≤ 2 := hge.trans hle
  norm_num at hbad

end PfaffianDescent.Coray
