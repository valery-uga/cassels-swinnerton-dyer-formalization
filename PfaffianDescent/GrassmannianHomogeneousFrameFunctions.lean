import PfaffianDescent.GrassmannianOpenChartFunctions
import PfaffianDescent.GrassmannianHomogeneousFrame
import PfaffianDescent.ProjectiveFrameCoordinateMap

/-!
# Homogeneous frames from Grassmannian chart functions

This transfers the algebraic chart frame to the section rings of scheme opens
and proves that its generated homogeneous system agrees on chart overlaps.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics AllCharacteristics.HomogeneousProjective
open AllCharacteristics.UniversalHomogeneous

universe u

variable (K : Type u) [CommRing K] {X : Scheme.{u}} {m n : ℕ}
variable {τ : Type} [Finite τ] (d : ℕ)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The homogeneous frame determined by a Grassmannian chart over an open
subset of a scheme. -/
noncomputable def grassmannianOpenChartHomogeneousFrame
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ : Equiv.Perm (Fin m ⊕ Fin n))
    (f : U.toScheme ⟶ grassmannianChartScheme K m n) :
    Fin m → homogeneousSubmodule τ Γ(X, U) d :=
  grassmannianChartHomogeneousFrame (R := Γ(X, U)) d e ρ
    (grassmannianOpenChartFunctions K U f)

/-- The homogeneous system generated by the local Grassmannian chart frame. -/
noncomputable def grassmannianOpenChartHomogeneousSystem
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ : Equiv.Perm (Fin m ⊕ Fin n))
    (f : U.toScheme ⟶ grassmannianChartScheme K m n) :
    Submodule Γ(X, U) (homogeneousSubmodule τ Γ(X, U) d) :=
  grassmannianChartHomogeneousSystem (R := Γ(X, U)) d e ρ
    (grassmannianOpenChartFunctions K U f)

/-- The local Grassmannian chart forms are linearly independent over the
section ring. -/
theorem grassmannianOpenChartHomogeneousFrame_linearIndependent
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ : Equiv.Perm (Fin m ⊕ Fin n))
    (f : U.toScheme ⟶ grassmannianChartScheme K m n) :
    LinearIndependent Γ(X, U)
      (grassmannianOpenChartHomogeneousFrame K d U e ρ f) :=
  grassmannianChartHomogeneousFrame_linearIndependent (R := Γ(X, U)) d e ρ
    (grassmannianOpenChartFunctions K U f)

/-- The local chart-frame retraction is a left inverse to the local frame
linear-combination map. -/
theorem grassmannianOpenChartHomogeneousFrameRetraction_comp_map
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ : Equiv.Perm (Fin m ⊕ Fin n))
    (f : U.toScheme ⟶ grassmannianChartScheme K m n) :
    (grassmannianChartHomogeneousFrameRetraction (R := Γ(X, U)) d e ρ).comp
      (projectiveFrameMap
        (grassmannianOpenChartHomogeneousFrame K d U e ρ f)) = LinearMap.id :=
  grassmannianChartHomogeneousFrameRetraction_comp_map (R := Γ(X, U)) d e ρ
    (grassmannianOpenChartFunctions K U f)

/-- Restricting an open Grassmannian-chart frame is coefficient extension of
the original homogeneous frame. -/
theorem grassmannianOpenChartHomogeneousFrame_resLE
    {Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens) (V : X.Opens)
    (hVU : V ≤ h ⁻¹ᵁ U) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ : Equiv.Perm (Fin m ⊕ Fin n))
    (g : U.toScheme ⟶ grassmannianChartScheme K m n) (j : Fin m) :
    homogeneousSubmoduleBaseChange d (h.appLE U V hVU).hom
      (grassmannianOpenChartHomogeneousFrame K d U e ρ g j) =
        grassmannianOpenChartHomogeneousFrame K d V e ρ
          (h.resLE U V hVU ≫ g) j := by
  change homogeneousSubmoduleBaseChange d (h.appLE U V hVU).hom
    (grassmannianChartHomogeneousFrame (R := Γ(Y, U)) d e ρ
      (grassmannianOpenChartFunctions K U g) j) =
    grassmannianChartHomogeneousFrame (R := Γ(X, V)) d e ρ
      (grassmannianOpenChartFunctions K V (h.resLE U V hVU ≫ g)) j
  rw [grassmannianChartHomogeneousFrame_baseChange]
  rw [grassmannianOpenChartFunctions_resLE]

/-- The homogeneous system itself restricts by scalar extension on every
inclusion of scheme opens. -/
theorem grassmannianOpenChartHomogeneousSystem_resLE
    {Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens) (V : X.Opens)
    (hVU : V ≤ h ⁻¹ᵁ U) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ : Equiv.Perm (Fin m ⊕ Fin n))
    (g : U.toScheme ⟶ grassmannianChartScheme K m n) :
    homogeneousSystemBaseChange d (h.appLE U V hVU).hom
      (grassmannianOpenChartHomogeneousSystem K d U e ρ g) =
        grassmannianOpenChartHomogeneousSystem K d V e ρ
          (h.resLE U V hVU ≫ g) := by
  change homogeneousSystemBaseChange d (h.appLE U V hVU).hom
    (grassmannianChartHomogeneousSystem (R := Γ(Y, U)) d e ρ
      (grassmannianOpenChartFunctions K U g)) =
    grassmannianChartHomogeneousSystem (R := Γ(X, V)) d e ρ
      (grassmannianOpenChartFunctions K V (h.resLE U V hVU ≫ g))
  rw [grassmannianChartHomogeneousSystem_baseChange]
  rw [grassmannianOpenChartFunctions_resLE]

/-- Equal Grassmannian points represented in two charts induce equal
homogeneous systems on the common open. -/
theorem grassmannianOpenChartHomogeneousSystem_eq
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ ρ' : Equiv.Perm (Fin m ⊕ Fin n))
    (f g : U.toScheme ⟶ grassmannianChartScheme K m n)
    (h : f ≫ grassmannianChartι K ρ = g ≫ grassmannianChartι K ρ') :
    grassmannianOpenChartHomogeneousSystem K d U e ρ f =
      grassmannianOpenChartHomogeneousSystem K d U e ρ' g := by
  apply grassmannianChartHomogeneousSystem_eq_of_submodule_eq (R := Γ(X, U)) d e
    ρ ρ' (grassmannianOpenChartFunctions K U f)
      (grassmannianOpenChartFunctions K U g)
  exact grassmannianOpenChartFunctions_submodule_eq K U ρ ρ' f g h

/-- Equality of two local Grassmannian-chart systems identifies the spans of
their homogeneous frames. -/
theorem grassmannianOpenChartHomogeneousFrame_span_eq
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ ρ' : Equiv.Perm (Fin m ⊕ Fin n))
    (f g : U.toScheme ⟶ grassmannianChartScheme K m n)
    (h : f ≫ grassmannianChartι K ρ = g ≫ grassmannianChartι K ρ') :
    Submodule.span Γ(X, U) (Set.range
      (grassmannianOpenChartHomogeneousFrame K d U e ρ f)) =
      Submodule.span Γ(X, U) (Set.range
        (grassmannianOpenChartHomogeneousFrame K d U e ρ' g)) := by
  change Submodule.span Γ(X, U) (Set.range
      (grassmannianChartHomogeneousFrame (R := Γ(X, U)) d e ρ
        (grassmannianOpenChartFunctions K U f))) =
    Submodule.span Γ(X, U) (Set.range
      (grassmannianChartHomogeneousFrame (R := Γ(X, U)) d e ρ'
        (grassmannianOpenChartFunctions K U g)))
  rw [← grassmannianChartHomogeneousSystem_span,
    ← grassmannianChartHomogeneousSystem_span]
  exact grassmannianOpenChartHomogeneousSystem_eq K d U e ρ ρ' f g h

/-- The projective coordinate transition on a common scheme open where two
Grassmannian chart maps represent the same submodule. -/
noncomputable def grassmannianOpenChartHomogeneousFrameProjectiveTransition
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ ρ' : Equiv.Perm (Fin m ⊕ Fin n))
    (f g : U.toScheme ⟶ grassmannianChartScheme K m n)
    (h : f ≫ grassmannianChartι K ρ = g ≫ grassmannianChartι K ρ') :
    projectiveFrameCoordinateSpace (R := Γ(X, U)) m ⟶
      projectiveFrameCoordinateSpace (R := Γ(X, U)) m :=
  projectiveFrameProjectiveTransition
    (grassmannianOpenChartHomogeneousFrame K d U e ρ f)
    (grassmannianOpenChartHomogeneousFrame K d U e ρ' g)
    (grassmannianChartHomogeneousFrameRetraction (R := Γ(X, U)) d e ρ)
    (grassmannianChartHomogeneousFrameRetraction (R := Γ(X, U)) d e ρ')
    (grassmannianOpenChartHomogeneousFrameRetraction_comp_map K d U e ρ f)
    (grassmannianOpenChartHomogeneousFrameRetraction_comp_map K d U e ρ' g)
    (grassmannianOpenChartHomogeneousFrame_span_eq K d U e ρ ρ' f g h)

/-- The two projective coordinate transitions on a common Grassmannian chart
overlap are inverse scheme morphisms. -/
theorem grassmannianOpenChartHomogeneousFrameProjectiveTransition_comp
    (U : X.Opens) (e : Fin (m + n) ≃ Monomials τ d)
    (ρ ρ' : Equiv.Perm (Fin m ⊕ Fin n))
    (f g : U.toScheme ⟶ grassmannianChartScheme K m n)
    (h : f ≫ grassmannianChartι K ρ = g ≫ grassmannianChartι K ρ') :
    grassmannianOpenChartHomogeneousFrameProjectiveTransition K d U e ρ' ρ g f h.symm ≫
      grassmannianOpenChartHomogeneousFrameProjectiveTransition K d U e ρ ρ' f g h =
        𝟙 _ := by
  exact projectiveFrameProjectiveTransition_comp
    (grassmannianOpenChartHomogeneousFrame K d U e ρ f)
    (grassmannianOpenChartHomogeneousFrame K d U e ρ' g)
    (grassmannianChartHomogeneousFrameRetraction (R := Γ(X, U)) d e ρ)
    (grassmannianChartHomogeneousFrameRetraction (R := Γ(X, U)) d e ρ')
    (grassmannianOpenChartHomogeneousFrameRetraction_comp_map K d U e ρ f)
    (grassmannianOpenChartHomogeneousFrameRetraction_comp_map K d U e ρ' g)
    (grassmannianOpenChartHomogeneousFrame_span_eq K d U e ρ ρ' f g h)

end PfaffianDescent
