import PfaffianDescent.CubicClosedPointSerreFiniteZeroResidualNativeStalkQuotient
import PfaffianDescent.AffineBaseChangeQuotientPresentation
import PfaffianDescent.AffineClosedImmersionIdealKernel

/-! # Actual affine fibre kernels and their source stalk rings -/
noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
namespace PfaffianDescent
universe u
set_option backward.isDefEq.respectTransparency false

/-- The actual affine pullback of a quotient closed immersion has the extended
ideal, transported only by the native global-section isomorphism. -/
theorem cubicClosedPointSerreFiniteZeroResidual_affineFibre_kernel_top
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (I : Ideal A) :
    (pullback.fst (Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).ker.ideal
        (⟨⊤, isAffineOpen_top (Spec (.of B))⟩ : (Spec (.of B)).affineOpens) =
      (I.map g).comap (Scheme.ΓSpecIso (.of B)).hom.hom := by
  letI : Algebra A B := g.toAlgebra
  let K : Ideal B := RingHom.ker (Algebra.TensorProduct.includeLeft
    (R := A) (S := A) (A := B) (B := A ⧸ I)).toRingHom
  let e := affineBaseChangedClosedImmersionSpecIso g I
  have he := affineBaseChangedClosedImmersionSpecIso_hom_fst g I
  have hk : (pullback.fst (Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).ker =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K))).ker := by
    rw [← he, Scheme.Hom.ker_comp_of_isIso]
  rw [hk, specMap_ker_ideal_top]
  change (RingHom.ker (Ideal.Quotient.mk K)).comap
    (Scheme.ΓSpecIso (.of B)).hom.hom = _
  rw [Ideal.mk_ker, show K = I.map g from ideal_map_eq_ker_tensor_quotient g I]

/-- The source stalk of the literal affine fibre product is the quotient of
the ambient stalk by the germ-localized extended base ideal. -/
def cubicClosedPointSerreFiniteZeroResidual_affineFibre_stalkRingEquiv
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (I : Ideal A)
    (z : ↥(pullback (Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) : Scheme.{u})) :
    let i := pullback.fst (Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    ((Spec (.of B)).presheaf.stalk (i z) ⧸
      ((I.map g).comap (Scheme.ΓSpecIso (.of B)).hom.hom).map
        ((Spec (.of B)).presheaf.germ ⊤ (i z) (by trivial)).hom) ≃+*
      (pullback (Spec.map (CommRingCat.ofHom g))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).presheaf.stalk z := by
  let i := pullback.fst (Spec.map (CommRingCat.ofHom g))
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
  letI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  let e := cubicClosedPointSerreFiniteZeroResidual_affineIdeal_quotientStalkRingEquiv
    i ⟨⊤, isAffineOpen_top _⟩ z (by trivial)
  exact (Ideal.quotEquivOfEq
    (congrArg (fun J : Ideal Γ(Spec (.of B), ⊤) =>
      J.map ((Spec (.of B)).presheaf.germ ⊤ (i z) (by trivial)).hom)
      (cubicClosedPointSerreFiniteZeroResidual_affineFibre_kernel_top g I)).symm).trans e

/-- For a principal base closed fibre, the literal fibre stalk-map kernel
is generated by the literal germ of the pulled-back parameter. -/
theorem cubicClosedPointSerreFiniteZeroResidual_affinePrincipalFibre_stalkMap_kernel
    {A B : Type u} [CommRing A] [CommRing B]
    (g : A →+* B) (t : A)
    (z : ↥(pullback (Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))) : Scheme.{u})) :
    let i := pullback.fst (Spec.map (CommRingCat.ofHom g))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t}))))
    RingHom.ker (i.stalkMap z).hom = Ideal.span
      ({((Spec (.of B)).presheaf.germ ⊤ (i z) (by trivial))
        ((Scheme.ΓSpecIso (.of B)).inv (g t))} :
        Set ((Spec (.of B)).presheaf.stalk (i z))) := by
  let i := pullback.fst (Spec.map (CommRingCat.ofHom g))
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t}))))
  letI : IsClosedImmersion (Spec.map
      (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({t} : Set A))))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  letI : IsClosedImmersion i := inferInstance
  let e := (Scheme.ΓSpecIso (.of B)).commRingCatIsoToRingEquiv
  have hk := cubicClosedPointSerreFiniteZeroResidual_affineFibre_kernel_top
    g (Ideal.span {t})
  have hspan : (i.ker.ideal ⟨⊤, isAffineOpen_top _⟩) =
      Ideal.span ({e.symm (g t)} : Set Γ(Spec (.of B), ⊤)) := by
    rw [hk, Ideal.map_span, Set.image_singleton]
    change (Ideal.span {g t}).comap e.toRingHom = _
    calc
      _ = (Ideal.span {g t}).map e.symm := (Ideal.map_symm e).symm
      _ = _ := by rw [Ideal.map_span, Set.image_singleton]
  dsimp only
  rw [← cubicClosedPointSerreFiniteZeroResidual_affineIdeal_germ_eq_stalkMap_kernel
    i ⟨⊤, isAffineOpen_top _⟩ z (by trivial), hspan,
    Ideal.map_span, Set.image_singleton]
  rfl

end PfaffianDescent
