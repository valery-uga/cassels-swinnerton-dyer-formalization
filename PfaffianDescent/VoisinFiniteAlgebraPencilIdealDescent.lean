import PfaffianDescent.VoisinCanonicalPencilCoefficients
import PfaffianDescent.PolynomialCoefficientFaithfullyFlat

/-!
# Descending the intrinsic cubic--quadratic ideal from ordered points

For a finite algebra whose ordered components detect it, the intrinsic
ordered triple-intersection ideal is the scalar extension of the unordered
ideal generated by the cubic and two independent vanishing quadrics.
Faithful flatness then identifies the unordered ideal as its contraction.
-/

namespace PfaffianDescent

open MvPolynomial
open AllCharacteristics.UniversalHomogeneous
open AllCharacteristics.HomogeneousProjective

universe u

theorem quadraticHomogeneousPair_intrinsicTripleIdeal_eq_idealMap
    {K A L : Type u} [Field K] [CommRing A] [Algebra K A]
    [Field L] [Algebra K L]
    (φ : Fin 8 → A →ₐ[K] L)
    (hφ : Function.Injective (fun t : A => fun i => φ i t))
    (x : Fin 4 → A)
    (q : Fin 2 → homogeneousSubmodule (Fin 4) K 2)
    (hq : LinearIndependent K q)
    (hzero : ∀ i, (q i).1.eval₂ (algebraMap K A) x = 0)
    (m : Fin 8 ↪ Monomials (Fin 4) 2)
    (hminor : IsUnit (eightPointQuadraticEvaluationMinor m
      (fun i j => φ i (x j))).det)
    (p : MvPolynomial (Fin 4) K) :
    intrinsicEightPointTripleIdeal
      (p.map (algebraMap K L)) (fun i j => φ i (x j)) =
      (Ideal.span (insert p (Set.range (fun i : Fin 2 => (q i).1)))).map
        (MvPolynomial.map (algebraMap K L)) := by
  rw [quadraticHomogeneousPair_intrinsicTripleIdeal_eq_mappedPolynomials
    φ hφ x q hq hzero m hminor p]
  simp only [Ideal.map_span, Set.image_insert_eq, ← Set.range_comp']

/-- Contraction of the intrinsic ordered triple-intersection ideal recovers
the unordered cubic--quadratic ideal exactly. -/
theorem quadraticHomogeneousPair_intrinsicTripleIdeal_comap
    {K A L : Type u} [Field K] [CommRing A] [Algebra K A]
    [Field L] [Algebra K L]
    (φ : Fin 8 → A →ₐ[K] L)
    (hφ : Function.Injective (fun t : A => fun i => φ i t))
    (x : Fin 4 → A)
    (q : Fin 2 → homogeneousSubmodule (Fin 4) K 2)
    (hq : LinearIndependent K q)
    (hzero : ∀ i, (q i).1.eval₂ (algebraMap K A) x = 0)
    (m : Fin 8 ↪ Monomials (Fin 4) 2)
    (hminor : IsUnit (eightPointQuadraticEvaluationMinor m
      (fun i j => φ i (x j))).det)
    (p : MvPolynomial (Fin 4) K) :
    Ideal.comap (MvPolynomial.map (algebraMap K L))
      (intrinsicEightPointTripleIdeal
        (p.map (algebraMap K L)) (fun i j => φ i (x j))) =
      Ideal.span (insert p (Set.range (fun i : Fin 2 => (q i).1))) := by
  rw [quadraticHomogeneousPair_intrinsicTripleIdeal_eq_idealMap
    φ hφ x q hq hzero m hminor p]
  exact mvPolynomial_comap_map_coefficientExtension _

end PfaffianDescent
