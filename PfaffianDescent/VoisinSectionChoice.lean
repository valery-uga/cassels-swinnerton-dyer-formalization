import PfaffianDescent.VoisinSectionRestriction
import PfaffianDescent.GenericRegularSection
import PfaffianDescent.HomogeneousVanishingLinearSystem
import AllCharacteristics.FlatPrincipalQuotient
import Mathlib.LinearAlgebra.Dimension.RankNullity

/-!
# Choosing the sections used in Voisin's complete intersections

The Hilbert-function estimates give dimensions of concrete kernels.  Here we
turn those inequalities into actual linearly independent homogeneous
sections.  For cubics the chosen frame starts with the defining equation of
the cubic surface; for quadrics it is an independent pair through the finite
subscheme.
-/

namespace PfaffianDescent

open MvPolynomial Module

universe u

section LinearAlgebra
variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- A nonzero vector in a space of dimension at least four extends to an
independent four-vector frame whose first vector is the prescribed one. -/
theorem exists_linearIndependent_fin_four_with_first
    (v₀ : V) (hv₀ : v₀ ≠ 0) (hdim : 4 ≤ finrank K V) :
    ∃ v : Fin 4 → V, v 0 = v₀ ∧ LinearIndependent K v := by
  have hsingle : LinearIndependent K (![v₀] : Fin 1 → V) :=
    LinearIndependent.of_subsingleton 0 hv₀
  obtain ⟨v₁, h₁⟩ := exists_linearIndependent_snoc_of_lt_finrank
    hsingle (by omega : 1 < finrank K V)
  let w₁ : Fin 2 → V := Fin.snoc (![v₀] : Fin 1 → V) v₁
  have hw₁ : LinearIndependent K w₁ := h₁
  obtain ⟨v₂, h₂⟩ := exists_linearIndependent_snoc_of_lt_finrank
    hw₁ (by omega : 2 < finrank K V)
  let w₂ : Fin 3 → V := Fin.snoc w₁ v₂
  have hw₂ : LinearIndependent K w₂ := h₂
  obtain ⟨v₃, h₃⟩ := exists_linearIndependent_snoc_of_lt_finrank
    hw₂ (by omega : 3 < finrank K V)
  let v : Fin 4 → V := Fin.snoc w₂ v₃
  exact ⟨v, by simp [v, w₂, w₁], h₃⟩

end LinearAlgebra

section Cubics
variable {K A : Type u} [Field K] [Infinite K] [CommRing A] [Algebra K A]
    [FiniteDimensional K A]

/- A homogeneous member of the ideal generated by two same-degree forms is
   already in their scalar span.  This is the graded algebra fact needed to
   turn a frame-level linear-independence witness into noncontainment in the
   two-equation ideal. -/
theorem homogeneous_mem_span_pair_eq_span_smul
    {p q h : MvPolynomial (Fin 4) K} {d : ℕ}
    (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous d)
    (hh : h.IsHomogeneous d)
    (hmem : h ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))) :
    ∃ a b : K, a • p + b • q = h := by
  obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp hmem
  refine ⟨MvPolynomial.coeff 0 u, MvPolynomial.coeff 0 v, ?_⟩
  have hu : homogeneousComponent d (u * p) = C (coeff 0 u) * p := by
    have hcomp := homogeneousComponent_mul_left (p := p) (q := u) hp 0
    rw [homogeneousComponent_zero] at hcomp
    simpa [mul_comm] using hcomp
  have hv : homogeneousComponent d (v * q) = C (coeff 0 v) * q := by
    have hcomp := homogeneousComponent_mul_left (p := q) (q := v) hq 0
    rw [homogeneousComponent_zero] at hcomp
    simpa [mul_comm] using hcomp
  have hleft := congrArg (homogeneousComponent d) huv
  rw [map_add, hu, hv, homogeneousComponent_eq_self hh] at hleft
  simpa only [smul_eq_C_mul] using hleft

/-- Three dimensions modulo the defining cubic give an actual independent
four-vector frame in the kernel of restriction, with the surface equation as
its first member. -/
theorem choose_cubic_vanishing_frame
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤
      cubicVanishingSectionsModuloEquationFinrank p hp x hpx) :
    ∃ v : Fin 4 →
        LinearMap.ker (homogeneousSectionRestriction (K := K) x 3),
      v 0 = cubicEquationKernelVector p hp x hpx ∧ LinearIndependent K v := by
  let pv := cubicEquationKernelVector p hp x hpx
  have hpv : pv ≠ 0 := by
    intro hzero
    apply hne
    have := congrArg (fun q : LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 3) ↦ q.1.1) hzero
    exact this
  have hdim : 4 ≤ finrank K
      (LinearMap.ker (homogeneousSectionRestriction (K := K) x 3)) := by
    unfold cubicVanishingSectionsModuloEquationFinrank at hsections
    omega
  exact exists_linearIndependent_fin_four_with_first pv hpv hdim

/- The frame can be unpacked into the actual polynomial equations used by a
complete-intersection construction. -/
theorem choose_cubic_vanishing_frame_data
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤
      cubicVanishingSectionsModuloEquationFinrank p hp x hpx) :
    ∃ v : Fin 4 →
        LinearMap.ker (homogeneousSectionRestriction (K := K) x 3),
      (v 0).1.1 = p ∧ LinearIndependent K v ∧
        ∀ i, (v i).1.1.IsHomogeneous 3 ∧
          (v i).1.1.eval₂ (algebraMap K A) x = 0 := by
  obtain ⟨v, hv0, hli⟩ := choose_cubic_vanishing_frame p hp hne x hpx hsections
  refine ⟨v, ?_, hli, ?_⟩
  · exact congrArg (fun q : LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 3) ↦ q.1.1) hv0
  · intro i
    refine ⟨(v i).1.2, ?_⟩
    have hz : homogeneousSectionRestriction (K := K) x 3 (v i).1 = 0 :=
      LinearMap.mem_ker.mp (v i).property
    simpa only [homogeneousSectionRestriction_apply] using hz

/-- An associated-prime avoidance certificate for the actual cubic sections
through a finite coordinate algebra produces a section regular modulo the
surface equation. -/
theorem exists_regular_cubic_section_through_coordinates
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (havoid : ∀ P ∈ associatedPrimes
      (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))
      (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))),
      ∃ q ∈ homogeneousVanishingPolynomialSubmodule (K := K) (A := A) (sigma := Fin 4) x 3,
        Ideal.Quotient.mk (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) q ∉ P) :
    ∃ q : MvPolynomial (Fin 4) K,
      q ∈ homogeneousVanishingPolynomialSubmodule (K := K) (A := A) (sigma := Fin 4) x 3 ∧
      IsRelPrime p q := by
  exact exists_isRelPrime_in_linear_system_of_avoids_associatedPrimes
    hne (homogeneousVanishingPolynomialSubmodule (K := K) (A := A) (sigma := Fin 4) x 3) havoid

/- Unpacking the concrete submodule membership exposes the geometric section
as a homogeneous cubic vanishing on the coordinate algebra. -/
theorem exists_regular_cubic_section_data
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (havoid : ∀ P ∈ associatedPrimes
      (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))
      (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))),
      ∃ q ∈ homogeneousVanishingPolynomialSubmodule (K := K) (A := A) (sigma := Fin 4) x 3,
        Ideal.Quotient.mk (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) q ∉ P) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 3 ∧ q.eval₂ (algebraMap K A) x = 0 ∧ IsRelPrime p q := by
  obtain ⟨q, hq, hrel⟩ := exists_regular_cubic_section_through_coordinates
    p hp hne x hpx havoid
  obtain ⟨hqhom, hqvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 q).mp hq
  exact ⟨q, hqhom, hqvan, hrel⟩

/- A finite-dimensional strict-drop estimate for the concrete cubic linear
system is enough to select the regular section directly.  The quotient image
and its associated-prime restrictions are left in the premise so the result
matches the form of a geometric codimension calculation. -/
theorem exists_regular_cubic_section_data_of_finrank_drop
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hdrop :
      let W := homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3
      let q : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) :=
        (Ideal.Quotient.mkₐ K (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))).toLinearMap
      let V : Submodule K
          (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) := W.map q
      ∀ P ∈ associatedPrimes
          (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)))
          (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 3 ∧ q.eval₂ (algebraMap K A) x = 0 ∧
      q ≠ 0 ∧ IsRelPrime p q := by
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 3
  have hI : Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) ≠ ⊤ :=
    Ideal.span_singleton_ne_top (homogeneous_not_isUnit_of_pos_degree hp (by decide))
  obtain ⟨q, hqW, hq0, hregular⟩ :=
    exists_regular_mod_ideal_of_finrank_drop_of_ne_top
      (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))) hI W hdrop
  have hrel : IsRelPrime p q :=
    isRelPrime_of_regular_mod_span_singleton hne hregular
  obtain ⟨hqhom, hqvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 q).mp hqW
  exact ⟨q, hqhom, hqvan, hq0, hrel⟩

/- The same associated-prime hypotheses can select two regular cubic
sections at once. This is the exact two-equation interface for the cubic
complete-intersection stage; the geometric avoidance hypotheses remain
explicit so they can later be discharged on the configuration open. -/
theorem exists_regular_cubic_pair_data_of_avoids_associatedPrimes
    (x : Fin 4 → A)
    (havoid₁ : ∀ P ∈ associatedPrimes
      (MvPolynomial (Fin 4) K) (MvPolynomial (Fin 4) K),
      ∃ q ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3, q ∉ P)
    (havoid₂ : ∀ (f : MvPolynomial (Fin 4) K),
      f ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3 →
      f ∈ nonZeroDivisors (MvPolynomial (Fin 4) K) →
      ∀ P ∈ associatedPrimes
        (MvPolynomial (Fin 4) K ⧸ Ideal.span ({f} : Set (MvPolynomial (Fin 4) K)))
        (MvPolynomial (Fin 4) K ⧸ Ideal.span ({f} : Set (MvPolynomial (Fin 4) K))),
        ∃ q ∈ homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3,
          Ideal.Quotient.mk (Ideal.span ({f} : Set (MvPolynomial (Fin 4) K))) q ∉ P) :
    ∃ f g : MvPolynomial (Fin 4) K,
      f.IsHomogeneous 3 ∧ g.IsHomogeneous 3 ∧
      f.eval₂ (algebraMap K A) x = 0 ∧
      g.eval₂ (algebraMap K A) x = 0 ∧ IsRelPrime f g := by
  obtain ⟨f, hfW, g, hgW, hfreg, hrel⟩ :=
    exists_regular_pair_of_avoids_associatedPrimes
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3)
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3)
      havoid₁ havoid₂
  obtain ⟨hfhom, hfvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 f).mp hfW
  obtain ⟨hghom, hgvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 g).mp hgW
  exact ⟨f, g, hfhom, hghom, hfvan, hgvan, hrel⟩

/- The paired codimension criterion specializes to the same concrete cubic
linear system.  This is the form used when Voisin's base-locus calculation
supplies rank drops for both the ambient and quotient systems. -/
theorem exists_regular_cubic_pair_data_of_finrank_drop
    (x : Fin 4 → A)
    (hdrop₁ : ∀ P ∈ associatedPrimes
      (MvPolynomial (Fin 4) K) (MvPolynomial (Fin 4) K),
      Module.finrank K ((P.restrictScalars K).comap
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3).subtype) <
        Module.finrank K (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3))
    (hdrop₂ : ∀ (f : MvPolynomial (Fin 4) K),
      f ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3 →
      f ∈ nonZeroDivisors (MvPolynomial (Fin 4) K) →
      let I := Ideal.span ({f} : Set (MvPolynomial (Fin 4) K))
      let q : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
      let V : Submodule K
          (MvPolynomial (Fin 4) K ⧸ I) :=
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3).map q
      ∀ P ∈ associatedPrimes (MvPolynomial (Fin 4) K ⧸ I)
          (MvPolynomial (Fin 4) K ⧸ I),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ f g : MvPolynomial (Fin 4) K,
      f.IsHomogeneous 3 ∧ g.IsHomogeneous 3 ∧
      f.eval₂ (algebraMap K A) x = 0 ∧
      g.eval₂ (algebraMap K A) x = 0 ∧ IsRelPrime f g := by
  obtain ⟨f, hfW, g, hgW, _, hrel⟩ :=
    exists_regular_pair_of_finrank_drop
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3)
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3)
      hdrop₁ hdrop₂
  obtain ⟨hfhom, hfvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 f).mp hfW
  obtain ⟨hghom, hgvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 g).mp hgW
  exact ⟨f, g, hfhom, hghom, hfvan, hgvan, hrel⟩

/- Since the polynomial ring is a domain, positive finrank of the first
cubic system removes its ambient rank-drop premise. -/
theorem exists_regular_cubic_pair_data_of_domain_finrank_drop
    (x : Fin 4 → A)
    (hpos : 0 < Module.finrank K
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3))
    (hdrop₂ : ∀ (f : MvPolynomial (Fin 4) K),
      f ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3 →
      f ∈ nonZeroDivisors (MvPolynomial (Fin 4) K) →
      let I := Ideal.span ({f} : Set (MvPolynomial (Fin 4) K))
      let q : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
      let V : Submodule K
          (MvPolynomial (Fin 4) K ⧸ I) :=
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3).map q
      ∀ P ∈ associatedPrimes (MvPolynomial (Fin 4) K ⧸ I)
          (MvPolynomial (Fin 4) K ⧸ I),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ f g : MvPolynomial (Fin 4) K,
      f.IsHomogeneous 3 ∧ g.IsHomogeneous 3 ∧
      f.eval₂ (algebraMap K A) x = 0 ∧
      g.eval₂ (algebraMap K A) x = 0 ∧ IsRelPrime f g := by
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 3
  have hW : W ≠ ⊥ :=
    homogeneousVanishingPolynomialSubmodule_ne_bot_of_finrank_pos x 3 hpos
  obtain ⟨f, hfW, g, hgW, _, hrel⟩ :=
    exists_regular_pair_of_finrank_drop_of_domain W W hW hdrop₂
  obtain ⟨hfhom, hfvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 f).mp hfW
  obtain ⟨hghom, hgvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 g).mp hgW
  exact ⟨f, g, hfhom, hghom, hfvan, hgvan, hrel⟩

/- With a prime intermediate ideal `(p,q)`, an explicit cubic section outside
that ideal is automatically regular modulo it. -/
theorem exists_regular_third_cubic_section_data_of_prime_intermediate
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (hprime : (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))).IsPrime)
    (havoid : ∃ h ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3,
      h ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))) :
    ∃ h : MvPolynomial (Fin 4) K,
      h.IsHomogeneous 3 ∧ h.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        h * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  obtain ⟨h, hhW, hreg⟩ := exists_regular_third_of_prime_intermediate
    (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))) hprime
    (homogeneousVanishingPolynomialSubmodule
      (K := K) (A := A) (sigma := Fin 4) x 3) havoid
  obtain ⟨hhom, hhvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 h).mp hhW
  exact ⟨h, hhom, hhvan, hreg⟩

/- The third cubic can also be selected from a quotient rank-drop estimate,
   without assuming that the intermediate ideal is prime. -/
theorem exists_regular_third_cubic_section_data_of_finrank_drop
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (hdrop :
      let I := Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))
      let W := homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3
      let qmap : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
      let V : Submodule K (MvPolynomial (Fin 4) K ⧸ I) := W.map qmap
      ∀ P ∈ associatedPrimes (MvPolynomial (Fin 4) K ⧸ I)
          (MvPolynomial (Fin 4) K ⧸ I),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ h : MvPolynomial (Fin 4) K,
      h.IsHomogeneous 3 ∧ h.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        h * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let I := Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 3
  let qmap : MvPolynomial (Fin 4) K →ₗ[K]
      MvPolynomial (Fin 4) K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
  let V : Submodule K (MvPolynomial (Fin 4) K ⧸ I) := W.map qmap
  have hregular : ∃ h ∈ W, ∀ y : MvPolynomial (Fin 4) K,
      h * y ∈ I → y ∈ I := by
    exact exists_regular_mod_ideal_of_finrank_drop I W hdrop
  obtain ⟨h, hhW, hreg⟩ := hregular
  obtain ⟨hhom, hhvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 h).mp hhW
  exact ⟨h, hhom, hhvan, hreg⟩

/-- A finite family of cubic--cubic quotient rank drops can be discharged by
one cubic from the common vanishing system.  The resulting cubic is regular
modulo every member of the family, without requiring those intermediate
curves to be prime. -/
theorem exists_regular_third_cubic_section_data_of_finrank_drop_family
    {ι : Type*} [Finite ι]
    (x : Fin 4 → A) (I : ι → Ideal (MvPolynomial (Fin 4) K))
    (hdrop : ∀ i : ι,
      let q : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ I i := (Ideal.Quotient.mkₐ K (I i)).toLinearMap
      let V : Submodule K (MvPolynomial (Fin 4) K ⧸ I i) :=
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3).map q
      ∀ P ∈ associatedPrimes (MvPolynomial (Fin 4) K ⧸ I i)
          (MvPolynomial (Fin 4) K ⧸ I i),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ h : MvPolynomial (Fin 4) K,
      h.IsHomogeneous 3 ∧ h.eval₂ (algebraMap K A) x = 0 ∧
      ∀ i : ι, ∀ y : MvPolynomial (Fin 4) K,
        h * y ∈ I i → y ∈ I i := by
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 3
  obtain ⟨h, hhW, hreg⟩ :=
    exists_regular_mod_ideal_of_finrank_drop_family I W (by
      intro i
      simpa only [W] using hdrop i)
  obtain ⟨hhom, hhvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 h).mp hhW
  exact ⟨h, hhom, hhvan, hreg⟩

/- The same third-section selector can consume the geometric base-locus
statement directly.  The finite-dimensional rank-drop proof is supplied by
`finrank_drop_of_avoids_associatedPrimes_mod_ideal`. -/
theorem exists_regular_third_cubic_section_data_of_avoids_associatedPrimes
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (havoid : ∀ P ∈ associatedPrimes
        (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)))
        (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))),
      ∃ h ∈ homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 3,
        Ideal.Quotient.mk (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))) h ∉ P) :
    ∃ h : MvPolynomial (Fin 4) K,
      h.IsHomogeneous 3 ∧ h.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        h * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let I := Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 3
  have hregular : ∃ h ∈ W, ∀ y : MvPolynomial (Fin 4) K,
      h * y ∈ I → y ∈ I := by
    exact exists_regular_mod_ideal_of_avoids_associatedPrimes_finrank I W
      (by simpa only [I, W] using havoid)
  obtain ⟨h, hhW, hreg⟩ := hregular
  obtain ⟨hhom, hhvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 h).mp hhW
  exact ⟨h, hhom, hhvan, hreg⟩

/- The independent frame gives a cubic section outside the line spanned by the
surface equation.  This is the concrete noncontainment certificate needed to
apply prime-quotient regularity without enumerating associated primes. -/
theorem exists_cubic_vanishing_section_not_mem_span_equation
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx) :
    ∃ q ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3,
      q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) := by
  obtain ⟨v, hv0, hli⟩ := choose_cubic_vanishing_frame p hp hne x hpx hsections
  let u : Fin 2 → LinearMap.ker (homogeneousSectionRestriction (K := K) x 3) :=
    fun i => v (Fin.castLE (by omega : 2 ≤ 4) i)
  have hui : LinearIndependent K u := by
    apply hli.comp (fun i : Fin 2 => Fin.castLE (by omega : 2 ≤ 4) i)
    exact Fin.castLE_injective (by omega)
  have hpair : LinearIndependent K ![u 0, u 1] := by
    convert hui using 1
    funext i
    fin_cases i <;> rfl
  have hv10 : (v 1).1 ≠ 0 := by
    intro hz
    apply hli.ne_zero 1
    exact Subtype.ext hz
  have hq0 : (v 1).1.1 ≠ 0 := by
    intro hz
    apply hv10
    exact Subtype.ext hz
  refine ⟨(v 1).1.1, ⟨v 1, (v 1).property, rfl⟩, ?_⟩
  intro hq
  have hdiv : p ∣ (v 1).1.1 := Ideal.mem_span_singleton.mp hq
  obtain ⟨a, ha⟩ := homogeneous_dvd_same_degree_eq_smul
    hp (v 1).1.2 hne hq0 hdiv
  have hrel : a • u 0 = u 1 := by
    apply Subtype.ext
    apply Subtype.ext
    change a • (v 0).1.1 = (v 1).1.1
    rw [hv0]
    exact ha.symm
  have hu0 : u 0 ≠ 0 := by
    dsimp [u]
    intro hz
    apply hli.ne_zero 0
    exact hz
  have hpair_ne : ∀ b : K, b • u 0 ≠ u 1 :=
    (LinearIndependent.pair_iff' (x := u 0) (y := u 1) hu0).mp hpair
  exact (hpair_ne a) hrel

/- If two same-degree cubic equations vanish on the finite coordinate algebra,
   the four-dimensional cubic kernel supplies a third vanishing cubic outside
   their ideal.  The proof combines the graded scalar-span lemma above with
   the finite-dimensional fact that two vectors cannot span a space of
   dimension at least four. -/
theorem exists_cubic_vanishing_section_not_mem_span_pair
    (p q : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hqhom : q.IsHomogeneous 3)
    (hqvan : q.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx) :
    ∃ h ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3,
      h ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  classical
  let V : Submodule K (homogeneousSubmodule (Fin 4) K 3) :=
    LinearMap.ker (homogeneousSectionRestriction (K := K) x 3)
  let pv : V := cubicEquationKernelVector p hp x hpx
  let qv : V := ⟨⟨q, hqhom⟩, by
    change homogeneousSectionRestriction (K := K) x 3 ⟨q, hqhom⟩ = 0
    simpa only [homogeneousSectionRestriction_apply] using hqvan⟩
  let S : Set V := {pv, qv}
  letI : Fintype S := Fintype.ofFinite S
  have hdim : 4 ≤ finrank K V := by
    unfold V
    unfold cubicVanishingSectionsModuloEquationFinrank at hsections
    omega
  have hcard : S.toFinset.card < finrank K V := by
    have hle : S.toFinset.card ≤ 2 := by
      change (Set.toFinite S).toFinset.card ≤ 2
      rw [← Set.ncard_eq_toFinset_card S (Set.toFinite S)]
      change ({pv, qv} : Set V).ncard ≤ 2
      calc
        ({pv, qv} : Set V).ncard ≤ ({qv} : Set V).ncard + 1 :=
          Set.ncard_insert_le pv {qv}
        _ ≤ 2 := by simp
    omega
  have hlt : Submodule.span K S < (⊤ : Submodule K V) :=
    span_lt_top_of_card_lt_finrank hcard
  have hnotle : ¬ (⊤ : Submodule K V) ≤ Submodule.span K S :=
    not_le_of_gt hlt
  have hex : ∃ w : V, w ∈ (⊤ : Submodule K V) ∧
      w ∉ Submodule.span K S := by
    by_contra hn
    apply hnotle
    intro w hw
    by_contra hws
    exact hn ⟨w, hw, hws⟩
  obtain ⟨w, hwtop, hws⟩ := hex
  have hwW : w.1.1 ∈ homogeneousVanishingPolynomialSubmodule
      (K := K) (A := A) (sigma := Fin 4) x 3 := by
    exact ⟨w.1, w.property, rfl⟩
  refine ⟨w.1, hwW, ?_⟩
  intro hmem
  obtain ⟨a, b, hab⟩ := homogeneous_mem_span_pair_eq_span_smul hp hqhom
    w.1.2 hmem
  apply hws
  change w ∈ Submodule.span K S
  have hweq : w = a • pv + b • qv := by
    apply Subtype.ext
    apply Subtype.ext
    change w.1.1 = a • p + b • q
    simpa only [smul_eq_C_mul] using hab.symm
  rw [hweq]
  apply Submodule.add_mem
  · apply Submodule.smul_mem
    exact Submodule.subset_span (by simp [S])
  · apply Submodule.smul_mem
    exact Submodule.subset_span (by simp [S])

/- The preceding witness discharges the prime-intermediate selector whenever
   the second cubic is known to be homogeneous and vanishing. -/
theorem exists_regular_third_cubic_section_data_of_prime_and_sections
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (hprime : (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))).IsPrime)
    (hp : p.IsHomogeneous 3) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hqhom : q.IsHomogeneous 3)
    (hqvan : q.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx) :
    ∃ h : MvPolynomial (Fin 4) K,
      h.IsHomogeneous 3 ∧ h.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        h * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  apply exists_regular_third_cubic_section_data_of_prime_intermediate p q x hprime
  exact exists_cubic_vanishing_section_not_mem_span_pair p q hp x hpx hqhom hqvan
    hsections

/- When the surface equation generates a prime ideal, the preceding
noncontainment certificate discharges associated-prime avoidance completely. -/
theorem exists_regular_cubic_section_data_of_prime
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx)
    (hprime : (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 3 ∧ q.eval₂ (algebraMap K A) x = 0 ∧ IsRelPrime p q := by
  obtain ⟨q, hq, hqrel⟩ :=
    exists_isRelPrime_in_linear_system_of_prime_ideal hne hprime
      (homogeneousVanishingPolynomialSubmodule (K := K) (A := A)
        (sigma := Fin 4) x 3)
      (exists_cubic_vanishing_section_not_mem_span_equation
        p hp hne x hpx hsections)
  obtain ⟨hqhom, hqvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 q).mp hq
  exact ⟨q, hqhom, hqvan, hqrel⟩

/- The same prime-surface selector can retain the noncontainment certificate,
   which is needed when the chosen cubic is fed into a second quotient. -/
theorem exists_regular_cubic_section_data_of_prime_with_not_mem
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx)
    (hprime : (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 3 ∧ q.eval₂ (algebraMap K A) x = 0 ∧
      q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) ∧ IsRelPrime p q := by
  obtain ⟨q, hqW, hqnot, hqrel⟩ :=
    exists_isRelPrime_and_not_mem_in_linear_system_of_prime_ideal hne hprime
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 3)
      (exists_cubic_vanishing_section_not_mem_span_equation
        p hp hne x hpx hsections)
  obtain ⟨hqhom, hqvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 3 q).mp hqW
  exact ⟨q, hqhom, hqvan, hqnot, hqrel⟩

/- The same selected section is fibrewise regular over the coefficient field.
   This packages the prime-quotient calculation needed when the first cubic
   is used as one coordinate of a flat pencil. -/
theorem exists_regular_cubic_section_data_of_prime_with_fibrewiseRegularPair
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx)
    (hprime : (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 3 ∧ q.eval₂ (algebraMap K A) x = 0 ∧
      q ∉ Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) ∧
      IsRelPrime p q ∧
      AllCharacteristics.IsFibrewiseRegularPair
        (algebraMap K (MvPolynomial (Fin 4) K)) p q := by
  obtain ⟨q, hqhom, hqvan, hqnot, hqrel⟩ :=
    exists_regular_cubic_section_data_of_prime_with_not_mem
      p hp hne x hpx hsections hprime
  have hpair : AllCharacteristics.IsFibrewiseRegularPair
      (algebraMap K (MvPolynomial (Fin 4) K)) p q :=
    AllCharacteristics.isFibrewiseRegularPair_of_domain_of_prime_span_of_not_mem
      p q hne hprime hqnot
  exact ⟨q, hqhom, hqvan, hqnot, hqrel, hpair⟩

/- The prime selector also exposes the nonzero certificate needed by residual
   complete-intersection statements.  Noncontainment in a proper principal
   ideal immediately rules out the zero polynomial. -/
theorem exists_regular_cubic_section_data_of_prime_with_nonzero
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hne : p ≠ 0)
    (x : Fin 4 → A) (hpx : p.eval₂ (algebraMap K A) x = 0)
    (hsections : 3 ≤ cubicVanishingSectionsModuloEquationFinrank p hp x hpx)
    (hprime : (Ideal.span ({p} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 3 ∧ q.eval₂ (algebraMap K A) x = 0 ∧
      q ≠ 0 ∧ IsRelPrime p q := by
  obtain ⟨q, hqhom, hqvan, hqnot, hqrel⟩ :=
    exists_regular_cubic_section_data_of_prime_with_not_mem
      p hp hne x hpx hsections hprime
  have hq0 : q ≠ 0 := by
    intro hzero
    apply hqnot
    rw [hzero]
    exact Ideal.zero_mem _
  exact ⟨q, hqhom, hqvan, hq0, hqrel⟩

end Cubics

section Quadrics
variable {K A : Type u} [Field K] [CommRing A] [Algebra K A]
    [FiniteDimensional K A]

/-- A two-dimensional kernel of quadratic restriction contains an actual
independent pair of quadrics through the finite subscheme. -/
theorem choose_quadric_vanishing_pair
    (x : Fin 4 → A)
    (hsections : 2 ≤ finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2))) :
    ∃ v : Fin 2 →
        LinearMap.ker (homogeneousSectionRestriction (K := K) x 2),
      LinearIndependent K v :=
  exists_linearIndependent_of_le_finrank hsections

theorem choose_quadric_vanishing_pair_data
    (x : Fin 4 → A)
    (hsections : 2 ≤ finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2))) :
    ∃ v : Fin 2 →
        LinearMap.ker (homogeneousSectionRestriction (K := K) x 2),
      LinearIndependent K v ∧
        ∀ i, (v i).1.1.IsHomogeneous 2 ∧
          (v i).1.1.eval₂ (algebraMap K A) x = 0 := by
  obtain ⟨v, hli⟩ := choose_quadric_vanishing_pair x hsections
  refine ⟨v, hli, ?_⟩
  intro i
  refine ⟨(v i).1.2, ?_⟩
  have hz : homogeneousSectionRestriction (K := K) x 2 (v i).1 = 0 :=
    LinearMap.mem_ker.mp (v i).property
  simpa only [homogeneousSectionRestriction_apply] using hz

/-- When quadratic restriction has the expected rank at a length-eight
datum, its kernel is not merely known to contain two independent elements:
it has a basis indexed by `Fin 2`.  This is the finite pencil presentation
needed to put regularity of the two generators into a determinantal family. -/
noncomputable def quadraticVanishingPencilBasis
    (x : Fin 4 → A)
    (hsections : finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) = 2) :
    Basis (Fin 2) K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) := by
  letI : Module.Free K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) :=
    Module.Free.of_divisionRing K
      (LinearMap.ker (homogeneousSectionRestriction (K := K) x 2))
  exact Module.finBasisOfFinrankEq K
    (LinearMap.ker (homogeneousSectionRestriction (K := K) x 2)) hsections

/-- Each member of the canonical two-element kernel basis is a homogeneous
quadric and vanishes on the given finite coordinate algebra. -/
theorem quadraticVanishingPencilBasis_data
    (x : Fin 4 → A)
    (hsections : finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) = 2)
    (i : Fin 2) :
    ((quadraticVanishingPencilBasis x hsections i).1.1).IsHomogeneous 2 ∧
      (quadraticVanishingPencilBasis x hsections i).1.1.eval₂
        (algebraMap K A) x = 0 := by
  constructor
  · exact (quadraticVanishingPencilBasis x hsections i).1.2
  · have hz : homogeneousSectionRestriction (K := K) x 2
        (quadraticVanishingPencilBasis x hsections i).1 = 0 :=
      LinearMap.mem_ker.mp (quadraticVanishingPencilBasis x hsections i).property
    simpa only [homogeneousSectionRestriction_apply] using hz

/-- The two displayed kernel quadrics are linearly independent.  Keeping
this as a named theorem avoids rebuilding independence when the pencil is
inserted into a Grassmannian chart or a universal coefficient matrix. -/
theorem quadraticVanishingPencilBasis_linearIndependent
    (x : Fin 4 → A)
    (hsections : finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) = 2) :
    LinearIndependent K (quadraticVanishingPencilBasis x hsections) :=
  (quadraticVanishingPencilBasis x hsections).linearIndependent

/-- Every homogeneous quadric vanishing on the datum is the basis
combination of the two pencil generators.  This records equality with the
full restriction kernel rather than only inclusion of a chosen pair. -/
theorem quadraticVanishingPencilBasis_sum_repr
    (x : Fin 4 → A)
    (hsections : finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) = 2)
    (q : LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)) :
    ∑ i, ((quadraticVanishingPencilBasis x hsections).repr q i) •
        quadraticVanishingPencilBasis x hsections i = q := by
  exact (quadraticVanishingPencilBasis x hsections).sum_repr q

/-- For a prime cubic equation, the degree-eight quadratic-section bound
already gives a nonzero quadric through the finite subscheme that is
relatively prime to the cubic.  Only the regularity of the second quadric
remains a geometric selection problem in the final `8 → 4` step. -/
theorem exists_quadric_section_data_isRelPrime_of_prime_cubic
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hpprime : Prime p)
    (x : Fin 4 → A)
    (hsections : 2 ≤ finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2))) :
    ∃ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 2 ∧ q.eval₂ (algebraMap K A) x = 0 ∧
      q ≠ 0 ∧ IsRelPrime p q := by
  obtain ⟨v, hli, hv⟩ := choose_quadric_vanishing_pair_data x hsections
  have hq0 : (v 0).1.1 ≠ 0 := by
    intro hzero
    apply hli.ne_zero 0
    apply Subtype.ext
    apply Subtype.ext
    exact hzero
  refine ⟨(v 0).1.1, (hv 0).1, (hv 0).2, hq0, ?_⟩
  exact isRelPrime_of_prime_homogeneous_degree_lt hp (hv 0).1 hpprime hq0
    (by decide)

/-- If the first quadric through the finite subscheme cuts out a prime
intermediate intersection with a prime cubic, an independent second quadric
is automatically regular modulo that intersection.  The only geometric input
is primality of the intermediate cubic--quadric curve. -/
theorem exists_regular_quadric_pair_data_of_prime_cubic_intermediate
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hpprime : Prime p)
    (x : Fin 4 → A)
    (hsections : 2 ≤ finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)))
    (hprime : ∀ q : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 2 → q.eval₂ (algebraMap K A) x = 0 → q ≠ 0 →
      (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ q r : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 2 ∧ r.IsHomogeneous 2 ∧
      q.eval₂ (algebraMap K A) x = 0 ∧
      r.eval₂ (algebraMap K A) x = 0 ∧ q ≠ 0 ∧ IsRelPrime p q ∧
      ∀ y : MvPolynomial (Fin 4) K,
        r * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  obtain ⟨v, hli, hv⟩ := choose_quadric_vanishing_pair_data x hsections
  let q : MvPolynomial (Fin 4) K := (v 0).1.1
  let r : MvPolynomial (Fin 4) K := (v 1).1.1
  have hqhom : q.IsHomogeneous 2 := (hv 0).1
  have hrhom : r.IsHomogeneous 2 := (hv 1).1
  have hqvan : q.eval₂ (algebraMap K A) x = 0 := (hv 0).2
  have hrvan : r.eval₂ (algebraMap K A) x = 0 := (hv 1).2
  have hq0 : q ≠ 0 := by
    intro hzero
    apply hli.ne_zero 0
    exact Subtype.ext (Subtype.ext hzero)
  have hqrel : IsRelPrime p q :=
    isRelPrime_of_prime_homogeneous_degree_lt hp hqhom hpprime hq0 (by decide)
  have hIprime : (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))).IsPrime :=
    hprime q hqhom hqvan hq0
  have hpair : LinearIndependent K ![v 0, v 1] := by
    convert hli using 1
    funext i
    fin_cases i <;> rfl
  have hv0 : v 0 ≠ 0 := hli.ne_zero 0
  have hpair_ne : ∀ a : K, a • v 0 ≠ v 1 :=
    (LinearIndependent.pair_iff' (x := v 0) (y := v 1) hv0).mp hpair
  have hrnot : r ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
    intro hrmem
    obtain ⟨a, ha⟩ := homogeneous_mem_span_succ_degree_pair_eq_smul
      (d := 2) hp hqhom hrhom hrmem
    apply hpair_ne a
    apply Subtype.ext
    apply Subtype.ext
    change a • q = r
    exact ha.symm
  exact ⟨q, r, hqhom, hrhom, hqvan, hrvan, hq0, hqrel,
    third_equation_regular_of_span_isPrime p q r hIprime hrnot⟩

/-- The preceding selection needs primality only for one quadric in the
vanishing system.  An independent second quadric is then forced outside the
cubic--quadric ideal by its degree, so it is regular modulo that prime ideal. -/
theorem exists_regular_quadric_pair_data_of_prime_cubic_prime_first
    (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3) (hpprime : Prime p)
    (x : Fin 4 → A)
    (hsections : 2 ≤ finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)))
    (hprime : ∃ q : MvPolynomial (Fin 4) K,
      q ∈ homogeneousVanishingPolynomialSubmodule (K := K) x 2 ∧ q ≠ 0 ∧
      (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ q r : MvPolynomial (Fin 4) K,
      q.IsHomogeneous 2 ∧ r.IsHomogeneous 2 ∧
      q.eval₂ (algebraMap K A) x = 0 ∧
      r.eval₂ (algebraMap K A) x = 0 ∧ q ≠ 0 ∧ IsRelPrime p q ∧
      ∀ y : MvPolynomial (Fin 4) K,
        r * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let W := homogeneousVanishingPolynomialSubmodule (K := K) (A := A) x 2
  have hWdim : 2 ≤ finrank K W := by
    simpa [W, homogeneousVanishingPolynomialSubmodule_finrank] using hsections
  obtain ⟨q, hqW, hq0, hIprime⟩ := hprime
  let qv : W := ⟨q, hqW⟩
  let S : Submodule K W := K ∙ qv
  have hSdim : finrank K S = 1 := by
    dsimp [S]
    exact finrank_span_singleton (by
      intro hz
      exact hq0 (congrArg Subtype.val hz))
  have hStop : S ≠ ⊤ := by
    intro htop
    have hdim : finrank K W = finrank K S := by
      rw [htop, finrank_top]
    rw [hSdim] at hdim
    omega
  have hnotall : ¬ ∀ w : W, w ∈ S := by
    intro hall
    apply hStop
    apply le_antisymm le_top
    intro w hw
    exact hall w
  obtain ⟨rv, hrvS⟩ := not_forall.mp hnotall
  let r : MvPolynomial (Fin 4) K := rv.1
  have hrW : r ∈ W := rv.2
  have hqhom : q.IsHomogeneous 2 :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A) x 2 q).mp hqW |>.1
  have hqvan : q.eval₂ (algebraMap K A) x = 0 :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A) x 2 q).mp hqW |>.2
  have hrhom : r.IsHomogeneous 2 :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A) x 2 r).mp hrW |>.1
  have hrvan : r.eval₂ (algebraMap K A) x = 0 :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A) x 2 r).mp hrW |>.2
  have hrnot : r ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
    intro hrmem
    obtain ⟨a, ha⟩ := homogeneous_mem_span_succ_degree_pair_eq_smul
      (d := 2) hp hqhom hrhom hrmem
    apply hrvS
    apply Submodule.mem_span_singleton.mpr
    exact ⟨a, Subtype.ext (by simpa [r, qv] using ha.symm)⟩
  have hqrel : IsRelPrime p q :=
    isRelPrime_of_prime_homogeneous_degree_lt hp hqhom hpprime hq0 (by decide)
  exact ⟨q, r, hqhom, hrhom, hqvan, hrvan, hq0, hqrel,
    third_equation_regular_of_span_isPrime p q r hIprime hrnot⟩

/-- A selected prime cubic--quadric ideal supplies a second regular quadric
from the same two-dimensional vanishing system.  Unlike the prime-cubic
selector, this only asks for the selected intermediate ideal to be prime. -/
theorem exists_regular_second_quadric_data_of_selected_prime_intermediate
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (hsections : 2 ≤ finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x 2)))
    (hqvan : q.eval₂ (algebraMap K A) x = 0) (hq0 : q ≠ 0)
    (hIprime : (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))).IsPrime) :
    ∃ r : MvPolynomial (Fin 4) K,
      r.IsHomogeneous 2 ∧ r.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        r * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let W := homogeneousVanishingPolynomialSubmodule (K := K) (A := A) x 2
  have hWdim : 2 ≤ finrank K W := by
    simpa [W, homogeneousVanishingPolynomialSubmodule_finrank] using hsections
  let qv : W := ⟨q, (mem_homogeneousVanishingPolynomialSubmodule_iff
    (K := K) (A := A) x 2 q).mpr ⟨hq, hqvan⟩⟩
  let S : Submodule K W := K ∙ qv
  have hSdim : finrank K S = 1 := by
    dsimp [S]
    exact finrank_span_singleton (by
      intro hz
      exact hq0 (congrArg Subtype.val hz))
  have hStop : S ≠ ⊤ := by
    intro htop
    have hdim : finrank K W = finrank K S := by
      rw [htop, finrank_top]
    rw [hSdim] at hdim
    omega
  have hnotall : ¬ ∀ w : W, w ∈ S := by
    intro hall
    apply hStop
    apply le_antisymm le_top
    intro w hw
    exact hall w
  obtain ⟨rv, hrvS⟩ := not_forall.mp hnotall
  let r : MvPolynomial (Fin 4) K := rv.1
  have hrW : r ∈ W := rv.2
  have hrhom : r.IsHomogeneous 2 :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A) x 2 r).mp hrW |>.1
  have hrvan : r.eval₂ (algebraMap K A) x = 0 :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A) x 2 r).mp hrW |>.2
  have hrnot : r ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
    intro hrmem
    obtain ⟨a, ha⟩ := homogeneous_mem_span_succ_degree_pair_eq_smul
      (d := 2) hp hq hrhom hrmem
    apply hrvS
    apply Submodule.mem_span_singleton.mpr
    exact ⟨a, Subtype.ext (by simpa [r, qv] using ha.symm)⟩
  exact ⟨r, hrhom, hrvan,
    third_equation_regular_of_span_isPrime p q r hIprime hrnot⟩

/-- A quotient rank-drop estimate selects the final quadric without requiring
the selected cubic--quadric ideal to be prime.  This is the numerical form of
the last base-locus condition in Voisin's residual construction. -/
theorem exists_regular_second_quadric_data_of_finrank_drop
    [Infinite K]
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (hdrop :
      let I := Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))
      let W := homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := Fin 4) x 2
      let qmap : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
      let V : Submodule K (MvPolynomial (Fin 4) K ⧸ I) := W.map qmap
      ∀ P ∈ associatedPrimes (MvPolynomial (Fin 4) K ⧸ I)
          (MvPolynomial (Fin 4) K ⧸ I),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ r : MvPolynomial (Fin 4) K,
      r.IsHomogeneous 2 ∧ r.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        r * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let I := Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 2
  let qmap : MvPolynomial (Fin 4) K →ₗ[K]
      MvPolynomial (Fin 4) K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
  let V : Submodule K (MvPolynomial (Fin 4) K ⧸ I) := W.map qmap
  have hregular : ∃ r ∈ W, ∀ y : MvPolynomial (Fin 4) K,
      r * y ∈ I → y ∈ I := by
    exact exists_regular_mod_ideal_of_finrank_drop I W hdrop
  obtain ⟨r, hrW, hreg⟩ := hregular
  obtain ⟨hrhom, hrvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 2 r).mp hrW
  exact ⟨r, hrhom, hrvan, hreg⟩

/-- A finite family of cubic--quadric quotient rank drops can be discharged by
one quadric from the common vanishing system.  The selected quadric is
regular modulo every member of the family, which is the simultaneous form of
the final residual-section condition. -/
theorem exists_regular_second_quadric_data_of_finrank_drop_family
    [Infinite K] {ι : Type*} [Finite ι]
    (x : Fin 4 → A) (I : ι → Ideal (MvPolynomial (Fin 4) K))
    (hdrop : ∀ i : ι,
      let q : MvPolynomial (Fin 4) K →ₗ[K]
          MvPolynomial (Fin 4) K ⧸ I i := (Ideal.Quotient.mkₐ K (I i)).toLinearMap
      let V : Submodule K (MvPolynomial (Fin 4) K ⧸ I i) :=
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 2).map q
      ∀ P ∈ associatedPrimes (MvPolynomial (Fin 4) K ⧸ I i)
          (MvPolynomial (Fin 4) K ⧸ I i),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ r : MvPolynomial (Fin 4) K,
      r.IsHomogeneous 2 ∧ r.eval₂ (algebraMap K A) x = 0 ∧
      ∀ i : ι, ∀ y : MvPolynomial (Fin 4) K,
        r * y ∈ I i → y ∈ I i := by
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 2
  obtain ⟨r, hrW, hreg⟩ :=
    exists_regular_mod_ideal_of_finrank_drop_family I W (by
      intro i
      simpa only [W] using hdrop i)
  obtain ⟨hrhom, hrvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 2 r).mp hrW
  exact ⟨r, hrhom, hrvan, hreg⟩

/-- Associated-component avoidance selects the second quadric directly.
This is the quadratic counterpart of the third-cubic selector: it does not
replace the cubic--quadric curve by a prime one, and records exactly the
regularity needed for the final complete intersection. -/
theorem exists_regular_second_quadric_data_of_avoids_associatedPrimes
    [Infinite K]
    (p q : MvPolynomial (Fin 4) K) (x : Fin 4 → A)
    (havoid : ∀ P ∈ associatedPrimes
        (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)))
        (MvPolynomial (Fin 4) K ⧸ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))),
      ∃ r ∈ homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := Fin 4) x 2,
        Ideal.Quotient.mk (Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))) r ∉ P) :
    ∃ r : MvPolynomial (Fin 4) K,
      r.IsHomogeneous 2 ∧ r.eval₂ (algebraMap K A) x = 0 ∧
      ∀ y : MvPolynomial (Fin 4) K,
        r * y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) →
          y ∈ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) := by
  let I := Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K))
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := Fin 4) x 2
  have hregular : ∃ r ∈ W, ∀ y : MvPolynomial (Fin 4) K,
      r * y ∈ I → y ∈ I := by
    exact exists_regular_mod_ideal_of_avoids_associatedPrimes_finrank I W
      (by simpa only [I, W] using havoid)
  obtain ⟨r, hrW, hreg⟩ := hregular
  obtain ⟨hrhom, hrvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff (K := K) (A := A)
      (sigma := Fin 4) x 2 r).mp hrW
  exact ⟨r, hrhom, hrvan, hreg⟩

end Quadrics

section HomogeneousPairs
universe v
variable {K A : Type u} {sigma : Type v} [Field K] [Infinite K] [CommRing A]
  [Algebra K A] [FiniteDimensional K A] [Fintype sigma]

/- A degree-uniform interface for the domain-specialized pair selector.  It
applies equally to the cubic and quadratic section systems used in Voisin's
construction. -/
theorem exists_regular_homogeneous_pair_data_of_domain_finrank_drop
    (x : sigma → A) (d : ℕ)
    (hpos : 0 < Module.finrank K
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := sigma) x d))
    (hdrop₂ : ∀ (f : MvPolynomial sigma K),
      f ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := sigma) x d →
      f ∈ nonZeroDivisors (MvPolynomial sigma K) →
      let I := Ideal.span ({f} : Set (MvPolynomial sigma K))
      let q : MvPolynomial sigma K →ₗ[K]
          MvPolynomial sigma K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
      let V : Submodule K (MvPolynomial sigma K ⧸ I) :=
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := sigma) x d).map q
      ∀ P ∈ associatedPrimes (MvPolynomial sigma K ⧸ I)
          (MvPolynomial sigma K ⧸ I),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ f g : MvPolynomial sigma K,
      f.IsHomogeneous d ∧ g.IsHomogeneous d ∧
      f.eval₂ (algebraMap K A) x = 0 ∧
      g.eval₂ (algebraMap K A) x = 0 ∧ IsRelPrime f g := by
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := sigma) x d
  have hW : W ≠ ⊥ :=
    homogeneousVanishingPolynomialSubmodule_ne_bot_of_finrank_pos
      (K := K) (A := A) (sigma := sigma) x d hpos
  obtain ⟨f, hfW, g, hgW, _, hrel⟩ :=
    exists_regular_pair_of_finrank_drop_of_domain W W hW hdrop₂
  obtain ⟨hfhom, hfvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := K) (A := A) (sigma := sigma) x d f).mp hfW
  obtain ⟨hghom, hgvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := K) (A := A) (sigma := sigma) x d g).mp hgW
  exact ⟨f, g, hfhom, hghom, hfvan, hgvan, hrel⟩

/- The first member comes from the non-zero-divisor selector, so this
   strengthened interface records its nonvanishing explicitly.  The
   certificate is needed when the first equation is used to define a
   principal complete-intersection quotient. -/
theorem exists_regular_homogeneous_pair_data_of_domain_finrank_drop_with_nonzero
    (x : sigma → A) (d : ℕ)
    (hpos : 0 < Module.finrank K
      (homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := sigma) x d))
    (hdrop₂ : ∀ (f : MvPolynomial sigma K),
      f ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := sigma) x d →
      f ∈ nonZeroDivisors (MvPolynomial sigma K) →
      let I := Ideal.span ({f} : Set (MvPolynomial sigma K))
      let q : MvPolynomial sigma K →ₗ[K]
          MvPolynomial sigma K ⧸ I := (Ideal.Quotient.mkₐ K I).toLinearMap
      let V : Submodule K (MvPolynomial sigma K ⧸ I) :=
        (homogeneousVanishingPolynomialSubmodule
          (K := K) (A := A) (sigma := sigma) x d).map q
      ∀ P ∈ associatedPrimes (MvPolynomial sigma K ⧸ I)
          (MvPolynomial sigma K ⧸ I),
        Module.finrank K ((P.restrictScalars K).comap V.subtype) <
          Module.finrank K V) :
    ∃ f g : MvPolynomial sigma K,
      f.IsHomogeneous d ∧ g.IsHomogeneous d ∧
      f.eval₂ (algebraMap K A) x = 0 ∧
      g.eval₂ (algebraMap K A) x = 0 ∧
      f ≠ 0 ∧ IsRelPrime f g := by
  let W := homogeneousVanishingPolynomialSubmodule
    (K := K) (A := A) (sigma := sigma) x d
  have hW : W ≠ ⊥ :=
    homogeneousVanishingPolynomialSubmodule_ne_bot_of_finrank_pos
      (K := K) (A := A) (sigma := sigma) x d hpos
  obtain ⟨f, hfW, g, hgW, hfreg, hrel⟩ :=
    exists_regular_pair_of_finrank_drop_of_domain W W hW hdrop₂
  have hf0 : f ≠ 0 := by
    rw [mem_nonZeroDivisors_iff_ne_zero] at hfreg
    exact hfreg
  obtain ⟨hfhom, hfvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := K) (A := A) (sigma := sigma) x d f).mp hfW
  obtain ⟨hghom, hgvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := K) (A := A) (sigma := sigma) x d g).mp hgW
  exact ⟨f, g, hfhom, hghom, hfvan, hgvan, hf0, hrel⟩

/- If one section in a two-dimensional homogeneous system is already known to
   generate a prime principal ideal, linear algebra supplies a second section
   outside that ideal.  This weakens the earlier ``every section is prime''
   shortcut used for the quadratic stage. -/
theorem exists_regular_homogeneous_pair_data_of_prime_first
    (x : sigma → A) (d : ℕ)
    (hsections : 2 ≤ Module.finrank K (LinearMap.ker
      (homogeneousSectionRestriction (K := K) x d)))
    (hprime : ∃ q : MvPolynomial sigma K,
      q ∈ homogeneousVanishingPolynomialSubmodule
        (K := K) (A := A) (sigma := sigma) x d ∧ q ≠ 0 ∧
      (Ideal.span ({q} : Set (MvPolynomial sigma K))).IsPrime) :
    ∃ q r : MvPolynomial sigma K,
      q.IsHomogeneous d ∧ r.IsHomogeneous d ∧
      q.eval₂ (algebraMap K A) x = 0 ∧
      r.eval₂ (algebraMap K A) x = 0 ∧ q ≠ 0 ∧ IsRelPrime q r := by
  let W := homogeneousVanishingPolynomialSubmodule (K := K) (A := A)
    (sigma := sigma) x d
  have hWdim : 2 ≤ Module.finrank K W := by
    simpa [W, homogeneousVanishingPolynomialSubmodule_finrank] using hsections
  obtain ⟨q, hqW, hq0, hqprime⟩ := hprime
  let qv : W := ⟨q, hqW⟩
  let S : Submodule K W := K ∙ qv
  have hSdim : Module.finrank K S = 1 := by
    dsimp [S]
    exact finrank_span_singleton (by
      intro hz
      exact hq0 (congrArg Subtype.val hz))
  have hStop : S ≠ ⊤ := by
    intro htop
    have hdim : Module.finrank K W = Module.finrank K S := by
      rw [htop, finrank_top]
    rw [hSdim] at hdim
    omega
  have hnotall : ¬ ∀ w : W, w ∈ S := by
    intro hall
    apply hStop
    apply le_antisymm le_top
    intro w hw
    exact hall w
  obtain ⟨rv, hrvS⟩ := not_forall.mp hnotall
  let r : MvPolynomial sigma K := rv.1
  have hrW : r ∈ W := rv.2
  have hrnot : r ∉ Ideal.span ({q} : Set (MvPolynomial sigma K)) := by
    intro hrmem
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hrmem
    have hqhom :=
      (mem_homogeneousVanishingPolynomialSubmodule_iff
        (K := K) (A := A) (sigma := sigma) x d q).mp hqW |>.1
    have hrhom :=
      (mem_homogeneousVanishingPolynomialSubmodule_iff
        (K := K) (A := A) (sigma := sigma) x d r).mp hrW |>.1
    obtain ⟨a, ha⟩ := homogeneous_dvd_same_degree_eq_smul
      hqhom hrhom hq0 (by
        intro hr0
        apply hrvS
        have hrv0 : rv = 0 := by
          apply Subtype.ext
          exact hr0
        rw [hrv0]
        exact Submodule.zero_mem S) ⟨a, ha⟩
    apply hrvS
    apply Submodule.mem_span_singleton.mpr
    exact ⟨a, Subtype.ext (by simpa [r, qv] using ha.symm)⟩
  obtain ⟨r2, hr2W, hrel⟩ :=
    exists_isRelPrime_in_linear_system_of_prime_ideal
      hq0 hqprime W ⟨r, hrW, hrnot⟩
  obtain ⟨hqhom, hqvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := K) (A := A) (sigma := sigma) x d q).mp hqW
  obtain ⟨hr2hom, hr2van⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := K) (A := A) (sigma := sigma) x d r2).mp hr2W
  exact ⟨q, r2, hqhom, hr2hom, hqvan, hr2van, hq0, hrel⟩

end HomogeneousPairs

end PfaffianDescent
