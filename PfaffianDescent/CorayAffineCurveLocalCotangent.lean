import PfaffianDescent.CorayAffineSurfaceJetExactKernel
import PfaffianDescent.CorayLocalFullJetCotangent
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Noetherian

/-!
# Large cotangent rank at the actual selected affine curve point

The actual ambient normalized jet descends through the actual curve ideal
generated by p and q. Surjectivity is constructed from ambient preimages;
the actual residue-kernel point is maximal, and localization retains the full
jet. Consequently the selected curve point's ACTUAL local cotangent rank is
at least two over its ACTUAL local residue field, with no supplied rank premise.

This does not assume or prove that the whole curve is integral or has local
dimension at most one. Those are separate geometric gates to normalization
defect and must be treated in the integral/reducible branches.

STATUS: UNVERIFIED source draft. Root owns all compiler checks.
-/

noncomputable section
namespace PfaffianDescent.Coray

open MvPolynomial TrivSqZeroExt IsLocalRing Module

universe u
variable {M : Type u} [Field M]

/-- The literal affine intersection ideal of the surface and selected curve. -/
def affineCurveIdeal (p q : MvPolynomial (Fin 3) M) :
    Ideal (MvPolynomial (Fin 3) M) :=
  Ideal.span ({p, q} : Set (MvPolynomial (Fin 3) M))

/-- The actual affine curve ring. -/
abbrev affineCurveRing (p q : MvPolynomial (Fin 3) M) :=
  MvPolynomial (Fin 3) M ⧸ affineCurveIdeal p q

/-- The actual curve carries the actual full jet, because both of its
literal defining equations vanish in that jet. -/
def affineCurvePointJet
    (p q : MvPolynomial (Fin 3) M) (x : Fin 3 → M) (pivot : Fin 3)
    (hp : eval x p = 0) (hpivot : eval x (pderiv pivot p) ≠ 0)
    (hq : affineNormalizedSurfaceJetMap p x pivot q = 0) :
    affineCurveRing p q →ₐ[M] CubicSurfaceFirstJet M := by
  refine Ideal.Quotient.liftₐ (affineCurveIdeal p q)
    (affineNormalizedSurfaceJetMap p x pivot) ?_
  intro r hr
  have hle : affineCurveIdeal p q ≤
      RingHom.ker (affineNormalizedSurfaceJetMap p x pivot).toRingHom := by
    apply Ideal.span_le.mpr
    intro s hs
    rcases Set.mem_insert_iff.mp hs with hsp | hsq
    · rw [hsp]
      exact affineNormalizedSurfaceJetCoordinates_equation_zero p x pivot hp hpivot
    · rw [Set.mem_singleton_iff.mp hsq]
      exact hq
  exact hle hr

/-- The actual curve jet agrees with actual ambient polynomial evaluation. -/
theorem affineCurvePointJet_apply_mk
    (p q r : MvPolynomial (Fin 3) M) (x : Fin 3 → M) (pivot : Fin 3)
    (hp : eval x p = 0) (hpivot : eval x (pderiv pivot p) ≠ 0)
    (hq : affineNormalizedSurfaceJetMap p x pivot q = 0) :
    affineCurvePointJet p q x pivot hp hpivot hq
        (Ideal.Quotient.mk (affineCurveIdeal p q) r) =
      affineNormalizedSurfaceJetMap p x pivot r := by
  rfl

/-- The actual curve jet's residue is evaluation at the original affine point. -/
theorem affineCurvePointJet_fst_mk
    (p q r : MvPolynomial (Fin 3) M) (x : Fin 3 → M) (pivot : Fin 3)
    (hp : eval x p = 0) (hpivot : eval x (pderiv pivot p) ≠ 0)
    (hq : affineNormalizedSurfaceJetMap p x pivot q = 0) :
    (affineCurvePointJet p q x pivot hp hpivot hq
        (Ideal.Quotient.mk (affineCurveIdeal p q) r)).fst = eval x r := by
  rw [affineCurvePointJet_apply_mk]
  exact affineNormalizedSurfaceJetMap_fst p r x pivot

/-- The literal curve point ideal pulls back to the original point's actual
polynomial evaluation ideal. Thus the localization below is at that point. -/
theorem affineCurve_actualPointIdeal_comap_mk
    (p q : MvPolynomial (Fin 3) M) (x : Fin 3 → M) (pivot : Fin 3)
    (hp : eval x p = 0) (hpivot : eval x (pderiv pivot p) ≠ 0)
    (hq : affineNormalizedSurfaceJetMap p x pivot q = 0) :
    (RingHom.ker (fullJetResidueMap
      (affineCurvePointJet p q x pivot hp hpivot hq).toRingHom)).comap
        (Ideal.Quotient.mk (affineCurveIdeal p q)) = affinePointIdeal x := by
  ext r
  change (affineCurvePointJet p q x pivot hp hpivot hq
    (Ideal.Quotient.mk (affineCurveIdeal p q) r)).fst = 0 ↔ eval x r = 0
  rw [affineCurvePointJet_fst_mk]

/-- Ambient explicit preimages give surjectivity on the actual curve. -/
theorem affineCurvePointJet_surjective
    (p q : MvPolynomial (Fin 3) M) (x : Fin 3 → M) (pivot : Fin 3)
    (hp : eval x p = 0) (hpivot : eval x (pderiv pivot p) ≠ 0)
    (hq : affineNormalizedSurfaceJetMap p x pivot q = 0) :
    Function.Surjective (affineCurvePointJet p q x pivot hp hpivot hq) := by
  intro z
  obtain ⟨r, hr⟩ := affineNormalizedSurfaceJetMap_surjective p x pivot z
  exact ⟨Ideal.Quotient.mk (affineCurveIdeal p q) r,
    (affineCurvePointJet_apply_mk p q r x pivot hp hpivot hq).trans hr⟩

/-- At the actual residue-kernel point of the actual affine intersection,
the actual local cotangent dimension is at least two over the actual local
residue field. No domain/dimension/rank certificate is an input. -/
theorem affineCurve_actualPoint_cotangent_finrank_ge_two
    (p q : MvPolynomial (Fin 3) M) (x : Fin 3 → M) (pivot : Fin 3)
    (hp : eval x p = 0) (hpivot : eval x (pderiv pivot p) ≠ 0)
    (hq : affineNormalizedSurfaceJetMap p x pivot q = 0) :
    let φ := (affineCurvePointJet p q x pivot hp hpivot hq).toRingHom
    let hφ : Function.Surjective φ :=
      affineCurvePointJet_surjective p q x pivot hp hpivot hq
    let P := RingHom.ker (fullJetResidueMap φ)
    letI : P.IsPrime := (fullJetResidueIdeal_isMaximal φ hφ).isPrime
    2 ≤ finrank (ResidueField (Localization.AtPrime P))
      (CotangentSpace (Localization.AtPrime P)) := by
  let φ := (affineCurvePointJet p q x pivot hp hpivot hq).toRingHom
  let hφ : Function.Surjective φ :=
    affineCurvePointJet_surjective p q x pivot hp hpivot hq
  let P := RingHom.ker (fullJetResidueMap φ)
  letI : P.IsPrime := (fullJetResidueIdeal_isMaximal φ hφ).isPrime
  exact fullJetAtActualPoint_cotangent_finrank_ge_two φ hφ

end PfaffianDescent.Coray
