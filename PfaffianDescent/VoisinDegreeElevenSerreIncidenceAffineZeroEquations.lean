import PfaffianDescent.VoisinDegreeElevenSerreIncidenceBundleCoordinates
import PfaffianDescent.CubicClosedPointSerreFiniteZeroResidualAffineIdealComap

/-! # Actual affine pullback equations for bundle zero schemes -/
noncomputable section
open AlgebraicGeometry CategoryTheory
namespace PfaffianDescent
universe u
set_option backward.isDefEq.respectTransparency false

/-- Pullback of a literal free-coordinate zero ideal along any affine
morphism is the ideal generated by the literal pulled-back coordinates. -/
theorem serreIncidenceZeroIdeal_comap_affine
    {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (ι : Type u) {M : Y.Modules}
    (t : SheafOfModules.free (R := Y.ringCatSheaf) ι ≅ M)
    (s : M.sections) :
    (BundleSectionZeroLocus.sectionZeroIdealOfFreeIso ι t s).comap f =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range fun i => f.appTop
          (BundleSectionZeroLocus.sectionCoordinateOfFreeIso ι t s i))) := by
  unfold BundleSectionZeroLocus.sectionZeroIdealOfFreeIso
    BundleSectionZeroLocus.freeSectionZeroIdeal
  rw [cubicClosedPointSerreFiniteZeroResidual_affineIdeal_comap, Ideal.map_span]
  congr 2
  exact (Set.range_comp f.appTop
    (BundleSectionZeroLocus.freeSectionCoordinate ι (SheafOfModules.sectionsMap t.inv s))).symm

/-- For actual pulled-back bundle sections, affine zero ideals commute with
canonical pullback, without any open-immersion hypothesis. -/
theorem serreIncidenceZeroIdeal_comap_pullback
    {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (ι : Type u) [Fintype ι] [DecidableEq ι] {M : Y.Modules}
    (t : SheafOfModules.free (R := Y.ringCatSheaf) ι ≅ M)
    (s : M.sections) :
    (BundleSectionZeroLocus.sectionZeroIdealOfFreeIso ι t s).comap f =
      BundleSectionZeroLocus.sectionZeroIdealOfFreeIso ι
        (BundleSectionZeroLocus.pullbackFreeIso f ι t)
        (BundleSectionZeroLocus.pullbackSection f M
          (BundleSectionZeroLocus.isIso_pullbackUnitComparison f) s) := by
  rw [serreIncidenceZeroIdeal_comap_affine]
  change Scheme.IdealSheafData.ofIdealTop (Ideal.span _) =
    Scheme.IdealSheafData.ofIdealTop (Ideal.span _)
  congr 2
  apply congrArg Set.range
  funext i
  exact (serreIncidenceSectionCoordinate_pullback f ι M t s i).symm

end PfaffianDescent
