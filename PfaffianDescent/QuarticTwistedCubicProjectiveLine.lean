import PfaffianDescent.QuarticTwistedCubicPoint
import PfaffianDescent.ProjectiveChartMorphisms
import PfaffianDescent.LineGrassmannianProjCharts
import AllCharacteristics.AffineChartPresentation
import AllCharacteristics.ProjectiveBaseChange

/-!
# The standard projective twisted cubic and the projective line

This file develops the two affine charts needed to identify the standard
twisted cubic with the projective line.  The first chart is generated by the
ratio `X₁/X₀`, and the second by `X₂/X₃`.
-/

namespace PfaffianDescent.QuarticNet

open MvPolynomial AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open AllCharacteristics.HomogeneousProjective

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {K : Type u} [Field K]

local notation "I" => standardTwistedCubicHomogeneousIdeal (K := K)
local notation "L" => (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule Bool K))

private lemma standardTwistedCubic_generator_mem (i : Fin 3) :
    standardTwistedCubicGenerators K i ∈ (I).toIdeal := by
  change standardTwistedCubicGenerators K i ∈ standardTwistedCubicIdeal K
  exact Ideal.subset_span (Set.mem_range_self i)

/-- The first Hankel relation in the homogeneous coordinate ring. -/
theorem standardTwistedCubic_coordinate_relation_zero :
    coordinate I 1 ^ 2 = coordinate I 0 * coordinate I 2 := by
  apply sub_eq_zero.mp
  change Ideal.Quotient.mk (I).toIdeal (X 1 ^ 2 - X 0 * X 2) = 0
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  simpa [standardTwistedCubicGenerators] using
    standardTwistedCubic_generator_mem (K := K) 0

/-- The last Hankel relation in the homogeneous coordinate ring. -/
theorem standardTwistedCubic_coordinate_relation_two :
    coordinate I 2 ^ 2 = coordinate I 1 * coordinate I 3 := by
  apply sub_eq_zero.mp
  change Ideal.Quotient.mk (I).toIdeal (X 2 ^ 2 - X 1 * X 3) = 0
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  simpa [standardTwistedCubicGenerators] using
    standardTwistedCubic_generator_mem (K := K) 2

/-- Every projective point of the standard cubic lies in the `X₀` or `X₃`
affine chart. -/
theorem standardTwistedCubic_coordinate_zero_or_three_not_mem
    (p : ProjectiveSpectrum (grading I)) :
    coordinate I 0 ∉ p.asHomogeneousIdeal.toIdeal ∨
      coordinate I 3 ∉ p.asHomogeneousIdeal.toIdeal := by
  by_cases h0 : coordinate I 0 ∈ p.asHomogeneousIdeal.toIdeal
  · by_cases h3 : coordinate I 3 ∈ p.asHomogeneousIdeal.toIdeal
    · have h1sq : coordinate I 1 ^ 2 ∈ p.asHomogeneousIdeal.toIdeal := by
        rw [standardTwistedCubic_coordinate_relation_zero]
        exact Ideal.mul_mem_right (coordinate I 2) p.asHomogeneousIdeal.toIdeal h0
      have h1 : coordinate I 1 ∈ p.asHomogeneousIdeal.toIdeal :=
        p.isPrime.mem_of_pow_mem 2 h1sq
      have h2sq : coordinate I 2 ^ 2 ∈ p.asHomogeneousIdeal.toIdeal := by
        rw [standardTwistedCubic_coordinate_relation_two]
        exact Ideal.mul_mem_left p.asHomogeneousIdeal.toIdeal (coordinate I 1) h3
      have h2 : coordinate I 2 ∈ p.asHomogeneousIdeal.toIdeal :=
        p.isPrime.mem_of_pow_mem 2 h2sq
      exfalso
      apply p.not_irrelevant_le
      apply toIdeal_le_toIdeal_iff.mp
      rw [irrelevant_eq_coordinateIdeal]
      apply Ideal.span_le.mpr
      rintro x ⟨i, rfl⟩
      fin_cases i
      · exact h0
      · exact h1
      · exact h2
      · exact h3
    · exact Or.inr h3
  · exact Or.inl h0

/-- The two end-coordinate affine charts cover the standard twisted cubic. -/
noncomputable def standardTwistedCubicOpenCover : (scheme I).OpenCover where
  I₀ := Bool
  X b := Spec (.of (ChartRing I (if b then 3 else 0)))
  f b := chartι I (if b then 3 else 0)
  mem₀ := by
    rw [Scheme.presieve₀_mem_precoverage_iff]
    constructor
    · intro x
      obtain h0 | h3 := standardTwistedCubic_coordinate_zero_or_three_not_mem (K := K) x
      · refine ⟨false, ?_⟩
        change x ∈ (chartι I 0).opensRange
        rw [chartι_opensRange]
        exact (ProjectiveSpectrum.mem_basicOpen (grading I) (coordinate I 0) x).mpr h0
      · refine ⟨true, ?_⟩
        change x ∈ (chartι I 3).opensRange
        rw [chartι_opensRange]
        exact (ProjectiveSpectrum.mem_basicOpen (grading I) (coordinate I 3) x).mpr h3
    · intro b
      change IsOpenImmersion (chartι I (if b then 3 else 0))
      infer_instance

/-- On the `X₀ ≠ 0` chart, `X₂/X₀` is the square of `X₁/X₀`. -/
theorem standardTwistedCubic_chart_zero_coordinate_two :
    chartCoordinate I 0 2 = chartCoordinate I 0 1 ^ 2 := by
  have h := eval₂_chartCoordinate_eq_zero_of_mem I 0
    (standardTwistedCubicGenerators K 0) (standardTwistedCubic_generator_mem (K := K) 0)
  have h' : chartCoordinate I 0 1 ^ 2 -
      chartCoordinate I 0 0 * chartCoordinate I 0 2 = 0 := by
    simpa [standardTwistedCubicGenerators] using h
  rw [chartCoordinate_self, one_mul] at h'
  exact (sub_eq_zero.mp h').symm

/-- On the `X₀ ≠ 0` chart, `X₃/X₀` is the cube of `X₁/X₀`. -/
theorem standardTwistedCubic_chart_zero_coordinate_three :
    chartCoordinate I 0 3 = chartCoordinate I 0 1 ^ 3 := by
  have h := eval₂_chartCoordinate_eq_zero_of_mem I 0
    (standardTwistedCubicGenerators K 1) (standardTwistedCubic_generator_mem (K := K) 1)
  have h' : chartCoordinate I 0 1 * chartCoordinate I 0 2 -
      chartCoordinate I 0 0 * chartCoordinate I 0 3 = 0 := by
    simpa [standardTwistedCubicGenerators] using h
  rw [chartCoordinate_self, one_mul, standardTwistedCubic_chart_zero_coordinate_two] at h'
  have heq : chartCoordinate I 0 3 = chartCoordinate I 0 1 * chartCoordinate I 0 1 ^ 2 :=
    (sub_eq_zero.mp h').symm
  calc
    chartCoordinate I 0 3 = chartCoordinate I 0 1 * chartCoordinate I 0 1 ^ 2 := heq
    _ = chartCoordinate I 0 1 ^ 3 := by ring

/-- The middle Hankel relation on the `X₀` chart. -/
theorem standardTwistedCubic_chart_zero_coordinate_product :
    chartCoordinate I 0 1 * chartCoordinate I 0 2 = chartCoordinate I 0 3 := by
  have h := eval₂_chartCoordinate_eq_zero_of_mem I 0
    (standardTwistedCubicGenerators K 1) (standardTwistedCubic_generator_mem (K := K) 1)
  have h' : chartCoordinate I 0 1 * chartCoordinate I 0 2 -
      chartCoordinate I 0 0 * chartCoordinate I 0 3 = 0 := by
    simpa [standardTwistedCubicGenerators] using h
  rw [chartCoordinate_self, one_mul] at h'
  exact sub_eq_zero.mp h'

/-- On the `X₃ ≠ 0` chart, `X₁/X₃` is the square of `X₂/X₃`. -/
theorem standardTwistedCubic_chart_three_coordinate_one :
    chartCoordinate I 3 1 = chartCoordinate I 3 2 ^ 2 := by
  have h := eval₂_chartCoordinate_eq_zero_of_mem I 3
    (standardTwistedCubicGenerators K 2) (standardTwistedCubic_generator_mem (K := K) 2)
  have h' : chartCoordinate I 3 2 ^ 2 -
      chartCoordinate I 3 1 * chartCoordinate I 3 3 = 0 := by
    simpa [standardTwistedCubicGenerators] using h
  rw [chartCoordinate_self, mul_one] at h'
  rw [sub_eq_zero] at h'
  exact h'.symm

/-- On the `X₃ ≠ 0` chart, `X₀/X₃` is the cube of `X₂/X₃`. -/
theorem standardTwistedCubic_chart_three_coordinate_zero :
    chartCoordinate I 3 0 = chartCoordinate I 3 2 ^ 3 := by
  have h := eval₂_chartCoordinate_eq_zero_of_mem I 3
    (standardTwistedCubicGenerators K 1) (standardTwistedCubic_generator_mem (K := K) 1)
  have h' : chartCoordinate I 3 1 * chartCoordinate I 3 2 -
      chartCoordinate I 3 0 * chartCoordinate I 3 3 = 0 := by
    simpa [standardTwistedCubicGenerators] using h
  rw [chartCoordinate_self, mul_one, standardTwistedCubic_chart_three_coordinate_one] at h'
  have heq : chartCoordinate I 3 0 = chartCoordinate I 3 2 ^ 2 * chartCoordinate I 3 2 :=
    (sub_eq_zero.mp h').symm
  calc
    chartCoordinate I 3 0 = chartCoordinate I 3 2 ^ 2 * chartCoordinate I 3 2 := heq
    _ = chartCoordinate I 3 2 ^ 3 := by ring

/-- The affine-coordinate map of the `X₀` chart, sending the four homogeneous
coordinates to `1, t, t², t³`. -/
noncomputable def standardTwistedCubic_chartZero_coordinateMap :
    CoordinateRing I →ₐ[K] MvPolynomial (Fin 1) K :=
  Ideal.Quotient.liftₐ (standardTwistedCubicIdeal K)
    (MvPolynomial.aeval ![1, X 0, X 0 ^ 2, X 0 ^ 3]) (by
      intro p hp
      change p ∈ RingHom.ker (MvPolynomial.aeval ![1, X 0, X 0 ^ 2, X 0 ^ 3]).toRingHom
      apply (Ideal.span_le.mpr ?_) hp
      rintro q ⟨i, rfl⟩
      fin_cases i <;> simp [standardTwistedCubicGenerators] <;> ring)

lemma standardTwistedCubic_chartZero_coordinateMap_mk (p : MvPolynomial (Fin 4) K) :
    standardTwistedCubic_chartZero_coordinateMap (K := K)
      (Ideal.Quotient.mk (I).toIdeal p) =
    MvPolynomial.aeval ![1, X 0, X 0 ^ 2, X 0 ^ 3] p := rfl

lemma standardTwistedCubic_chartZero_coordinateMap_coordinate (i : Fin 4) :
    standardTwistedCubic_chartZero_coordinateMap (K := K) (coordinate I i) =
      (![1, X 0, X 0 ^ 2, X 0 ^ 3] : Fin 4 → MvPolynomial (Fin 1) K) i := by
  change standardTwistedCubic_chartZero_coordinateMap (K := K)
      (Ideal.Quotient.mk (I).toIdeal (X i)) = _
  rw [standardTwistedCubic_chartZero_coordinateMap_mk]
  simp

/-- The `X₀` chart maps to the affine line by its coordinate `X₁/X₀`. -/
noncomputable def standardTwistedCubic_chartZero_toAffine :
    ChartRing I 0 →+* MvPolynomial (Fin 1) K :=
  AllCharacteristics.GradedChart.liftCoordinateOne (grading I) (coordinate I 0)
    (standardTwistedCubic_chartZero_coordinateMap (K := K)).toRingHom (by
      change standardTwistedCubic_chartZero_coordinateMap (K := K) (coordinate I 0) = 1
      rw [standardTwistedCubic_chartZero_coordinateMap_coordinate]
      rfl)

lemma standardTwistedCubic_chartZero_toAffine_coordinate (i : Fin 4) :
    standardTwistedCubic_chartZero_toAffine (K := K) (chartCoordinate I 0 i) =
      (![1, X 0, X 0 ^ 2, X 0 ^ 3] : Fin 4 → MvPolynomial (Fin 1) K) i := by
  change AllCharacteristics.GradedChart.liftCoordinateOne (grading I) (coordinate I 0)
      (standardTwistedCubic_chartZero_coordinateMap (K := K)).toRingHom _
      (chartCoordinate I 0 i) = _
  rw [show chartCoordinate I 0 i =
      AllCharacteristics.GradedChart.normalized (grading I) (coordinate_mem I 0)
        (coordinate I i) (coordinate_mem I i) by rfl]
  rw [AllCharacteristics.GradedChart.liftCoordinateOne_normalized]
  exact standardTwistedCubic_chartZero_coordinateMap_coordinate (K := K) i

/-- The inverse affine-chart map sends `t` to `X₁/X₀`. -/
noncomputable def standardTwistedCubic_affine_toChartZero :
    MvPolynomial (Fin 1) K →+* ChartRing I 0 :=
  MvPolynomial.eval₂Hom (chartBaseMap I 0) ![chartCoordinate I 0 1]

lemma standardTwistedCubic_affine_toChartZero_C (a : K) :
    standardTwistedCubic_affine_toChartZero (K := K) (C a) = chartBaseMap I 0 a := by
  simp [standardTwistedCubic_affine_toChartZero]

lemma standardTwistedCubic_affine_toChartZero_X :
    standardTwistedCubic_affine_toChartZero (K := K) (X 0) = chartCoordinate I 0 1 := by
  simp [standardTwistedCubic_affine_toChartZero]

lemma standardTwistedCubic_chartZero_toAffine_base (a : K) :
    standardTwistedCubic_chartZero_toAffine (K := K) (chartBaseMap I 0 a) = C a := by
  unfold chartBaseMap
  change AllCharacteristics.GradedChart.liftCoordinateOne (grading I) (coordinate I 0)
      (standardTwistedCubic_chartZero_coordinateMap (K := K)).toRingHom _
      (AllCharacteristics.GradedChart.baseMap (grading I) (z := coordinate I 0) a) = C a
  rw [AllCharacteristics.GradedChart.liftCoordinateOne_baseMap]
  change standardTwistedCubic_chartZero_coordinateMap (K := K)
      (Ideal.Quotient.mk (I).toIdeal (C a)) = C a
  rw [standardTwistedCubic_chartZero_coordinateMap_mk]
  simp

lemma standardTwistedCubic_chartZero_toAffine_comp_affine_toChartZero :
    (standardTwistedCubic_chartZero_toAffine (K := K)).comp
      (standardTwistedCubic_affine_toChartZero (K := K)) =
        RingHom.id (MvPolynomial (Fin 1) K) := by
  apply MvPolynomial.ringHom_ext
  · intro a
    simp only [RingHom.comp_apply, RingHom.id_apply,
      standardTwistedCubic_affine_toChartZero, MvPolynomial.eval₂Hom_C]
    exact standardTwistedCubic_chartZero_toAffine_base (K := K) a
  · intro i
    fin_cases i
    simp only [RingHom.comp_apply, RingHom.id_apply,
      standardTwistedCubic_affine_toChartZero, MvPolynomial.eval₂Hom_X']
    simpa using standardTwistedCubic_chartZero_toAffine_coordinate (K := K) (1 : Fin 4)

lemma standardTwistedCubic_affine_toChartZero_comp_chartZero_toAffine :
    (standardTwistedCubic_affine_toChartZero (K := K)).comp
      (standardTwistedCubic_chartZero_toAffine (K := K)) = RingHom.id (ChartRing I 0) := by
  let e := MvPolynomial.eval₂Hom (chartBaseMap I 0) (chartCoordinate I 0)
  have he : (standardTwistedCubic_affine_toChartZero (K := K)).comp
      ((standardTwistedCubic_chartZero_toAffine (K := K)).comp e) = e := by
    dsimp [e]
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      rw [standardTwistedCubic_chartZero_toAffine_base]
      exact standardTwistedCubic_affine_toChartZero_C (K := K) a
    · intro i
      fin_cases i
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartZero_toAffine_coordinate]
        change standardTwistedCubic_affine_toChartZero (K := K) 1 = chartCoordinate I 0 0
        rw [map_one]
        exact (chartCoordinate_self I 0).symm
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartZero_toAffine_coordinate]
        exact standardTwistedCubic_affine_toChartZero_X (K := K)
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartZero_toAffine_coordinate]
        change standardTwistedCubic_affine_toChartZero (K := K) (X 0 ^ 2) = chartCoordinate I 0 2
        rw [map_pow]
        rw [standardTwistedCubic_affine_toChartZero_X]
        exact (standardTwistedCubic_chart_zero_coordinate_two (K := K)).symm
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartZero_toAffine_coordinate]
        change standardTwistedCubic_affine_toChartZero (K := K) (X 0 ^ 3) = chartCoordinate I 0 3
        rw [map_pow]
        rw [standardTwistedCubic_affine_toChartZero_X]
        exact (standardTwistedCubic_chart_zero_coordinate_three (K := K)).symm
  apply RingHom.ext
  intro x
  obtain ⟨p, rfl⟩ := eval₂_chartCoordinate_surjective I 0 x
  exact DFunLike.congr_fun he p

/-- The `X₀` affine chart of the standard twisted cubic is an affine line. -/
noncomputable def standardTwistedCubic_chartZero_affineEquiv :
    ChartRing I 0 ≃+* MvPolynomial (Fin 1) K :=
  RingEquiv.ofRingHom (standardTwistedCubic_chartZero_toAffine (K := K))
    (standardTwistedCubic_affine_toChartZero (K := K))
    (standardTwistedCubic_chartZero_toAffine_comp_affine_toChartZero (K := K))
    (standardTwistedCubic_affine_toChartZero_comp_chartZero_toAffine (K := K))

/-- The affine-coordinate map of the `X₃` chart, sending the four homogeneous
coordinates to `t³, t², t, 1`. -/
noncomputable def standardTwistedCubic_chartThree_coordinateMap :
    CoordinateRing I →ₐ[K] MvPolynomial (Fin 1) K :=
  Ideal.Quotient.liftₐ (standardTwistedCubicIdeal K)
    (MvPolynomial.aeval ![X 0 ^ 3, X 0 ^ 2, X 0, 1]) (by
      intro p hp
      change p ∈ RingHom.ker (MvPolynomial.aeval ![X 0 ^ 3, X 0 ^ 2, X 0, 1]).toRingHom
      apply (Ideal.span_le.mpr ?_) hp
      rintro q ⟨i, rfl⟩
      fin_cases i <;> simp [standardTwistedCubicGenerators] <;> ring)

lemma standardTwistedCubic_chartThree_coordinateMap_mk (p : MvPolynomial (Fin 4) K) :
    standardTwistedCubic_chartThree_coordinateMap (K := K)
      (Ideal.Quotient.mk (I).toIdeal p) =
    MvPolynomial.aeval ![X 0 ^ 3, X 0 ^ 2, X 0, 1] p := rfl

lemma standardTwistedCubic_chartThree_coordinateMap_coordinate (i : Fin 4) :
    standardTwistedCubic_chartThree_coordinateMap (K := K) (coordinate I i) =
      (![X 0 ^ 3, X 0 ^ 2, X 0, 1] : Fin 4 → MvPolynomial (Fin 1) K) i := by
  change standardTwistedCubic_chartThree_coordinateMap (K := K)
      (Ideal.Quotient.mk (I).toIdeal (X i)) = _
  rw [standardTwistedCubic_chartThree_coordinateMap_mk]
  simp

/-- The `X₃` chart maps to the affine line by its coordinate `X₂/X₃`. -/
noncomputable def standardTwistedCubic_chartThree_toAffine :
    ChartRing I 3 →+* MvPolynomial (Fin 1) K :=
  AllCharacteristics.GradedChart.liftCoordinateOne (grading I) (coordinate I 3)
    (standardTwistedCubic_chartThree_coordinateMap (K := K)).toRingHom (by
      change standardTwistedCubic_chartThree_coordinateMap (K := K) (coordinate I 3) = 1
      rw [standardTwistedCubic_chartThree_coordinateMap_coordinate]
      rfl)

lemma standardTwistedCubic_chartThree_toAffine_coordinate (i : Fin 4) :
    standardTwistedCubic_chartThree_toAffine (K := K) (chartCoordinate I 3 i) =
      (![X 0 ^ 3, X 0 ^ 2, X 0, 1] : Fin 4 → MvPolynomial (Fin 1) K) i := by
  change AllCharacteristics.GradedChart.liftCoordinateOne (grading I) (coordinate I 3)
      (standardTwistedCubic_chartThree_coordinateMap (K := K)).toRingHom _
      (chartCoordinate I 3 i) = _
  rw [show chartCoordinate I 3 i =
      AllCharacteristics.GradedChart.normalized (grading I) (coordinate_mem I 3)
        (coordinate I i) (coordinate_mem I i) by rfl]
  rw [AllCharacteristics.GradedChart.liftCoordinateOne_normalized]
  exact standardTwistedCubic_chartThree_coordinateMap_coordinate (K := K) i

/-- The inverse affine-chart map sends `t` to `X₂/X₃`. -/
noncomputable def standardTwistedCubic_affine_toChartThree :
    MvPolynomial (Fin 1) K →+* ChartRing I 3 :=
  MvPolynomial.eval₂Hom (chartBaseMap I 3) ![chartCoordinate I 3 2]

lemma standardTwistedCubic_affine_toChartThree_C (a : K) :
    standardTwistedCubic_affine_toChartThree (K := K) (C a) = chartBaseMap I 3 a := by
  simp [standardTwistedCubic_affine_toChartThree]

lemma standardTwistedCubic_affine_toChartThree_X :
    standardTwistedCubic_affine_toChartThree (K := K) (X 0) = chartCoordinate I 3 2 := by
  simp [standardTwistedCubic_affine_toChartThree]

lemma standardTwistedCubic_chartThree_toAffine_base (a : K) :
    standardTwistedCubic_chartThree_toAffine (K := K) (chartBaseMap I 3 a) = C a := by
  unfold chartBaseMap
  change AllCharacteristics.GradedChart.liftCoordinateOne (grading I) (coordinate I 3)
      (standardTwistedCubic_chartThree_coordinateMap (K := K)).toRingHom _
      (AllCharacteristics.GradedChart.baseMap (grading I) (z := coordinate I 3) a) = C a
  rw [AllCharacteristics.GradedChart.liftCoordinateOne_baseMap]
  change standardTwistedCubic_chartThree_coordinateMap (K := K)
      (Ideal.Quotient.mk (I).toIdeal (C a)) = C a
  rw [standardTwistedCubic_chartThree_coordinateMap_mk]
  simp

lemma standardTwistedCubic_chartThree_toAffine_comp_affine_toChartThree :
    (standardTwistedCubic_chartThree_toAffine (K := K)).comp
      (standardTwistedCubic_affine_toChartThree (K := K)) =
        RingHom.id (MvPolynomial (Fin 1) K) := by
  apply MvPolynomial.ringHom_ext
  · intro a
    simp only [RingHom.comp_apply, RingHom.id_apply,
      standardTwistedCubic_affine_toChartThree, MvPolynomial.eval₂Hom_C]
    exact standardTwistedCubic_chartThree_toAffine_base (K := K) a
  · intro i
    fin_cases i
    simp only [RingHom.comp_apply, RingHom.id_apply,
      standardTwistedCubic_affine_toChartThree, MvPolynomial.eval₂Hom_X']
    simpa using standardTwistedCubic_chartThree_toAffine_coordinate (K := K) (2 : Fin 4)

lemma standardTwistedCubic_affine_toChartThree_comp_chartThree_toAffine :
    (standardTwistedCubic_affine_toChartThree (K := K)).comp
      (standardTwistedCubic_chartThree_toAffine (K := K)) = RingHom.id (ChartRing I 3) := by
  let e := MvPolynomial.eval₂Hom (chartBaseMap I 3) (chartCoordinate I 3)
  have he : (standardTwistedCubic_affine_toChartThree (K := K)).comp
      ((standardTwistedCubic_chartThree_toAffine (K := K)).comp e) = e := by
    dsimp [e]
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      rw [standardTwistedCubic_chartThree_toAffine_base]
      exact standardTwistedCubic_affine_toChartThree_C (K := K) a
    · intro i
      fin_cases i
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartThree_toAffine_coordinate]
        change standardTwistedCubic_affine_toChartThree (K := K) (X 0 ^ 3) = chartCoordinate I 3 0
        rw [map_pow, standardTwistedCubic_affine_toChartThree_X]
        exact (standardTwistedCubic_chart_three_coordinate_zero (K := K)).symm
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartThree_toAffine_coordinate]
        change standardTwistedCubic_affine_toChartThree (K := K) (X 0 ^ 2) = chartCoordinate I 3 1
        rw [map_pow, standardTwistedCubic_affine_toChartThree_X]
        exact (standardTwistedCubic_chart_three_coordinate_one (K := K)).symm
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartThree_toAffine_coordinate]
        exact standardTwistedCubic_affine_toChartThree_X (K := K)
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [standardTwistedCubic_chartThree_toAffine_coordinate]
        change standardTwistedCubic_affine_toChartThree (K := K) 1 = chartCoordinate I 3 3
        rw [map_one]
        exact (chartCoordinate_self I 3).symm
  apply RingHom.ext
  intro x
  obtain ⟨p, rfl⟩ := eval₂_chartCoordinate_surjective I 3 x
  exact DFunLike.congr_fun he p

/-- The `X₃` affine chart of the standard twisted cubic is an affine line. -/
noncomputable def standardTwistedCubic_chartThree_affineEquiv :
    ChartRing I 3 ≃+* MvPolynomial (Fin 1) K :=
  RingEquiv.ofRingHom (standardTwistedCubic_chartThree_toAffine (K := K))
    (standardTwistedCubic_affine_toChartThree (K := K))
    (standardTwistedCubic_chartThree_toAffine_comp_affine_toChartThree (K := K))
    (standardTwistedCubic_affine_toChartThree_comp_chartThree_toAffine (K := K))

/-- The `X₀` chart of the cubic maps to the corresponding standard chart of the
projective line by `X₁/X₀`. -/
noncomputable def lineChartToStandardTwistedCubicChartZero :
    ChartRing L false →+* ChartRing I 0 :=
  projectiveChartMap (chartBaseMap I 0)
    (fun b => if b then chartCoordinate I 0 1 else 1) false (by rfl)

lemma lineChartToStandardTwistedCubicChartZero_base (a : K) :
    lineChartToStandardTwistedCubicChartZero (K := K) (chartBaseMap L false a) =
      chartBaseMap I 0 a := by
  exact projectiveChartMap_baseMap _ _ false rfl a

lemma lineChartToStandardTwistedCubicChartZero_coordinate_false :
    lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false false) = 1 := by
  exact projectiveChartMap_coordinate _ _ false rfl false

lemma lineChartToStandardTwistedCubicChartZero_coordinate_true :
    lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false true) =
      chartCoordinate I 0 1 := by
  exact projectiveChartMap_coordinate _ _ false rfl true

/-- The `X₃` chart of the cubic maps to the other standard chart of the
projective line by `X₂/X₃`. -/
noncomputable def lineChartToStandardTwistedCubicChartThree :
    ChartRing L true →+* ChartRing I 3 :=
  projectiveChartMap (chartBaseMap I 3)
    (fun b => if b then 1 else chartCoordinate I 3 2) true (by rfl)

lemma lineChartToStandardTwistedCubicChartThree_base (a : K) :
    lineChartToStandardTwistedCubicChartThree (K := K) (chartBaseMap L true a) =
      chartBaseMap I 3 a := by
  exact projectiveChartMap_baseMap _ _ true rfl a

lemma lineChartToStandardTwistedCubicChartThree_coordinate_false :
    lineChartToStandardTwistedCubicChartThree (K := K) (chartCoordinate L true false) =
      chartCoordinate I 3 2 := by
  exact projectiveChartMap_coordinate _ _ true rfl false

lemma lineChartToStandardTwistedCubicChartThree_coordinate_true :
    lineChartToStandardTwistedCubicChartThree (K := K) (chartCoordinate L true true) = 1 := by
  exact projectiveChartMap_coordinate _ _ true rfl true

private lemma standardTwistedCubic_overlap_parameter_product :
    chartOverlapLeftMap I 0 3 (chartCoordinate I 0 1) *
      chartOverlapRightMap I 0 3 (chartCoordinate I 3 2) = 1 := by
  have h := congrArg (chartOverlapLeftMap I 0 3)
    (standardTwistedCubic_chart_zero_coordinate_product (K := K))
  rw [map_mul] at h
  rw [chartOverlap_coordinate_relation I 0 3 2, chartOverlapUnit_inv I 0 3] at h
  let u : (ChartOverlapRing I 0 3)ˣ := (chartOverlapUnit I 0 3)⁻¹
  have hu : IsUnit (↑u : ChartOverlapRing I 0 3) := u.isUnit
  apply hu.mul_right_cancel
  calc
    (chartOverlapLeftMap I 0 3 (chartCoordinate I 0 1) *
        chartOverlapRightMap I 0 3 (chartCoordinate I 3 2)) * (↑u : ChartOverlapRing I 0 3) =
        chartOverlapLeftMap I 0 3 (chartCoordinate I 0 1) *
          ((↑u : ChartOverlapRing I 0 3) *
            chartOverlapRightMap I 0 3 (chartCoordinate I 3 2)) := by ring
    _ = ↑u := h
    _ = 1 * ↑u := by rw [one_mul]

private lemma standardTwistedCubic_overlap_parameter_isUnit :
    IsUnit (chartOverlapLeftMap I 0 3 (chartCoordinate I 0 1)) := by
  apply (isUnit_pow_iff (by norm_num : (3 : ℕ) ≠ 0)).mp
  rw [← map_pow, ← standardTwistedCubic_chart_zero_coordinate_three]
  rw [← chartOverlapUnit_inv]
  exact ((chartOverlapUnit I 0 3)⁻¹).isUnit

noncomputable def standardTwistedCubic_overlapToLineChartZero :
    ChartRing L false →+* ChartOverlapRing I 0 3 :=
  (chartOverlapLeftMap I 0 3).comp (lineChartToStandardTwistedCubicChartZero (K := K))

noncomputable def standardTwistedCubic_overlapToLineChartThree :
    ChartRing L true →+* ChartOverlapRing I 0 3 :=
  (chartOverlapRightMap I 0 3).comp (lineChartToStandardTwistedCubicChartThree (K := K))

private theorem standardTwistedCubic_overlap_lineCharts_compatible :
    Spec.map (CommRingCat.ofHom (standardTwistedCubic_overlapToLineChartZero (K := K))) ≫
        chartι L false =
      Spec.map (CommRingCat.ofHom (standardTwistedCubic_overlapToLineChartThree (K := K))) ≫
        chartι L true := by
  apply projectiveChartSpec_eq_of_ratio false true
  · apply RingHom.ext
    intro a
    change chartOverlapLeftMap I 0 3
        (lineChartToStandardTwistedCubicChartZero (K := K) (chartBaseMap L false a)) =
      chartOverlapRightMap I 0 3
        (lineChartToStandardTwistedCubicChartThree (K := K) (chartBaseMap L true a))
    rw [lineChartToStandardTwistedCubicChartZero_base,
      lineChartToStandardTwistedCubicChartThree_base,
      chartOverlapLeftMap_baseMap, chartOverlapRightMap_baseMap]
  · change IsUnit (chartOverlapLeftMap I 0 3
      (lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false true)))
    rw [lineChartToStandardTwistedCubicChartZero_coordinate_true]
    exact standardTwistedCubic_overlap_parameter_isUnit (K := K)
  · intro m
    cases m
    · change chartOverlapLeftMap I 0 3
          (lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false false)) =
        chartOverlapLeftMap I 0 3
          (lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false true)) *
          chartOverlapRightMap I 0 3
            (lineChartToStandardTwistedCubicChartThree (K := K) (chartCoordinate L true false))
      rw [lineChartToStandardTwistedCubicChartZero_coordinate_false,
        lineChartToStandardTwistedCubicChartZero_coordinate_true,
        lineChartToStandardTwistedCubicChartThree_coordinate_false, map_one]
      exact (standardTwistedCubic_overlap_parameter_product (K := K)).symm
    · change chartOverlapLeftMap I 0 3
          (lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false true)) =
        chartOverlapLeftMap I 0 3
          (lineChartToStandardTwistedCubicChartZero (K := K) (chartCoordinate L false true)) *
          chartOverlapRightMap I 0 3
            (lineChartToStandardTwistedCubicChartThree (K := K) (chartCoordinate L true true))
      rw [lineChartToStandardTwistedCubicChartZero_coordinate_true,
        lineChartToStandardTwistedCubicChartThree_coordinate_true, map_one, mul_one]

private theorem standardTwistedCubic_charts_to_line_cross_compatible :
    pullback.fst (chartι I 0) (chartι I 3) ≫
        (Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartZero (K := K))) ≫
          chartι L false) =
      pullback.snd (chartι I 0) (chartι I 3) ≫
        (Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartThree (K := K))) ≫
          chartι L true) := by
  apply (cancel_epi (chartOverlapIso I 0 3).inv).mp
  simp only [← Category.assoc]
  rw [chartOverlapIso_inv_fst, chartOverlapIso_inv_snd,
    ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  exact standardTwistedCubic_overlap_lineCharts_compatible (K := K)

noncomputable def standardTwistedCubicChartToLine (b : Bool) :
    (standardTwistedCubicOpenCover (K := K)).X b ⟶ scheme L := by
  cases b
  · exact Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartZero (K := K))) ≫
      chartι L false
  · exact Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartThree (K := K))) ≫
      chartι L true

private theorem standardTwistedCubicChartToLine_compatible (b c : Bool) :
    pullback.fst ((standardTwistedCubicOpenCover (K := K)).f b)
        ((standardTwistedCubicOpenCover (K := K)).f c) ≫
      standardTwistedCubicChartToLine (K := K) b =
      pullback.snd ((standardTwistedCubicOpenCover (K := K)).f b)
        ((standardTwistedCubicOpenCover (K := K)).f c) ≫
      standardTwistedCubicChartToLine (K := K) c := by
  cases b <;> cases c
  · change pullback.fst (chartι I 0) (chartι I 0) ≫ _ =
      pullback.snd (chartι I 0) (chartι I 0) ≫ _
    have h : pullback.fst (chartι I 0) (chartι I 0) = pullback.snd (chartι I 0) (chartι I 0) :=
      (cancel_mono (chartι I 0)).mp pullback.condition
    rw [h]
  · exact standardTwistedCubic_charts_to_line_cross_compatible (K := K)
  · change pullback.fst (chartι I 3) (chartι I 0) ≫ _ =
      pullback.snd (chartι I 3) (chartι I 0) ≫ _
    apply (cancel_epi (pullbackSymmetry (chartι I 3) (chartι I 0)).inv).mp
    change (pullbackSymmetry (chartι I 3) (chartι I 0)).inv ≫
        (pullback.fst (chartι I 3) (chartι I 0) ≫
          (Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartThree (K := K))) ≫
            chartι L true)) =
      (pullbackSymmetry (chartι I 3) (chartι I 0)).inv ≫
        (pullback.snd (chartι I 3) (chartι I 0) ≫
          (Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartZero (K := K))) ≫
            chartι L false))
    simpa only [← Category.assoc, pullbackSymmetry_inv_comp_fst,
      pullbackSymmetry_inv_comp_snd] using
      (standardTwistedCubic_charts_to_line_cross_compatible (K := K)).symm
  · change pullback.fst (chartι I 3) (chartι I 3) ≫ _ =
      pullback.snd (chartι I 3) (chartι I 3) ≫ _
    have h : pullback.fst (chartι I 3) (chartι I 3) = pullback.snd (chartι I 3) (chartι I 3) :=
      (cancel_mono (chartι I 3)).mp pullback.condition
    rw [h]

/-- The standard twisted cubic maps canonically to the standard projective line. -/
noncomputable def standardTwistedCubicToProjectiveLine : scheme I ⟶ scheme L :=
  (standardTwistedCubicOpenCover (K := K)).glueMorphisms
    (standardTwistedCubicChartToLine (K := K))
    (standardTwistedCubicChartToLine_compatible (K := K))

noncomputable def affineToLineChartZero :
    MvPolynomial (Fin 1) K →+* ChartRing L false :=
  MvPolynomial.eval₂Hom (chartBaseMap L false) ![chartCoordinate L false true]

lemma affineToLineChartZero_C (a : K) :
    affineToLineChartZero (K := K) (C a) = chartBaseMap L false a := by
  simp [affineToLineChartZero]

lemma affineToLineChartZero_X :
    affineToLineChartZero (K := K) (X 0) = chartCoordinate L false true := by
  simp [affineToLineChartZero]

noncomputable def affineToLineChartThree :
    MvPolynomial (Fin 1) K →+* ChartRing L true :=
  MvPolynomial.eval₂Hom (chartBaseMap L true) ![chartCoordinate L true false]

lemma affineToLineChartThree_C (a : K) :
    affineToLineChartThree (K := K) (C a) = chartBaseMap L true a := by
  simp [affineToLineChartThree]

lemma affineToLineChartThree_X :
    affineToLineChartThree (K := K) (X 0) = chartCoordinate L true false := by
  simp [affineToLineChartThree]

/-- The inverse local map from the first cubic chart to the first line chart. -/
noncomputable def standardTwistedCubicChartZeroToLineChart :
    ChartRing I 0 →+* ChartRing L false :=
  (affineToLineChartZero (K := K)).comp (standardTwistedCubic_chartZero_toAffine (K := K))

/-- The inverse local map from the last cubic chart to the last line chart. -/
noncomputable def standardTwistedCubicChartThreeToLineChart :
    ChartRing I 3 →+* ChartRing L true :=
  (affineToLineChartThree (K := K)).comp (standardTwistedCubic_chartThree_toAffine (K := K))

lemma standardTwistedCubicChartZeroToLineChart_base (a : K) :
    standardTwistedCubicChartZeroToLineChart (K := K) (chartBaseMap I 0 a) =
      chartBaseMap L false a := by
  change affineToLineChartZero (K := K)
    (standardTwistedCubic_chartZero_toAffine (K := K) (chartBaseMap I 0 a)) = _
  rw [standardTwistedCubic_chartZero_toAffine_base, affineToLineChartZero_C]

lemma standardTwistedCubicChartThreeToLineChart_base (a : K) :
    standardTwistedCubicChartThreeToLineChart (K := K) (chartBaseMap I 3 a) =
      chartBaseMap L true a := by
  change affineToLineChartThree (K := K)
    (standardTwistedCubic_chartThree_toAffine (K := K) (chartBaseMap I 3 a)) = _
  rw [standardTwistedCubic_chartThree_toAffine_base, affineToLineChartThree_C]

lemma standardTwistedCubicChartZeroToLineChart_coordinate (i : Fin 4) :
    standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 i) =
      (![1, chartCoordinate L false true, chartCoordinate L false true ^ 2,
        chartCoordinate L false true ^ 3] : Fin 4 → ChartRing L false) i := by
  change affineToLineChartZero (K := K)
    (standardTwistedCubic_chartZero_toAffine (K := K) (chartCoordinate I 0 i)) = _
  rw [standardTwistedCubic_chartZero_toAffine_coordinate]
  fin_cases i <;> simp [affineToLineChartZero]

lemma standardTwistedCubicChartThreeToLineChart_coordinate (i : Fin 4) :
    standardTwistedCubicChartThreeToLineChart (K := K) (chartCoordinate I 3 i) =
      (![chartCoordinate L true false ^ 3, chartCoordinate L true false ^ 2,
        chartCoordinate L true false, 1] : Fin 4 → ChartRing L true) i := by
  change affineToLineChartThree (K := K)
    (standardTwistedCubic_chartThree_toAffine (K := K) (chartCoordinate I 3 i)) = _
  rw [standardTwistedCubic_chartThree_toAffine_coordinate]
  fin_cases i <;> simp [affineToLineChartThree]

private lemma standardTwistedCubic_lineChartZero_comp_chartZeroToLine :
    (standardTwistedCubicChartZeroToLineChart (K := K)).comp
      (lineChartToStandardTwistedCubicChartZero (K := K)) = RingHom.id (ChartRing L false) := by
  apply projectiveChartMap_ext false
  · apply RingHom.ext
    intro a
    change affineToLineChartZero (K := K)
        (standardTwistedCubic_chartZero_toAffine (K := K)
          (lineChartToStandardTwistedCubicChartZero (K := K) (chartBaseMap L false a))) = _
    rw [lineChartToStandardTwistedCubicChartZero_base,
      standardTwistedCubic_chartZero_toAffine_base, affineToLineChartZero_C]
    simp
  · intro b
    cases b
    · change affineToLineChartZero (K := K)
          (standardTwistedCubic_chartZero_toAffine (K := K)
            (lineChartToStandardTwistedCubicChartZero (K := K)
              (chartCoordinate L false false))) = _
      rw [lineChartToStandardTwistedCubicChartZero_coordinate_false, map_one]
      rw [RingHom.id_apply, chartCoordinate_self]
      exact (affineToLineChartZero (K := K)).map_one
    · change affineToLineChartZero (K := K)
          (standardTwistedCubic_chartZero_toAffine (K := K)
            (lineChartToStandardTwistedCubicChartZero (K := K)
              (chartCoordinate L false true))) = _
      rw [lineChartToStandardTwistedCubicChartZero_coordinate_true,
        standardTwistedCubic_chartZero_toAffine_coordinate]
      exact affineToLineChartZero_X (K := K)

private lemma standardTwistedCubic_chartZeroToLine_comp_lineChartZero :
    (lineChartToStandardTwistedCubicChartZero (K := K)).comp
      (standardTwistedCubicChartZeroToLineChart (K := K)) = RingHom.id (ChartRing I 0) := by
  have hbase (a : K) :
      ((lineChartToStandardTwistedCubicChartZero (K := K)).comp
        (standardTwistedCubicChartZeroToLineChart (K := K))) (chartBaseMap I 0 a) =
        chartBaseMap I 0 a := by
    change lineChartToStandardTwistedCubicChartZero (K := K)
        (affineToLineChartZero (K := K)
          (standardTwistedCubic_chartZero_toAffine (K := K) (chartBaseMap I 0 a))) = _
    rw [standardTwistedCubic_chartZero_toAffine_base, affineToLineChartZero_C,
      lineChartToStandardTwistedCubicChartZero_base]
  have hcoord (i : Fin 4) :
      ((lineChartToStandardTwistedCubicChartZero (K := K)).comp
        (standardTwistedCubicChartZeroToLineChart (K := K))) (chartCoordinate I 0 i) =
        chartCoordinate I 0 i := by
    fin_cases i
    · change lineChartToStandardTwistedCubicChartZero (K := K)
          (affineToLineChartZero (K := K)
            (standardTwistedCubic_chartZero_toAffine (K := K) (chartCoordinate I 0 0))) = _
      rw [standardTwistedCubic_chartZero_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartZero (K := K) (affineToLineChartZero (K := K) 1) = _
      rw [map_one]
      simpa using (chartCoordinate_self I 0).symm
    · change lineChartToStandardTwistedCubicChartZero (K := K)
          (affineToLineChartZero (K := K)
            (standardTwistedCubic_chartZero_toAffine (K := K) (chartCoordinate I 0 1))) = _
      rw [standardTwistedCubic_chartZero_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartZero (K := K)
        (affineToLineChartZero (K := K) (X 0)) = _
      rw [affineToLineChartZero_X, lineChartToStandardTwistedCubicChartZero_coordinate_true]
      rfl
    · change lineChartToStandardTwistedCubicChartZero (K := K)
          (affineToLineChartZero (K := K)
            (standardTwistedCubic_chartZero_toAffine (K := K) (chartCoordinate I 0 2))) = _
      rw [standardTwistedCubic_chartZero_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartZero (K := K)
        (affineToLineChartZero (K := K) (X 0 ^ 2)) = _
      rw [map_pow, affineToLineChartZero_X, map_pow,
        lineChartToStandardTwistedCubicChartZero_coordinate_true]
      simpa using (standardTwistedCubic_chart_zero_coordinate_two (K := K)).symm
    · change lineChartToStandardTwistedCubicChartZero (K := K)
          (affineToLineChartZero (K := K)
            (standardTwistedCubic_chartZero_toAffine (K := K) (chartCoordinate I 0 3))) = _
      rw [standardTwistedCubic_chartZero_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartZero (K := K)
        (affineToLineChartZero (K := K) (X 0 ^ 3)) = _
      rw [map_pow, affineToLineChartZero_X, map_pow,
        lineChartToStandardTwistedCubicChartZero_coordinate_true]
      simpa using (standardTwistedCubic_chart_zero_coordinate_three (K := K)).symm
  let φ := (lineChartToStandardTwistedCubicChartZero (K := K)).comp
    (standardTwistedCubicChartZeroToLineChart (K := K))
  let e := MvPolynomial.eval₂Hom (chartBaseMap I 0) (chartCoordinate I 0)
  have he : φ.comp e = e := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simpa [φ, e] using hbase a
    · intro i
      simpa [φ, e] using hcoord i
  apply RingHom.ext
  intro x
  obtain ⟨p, rfl⟩ := eval₂_chartCoordinate_surjective I 0 x
  exact DFunLike.congr_fun he p

private lemma standardTwistedCubic_lineChartThree_comp_chartThreeToLine :
    (standardTwistedCubicChartThreeToLineChart (K := K)).comp
      (lineChartToStandardTwistedCubicChartThree (K := K)) = RingHom.id (ChartRing L true) := by
  apply projectiveChartMap_ext true
  · apply RingHom.ext
    intro a
    change affineToLineChartThree (K := K)
        (standardTwistedCubic_chartThree_toAffine (K := K)
          (lineChartToStandardTwistedCubicChartThree (K := K) (chartBaseMap L true a))) = _
    rw [lineChartToStandardTwistedCubicChartThree_base,
      standardTwistedCubic_chartThree_toAffine_base, affineToLineChartThree_C]
    simp
  · intro b
    cases b
    · change affineToLineChartThree (K := K)
          (standardTwistedCubic_chartThree_toAffine (K := K)
            (lineChartToStandardTwistedCubicChartThree (K := K)
              (chartCoordinate L true false))) = _
      rw [lineChartToStandardTwistedCubicChartThree_coordinate_false,
        standardTwistedCubic_chartThree_toAffine_coordinate]
      exact affineToLineChartThree_X (K := K)
    · change affineToLineChartThree (K := K)
          (standardTwistedCubic_chartThree_toAffine (K := K)
            (lineChartToStandardTwistedCubicChartThree (K := K)
              (chartCoordinate L true true))) = _
      rw [lineChartToStandardTwistedCubicChartThree_coordinate_true, map_one,
        RingHom.id_apply, chartCoordinate_self]
      exact (affineToLineChartThree (K := K)).map_one

private lemma standardTwistedCubic_chartThreeToLine_comp_lineChartThree :
    (lineChartToStandardTwistedCubicChartThree (K := K)).comp
      (standardTwistedCubicChartThreeToLineChart (K := K)) = RingHom.id (ChartRing I 3) := by
  have hbase (a : K) :
      ((lineChartToStandardTwistedCubicChartThree (K := K)).comp
        (standardTwistedCubicChartThreeToLineChart (K := K))) (chartBaseMap I 3 a) =
        chartBaseMap I 3 a := by
    change lineChartToStandardTwistedCubicChartThree (K := K)
        (affineToLineChartThree (K := K)
          (standardTwistedCubic_chartThree_toAffine (K := K) (chartBaseMap I 3 a))) = _
    rw [standardTwistedCubic_chartThree_toAffine_base, affineToLineChartThree_C,
      lineChartToStandardTwistedCubicChartThree_base]
  have hcoord (i : Fin 4) :
      ((lineChartToStandardTwistedCubicChartThree (K := K)).comp
        (standardTwistedCubicChartThreeToLineChart (K := K))) (chartCoordinate I 3 i) =
        chartCoordinate I 3 i := by
    fin_cases i
    · change lineChartToStandardTwistedCubicChartThree (K := K)
          (affineToLineChartThree (K := K)
            (standardTwistedCubic_chartThree_toAffine (K := K) (chartCoordinate I 3 0))) = _
      rw [standardTwistedCubic_chartThree_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartThree (K := K)
        (affineToLineChartThree (K := K) (X 0 ^ 3)) = _
      rw [map_pow, affineToLineChartThree_X, map_pow,
        lineChartToStandardTwistedCubicChartThree_coordinate_false]
      simpa using (standardTwistedCubic_chart_three_coordinate_zero (K := K)).symm
    · change lineChartToStandardTwistedCubicChartThree (K := K)
          (affineToLineChartThree (K := K)
            (standardTwistedCubic_chartThree_toAffine (K := K) (chartCoordinate I 3 1))) = _
      rw [standardTwistedCubic_chartThree_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartThree (K := K)
        (affineToLineChartThree (K := K) (X 0 ^ 2)) = _
      rw [map_pow, affineToLineChartThree_X, map_pow,
        lineChartToStandardTwistedCubicChartThree_coordinate_false]
      simpa using (standardTwistedCubic_chart_three_coordinate_one (K := K)).symm
    · change lineChartToStandardTwistedCubicChartThree (K := K)
          (affineToLineChartThree (K := K)
            (standardTwistedCubic_chartThree_toAffine (K := K) (chartCoordinate I 3 2))) = _
      rw [standardTwistedCubic_chartThree_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartThree (K := K)
        (affineToLineChartThree (K := K) (X 0)) = _
      rw [affineToLineChartThree_X, lineChartToStandardTwistedCubicChartThree_coordinate_false]
      rfl
    · change lineChartToStandardTwistedCubicChartThree (K := K)
          (affineToLineChartThree (K := K)
            (standardTwistedCubic_chartThree_toAffine (K := K) (chartCoordinate I 3 3))) = _
      rw [standardTwistedCubic_chartThree_toAffine_coordinate]
      change lineChartToStandardTwistedCubicChartThree (K := K)
        (affineToLineChartThree (K := K) 1) = _
      rw [map_one]
      simpa using (chartCoordinate_self I 3).symm
  let φ := (lineChartToStandardTwistedCubicChartThree (K := K)).comp
    (standardTwistedCubicChartThreeToLineChart (K := K))
  let e := MvPolynomial.eval₂Hom (chartBaseMap I 3) (chartCoordinate I 3)
  have he : φ.comp e = e := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simpa [φ, e] using hbase a
    · intro i
      simpa [φ, e] using hcoord i
  apply RingHom.ext
  intro x
  obtain ⟨p, rfl⟩ := eval₂_chartCoordinate_surjective I 3 x
  exact DFunLike.congr_fun he p

private lemma standardProjectiveLine_overlap_parameter_product :
    chartOverlapLeftMap L false true (chartCoordinate L false true) *
      chartOverlapRightMap L false true (chartCoordinate L true false) = 1 := by
  rw [← chartOverlapUnit_inv L false true, ← chartOverlapUnit_val L false true]
  exact Units.inv_mul _

private lemma standardProjectiveLine_overlap_parameter_isUnit :
    IsUnit (chartOverlapLeftMap L false true (chartCoordinate L false true)) := by
  rw [← chartOverlapUnit_inv L false true]
  exact ((chartOverlapUnit L false true)⁻¹).isUnit

noncomputable def standardProjectiveLine_overlapToCubicChartZero :
    ChartRing I 0 →+* ChartOverlapRing L false true :=
  (chartOverlapLeftMap L false true).comp (standardTwistedCubicChartZeroToLineChart (K := K))

noncomputable def standardProjectiveLine_overlapToCubicChartThree :
    ChartRing I 3 →+* ChartOverlapRing L false true :=
  (chartOverlapRightMap L false true).comp (standardTwistedCubicChartThreeToLineChart (K := K))

private lemma standardTwistedCubicChartZeroToLineChart_coordinate_zero :
    standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 0) = 1 := by
  simpa using standardTwistedCubicChartZeroToLineChart_coordinate (K := K) (0 : Fin 4)

private lemma standardTwistedCubicChartZeroToLineChart_coordinate_one :
    standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 1) =
      chartCoordinate L false true := by
  simpa using standardTwistedCubicChartZeroToLineChart_coordinate (K := K) (1 : Fin 4)

private lemma standardTwistedCubicChartZeroToLineChart_coordinate_two :
    standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 2) =
      chartCoordinate L false true ^ 2 := by
  simpa using standardTwistedCubicChartZeroToLineChart_coordinate (K := K) (2 : Fin 4)

private lemma standardTwistedCubicChartZeroToLineChart_coordinate_three :
    standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 3) =
      chartCoordinate L false true ^ 3 := by
  simpa using standardTwistedCubicChartZeroToLineChart_coordinate (K := K) (3 : Fin 4)

private lemma standardTwistedCubicChartThreeToLineChart_coordinate_zero :
    standardTwistedCubicChartThreeToLineChart (K := K) (chartCoordinate I 3 0) =
      chartCoordinate L true false ^ 3 := by
  simpa using standardTwistedCubicChartThreeToLineChart_coordinate (K := K) (0 : Fin 4)

private lemma standardTwistedCubicChartThreeToLineChart_coordinate_one :
    standardTwistedCubicChartThreeToLineChart (K := K) (chartCoordinate I 3 1) =
      chartCoordinate L true false ^ 2 := by
  simpa using standardTwistedCubicChartThreeToLineChart_coordinate (K := K) (1 : Fin 4)

private lemma standardTwistedCubicChartThreeToLineChart_coordinate_two :
    standardTwistedCubicChartThreeToLineChart (K := K) (chartCoordinate I 3 2) =
      chartCoordinate L true false := by
  simpa using standardTwistedCubicChartThreeToLineChart_coordinate (K := K) (2 : Fin 4)

private lemma standardTwistedCubicChartThreeToLineChart_coordinate_three :
    standardTwistedCubicChartThreeToLineChart (K := K) (chartCoordinate I 3 3) = 1 := by
  simpa using standardTwistedCubicChartThreeToLineChart_coordinate (K := K) (3 : Fin 4)

private theorem standardProjectiveLine_overlap_cubicCharts_compatible :
    Spec.map (CommRingCat.ofHom (standardProjectiveLine_overlapToCubicChartZero (K := K))) ≫
        chartι I 0 =
      Spec.map (CommRingCat.ofHom (standardProjectiveLine_overlapToCubicChartThree (K := K))) ≫
        chartι I 3 := by
  apply projectiveQuotientChartSpec_eq_of_ratio I 0 3
  · apply RingHom.ext
    intro a
    change chartOverlapLeftMap L false true
        (standardTwistedCubicChartZeroToLineChart (K := K) (chartBaseMap I 0 a)) =
      chartOverlapRightMap L false true
        (standardTwistedCubicChartThreeToLineChart (K := K) (chartBaseMap I 3 a))
    rw [standardTwistedCubicChartZeroToLineChart_base,
      standardTwistedCubicChartThreeToLineChart_base,
      chartOverlapLeftMap_baseMap, chartOverlapRightMap_baseMap]
  · change IsUnit (chartOverlapLeftMap L false true
      (standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 3)))
    rw [standardTwistedCubicChartZeroToLineChart_coordinate]
    change IsUnit (chartOverlapLeftMap L false true (chartCoordinate L false true ^ 3))
    rw [map_pow]
    exact (standardProjectiveLine_overlap_parameter_isUnit (K := K)).pow 3
  · intro m
    change chartOverlapLeftMap L false true
        (standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 m)) =
      chartOverlapLeftMap L false true
          (standardTwistedCubicChartZeroToLineChart (K := K) (chartCoordinate I 0 3)) *
        chartOverlapRightMap L false true
          (standardTwistedCubicChartThreeToLineChart (K := K) (chartCoordinate I 3 m))
    refine Fin.cases ?_ (fun m => ?_) m
    · rw [standardTwistedCubicChartZeroToLineChart_coordinate_zero,
        standardTwistedCubicChartZeroToLineChart_coordinate_three,
        standardTwistedCubicChartThreeToLineChart_coordinate_zero]
      rw [map_one, map_pow, map_pow]
      rw [← mul_pow, standardProjectiveLine_overlap_parameter_product, one_pow]
    · refine Fin.cases ?_ (fun m => ?_) m
      · rw [Fin.succ_zero_eq_one']
        rw [standardTwistedCubicChartZeroToLineChart_coordinate_one,
          standardTwistedCubicChartZeroToLineChart_coordinate_three,
          standardTwistedCubicChartThreeToLineChart_coordinate_one]
        rw [map_pow, map_pow]
        calc
          chartOverlapLeftMap L false true (chartCoordinate L false true) =
              chartOverlapLeftMap L false true (chartCoordinate L false true) * 1 := (mul_one _).symm
          _ = chartOverlapLeftMap L false true (chartCoordinate L false true) *
              (chartOverlapLeftMap L false true (chartCoordinate L false true) *
                chartOverlapRightMap L false true (chartCoordinate L true false)) ^ 2 := by
              rw [standardProjectiveLine_overlap_parameter_product, one_pow]
          _ = _ := by ring
      · refine Fin.cases ?_ (fun m => ?_) m
        · rw [Fin.succ_zero_eq_one', Fin.succ_one_eq_two']
          rw [standardTwistedCubicChartZeroToLineChart_coordinate_two,
            standardTwistedCubicChartZeroToLineChart_coordinate_three,
            standardTwistedCubicChartThreeToLineChart_coordinate_two]
          rw [map_pow, map_pow]
          calc
            chartOverlapLeftMap L false true (chartCoordinate L false true) ^ 2 =
                chartOverlapLeftMap L false true (chartCoordinate L false true) ^ 2 * 1 := (mul_one _).symm
            _ = chartOverlapLeftMap L false true (chartCoordinate L false true) ^ 2 *
                (chartOverlapLeftMap L false true (chartCoordinate L false true) *
                  chartOverlapRightMap L false true (chartCoordinate L true false)) := by
                rw [standardProjectiveLine_overlap_parameter_product, mul_one]
            _ = _ := by ring
        · refine Fin.cases ?_ (fun m => ?_) m
          · rw [Fin.succ_zero_eq_one', Fin.succ_one_eq_two']
            have hthree : (Fin.succ (2 : Fin 3) : Fin 4) = 3 := by rfl
            rw [hthree]
            rw [standardTwistedCubicChartZeroToLineChart_coordinate_three,
              standardTwistedCubicChartThreeToLineChart_coordinate_three]
            rw [map_one]
            change chartOverlapLeftMap L false true (chartCoordinate L false true ^ 3) =
              chartOverlapLeftMap L false true (chartCoordinate L false true ^ 3) * 1
            rw [mul_one]
          · exact Fin.elim0 m

noncomputable def standardProjectiveLineOpenCover : (scheme L).OpenCover where
  I₀ := Bool
  X b := Spec (.of (ChartRing L b))
  f b := chartι L b
  mem₀ := by
    rw [Scheme.presieve₀_mem_precoverage_iff]
    constructor
    · intro x
      obtain ⟨b, y, hy⟩ := exists_coordinate_chart L x
      exact ⟨b, y, hy⟩
    · intro b
      infer_instance

noncomputable def standardProjectiveLineChartToCubic (b : Bool) :
    (standardProjectiveLineOpenCover (K := K)).X b ⟶ scheme I := by
  cases b
  · exact Spec.map (CommRingCat.ofHom (standardTwistedCubicChartZeroToLineChart (K := K))) ≫
      chartι I 0
  · exact Spec.map (CommRingCat.ofHom (standardTwistedCubicChartThreeToLineChart (K := K))) ≫
      chartι I 3

private theorem standardProjectiveLine_charts_to_cubic_cross_compatible :
    pullback.fst (chartι L false) (chartι L true) ≫
        (Spec.map (CommRingCat.ofHom (standardTwistedCubicChartZeroToLineChart (K := K))) ≫
          chartι I 0) =
      pullback.snd (chartι L false) (chartι L true) ≫
        (Spec.map (CommRingCat.ofHom (standardTwistedCubicChartThreeToLineChart (K := K))) ≫
          chartι I 3) := by
  apply (cancel_epi (chartOverlapIso L false true).inv).mp
  simp only [← Category.assoc]
  rw [chartOverlapIso_inv_fst, chartOverlapIso_inv_snd,
    ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  exact standardProjectiveLine_overlap_cubicCharts_compatible (K := K)

private theorem standardProjectiveLineChartToCubic_compatible (b c : Bool) :
    pullback.fst ((standardProjectiveLineOpenCover (K := K)).f b)
        ((standardProjectiveLineOpenCover (K := K)).f c) ≫
      standardProjectiveLineChartToCubic (K := K) b =
      pullback.snd ((standardProjectiveLineOpenCover (K := K)).f b)
        ((standardProjectiveLineOpenCover (K := K)).f c) ≫
      standardProjectiveLineChartToCubic (K := K) c := by
  cases b <;> cases c
  · change pullback.fst (chartι L false) (chartι L false) ≫ _ =
      pullback.snd (chartι L false) (chartι L false) ≫ _
    have h : pullback.fst (chartι L false) (chartι L false) =
        pullback.snd (chartι L false) (chartι L false) :=
      (cancel_mono (chartι L false)).mp pullback.condition
    rw [h]
  · exact standardProjectiveLine_charts_to_cubic_cross_compatible (K := K)
  · change pullback.fst (chartι L true) (chartι L false) ≫ _ =
      pullback.snd (chartι L true) (chartι L false) ≫ _
    apply (cancel_epi (pullbackSymmetry (chartι L true) (chartι L false)).inv).mp
    change (pullbackSymmetry (chartι L true) (chartι L false)).inv ≫
        (pullback.fst (chartι L true) (chartι L false) ≫
          (Spec.map (CommRingCat.ofHom (standardTwistedCubicChartThreeToLineChart (K := K))) ≫
            chartι I 3)) =
      (pullbackSymmetry (chartι L true) (chartι L false)).inv ≫
        (pullback.snd (chartι L true) (chartι L false) ≫
          (Spec.map (CommRingCat.ofHom (standardTwistedCubicChartZeroToLineChart (K := K))) ≫
            chartι I 0))
    simpa only [← Category.assoc, pullbackSymmetry_inv_comp_fst,
      pullbackSymmetry_inv_comp_snd] using
      (standardProjectiveLine_charts_to_cubic_cross_compatible (K := K)).symm
  · change pullback.fst (chartι L true) (chartι L true) ≫ _ =
      pullback.snd (chartι L true) (chartι L true) ≫ _
    have h : pullback.fst (chartι L true) (chartι L true) =
        pullback.snd (chartι L true) (chartι L true) :=
      (cancel_mono (chartι L true)).mp pullback.condition
    rw [h]

/-- The inverse map from the standard projective line to the standard twisted cubic. -/
noncomputable def standardProjectiveLineToTwistedCubic : scheme L ⟶ scheme I :=
  (standardProjectiveLineOpenCover (K := K)).glueMorphisms
    (standardProjectiveLineChartToCubic (K := K))
    (standardProjectiveLineChartToCubic_compatible (K := K))

lemma standardTwistedCubicChart_toProjectiveLine (b : Bool) :
    (standardTwistedCubicOpenCover (K := K)).f b ≫
      standardTwistedCubicToProjectiveLine (K := K) =
        standardTwistedCubicChartToLine (K := K) b :=
  (standardTwistedCubicOpenCover (K := K)).ι_glueMorphisms
    (standardTwistedCubicChartToLine (K := K))
    (standardTwistedCubicChartToLine_compatible (K := K)) b

lemma standardProjectiveLineChart_toTwistedCubic (b : Bool) :
    (standardProjectiveLineOpenCover (K := K)).f b ≫
      standardProjectiveLineToTwistedCubic (K := K) =
        standardProjectiveLineChartToCubic (K := K) b :=
  (standardProjectiveLineOpenCover (K := K)).ι_glueMorphisms
    (standardProjectiveLineChartToCubic (K := K))
    (standardProjectiveLineChartToCubic_compatible (K := K)) b

lemma standardTwistedCubicChartZero_toProjectiveLine :
    chartι I 0 ≫ standardTwistedCubicToProjectiveLine (K := K) =
      Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartZero (K := K))) ≫
        chartι L false := by
  change (standardTwistedCubicOpenCover (K := K)).f false ≫
    standardTwistedCubicToProjectiveLine (K := K) = _
  exact standardTwistedCubicChart_toProjectiveLine (K := K) false

lemma standardTwistedCubicChartThree_toProjectiveLine :
    chartι I 3 ≫ standardTwistedCubicToProjectiveLine (K := K) =
      Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartThree (K := K))) ≫
        chartι L true := by
  change (standardTwistedCubicOpenCover (K := K)).f true ≫
    standardTwistedCubicToProjectiveLine (K := K) = _
  exact standardTwistedCubicChart_toProjectiveLine (K := K) true

lemma standardProjectiveLineChartZero_toTwistedCubic :
    chartι L false ≫ standardProjectiveLineToTwistedCubic (K := K) =
      Spec.map (CommRingCat.ofHom (standardTwistedCubicChartZeroToLineChart (K := K))) ≫
        chartι I 0 := by
  change (standardProjectiveLineOpenCover (K := K)).f false ≫
    standardProjectiveLineToTwistedCubic (K := K) = _
  exact standardProjectiveLineChart_toTwistedCubic (K := K) false

lemma standardProjectiveLineChartThree_toTwistedCubic :
    chartι L true ≫ standardProjectiveLineToTwistedCubic (K := K) =
      Spec.map (CommRingCat.ofHom (standardTwistedCubicChartThreeToLineChart (K := K))) ≫
        chartι I 3 := by
  change (standardProjectiveLineOpenCover (K := K)).f true ≫
    standardProjectiveLineToTwistedCubic (K := K) = _
  exact standardProjectiveLineChart_toTwistedCubic (K := K) true

private theorem standardTwistedCubic_projectiveLine_comp :
    standardTwistedCubicToProjectiveLine (K := K) ≫
      standardProjectiveLineToTwistedCubic (K := K) = 𝟙 (scheme I) := by
  apply (standardTwistedCubicOpenCover (K := K)).hom_ext
  intro b
  cases b
  · change chartι I 0 ≫ standardTwistedCubicToProjectiveLine (K := K) ≫
        standardProjectiveLineToTwistedCubic (K := K) = chartι I 0
    rw [← Category.assoc]
    change ((standardTwistedCubicOpenCover (K := K)).f false ≫
      standardTwistedCubicToProjectiveLine (K := K)) ≫
        standardProjectiveLineToTwistedCubic (K := K) = chartι I 0
    rw [standardTwistedCubicChart_toProjectiveLine]
    change (Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartZero (K := K))) ≫
      chartι L false) ≫ standardProjectiveLineToTwistedCubic (K := K) = chartι I 0
    rw [Category.assoc, standardProjectiveLineChartZero_toTwistedCubic]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      standardTwistedCubic_chartZeroToLine_comp_lineChartZero]
    simp
  · change chartι I 3 ≫ standardTwistedCubicToProjectiveLine (K := K) ≫
        standardProjectiveLineToTwistedCubic (K := K) = chartι I 3
    rw [← Category.assoc]
    change ((standardTwistedCubicOpenCover (K := K)).f true ≫
      standardTwistedCubicToProjectiveLine (K := K)) ≫
        standardProjectiveLineToTwistedCubic (K := K) = chartι I 3
    rw [standardTwistedCubicChart_toProjectiveLine]
    change (Spec.map (CommRingCat.ofHom (lineChartToStandardTwistedCubicChartThree (K := K))) ≫
      chartι L true) ≫ standardProjectiveLineToTwistedCubic (K := K) = chartι I 3
    rw [Category.assoc, standardProjectiveLineChartThree_toTwistedCubic]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      standardTwistedCubic_chartThreeToLine_comp_lineChartThree]
    simp

private theorem standardProjectiveLine_twistedCubic_comp :
    standardProjectiveLineToTwistedCubic (K := K) ≫
      standardTwistedCubicToProjectiveLine (K := K) = 𝟙 (scheme L) := by
  apply (standardProjectiveLineOpenCover (K := K)).hom_ext
  intro b
  cases b
  · change chartι L false ≫ standardProjectiveLineToTwistedCubic (K := K) ≫
        standardTwistedCubicToProjectiveLine (K := K) = chartι L false
    rw [← Category.assoc]
    change ((standardProjectiveLineOpenCover (K := K)).f false ≫
      standardProjectiveLineToTwistedCubic (K := K)) ≫
        standardTwistedCubicToProjectiveLine (K := K) = chartι L false
    rw [standardProjectiveLineChart_toTwistedCubic]
    change (Spec.map (CommRingCat.ofHom (standardTwistedCubicChartZeroToLineChart (K := K))) ≫
      chartι I 0) ≫ standardTwistedCubicToProjectiveLine (K := K) = chartι L false
    rw [Category.assoc, standardTwistedCubicChartZero_toProjectiveLine]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      standardTwistedCubic_lineChartZero_comp_chartZeroToLine]
    simp
  · change chartι L true ≫ standardProjectiveLineToTwistedCubic (K := K) ≫
        standardTwistedCubicToProjectiveLine (K := K) = chartι L true
    rw [← Category.assoc]
    change ((standardProjectiveLineOpenCover (K := K)).f true ≫
      standardProjectiveLineToTwistedCubic (K := K)) ≫
        standardTwistedCubicToProjectiveLine (K := K) = chartι L true
    rw [standardProjectiveLineChart_toTwistedCubic]
    change (Spec.map (CommRingCat.ofHom (standardTwistedCubicChartThreeToLineChart (K := K))) ≫
      chartι I 3) ≫ standardTwistedCubicToProjectiveLine (K := K) = chartι L true
    rw [Category.assoc, standardTwistedCubicChartThree_toProjectiveLine]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      standardTwistedCubic_lineChartThree_comp_chartThreeToLine]
    simp

/-- The standard Hankel twisted cubic is the standard projective line. -/
noncomputable def standardTwistedCubicProjectiveLineIso : scheme I ≅ scheme L where
  hom := standardTwistedCubicToProjectiveLine (K := K)
  inv := standardProjectiveLineToTwistedCubic (K := K)
  hom_inv_id := standardTwistedCubic_projectiveLine_comp (K := K)
  inv_hom_id := standardProjectiveLine_twistedCubic_comp (K := K)

/-- The standard cubic is the project's named Proj model of `P¹`. -/
noncomputable def standardTwistedCubicProjectiveLineProjIso :
    scheme I ≅ projectiveLineProj K :=
  standardTwistedCubicProjectiveLineIso (K := K)

end PfaffianDescent.QuarticNet
