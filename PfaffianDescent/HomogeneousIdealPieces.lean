import AllCharacteristics.HomogeneousProjective
import PfaffianDescent.HomogeneousDimensions
import PfaffianDescent.HomogeneousProjection
import Mathlib.LinearAlgebra.Dimension.Free

/-!
# Homogeneous pieces of projective ideals

This file supplies the degreewise linear subspaces of a homogeneous ideal.
The quadratic-piece basis lemma is used to turn a dimension computation into
three actual quadratic equations.
-/

namespace PfaffianDescent

open MvPolynomial Module
open AllCharacteristics.HomogeneousProjective

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {K : Type u} [Field K]

/-- The degree-`d` homogeneous part of a projective homogeneous ideal, viewed
as a vector subspace of homogeneous polynomials of degree `d`. -/
noncomputable def homogeneousIdealPiece
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (d : ℕ) : Submodule K (MvPolynomial.homogeneousSubmodule (Fin 4) K d) :=
  (I.toIdeal.restrictScalars K).comap
    (MvPolynomial.homogeneousSubmodule (Fin 4) K d).subtype

theorem mem_homogeneousIdealPiece_iff
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (d : ℕ) (p : MvPolynomial.homogeneousSubmodule (Fin 4) K d) :
    p ∈ homogeneousIdealPiece I d ↔ p.val ∈ I.toIdeal := Iff.rfl

/-- The statement that a homogeneous projective ideal is generated by its
quadratic piece.  This is the algebraic output supplied by the intrinsic
twisted-cubic calculation. -/
def quadraticPieceGenerates
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K)) : Prop :=
  I.toIdeal = Ideal.span (Set.range fun p : homogeneousIdealPiece I 2 => p.val.val)

/-- Any ideal already presented by homogeneous quadrics is generated by its
quadratic piece. -/
theorem quadraticPieceGenerates_of_ideal_eq_span_quadrics
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (Q : Fin 3 → MvPolynomial (Fin 4) K)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (hIQ : I.toIdeal = Ideal.span (Set.range Q)) :
    quadraticPieceGenerates I := by
  unfold quadraticPieceGenerates
  apply le_antisymm
  · rw [hIQ]
    apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    apply Ideal.subset_span
    let q : MvPolynomial.homogeneousSubmodule (Fin 4) K 2 := ⟨Q i, hQ i⟩
    have hq : q ∈ homogeneousIdealPiece I 2 := by
      change Q i ∈ I.toIdeal
      rw [hIQ]
      exact Ideal.subset_span (Set.mem_range_self i)
    exact ⟨⟨q, hq⟩, rfl⟩
  · apply Ideal.span_le.mpr
    rintro p ⟨q, rfl⟩
    exact q.property

/-- If an ideal is generated by homogeneous quadrics, its degree-two piece,
embedded in the polynomial ring, is exactly their scalar span. -/
theorem homogeneousIdealPiece_map_eq_span_of_ideal_eq_span_quadrics
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (Q : Fin 3 → MvPolynomial (Fin 4) K)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (hIQ : I.toIdeal = Ideal.span (Set.range Q)) :
    (homogeneousIdealPiece I 2).map
      (MvPolynomial.homogeneousSubmodule (Fin 4) K 2).subtype =
        Submodule.span K (Set.range Q) := by
  apply le_antisymm
  · rintro p ⟨q, hq, rfl⟩
    have hmem : q.val ∈ Ideal.span (Set.range Q) := by
      rw [← hIQ]
      exact hq
    obtain ⟨A, hA⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
    have hcomponent := congrArg (homogeneousComponent 2) hA
    rw [map_sum] at hcomponent
    have hterm (i : Fin 3) :
        homogeneousComponent 2 (A i * Q i) = C (coeff 0 (A i)) * Q i := by
      simpa only [zero_add, homogeneousComponent_zero] using
        homogeneousComponent_mul_right (p := A i) (q := Q i) (hQ i) 0
    simp only [hterm] at hcomponent
    have hq' : homogeneousComponent 2 q.val = q.val :=
      homogeneousComponent_eq_self q.property
    have hrepr : q.val = ∑ i, C (coeff 0 (A i)) * Q i :=
      (hcomponent.trans hq').symm
    change q.val ∈ Submodule.span K (Set.range Q)
    rw [hrepr]
    apply Submodule.sum_mem
    intro i _
    simpa only [smul_eq_C_mul] using
      Submodule.smul_mem (Submodule.span K (Set.range Q)) (coeff 0 (A i))
        (Submodule.subset_span (Set.mem_range_self i))
  · apply Submodule.span_le.mpr
    rintro p ⟨i, rfl⟩
    let q : MvPolynomial.homogeneousSubmodule (Fin 4) K 2 := ⟨Q i, hQ i⟩
    have hq : q ∈ homogeneousIdealPiece I 2 := by
      change Q i ∈ I.toIdeal
      rw [hIQ]
      exact Ideal.subset_span (Set.mem_range_self i)
    exact ⟨q, hq, rfl⟩

/-- Three linearly independent homogeneous quadratic generators give a
three-dimensional quadratic piece. -/
theorem finrank_homogeneousIdealPiece_eq_three_of_ideal_eq_span_quadrics
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (Q : Fin 3 → MvPolynomial (Fin 4) K)
    (hQ : ∀ i, (Q i).IsHomogeneous 2)
    (hIQ : I.toIdeal = Ideal.span (Set.range Q))
    (hlin : LinearIndependent K Q) :
    Module.finrank K (homogeneousIdealPiece I 2) = 3 := by
  let H := MvPolynomial.homogeneousSubmodule (Fin 4) K 2
  let P := homogeneousIdealPiece I 2
  let f : P →ₗ[K] MvPolynomial (Fin 4) K := H.subtype.domRestrict P
  have hf : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    apply Subtype.ext
    exact hxy
  let e : P ≃ₗ[K] f.range := LinearEquiv.ofInjective f hf
  have hpiece : P.map H.subtype = Submodule.span K (Set.range Q) :=
    homogeneousIdealPiece_map_eq_span_of_ideal_eq_span_quadrics I Q hQ hIQ
  calc
    Module.finrank K P = Module.finrank K f.range := e.finrank_eq
    _ = Module.finrank K (P.map H.subtype) := by
      rw [← LinearMap.range_domRestrict P H.subtype]
    _ = Module.finrank K (Submodule.span K (Set.range Q)) := by rw [hpiece]
    _ = 3 := by simpa using finrank_span_eq_card hlin

/-- When the quadratic piece of a projective homogeneous ideal has dimension
three, it has three homogeneous quadratic elements that span that piece. -/
theorem exists_three_quadrics_spanning_homogeneousIdealPiece
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (hI : Module.finrank K (homogeneousIdealPiece I 2) = 3) :
    ∃ Q : Fin 3 → MvPolynomial (Fin 4) K,
      (∀ i, (Q i).IsHomogeneous 2) ∧
      (∀ i, Q i ∈ I.toIdeal) ∧
      (homogeneousIdealPiece I 2).map
        (MvPolynomial.homogeneousSubmodule (Fin 4) K 2).subtype =
          Submodule.span K (Set.range Q) := by
  let P := homogeneousIdealPiece I 2
  let H := MvPolynomial.homogeneousSubmodule (Fin 4) K 2
  letI : FiniteDimensional K H :=
    (Submodule.fg_iff_finiteDimensional H).mp
      (MvPolynomial.homogeneousSubmodule_fg (Fin 4) K 2)
  letI : FiniteDimensional K P := inferInstance
  letI : Module.Free K P := Module.Free.of_divisionRing K P
  let b : Basis (Fin 3) K P := Module.finBasisOfFinrankEq K P hI
  let g : Fin 3 → H := fun i => (b i).val
  let Q : Fin 3 → MvPolynomial (Fin 4) K := fun i => (g i).val
  refine ⟨Q, ?_, ?_, ?_⟩
  · intro i
    exact (g i).property
  · intro i
    change (g i).val ∈ I.toIdeal
    exact (b i).property
  · have hPmap : P = Submodule.map P.subtype ⊤ := by
      ext q
      constructor
      · intro hq
        exact ⟨⟨q, hq⟩, Submodule.mem_top, rfl⟩
      · rintro ⟨q, -, rfl⟩
        exact q.property
    have hrangeP : P.subtype '' Set.range b = Set.range g := by
      ext q
      constructor
      · rintro ⟨p, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨b i, ⟨i, rfl⟩, rfl⟩
    have hPspan : P = Submodule.span K (Set.range g) := by
      calc
        P = Submodule.map P.subtype ⊤ := hPmap
        _ = Submodule.map P.subtype (Submodule.span K (Set.range b)) := by
          rw [b.span_eq]
        _ = Submodule.span K (P.subtype '' Set.range b) := by
          rw [Submodule.map_span]
        _ = Submodule.span K (Set.range g) := by rw [hrangeP]
    have hrangeH : H.subtype '' Set.range g = Set.range Q := by
      ext q
      constructor
      · rintro ⟨p, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨g i, ⟨i, rfl⟩, rfl⟩
    change Submodule.map H.subtype P = Submodule.span K (Set.range Q)
    rw [hPspan, Submodule.map_span, hrangeH]

/-- A quadratically generated projective ideal with a three-dimensional
quadratic piece has a presentation by three homogeneous quadrics. -/
theorem exists_three_quadrics_generating_of_quadraticPieceGenerates
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (hgen : quadraticPieceGenerates I)
    (hI : Module.finrank K (homogeneousIdealPiece I 2) = 3) :
    ∃ Q : Fin 3 → MvPolynomial (Fin 4) K,
      (∀ i, (Q i).IsHomogeneous 2) ∧
      I.toIdeal = Ideal.span (Set.range Q) := by
  obtain ⟨Q, hQhom, hQmem, hpiece⟩ :=
    exists_three_quadrics_spanning_homogeneousIdealPiece I hI
  refine ⟨Q, hQhom, ?_⟩
  apply le_antisymm
  · rw [hgen]
    apply Ideal.span_le.mpr
    rintro p ⟨q, rfl⟩
    have hq : q.val.val ∈ (homogeneousIdealPiece I 2).map
        (MvPolynomial.homogeneousSubmodule (Fin 4) K 2).subtype :=
      ⟨q.val, q.property, rfl⟩
    rw [hpiece] at hq
    have hspan : Submodule.span K (Set.range Q) ≤
        (Ideal.span (Set.range Q)).restrictScalars K := by
      apply Submodule.span_le.mpr
      rintro x ⟨i, rfl⟩
      exact Ideal.subset_span (Set.mem_range_self i)
    exact hspan hq
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact hQmem i

/-- The quotient map from homogeneous degree-`d` polynomials to the degree-`d`
part of the projective coordinate ring. -/
noncomputable def homogeneousIdealPieceQuotientMap
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (d : ℕ) :
    MvPolynomial.homogeneousSubmodule (Fin 4) K d →ₗ[K] grading I d where
  toFun := fun p => ⟨Ideal.Quotient.mk I.toIdeal p.val, ⟨p.val, p.property, rfl⟩⟩
  map_add' := by
    intro p q
    apply Subtype.ext
    exact map_add (Ideal.Quotient.mk I.toIdeal) p.val q.val
  map_smul' := by
    intro a p
    apply Subtype.ext
    change Ideal.Quotient.mk I.toIdeal ((a • p).val) =
      a • Ideal.Quotient.mk I.toIdeal p.val
    exact map_smul (Ideal.Quotient.mkₐ K I.toIdeal) a p.val

/-- Every degree-`d` quotient class has a homogeneous polynomial
representative of degree `d`. -/
theorem homogeneousIdealPieceQuotientMap_surjective
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (d : ℕ) :
    Function.Surjective (homogeneousIdealPieceQuotientMap I d) := by
  intro x
  obtain ⟨p, hp, hpx⟩ := x.property
  let q : MvPolynomial.homogeneousSubmodule (Fin 4) K d := ⟨p, hp⟩
  refine ⟨q, ?_⟩
  apply Subtype.ext
  exact hpx

/-- The kernel of the degree-`d` quotient map is the degree-`d` part of the
homogeneous ideal. -/
theorem homogeneousIdealPieceQuotientMap_ker
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (d : ℕ) :
    LinearMap.ker (homogeneousIdealPieceQuotientMap I d) = homogeneousIdealPiece I d := by
  ext p
  rw [LinearMap.mem_ker]
  constructor
  · intro hp
    have hp' := congrArg Subtype.val hp
    change Ideal.Quotient.mk I.toIdeal p.val = 0 at hp'
    rw [Ideal.Quotient.eq_zero_iff_mem] at hp'
    exact hp'
  · intro hp
    apply Subtype.ext
    change Ideal.Quotient.mk I.toIdeal p.val = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hp

/-- The degree-`d` ideal piece and quotient piece have complementary
dimensions inside the ambient homogeneous polynomial space. -/
theorem finrank_homogeneousIdealPiece_add_finrank_grading
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (d : ℕ) :
    Module.finrank K (homogeneousIdealPiece I d) + Module.finrank K (grading I d) =
      Module.finrank K (MvPolynomial.homogeneousSubmodule (Fin 4) K d) := by
  let H := MvPolynomial.homogeneousSubmodule (Fin 4) K d
  let f := homogeneousIdealPieceQuotientMap I d
  letI : FiniteDimensional K H :=
    (Submodule.fg_iff_finiteDimensional H).mp
      (MvPolynomial.homogeneousSubmodule_fg (Fin 4) K d)
  have hsurj : Function.Surjective f := homogeneousIdealPieceQuotientMap_surjective I d
  letI : Module.Finite K (grading I d) := Module.Finite.of_surjective f hsurj
  have hker : LinearMap.ker f = homogeneousIdealPiece I d :=
    homogeneousIdealPieceQuotientMap_ker I d
  have hrange : LinearMap.range f = ⊤ := LinearMap.range_eq_top.mpr hsurj
  calc
    Module.finrank K (homogeneousIdealPiece I d) + Module.finrank K (grading I d) =
        Module.finrank K (LinearMap.ker f) + Module.finrank K (LinearMap.range f) := by
      rw [hker, hrange]
      simp
    _ = Module.finrank K (LinearMap.range f) + Module.finrank K (LinearMap.ker f) :=
      Nat.add_comm _ _
    _ = Module.finrank K H := f.finrank_range_add_finrank_ker

end PfaffianDescent
