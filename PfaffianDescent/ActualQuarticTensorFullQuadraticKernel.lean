import PfaffianDescent.ActualQuarticDualTensorCoordinates
import PfaffianDescent.HomogeneousVanishingLinearSystem
import Mathlib.RingTheory.TensorProduct.Finite

/-! Equality of the ENTIRE quadratic submodules after actual scalar extension
and coordinate normalization. The coordinate automorphism and its inverse
are derived from the actual residue basis, preserving all nilpotent equations. -/

noncomputable section
namespace PfaffianDescent.QuarticNet
open MvPolynomial Module
open scoped TensorProduct
universe u
variable {k L K A : Type u} [Field k] [Field L] [Field K] [CommRing A]
  [Algebra k L] [Algebra k K] [Algebra k A]
  [IsAlgClosed K] [FiniteDimensional k L] [Algebra.IsSeparable k L]
  [FiniteDimensional k A]

/-- Exact comparison with all extension-field quadrics. This is a theorem
about the actual K-tensor-A evaluation kernel, not an assumed dimension or
coordinate certificate. The public geometric caller obtains eA/x/b/v/full
from its actual supplied-Z extraction. -/
theorem actualQuarticTensor_fullQuadraticKernel_eq
    (eA : A ≃ₐ[k] DualNumber L) (x : Fin 4 → A)
    (b : Basis (Fin 4) k L) (v : Fin 4 → L)
    (hx : ∀ r, eA (x r) = TrivSqZeroExt.inl (b r) + TrivSqZeroExt.inr (v r))
    (full : Fin 4 ≃ (L →ₐ[k] K)) (l : Fin 4 → K) (hl : ∀ row, l row ≠ 0) :
    let hs := conjugate_basis_span b full
    let cb := conjugateBasis full b hs
    let M := basisCoordinateMatrix cb
    let ep := linearSubstitutionEquiv M (basisCoordinateMatrix_isUnit cb)
    let U := rescaleTangentDirections l (conjugateTangentMatrix full b v hs)
    (homogeneousVanishingPolynomialSubmodule (K := K)
      (fun r => (1 : K) ⊗ₜ[k] x r) 2).map ep.toLinearEquiv.toLinearMap =
      homogeneousVanishingPolynomialSubmodule (K := K)
        (fourTangentNormalizedCoordinates U) 2 := by
  let hs := conjugate_basis_span b full
  let cb := conjugateBasis full b hs
  let M := basisCoordinateMatrix cb
  let ep := linearSubstitutionEquiv M (basisCoordinateMatrix_isUnit cb)
  let U := rescaleTangentDirections l (conjugateTangentMatrix full b v hs)
  let y : Fin 4 → K ⊗[k] A := fun r => (1 : K) ⊗ₜ[k] x r
  let z := fourTangentNormalizedCoordinates U
  change (homogeneousVanishingPolynomialSubmodule y 2).map ep.toLinearEquiv.toLinearMap =
    homogeneousVanishingPolynomialSubmodule z 2
  ext q
  constructor
  · rintro ⟨F, hF, rfl⟩
    obtain ⟨hFhom, hFzero⟩ :=
      (mem_homogeneousVanishingPolynomialSubmodule_iff y 2 F).mp hF
    apply (mem_homogeneousVanishingPolynomialSubmodule_iff z 2 _).mpr
    refine ⟨linearSubstitution_homogeneous M hFhom, ?_⟩
    exact (actualQuarticTensor_normalized_rescaled_equation_iff
      eA x b v hx full l hl F 2 hFhom).mpr hFzero
  · intro hq
    obtain ⟨hqhom, hqzero⟩ :=
      (mem_homogeneousVanishingPolynomialSubmodule_iff z 2 q).mp hq
    let F := ep.symm q
    have hFhom : F.IsHomogeneous 2 := by
      change (linearSubstitution M⁻¹ q).IsHomogeneous 2
      exact linearSubstitution_homogeneous M⁻¹ hqhom
    have hFimage : linearSubstitution M F = q := ep.apply_symm_apply q
    have hFzero : aeval (R := K) y F = 0 := by
      apply (actualQuarticTensor_normalized_rescaled_equation_iff
        eA x b v hx full l hl F 2 hFhom).mp
      rw [hFimage]
      exact hqzero
    exact ⟨F, (mem_homogeneousVanishingPolynomialSubmodule_iff y 2 F).mpr
      ⟨hFhom, hFzero⟩, hFimage⟩

/-- Consequently the ideals generated by the FULL actual quadratic systems
are carried to each other by that same polynomial coordinate automorphism. -/
theorem actualQuarticTensor_fullQuadraticBaseIdeal_map
    (eA : A ≃ₐ[k] DualNumber L) (x : Fin 4 → A)
    (b : Basis (Fin 4) k L) (v : Fin 4 → L)
    (hx : ∀ r, eA (x r) = TrivSqZeroExt.inl (b r) + TrivSqZeroExt.inr (v r))
    (full : Fin 4 ≃ (L →ₐ[k] K)) (l : Fin 4 → K) (hl : ∀ row, l row ≠ 0) :
    let hs := conjugate_basis_span b full
    let cb := conjugateBasis full b hs
    let M := basisCoordinateMatrix cb
    let ep := linearSubstitutionEquiv M (basisCoordinateMatrix_isUnit cb)
    let U := rescaleTangentDirections l (conjugateTangentMatrix full b v hs)
    (Ideal.span (homogeneousVanishingPolynomialSubmodule (K := K)
      (fun r => (1 : K) ⊗ₜ[k] x r) 2 : Set (MvPolynomial (Fin 4) K))).map ep.toRingHom =
      Ideal.span (homogeneousVanishingPolynomialSubmodule (K := K)
        (fourTangentNormalizedCoordinates U) 2 : Set (MvPolynomial (Fin 4) K)) := by
  let hs := conjugate_basis_span b full
  let cb := conjugateBasis full b hs
  let M := basisCoordinateMatrix cb
  let ep := linearSubstitutionEquiv M (basisCoordinateMatrix_isUnit cb)
  let U := rescaleTangentDirections l (conjugateTangentMatrix full b v hs)
  let W := homogeneousVanishingPolynomialSubmodule (K := K)
    (fun r => (1 : K) ⊗ₜ[k] x r) 2
  let V := homogeneousVanishingPolynomialSubmodule (K := K)
    (fourTangentNormalizedCoordinates U) 2
  have hWV : W.map ep.toLinearEquiv.toLinearMap = V :=
    actualQuarticTensor_fullQuadraticKernel_eq eA x b v hx full l hl
  change (Ideal.span (W : Set (MvPolynomial (Fin 4) K))).map ep.toRingHom =
    Ideal.span (V : Set (MvPolynomial (Fin 4) K))
  rw [Ideal.map_span]
  apply congrArg Ideal.span
  change ep '' (W : Set (MvPolynomial (Fin 4) K)) = (V : Set (MvPolynomial (Fin 4) K))
  rw [← hWV]
  ext q
  rfl

end PfaffianDescent.QuarticNet
