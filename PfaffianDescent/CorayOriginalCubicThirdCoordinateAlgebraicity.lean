import PfaffianDescent.CorayActualCubicIndependentGenericCoordinates
import PfaffianDescent.CorayOriginalChartFunctionFieldGeneration
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-! The nonzero actual cubic equation supplies an explicit nonzero univariate
polynomial for the removed coordinate. The literal original coefficient map,
chart and function field are retained. SOURCE ONLY / UNCOMPILED. -/
noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics.HomogeneousProjective
open scoped IntermediateField.algebraAdjoinAdjoin
universe u v

/-- Convert the given nonzero relation into a genuine univariate relation
with coefficients in the algebra generated by the remaining independent
coordinates. Independence is used as the injective coefficient evaluation:
no coefficient can disappear under this conversion. -/
theorem principalRelation_removedCoordinate_polynomialWitness
    {K F : Type u} {σ : Type v} [Field K] [Field F] [Algebra K F]
    (x : σ → F) (t : σ)
    (hx : AlgebraicIndependent K (fun i : {i : σ // i ≠ t} => x i.1))
    (q : MvPolynomial σ K) (hq : q ≠ 0) (hqx : MvPolynomial.aeval x q = 0) :
    ∃ P : Polynomial (Algebra.adjoin K
        (Set.range (fun i : {i : σ // i ≠ t} => x i.1))),
      P ≠ 0 ∧ Polynomial.aeval (x t) P = 0 := by
  classical
  let e : Option {i : σ // i ≠ t} ≃ σ := Equiv.optionSubtypeNe t
  let q' : MvPolynomial (Option {i : σ // i ≠ t}) K :=
    MvPolynomial.rename e.symm q
  have hq' : q' ≠ 0 := by
    intro hz
    apply hq
    exact (MvPolynomial.rename_injective e.symm e.symm.injective)
      (hz.trans (map_zero (MvPolynomial.rename e.symm)).symm)
  let P := hx.mvPolynomialOptionEquivPolynomialAdjoin q'
  have hP : P ≠ 0 := by
    intro hz
    apply hq'
    exact hx.mvPolynomialOptionEquivPolynomialAdjoin.injective
      (hz.trans (map_zero hx.mvPolynomialOptionEquivPolynomialAdjoin).symm)
  refine ⟨P, hP, ?_⟩
  have heval := RingHom.congr_fun
    (hx.aeval_comp_mvPolynomialOptionEquivPolynomialAdjoin (x t)) q'
  change Polynomial.aeval (x t) P = 0
  calc
    Polynomial.aeval (x t) P =
        MvPolynomial.aeval (fun o : Option {i : σ // i ≠ t} =>
          o.elim (x t) (fun i => x i.1)) q' := heval
    _ = MvPolynomial.aeval (x ∘ e) q' := by
      have hcoord : (fun o : Option {i : σ // i ≠ t} =>
          o.elim (x t) (fun i => x i.1)) = x ∘ e := by
        funext o
        cases o <;> rfl
      exact congrArg (fun family : Option {i : σ // i ≠ t} → F =>
        MvPolynomial.aeval family q') hcoord
    _ = MvPolynomial.aeval x q := by
      change MvPolynomial.aeval (x ∘ e) (MvPolynomial.rename e.symm q) = _
      have hcoord : ((x ∘ e) ∘ e.symm) = x := by
        funext i
        exact congrArg x (e.apply_symm_apply i)
      rw [MvPolynomial.aeval_rename, hcoord]
    _ = 0 := hqx

/-- The explicit univariate polynomial supplies algebraicity over the
literal field generated by the remaining coordinates. -/
theorem principalRelation_removedCoordinate_isAlgebraic
    {K F : Type u} {σ : Type v} [Field K] [Field F] [Algebra K F]
    (x : σ → F) (t : σ)
    (hx : AlgebraicIndependent K (fun i : {i : σ // i ≠ t} => x i.1))
    (q : MvPolynomial σ K) (hq : q ≠ 0) (hqx : MvPolynomial.aeval x q = 0) :
    IsAlgebraic (IntermediateField.adjoin K
      (Set.range (fun i : {i : σ // i ≠ t} => x i.1))) (x t) := by
  rw [IntermediateField.isAlgebraic_adjoin_iff]
  obtain ⟨P, hP, heval⟩ :=
    principalRelation_removedCoordinate_polynomialWitness x t hx q hq hqx
  exact ⟨P, hP, heval⟩

attribute [local instance] MvPolynomial.gradedAlgebra

section ActualOriginalChart
variable {K : Type u} [Field K]
variable (p : MvPolynomial (Fin 4) K) (hp : p.IsHomogeneous 3)
  [IsIntegral (hypersurface p hp)] (j : Fin 4)
  [Nonempty (chartι (equationIdeal p hp) j).opensRange]

/-- Three literal normalized coordinates in the ORIGINAL function field. -/
def cubicOriginalReducedChartGenericCoordinates :
    {i : Fin 4 // i ≠ j} → (hypersurface p hp).functionField :=
  fun i => @affineChartGenericEvaluation
    (ChartRing (equationIdeal p hp) j)
    (inferInstance : CommRing (ChartRing (equationIdeal p hp) j))
    (hypersurface p hp) (inferInstance : IsIntegral (hypersurface p hp))
    (chartι (equationIdeal p hp) j)
    (isOpenImmersion_chartι (equationIdeal p hp) j)
    (inferInstance : Nonempty (chartι (equationIdeal p hp) j).opensRange)
    (chartCoordinate (equationIdeal p hp) j i.1)

private def cubicOriginalTrdeg_genericAlgHom :
    letI : Algebra K (ChartRing (equationIdeal p hp) j) :=
      (chartBaseMap (equationIdeal p hp) j).toAlgebra
    letI : Algebra K (hypersurface p hp).functionField :=
      (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
    ChartRing (equationIdeal p hp) j →ₐ[K] (hypersurface p hp).functionField := by
  letI : Algebra K (ChartRing (equationIdeal p hp) j) :=
    (chartBaseMap (equationIdeal p hp) j).toAlgebra
  letI : Algebra K (hypersurface p hp).functionField :=
    (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
  let g := @affineChartGenericEvaluation
    (ChartRing (equationIdeal p hp) j)
    (inferInstance : CommRing (ChartRing (equationIdeal p hp) j))
    (hypersurface p hp) (inferInstance : IsIntegral (hypersurface p hp))
    (chartι (equationIdeal p hp) j)
    (isOpenImmersion_chartι (equationIdeal p hp) j)
    (inferInstance : Nonempty (chartι (equationIdeal p hp) j).opensRange)
  exact { toRingHom := g
          commutes' := fun c => by
            change g (chartBaseMap (equationIdeal p hp) j c) =
              schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp) c
            exact RingHom.congr_fun
              (cubicChartGenericEvaluation_coefficient_eq p hp j) c }

/-- The nonzero actual eliminated cubic equation annihilates the actual
original generic coordinate tuple. Both assertions are derived internally. -/
theorem cubicOriginalReducedChartGenericCoordinates_relation (hp0 : p ≠ 0) :
    letI : Algebra K (hypersurface p hp).functionField :=
      (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
    coordinateOneEvaluation j p ≠ 0 ∧
      MvPolynomial.aeval (cubicOriginalReducedChartGenericCoordinates p hp j)
        (coordinateOneEvaluation j p) = 0 := by
  letI : Algebra K (ChartRing (equationIdeal p hp) j) :=
    (chartBaseMap (equationIdeal p hp) j).toAlgebra
  letI : Algebra K (hypersurface p hp).functionField :=
    (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
  have h := @smoothCubic_eliminatedChartMap_surjective_and_kernel
    K (inferInstance : Field K) p hp hp0 j
  refine ⟨h.2.2, ?_⟩
  have hz : MvPolynomial.aeval
      (fun i : {i : Fin 4 // i ≠ j} => chartCoordinate (equationIdeal p hp) j i.1)
      (coordinateOneEvaluation j p) = 0 := by
    apply RingHom.mem_ker.mp
    exact h.2.1.symm ▸ Ideal.subset_span (Set.mem_singleton (coordinateOneEvaluation j p))
  have he := MvPolynomial.comp_aeval_apply
    (fun i : {i : Fin 4 // i ≠ j} => chartCoordinate (equationIdeal p hp) j i.1)
    (cubicOriginalTrdeg_genericAlgHom p hp j) (coordinateOneEvaluation j p)
  change MvPolynomial.aeval
    (fun i : {i : Fin 4 // i ≠ j} => cubicOriginalTrdeg_genericAlgHom p hp j
      (chartCoordinate (equationIdeal p hp) j i.1)) (coordinateOneEvaluation j p) = 0
  exact he.symm.trans (by rw [hz, map_zero])

/-- The same chosen independent pair has an ACTUAL algebraic third
coordinate, constructed from the nonzero original cubic equation. -/
theorem cubicOriginalChart_exists_two_independent_and_algebraic_third
    (hp0 : p ≠ 0) :
    letI : Algebra K (hypersurface p hp).functionField :=
      (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
    ∃ t : {i : Fin 4 // i ≠ j},
      Fintype.card {i : {i : Fin 4 // i ≠ j} // i ≠ t} = 2 ∧
      AlgebraicIndependent K (fun i : {i : {i : Fin 4 // i ≠ j} // i ≠ t} =>
        cubicOriginalReducedChartGenericCoordinates p hp j i.1) ∧
      IsAlgebraic (IntermediateField.adjoin K
        (Set.range (fun i : {i : {i : Fin 4 // i ≠ j} // i ≠ t} =>
          cubicOriginalReducedChartGenericCoordinates p hp j i.1)))
        (cubicOriginalReducedChartGenericCoordinates p hp j t) := by
  letI : Algebra K (hypersurface p hp).functionField :=
    (schemeFunctionFieldGroundRingHom (hypersurfaceToBase p hp)).toAlgebra
  obtain ⟨t, hcard, hind⟩ :=
    cubicOriginalChart_exists_two_independent_generic_coordinates p hp hp0 j
  have hrel := cubicOriginalReducedChartGenericCoordinates_relation p hp j hp0
  refine ⟨t, hcard, hind, ?_⟩
  exact principalRelation_removedCoordinate_isAlgebraic
    (cubicOriginalReducedChartGenericCoordinates p hp j) t hind
    (coordinateOneEvaluation j p) hrel.1 hrel.2

end ActualOriginalChart
end PfaffianDescent.Coray
end
