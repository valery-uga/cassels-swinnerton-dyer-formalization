import PfaffianDescent.VoisinRegularPrincipalProjectiveCharts
import AllCharacteristics.RegularLocalLowDimension
import Mathlib.RingTheory.Ideal.UFD

/-!
# A height-one-prime criterion for local Cartier equations

A height-one prime ideal in a UFD has a generator. Because the ring is a
domain and the prime has positive height, that generator is a non-zero-
divisor. This is the algebraic conversion needed on local charts of the
generic fixed curve. The standard-chart theorem below states it directly
for the actual projective quotient immersion.

The remaining geometric input is local factoriality of the smooth cubic
surface (or another proof that the relevant chart kernels are principal),
together with height one for each nonempty chart kernel. A smooth cubic's
four *global* standard chart rings need not themselves be UFDs.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-- A height-one prime in a factorial domain is generated by a regular
element. This is the affine algebra behind an effective Cartier divisor. -/
theorem heightOnePrime_regularPrincipal_of_ufd
    {A : Type u} [CommRing A] [IsDomain A]
    [WfDvdMonoid A] [UniqueFactorizationMonoid A]
    (P : Ideal A) [P.IsPrime] (hheight : P.height = 1) :
    ∃ z : A, IsRegular z ∧ P = Ideal.span ({z} : Set A) := by
  obtain ⟨z, hz⟩ :=
    UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hheight
  have hpne : P ≠ ⊥ := P.ne_bot_of_height_eq_one hheight
  have hz0 : z ≠ 0 := by
    intro hzero
    apply hpne
    simpa [hzero] using hz
  exact ⟨z, isRegular_iff_ne_zero.mpr hz0, hz⟩

/-- Pointwise version for the stalk of a prime curve ideal. A height-one
prime remains height one after localizing at any point of the curve. If that
local ring is factorial, the *actual localized curve ideal* has a regular
principal equation. This is the local algebra needed to turn a height-one
fixed-curve component on a smooth cubic into a Cartier divisor. -/
theorem heightOnePrime_localized_regularPrincipal_of_localUFD
    {A : Type u} [CommRing A] [IsDomain A]
    (P Q : Ideal A) [P.IsPrime] [Q.IsPrime]
    (hPQ : P ≤ Q) (hheight : P.height = 1)
    [WfDvdMonoid (Localization.AtPrime Q)]
    [UniqueFactorizationMonoid (Localization.AtPrime Q)] :
    ∃ z : Localization.AtPrime Q,
      IsRegular z ∧
      P.map (algebraMap A (Localization.AtPrime Q)) =
        Ideal.span ({z} : Set (Localization.AtPrime Q)) := by
  let f := algebraMap A (Localization.AtPrime Q)
  haveI hprime : (P.map f).IsPrime :=
    Ideal.isPrime_map_of_isLocalizationAtPrime Q hPQ
  have hdisj : Disjoint (Q.primeCompl : Set A) (P : Set A) := by
    simp [Ideal.primeCompl, ← le_compl_iff_disjoint_left, hPQ]
  have hheightLocal : (P.map f).height = 1 := by
    exact (IsLocalization.height_map_of_disjoint Q.primeCompl P hdisj).trans hheight
  exact heightOnePrime_regularPrincipal_of_ufd (P.map f) hheightLocal

/-- For a specified curve, principal generation of its localized ideal is
enough; the entire local ring need not be a UFD. The generator is regular
because a height-one prime cannot become the zero ideal after localization. -/
theorem heightOnePrime_localized_regularPrincipal_of_localPrincipal
    {A : Type u} [CommRing A] [IsDomain A]
    (P Q : Ideal A) [P.IsPrime] [Q.IsPrime]
    (hPQ : P ≤ Q) (hheight : P.height = 1)
    (hprincipal : (P.map (algebraMap A (Localization.AtPrime Q))).IsPrincipal) :
    ∃ z : Localization.AtPrime Q,
      IsRegular z ∧
      P.map (algebraMap A (Localization.AtPrime Q)) =
        Ideal.span ({z} : Set (Localization.AtPrime Q)) := by
  let f := algebraMap A (Localization.AtPrime Q)
  haveI : (P.map f).IsPrime :=
    Ideal.isPrime_map_of_isLocalizationAtPrime Q hPQ
  have hdisj : Disjoint (Q.primeCompl : Set A) (P : Set A) := by
    simp [Ideal.primeCompl, ← le_compl_iff_disjoint_left, hPQ]
  have hheightLocal : (P.map f).height = 1 :=
    (IsLocalization.height_map_of_disjoint Q.primeCompl P hdisj).trans hheight
  obtain ⟨z, hz⟩ := hprincipal
  have hz0 : z ≠ 0 := by
    intro hzero
    apply (P.map f).ne_bot_of_height_eq_one hheightLocal
    simpa [hzero] using hz
  exact ⟨z, isRegular_iff_ne_zero.mpr hz0, hz⟩

/-- At the generic point of a height-one prime on a regular scheme, its
local ideal is principal without a UFD theorem: the local ring itself has
dimension one, and a one-dimensional regular local ring has principal
maximal ideal. The remaining Cartier issue is at specializations of that
point, whose regular local rings generally have dimension two. -/
theorem heightOnePrime_atGeneric_regularPrincipal_of_regularLocal
    {A : Type u} [CommRing A] [IsDomain A]
    (P : Ideal A) [P.IsPrime] (hheight : P.height = 1)
    (hregular : IsRegularLocalRing (Localization.AtPrime P)) :
    ∃ z : Localization.AtPrime P,
      IsRegular z ∧
      P.map (algebraMap A (Localization.AtPrime P)) =
        Ideal.span ({z} : Set (Localization.AtPrime P)) := by
  let S := Localization.AtPrime P
  letI : IsRegularLocalRing S := hregular
  have hdim : ringKrullDim S = 1 := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height P S]
    exact_mod_cast hheight
  have hp : (P.map (algebraMap A S)).IsPrime :=
    Ideal.isPrime_map_of_isLocalizationAtPrime P le_rfl
  letI : (P.map (algebraMap A S)).IsPrime := hp
  have hheightLocal : (P.map (algebraMap A S)).height = 1 := by
    have hdisj : Disjoint (P.primeCompl : Set A) (P : Set A) := by
      refine Set.disjoint_left.mpr ?_
      intro x hx hy
      exact hx hy
    exact (IsLocalization.height_map_of_disjoint P.primeCompl P hdisj).trans hheight
  have hpne : P.map (algebraMap A S) ≠ ⊥ :=
    (P.map (algebraMap A S)).ne_bot_of_height_eq_one hheightLocal
  obtain ⟨z, hz⟩ :=
    AllCharacteristics.maximalIdeal_isPrincipal_of_regularLocal_dim_one hdim
  have hz0 : z ≠ 0 := by
    intro hzero
    apply hpne
    rw [IsLocalization.AtPrime.map_eq_maximalIdeal, hz, hzero]
    exact Ideal.span_singleton_zero
  exact ⟨z, isRegular_iff_ne_zero.mpr hz0,
    (IsLocalization.AtPrime.map_eq_maximalIdeal P S).trans hz⟩

/-- If the actual projective quotient chart kernels are height-one primes
in factorial domains, its closed immersion has regular-principal standard
charts and hence an effective-Cartier presentation. This criterion keeps
the ring-theoretic inputs visible for future local refinements. -/
theorem hasRegularPrincipalStandardCharts_of_heightOne_prime_ufd
    {R : Type u} {σ : Type} [CommRing R]
    (I J : HomogeneousIdeal (homogeneousSubmodule σ R))
    (hIJ : I.toIdeal ≤ J.toIdeal)
    (hdom : ∀ j : σ, IsDomain (ChartRing I j))
    (hwf : ∀ j : σ, WfDvdMonoid (ChartRing I j))
    (hufd : ∀ j : σ, UniqueFactorizationMonoid (ChartRing I j))
    (hprime : ∀ j : σ,
      (RingHom.ker (chartQuotientMap I J hIJ j)).IsPrime)
    (hheight : ∀ j : σ,
      (RingHom.ker (chartQuotientMap I J hIJ j)).height = 1) :
    HasRegularPrincipalStandardCharts I J hIJ := by
  intro j
  letI : IsDomain (ChartRing I j) := hdom j
  letI : WfDvdMonoid (ChartRing I j) := hwf j
  letI : UniqueFactorizationMonoid (ChartRing I j) := hufd j
  letI : (RingHom.ker (chartQuotientMap I J hIJ j)).IsPrime := hprime j
  exact heightOnePrime_regularPrincipal_of_ufd
    (RingHom.ker (chartQuotientMap I J hIJ j)) (hheight j)

/-- The same criterion provides the actual scheme-level regular-principal
immersion, rather than only chartwise algebra. -/
noncomputable def regularPrincipalImmersion_of_heightOne_prime_ufd
    {R : Type u} {σ : Type} [CommRing R]
    (I J : HomogeneousIdeal (homogeneousSubmodule σ R))
    (hIJ : I.toIdeal ≤ J.toIdeal)
    (hdom : ∀ j : σ, IsDomain (ChartRing I j))
    (hwf : ∀ j : σ, WfDvdMonoid (ChartRing I j))
    (hufd : ∀ j : σ, UniqueFactorizationMonoid (ChartRing I j))
    (hprime : ∀ j : σ,
      (RingHom.ker (chartQuotientMap I J hIJ j)).IsPrime)
    (hheight : ∀ j : σ,
      (RingHom.ker (chartQuotientMap I J hIJ j)).height = 1) :
    RegularPrincipalImmersion (schemeQuotientMap I J hIJ) :=
  (hasRegularPrincipalStandardCharts_of_heightOne_prime_ufd
    I J hIJ hdom hwf hufd hprime hheight).toImmersion

end PfaffianDescent
