import PfaffianDescent.VoisinPlaneConicCartierAlgebra
import PfaffianDescent.VoisinPlaneConicCubicSections
import PfaffianDescent.VoisinRegularPrincipalProjectiveCharts
import PfaffianDescent.QuotientChartKernel

/-!
# The actual plane–quadric intersection inside a cubic surface

The homogeneous ideal generated by a linear form and a quadratic form
defines an actual projective closed subscheme of a cubic that vanishes on
it.  Its affine chart kernels are exactly the ideals generated by the two
normalized equations.  A separate, explicit local-unit condition makes
these kernels regular principal and hence supplies the Cartier immersion
used by the inverse-twist argument.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- The homogeneous ideal of a plane–quadric intersection in projective
three-space.  Degenerate conics are permitted; nondegeneracy is a separate
geometric property. -/
noncomputable def planeConicHomogeneousIdeal
    (ell q : MvPolynomial (Fin 4) K)
    (hell : ell.IsHomogeneous 1) (hq : q.IsHomogeneous 2) :
    HomogeneousIdeal (homogeneousSubmodule (Fin 4) K) :=
  ⟨Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K)),
    Ideal.homogeneous_span _ _ (by
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact ⟨1, hell⟩
      · exact ⟨2, hq⟩)⟩

/-- A cubic in the ideal of the plane–quadric intersection gives a
homogeneous-ideal inclusion and thus a map into its cubic surface. -/
theorem equationIdeal_le_planeConicHomogeneousIdeal
    (p ell q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hell : ell.IsHomogeneous 1)
    (hq : q.IsHomogeneous 2)
    (hpc : p ∈ Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K))) :
    (equationIdeal p hp).toIdeal ≤
      (planeConicHomogeneousIdeal ell q hell hq).toIdeal := by
  change Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) ≤
    Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K))
  exact Ideal.span_le.mpr (by simpa using hpc)

/-- The plane–quadric intersection as a projective scheme. -/
noncomputable abbrev planeConicScheme
    (ell q : MvPolynomial (Fin 4) K)
    (hell : ell.IsHomogeneous 1) (hq : q.IsHomogeneous 2) : Scheme.{u} :=
  scheme (planeConicHomogeneousIdeal ell q hell hq)

/-- The actual closed immersion of the plane–quadric intersection into a
cubic containing it. -/
noncomputable def planeConicToCubic
    (p ell q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hell : ell.IsHomogeneous 1)
    (hq : q.IsHomogeneous 2)
    (hpc : p ∈ Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K))) :
    planeConicScheme ell q hell hq ⟶ hypersurface p hp :=
  schemeQuotientMap (equationIdeal p hp)
    (planeConicHomogeneousIdeal ell q hell hq)
    (equationIdeal_le_planeConicHomogeneousIdeal p ell q hp hell hq hpc)

theorem planeConicToCubic_isClosedImmersion
    (p ell q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hell : ell.IsHomogeneous 1)
    (hq : q.IsHomogeneous 2)
    (hpc : p ∈ Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K))) :
    IsClosedImmersion (planeConicToCubic p ell q hp hell hq hpc) := by
  unfold planeConicToCubic
  exact schemeQuotientMap_closedImmersion _ _ _

/-- An explicit cubic decomposition certifies that the plane–quadric
intersection lies on the cubic. -/
theorem cubic_mem_planeConicIdeal_of_decomposition
    (p ell q a b : MvPolynomial (Fin 4) K)
    (h : p = ell * a + q * b) :
    p ∈ Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K)) := by
  rw [h]
  let J : Ideal (MvPolynomial (Fin 4) K) := Ideal.span ({ell, q} : Set _)
  have hell : ell ∈ J := Ideal.subset_span (Or.inl rfl)
  have hq : q ∈ J := Ideal.subset_span (Or.inr rfl)
  exact J.add_mem (J.mul_mem_right a hell) (J.mul_mem_right b hq)

/-- On each standard affine chart, the actual conic immersion has exactly
the two expected normalized equations as its kernel. -/
theorem planeConicToCubic_chartKernel_eq_span_pair
    (p ell q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hell : ell.IsHomogeneous 1)
    (hq : q.IsHomogeneous 2)
    (hpc : p ∈ Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K)))
    (j : Fin 4) :
    let I := equationIdeal p hp
    let J := planeConicHomogeneousIdeal ell q hell hq
    RingHom.ker (chartQuotientMap I J
      (equationIdeal_le_planeConicHomogeneousIdeal p ell q hp hell hq hpc) j) =
      Ideal.span ({ell.eval₂ (chartBaseMap I j) (chartCoordinate I j),
        q.eval₂ (chartBaseMap I j) (chartCoordinate I j)} :
          Set (ChartRing I j)) := by
  dsimp only
  let I := equationIdeal p hp
  let J := planeConicHomogeneousIdeal ell q hell hq
  let evI := eval₂Hom (chartBaseMap I j) (chartCoordinate I j)
  have hle : I.toIdeal ≤ J.toIdeal :=
    equationIdeal_le_planeConicHomogeneousIdeal p ell q hp hell hq hpc
  have hJ : J.toIdeal = I.toIdeal ⊔
      Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K)) := by
    change Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K)) =
      Ideal.span ({p} : Set (MvPolynomial (Fin 4) K)) ⊔
        Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K))
    exact (sup_eq_right.mpr hle).symm
  have hchart : chartPresentationIdeal J j =
      chartPresentationIdeal I j ⊔
        Ideal.span ({ell, q} : Set (MvPolynomial (Fin 4) K)) := by
    simp only [chartPresentationIdeal, hJ]
    ac_rfl
  have hzero : (chartPresentationIdeal I j).map evI = ⊥ := by
    apply (Ideal.map_eq_bot_iff_le_ker evI).mpr
    rw [chartEvaluation_ker]
  rw [chartQuotientMap_ker_eq_presentationImage, hchart, Ideal.map_sup,
    hzero, bot_sup_eq, Ideal.map_span]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rfl

/-- A cubic decomposition vanishes on the actual cubic chart, giving the
local relation used to eliminate one of the conic equations. -/
theorem planeConic_cubicChart_relation
    (p ell q a b : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3)
    (h : p = ell * a + q * b) (j : Fin 4) :
    let I := equationIdeal p hp
    (ell.eval₂ (chartBaseMap I j) (chartCoordinate I j)) *
        (a.eval₂ (chartBaseMap I j) (chartCoordinate I j)) +
      (q.eval₂ (chartBaseMap I j) (chartCoordinate I j)) *
        (b.eval₂ (chartBaseMap I j) (chartCoordinate I j)) = 0 := by
  dsimp only
  let I := equationIdeal p hp
  let evI := eval₂Hom (chartBaseMap I j) (chartCoordinate I j)
  have hzero : evI p = 0 := by
    rw [← RingHom.mem_ker, chartEvaluation_ker]
    have hpideal : p ∈ I.toIdeal := Ideal.subset_span (Set.mem_singleton p)
    exact (le_sup_left : I.toIdeal ≤ chartPresentationIdeal I j) hpideal
  rw [h] at hzero
  simpa only [evI, I, MvPolynomial.coe_eval₂Hom, map_add, map_mul] using hzero

/-- An explicit local-unit and regularity certificate on each standard
chart makes the actual conic immersion an effective Cartier immersion. -/
noncomputable def planeConicToCubic_regularPrincipalImmersion_of_chartUnits
    (p ell q a b : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hell : ell.IsHomogeneous 1)
    (hq : q.IsHomogeneous 2)
    (h : p = ell * a + q * b)
    (hunits : ∀ j : Fin 4,
      let I := equationIdeal p hp
      (IsUnit (a.eval₂ (chartBaseMap I j) (chartCoordinate I j)) ∧
        IsRegular (q.eval₂ (chartBaseMap I j) (chartCoordinate I j))) ∨
      (IsUnit (b.eval₂ (chartBaseMap I j) (chartCoordinate I j)) ∧
        IsRegular (ell.eval₂ (chartBaseMap I j) (chartCoordinate I j)))) :
    RegularPrincipalImmersion
      (planeConicToCubic p ell q hp hell hq
        (cubic_mem_planeConicIdeal_of_decomposition p ell q a b h)) := by
  let hpc := cubic_mem_planeConicIdeal_of_decomposition p ell q a b h
  apply HasRegularPrincipalStandardCharts.toImmersion
    (I := equationIdeal p hp)
    (J := planeConicHomogeneousIdeal ell q hell hq)
    (hIJ := equationIdeal_le_planeConicHomogeneousIdeal
      p ell q hp hell hq hpc)
  intro j
  exact conicChart_regularPrincipal_of_unit_coefficient
    (chartQuotientMap (equationIdeal p hp)
      (planeConicHomogeneousIdeal ell q hell hq)
      (equationIdeal_le_planeConicHomogeneousIdeal p ell q hp hell hq hpc) j)
    _ _ _ _
    (planeConic_cubicChart_relation p ell q a b hp h j)
    (planeConicToCubic_chartKernel_eq_span_pair
      p ell q hp hell hq hpc j)
    (hunits j)

end PfaffianDescent
