import Mathlib.Algebra.BigOperators.Field
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.LinearAlgebra.Basis.Defs

/-! Source only, unverified. The field generated by basis evaluation ratios
contains the ratio of any two evaluated sections. This is an algebraic
prerequisite, with no image-dimension or differential-rank conclusion. -/
noncomputable section
namespace PfaffianDescent.Coray
open Module
universe u v w
section
variable {K : Type u} {F : Type v} {V : Type w}
  [Field K] [Field F] [Algebra K F] [AddCommGroup V] [Module K V]
variable {ι : Type*} [Fintype ι]

/-- The actual field of the normalized basis coordinates, over the given
ground action. The evaluation and anchor are retained in its definition. -/
def linearEvaluationBasisRatioField (b : Basis ι K V)
    (e : V →ₗ[K] F) (a : ι) : IntermediateField K F :=
  IntermediateField.adjoin K (Set.range (fun i => e (b i) / e (b a)))

/-- Every normalized section value is a ground linear combination of the
same normalized basis coordinates; no injectivity or rank input is needed. -/
theorem linearEvaluation_normalized_mem_basisRatioField
    (b : Basis ι K V) (e : V →ₗ[K] F) (a : ι) (s : V) :
    e s / e (b a) ∈ linearEvaluationBasisRatioField b e a := by
  classical
  rw [← b.sum_repr s, map_sum, Finset.sum_div]
  apply (linearEvaluationBasisRatioField b e a).sum_mem
  intro i _
  rw [map_smul, Algebra.smul_def, mul_div_assoc]
  apply (linearEvaluationBasisRatioField b e a).mul_mem
  · exact IntermediateField.algebraMap_mem _ _
  · exact IntermediateField.subset_adjoin K _ ⟨i, rfl⟩

/-- A nonzero anchor permits all section ratios in the SAME field. This
does not replace their ground coefficients by a constants extension. -/
theorem linearEvaluation_ratio_mem_basisRatioField
    (b : Basis ι K V) (e : V →ₗ[K] F) (a : ι)
    (ha : e (b a) ≠ 0) (s t : V) :
    e s / e t ∈ linearEvaluationBasisRatioField b e a := by
  have h := (linearEvaluationBasisRatioField b e a).div_mem
    (linearEvaluation_normalized_mem_basisRatioField b e a s)
    (linearEvaluation_normalized_mem_basisRatioField b e a t)
  simpa only [div_div_div_cancel_right₀ ha] using h

end
end PfaffianDescent.Coray
end
