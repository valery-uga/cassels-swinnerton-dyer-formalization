import PfaffianDescent.VoisinQuadraticKernelBasisIdeal
import PfaffianDescent.VoisinRelativeTripleIntersectionFamily

/-!
# The intrinsic ideal of the eight-point quadratic restriction kernel

The ideal is generated by all quadrics in the kernel, without choosing a
minor or a basis. On each full-rank minor chart, the two selected quadrics
generate exactly this ideal.
-/

namespace PfaffianDescent

open MvPolynomial Module AllCharacteristics.HomogeneousProjective
open AllCharacteristics.UniversalHomogeneous

attribute [local instance] MvPolynomial.gradedAlgebra

universe u v

/-- A basis generates the same polynomial ideal as every vector in its
module, after applying a linear polynomial-valued map. -/
theorem ideal_span_basis_image_eq_full_range
    {R : Type u} [CommRing R]
    {W : Type v} [AddCommGroup W] [Module R W]
    (b : Basis (Fin 2) R W)
    (f : W →ₗ[R] MvPolynomial (Fin 4) R) :
    Ideal.span (Set.range (fun i : Fin 2 => f (b i))) =
      Ideal.span (Set.range f) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro q ⟨i, rfl⟩
    exact Ideal.subset_span ⟨b i, rfl⟩
  · apply Ideal.span_le.mpr
    rintro q ⟨w, rfl⟩
    have hrepr := b.sum_repr w
    have hpoly :
        f w = ∑ i : Fin 2, C (b.repr w i) * f (b i) := by
      have h := congrArg f hrepr
      simpa only [map_sum, map_smul, MvPolynomial.smul_eq_C_mul] using h.symm
    rw [hpoly]
    apply Submodule.sum_mem
    intro i hi
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- An arbitrary spanning pair generates the same polynomial ideal as the
image of the whole module; no choice of basis is needed. -/
theorem ideal_span_pair_image_eq_full_range_of_span_top
    {R : Type u} [CommRing R]
    {W : Type v} [AddCommGroup W] [Module R W]
    (w : Fin 2 → W)
    (hspan : Submodule.span R (Set.range w) = ⊤)
    (f : W →ₗ[R] MvPolynomial (Fin 4) R) :
    Ideal.span (Set.range (fun i : Fin 2 => f (w i))) =
      Ideal.span (Set.range f) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact Ideal.subset_span ⟨w i, rfl⟩
  · apply Ideal.span_le.mpr
    rintro p ⟨x, rfl⟩
    have hx : x ∈ Submodule.span R (Set.range w) := by
      rw [hspan]
      trivial
    refine Submodule.span_induction (p := fun x _ =>
      f x ∈ Ideal.span (Set.range (fun i : Fin 2 => f (w i))))
      ?_ ?_ ?_ ?_ hx
    · rintro x ⟨i, rfl⟩
      exact Ideal.subset_span ⟨i, rfl⟩
    · simpa using (Ideal.zero_mem
        (Ideal.span (Set.range (fun i : Fin 2 => f (w i)))))
    · intro x y _ _ hx hy
      simpa only [map_add] using Ideal.add_mem _ hx hy
    · intro a x _ hx
      rw [map_smul, MvPolynomial.smul_eq_C_mul]
      exact Ideal.mul_mem_left _ _ hx

/-- The ideal of all homogeneous quadrics vanishing on eight ordered
representatives; the definition does not choose an evaluation minor. -/
noncomputable def intrinsicEightPointQuadraticIdeal
    {R : Type u} [CommRing R]
    (y : Fin 8 → Fin 4 → R) : Ideal (MvPolynomial (Fin 4) R) :=
  Ideal.span (Set.range (fun v : LinearMap.ker
    (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y)) =>
      quadraticPolynomialOfCoefficients v.1))

/-- Any two-element basis of the evaluation kernel generates its intrinsic
quadratic ideal. -/
theorem intrinsicEightPointQuadraticIdeal_eq_basis
    {R : Type u} [CommRing R]
    (y : Fin 8 → Fin 4 → R)
    (b : Basis (Fin 2) R
      (LinearMap.ker (Matrix.toLin'
        (eightPointQuadraticEvaluationMatrix y)))) :
    intrinsicEightPointQuadraticIdeal y =
      Ideal.span (Set.range (fun i : Fin 2 =>
        quadraticPolynomialOfCoefficients (b i).1)) := by
  let f := (quadraticPolynomialOfCoefficientsLinearMap R).comp
    (LinearMap.ker (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y))).subtype
  have h := (ideal_span_basis_image_eq_full_range b f).symm
  change Ideal.span (Set.range (fun v : LinearMap.ker
      (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y)) =>
        quadraticPolynomialOfCoefficients v.1)) =
    Ideal.span (Set.range (fun i : Fin 2 =>
      quadraticPolynomialOfCoefficients (b i).1)) at h
  exact h

/-- Any pair spanning the full evaluation kernel generates its intrinsic
quadratic polynomial ideal, even when the pair was obtained by descent from
a different coefficient field. -/
theorem intrinsicEightPointQuadraticIdeal_eq_pair_of_span
    {R : Type u} [CommRing R]
    (y : Fin 8 → Fin 4 → R)
    (v : Fin 2 → Monomials (Fin 4) 2 → R)
    (hmem : ∀ i, v i ∈ LinearMap.ker
      (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y)))
    (hspan : Submodule.span R (Set.range v) =
      LinearMap.ker (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y))) :
    intrinsicEightPointQuadraticIdeal y =
      Ideal.span (Set.range (fun i : Fin 2 =>
        quadraticPolynomialOfCoefficients (v i))) := by
  let W := LinearMap.ker (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y))
  let w : Fin 2 → W := fun i => ⟨v i, hmem i⟩
  have hspanW : Submodule.span R (Set.range w) = ⊤ :=
    (Submodule.span_range_subtype_eq_top_iff W hmem).mpr hspan
  let f : W →ₗ[R] MvPolynomial (Fin 4) R :=
    (quadraticPolynomialOfCoefficientsLinearMap R).comp W.subtype
  have h := ideal_span_pair_image_eq_full_range_of_span_top w hspanW f
  change Ideal.span (Set.range (fun i : Fin 2 =>
      quadraticPolynomialOfCoefficients (v i))) =
    intrinsicEightPointQuadraticIdeal y at h
  exact h.symm

/-- Equal evaluation kernels define literally the same intrinsic ideal. -/
theorem intrinsicEightPointQuadraticIdeal_eq_of_kernel_eq
    {R : Type u} [CommRing R]
    (z y : Fin 8 → Fin 4 → R)
    (hker : LinearMap.ker (Matrix.toLin'
      (eightPointQuadraticEvaluationMatrix z)) =
      LinearMap.ker (Matrix.toLin'
        (eightPointQuadraticEvaluationMatrix y))) :
    intrinsicEightPointQuadraticIdeal z =
      intrinsicEightPointQuadraticIdeal y := by
  unfold intrinsicEightPointQuadraticIdeal
  rw [hker]

/-- The cubic equation together with the intrinsic quadratic kernel ideal. -/
noncomputable def intrinsicEightPointTripleIdeal
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R)
    (y : Fin 8 → Fin 4 → R) : Ideal (MvPolynomial (Fin 4) R) :=
  Ideal.span {p} ⊔ intrinsicEightPointQuadraticIdeal y

theorem intrinsicEightPointTripleIdeal_eq_of_kernel_eq
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R)
    (z y : Fin 8 → Fin 4 → R)
    (hker : LinearMap.ker (Matrix.toLin'
      (eightPointQuadraticEvaluationMatrix z)) =
      LinearMap.ker (Matrix.toLin'
        (eightPointQuadraticEvaluationMatrix y))) :
    intrinsicEightPointTripleIdeal p z =
      intrinsicEightPointTripleIdeal p y := by
  simp only [intrinsicEightPointTripleIdeal,
    intrinsicEightPointQuadraticIdeal_eq_of_kernel_eq z y hker]

/-- On a rank-two kernel chart, the selected cubic and two basis quadrics
generate the intrinsic triple-intersection ideal. -/
theorem intrinsicEightPointTripleIdeal_eq_basis
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R)
    (y : Fin 8 → Fin 4 → R)
    (b : Basis (Fin 2) R
      (LinearMap.ker (Matrix.toLin'
        (eightPointQuadraticEvaluationMatrix y)))) :
    intrinsicEightPointTripleIdeal p y =
      Ideal.span (insert p (Set.range (fun i : Fin 2 =>
        quadraticPolynomialOfCoefficients (b i).1))) := by
  rw [intrinsicEightPointTripleIdeal,
    intrinsicEightPointQuadraticIdeal_eq_basis y b,
    Ideal.span_insert]

/-- The intrinsic intersection ideal is invariant under permutation and
unit rescaling of the eight projective representatives. -/
theorem intrinsicEightPointTripleIdeal_scale_relabel
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R)
    (σ : Equiv.Perm (Fin 8))
    (a : Fin 8 → R) (ha : ∀ i, IsUnit (a i))
    (y : Fin 8 → Fin 4 → R) :
    intrinsicEightPointTripleIdeal p
      (fun i j => a i * y (σ i) j) =
    intrinsicEightPointTripleIdeal p y :=
  intrinsicEightPointTripleIdeal_eq_of_kernel_eq p _ y
    (eightPointQuadraticEvaluationKernel_scale_relabel σ a ha y)

/-- The intrinsic cubic-plus-kernel ideal is homogeneous, so it defines a
relative projective intersection without choosing a quadratic frame. -/
noncomputable def intrinsicEightPointTripleHomogeneousIdeal
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R) (hp : p.IsHomogeneous 3)
    (y : Fin 8 → Fin 4 → R) :
    HomogeneousIdeal (homogeneousSubmodule (Fin 4) R) := by
  let J : Ideal (MvPolynomial (Fin 4) R) :=
    Ideal.span (insert p (Set.range (fun v : LinearMap.ker
      (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y)) =>
        quadraticPolynomialOfCoefficients v.1)))
  have hJ : J.IsHomogeneous (homogeneousSubmodule (Fin 4) R) := by
    dsimp [J]
    apply Ideal.homogeneous_span
    intro q hq
    rcases hq with rfl | ⟨v, rfl⟩
    · exact ⟨3, hp⟩
    · exact ⟨2, quadraticPolynomialOfCoefficients_isHomogeneous v.1⟩
  exact ⟨J, hJ⟩

/-- The underlying ideal of the intrinsic relative projective intersection
is precisely the cubic plus all quadrics in the evaluation kernel. -/
theorem intrinsicEightPointTripleHomogeneousIdeal_toIdeal
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R) (hp : p.IsHomogeneous 3)
    (y : Fin 8 → Fin 4 → R) :
    (intrinsicEightPointTripleHomogeneousIdeal p hp y).toIdeal =
      intrinsicEightPointTripleIdeal p y := by
  change Ideal.span (insert p (Set.range (fun v : LinearMap.ker
      (Matrix.toLin' (eightPointQuadraticEvaluationMatrix y)) =>
        quadraticPolynomialOfCoefficients v.1))) =
    Ideal.span {p} ⊔ intrinsicEightPointQuadraticIdeal y
  rw [Ideal.span_insert]
  rfl

/-- The intrinsic homogeneous ideal is itself independent of a change of
projective representatives and ordering. -/
theorem intrinsicEightPointTripleHomogeneousIdeal_scale_relabel
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R) (hp : p.IsHomogeneous 3)
    (σ : Equiv.Perm (Fin 8))
    (a : Fin 8 → R) (ha : ∀ i, IsUnit (a i))
    (y : Fin 8 → Fin 4 → R) :
    intrinsicEightPointTripleHomogeneousIdeal p hp
      (fun i j => a i * y (σ i) j) =
    intrinsicEightPointTripleHomogeneousIdeal p hp y := by
  apply HomogeneousIdeal.ext
  rw [intrinsicEightPointTripleHomogeneousIdeal_toIdeal,
    intrinsicEightPointTripleHomogeneousIdeal_toIdeal]
  exact intrinsicEightPointTripleIdeal_scale_relabel p σ a ha y

/-- The projective intersection scheme obtained from the intrinsic kernel
is unchanged by permutation and unit rescaling of the eight points. -/
theorem intrinsicEightPointTripleScheme_scale_relabel
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R) (hp : p.IsHomogeneous 3)
    (σ : Equiv.Perm (Fin 8))
    (a : Fin 8 → R) (ha : ∀ i, IsUnit (a i))
    (y : Fin 8 → Fin 4 → R) :
    scheme (intrinsicEightPointTripleHomogeneousIdeal p hp
      (fun i j => a i * y (σ i) j)) =
    scheme (intrinsicEightPointTripleHomogeneousIdeal p hp y) := by
  rw [intrinsicEightPointTripleHomogeneousIdeal_scale_relabel p hp σ a ha y]

private theorem range_fin_two_eq_pair {α : Type*} (g : Fin 2 → α) :
    Set.range g = {g 0, g 1} := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp
  · intro hx
    rcases hx with h | h
    · exact ⟨0, h.symm⟩
    · exact ⟨1, h.symm⟩

/-- The intrinsic relative projective ideal agrees with the usual
cubic--quadric--quadric family formed from any basis of the quadratic
evaluation kernel. -/
theorem intrinsicEightPointTripleHomogeneousIdeal_eq_relative_of_basis
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R) (hp : p.IsHomogeneous 3)
    (y : Fin 8 → Fin 4 → R)
    (b : Basis (Fin 2) R
      (LinearMap.ker (Matrix.toLin'
        (eightPointQuadraticEvaluationMatrix y)))) :
    intrinsicEightPointTripleHomogeneousIdeal p hp y =
    relativeTripleIntersectionHomogeneousIdeal p
      (quadraticPolynomialOfCoefficients (b 0).1)
      (quadraticPolynomialOfCoefficients (b 1).1) hp
      (quadraticPolynomialOfCoefficients_isHomogeneous (b 0).1)
      (quadraticPolynomialOfCoefficients_isHomogeneous (b 1).1) := by
  apply HomogeneousIdeal.ext
  rw [intrinsicEightPointTripleHomogeneousIdeal_toIdeal,
    intrinsicEightPointTripleIdeal_eq_basis p y b]
  change Ideal.span (insert p (Set.range (fun i : Fin 2 =>
      quadraticPolynomialOfCoefficients (b i).1))) =
    Ideal.span ({p, quadraticPolynomialOfCoefficients (b 0).1,
      quadraticPolynomialOfCoefficients (b 1).1} : Set _)
  rw [range_fin_two_eq_pair]

/-- Consequently the actual relative projective scheme can be identified
with the scheme defined by the intrinsic kernel ideal. -/
theorem intrinsicEightPointTripleScheme_eq_relative_of_basis
    {R : Type u} [CommRing R]
    (p : MvPolynomial (Fin 4) R) (hp : p.IsHomogeneous 3)
    (y : Fin 8 → Fin 4 → R)
    (b : Basis (Fin 2) R
      (LinearMap.ker (Matrix.toLin'
        (eightPointQuadraticEvaluationMatrix y)))) :
    scheme (intrinsicEightPointTripleHomogeneousIdeal p hp y) =
    relativeTripleIntersectionFamily p
      (quadraticPolynomialOfCoefficients (b 0).1)
      (quadraticPolynomialOfCoefficients (b 1).1) hp
      (quadraticPolynomialOfCoefficients_isHomogeneous (b 0).1)
      (quadraticPolynomialOfCoefficients_isHomogeneous (b 1).1) := by
  rw [intrinsicEightPointTripleHomogeneousIdeal_eq_relative_of_basis p hp y b]

end PfaffianDescent
