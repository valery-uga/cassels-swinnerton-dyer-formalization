import PfaffianDescent.IntrinsicFullQuadraticSystem
import PfaffianDescent.OriginalThreeQuadricRankEightSourceIso
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Data.Fin.VecNotation

/-! SOURCE ONLY / UNVERIFIED. The actual affine kernel of the SAME
nonreduced original length-eight scheme is generated by the literal
normalized three quadrics. There is no radical ideal or assumed ideal
comparison. The source isomorphism is derived internally from rank eight. -/
noncomputable section
namespace PfaffianDescent
open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics.HomogeneousProjective
universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra
local notation "PS" => homogeneousSubmodule (Fin 4) K

set_option backward.isDefEq.respectTransparency false in
/-- Actual kernel ideals on ambient affine charts, rather than only
polynomial chart kernels. -/
theorem quotientProjMap_affineIdeal_eq_normalizedIdeal
    (I : HomogeneousIdeal PS) (j : Fin 4) :
    (quotientProjMap I).ker.ideal (intrinsicQuadraticAmbientOpen j) =
      (I.toIdeal.map (ambientChartEvaluation j)).map
        (Proj.awayToSection PS (X j)).hom := by
  dsimp only [intrinsicQuadraticAmbientOpen]
  let U : (Proj PS).affineOpens :=
    ⟨Proj.basicOpen PS (X j),
      Proj.isAffineOpen_basicOpen PS (X j) (isHomogeneous_X K j) (by decide : 0 < 1)⟩
  let e : CommRingCat.of (HomogeneousLocalization.Away PS (X j)) ⟶
      (Proj PS).presheaf.obj (Opposite.op (Proj.basicOpen PS (X j))) :=
    Proj.awayToSection PS (X j)
  let eI := Proj.awayToSection (grading I) (coordinate I j)
  letI : IsIso e :=
    (Proj.basicOpenIsoAway PS (X j) (isHomogeneous_X K j) (by decide)).isIso_hom
  letI : IsIso eI :=
    (Proj.basicOpenIsoAway (grading I) (coordinate I j)
      (coordinate_mem I j) (by decide)).isIso_hom
  have he (a : HomogeneousLocalization.Away PS (X j)) :
      (quotientProjMap I).app U (e a) = eI (quotientAmbientChartMap I j a) := by
    exact congrArg (fun g => g a)
      (Proj.awayToSection_comp_appLE (quotientGradedRingHom I)
        (irrelevant_le_map_quotientGradedRingHom I) (isHomogeneous_X K j))
  ext s
  obtain ⟨a, rfl⟩ := (ConcreteCategory.bijective_of_isIso e).surjective s
  change e.hom a ∈ (quotientProjMap I).ker.ideal U ↔
    e.hom a ∈ (I.toIdeal.map (ambientChartEvaluation j)).map e.hom
  rw [Ideal.mem_map_iff_of_surjective e.hom
    (ConcreteCategory.bijective_of_isIso e).surjective]
  constructor
  · intro hs
    have hz : (quotientProjMap I).app U (e a) = 0 := by
      simpa only [Scheme.Hom.ker_apply, RingHom.mem_ker] using hs
    have ha : quotientAmbientChartMap I j a = 0 := by
      apply (ConcreteCategory.bijective_of_isIso eI).injective
      simpa only [map_zero] using (he a).symm.trans hz
    refine ⟨a, ?_, rfl⟩
    rw [← quotientAmbientChartMap_ker_eq_ideal_image]
    exact ha
  · rintro ⟨b, hb, hba⟩
    have hab : b = a := (ConcreteCategory.bijective_of_isIso e).injective hba
    subst b
    have ha : quotientAmbientChartMap I j a = 0 := by
      rw [← quotientAmbientChartMap_ker_eq_ideal_image] at hb
      exact hb
    rw [(quotientProjMap I).ker_apply U, RingHom.mem_ker]
    change (quotientProjMap I).app U (e a) = 0
    rw [he, ha, map_zero]

/-- The literal normalized coefficients of the three equations in the
actual ambient structure ring of one standard open. -/
def threeQuadricAffineCoefficients (f g h : PS 2) (j : Fin 4) :
    Fin 3 → Γ(Proj PS, (intrinsicQuadraticAmbientOpen j).1) :=
  fun r => (Proj.awayToSection PS (X j)).hom
    (ambientChartEvaluation j ((![f, g, h] r).val))

set_option backward.isDefEq.respectTransparency false in
/-- No source-identification certificate: actual rank eight supplies the
source isomorphism, then actual composition identifies the ideal kernel. -/
theorem p3OriginalThreeQuadric_affineIdeal_eq_span
    (f g h : PS 2)
    [IsFinite (toBase (tripleCompleteIntersectionHomogeneousIdeal
      f.val g.val h.val f.property g.property h.property))]
    {Z : Scheme.{u}}
    (l : Z ⟶ scheme (tripleCompleteIntersectionHomogeneousIdeal
      f.val g.val h.val f.property g.property h.property)) [IsClosedImmersion l]
    (hZ : AllCharacteristics.finiteSchemeRank
      (l ≫ toBase (tripleCompleteIntersectionHomogeneousIdeal
        f.val g.val h.val f.property g.property h.property)) = 8)
    (j : Fin 4) :
    (l ≫ quotientProjMap (tripleCompleteIntersectionHomogeneousIdeal
      f.val g.val h.val f.property g.property h.property)).ker.ideal
        (intrinsicQuadraticAmbientOpen j) =
      Ideal.span (Set.range (threeQuadricAffineCoefficients f g h j)) := by
  let T := tripleCompleteIntersectionHomogeneousIdeal f.val g.val h.val
    f.property g.property h.property
  letI := p3ThreeQuadricOriginalLift_isIso f g h l hZ
  rw [Scheme.Hom.ker_comp_of_isIso, quotientProjMap_affineIdeal_eq_normalizedIdeal]
  have hgen : T.toIdeal = Ideal.span (Set.range fun r : Fin 3 =>
      ((![f, g, h] r).val)) := by
    have hT : T.toIdeal = tripleCompleteIntersectionIdeal f.val g.val h.val :=
      tripleCompleteIntersectionHomogeneousIdeal_toIdeal (K := K)
        (a := 2) (b := 2) (c := 2) f.val g.val h.val
        f.property g.property h.property
    refine hT.trans ?_
    change Ideal.span ({f.val, g.val, h.val} : Set (MvPolynomial (Fin 4) K)) =
      Ideal.span (Set.range fun r : Fin 3 => ((![f, g, h] r).val))
    apply congrArg Ideal.span
    ext p
    constructor
    · intro hp
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rcases hp with rfl | rfl | rfl
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
      · exact ⟨2, rfl⟩
    · rintro ⟨r, rfl⟩
      fin_cases r <;> simp
  rw [hgen, Ideal.map_span, Ideal.map_span]
  congr 1
  ext z
  simp only [Set.mem_image, Set.mem_range, threeQuadricAffineCoefficients]
  constructor
  · rintro ⟨a, ⟨b, ⟨r, rfl⟩, rfl⟩, rfl⟩
    exact ⟨r, rfl⟩
  · rintro ⟨r, rfl⟩
    exact ⟨ambientChartEvaluation j ((![f, g, h] r).val),
      ⟨((![f, g, h] r).val), ⟨r, rfl⟩, rfl⟩, rfl⟩

end PfaffianDescent
