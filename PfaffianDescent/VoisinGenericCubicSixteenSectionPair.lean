import PfaffianDescent.VoisinGenericCubicSixteenSurjectivity
import PfaffianDescent.VoisinSectionChoice
import PfaffianDescent.TripleQuadricsSequentialRegularity

/-!
# Two cubics on the actual generic sixteen-point configuration

The exact three-dimensional cubic vanishing system is now combined with
the prime-surface section selector at one and the same normalized chart.
The first cubic is regular modulo the surface equation. A second cubic
vanishes on the same finite scheme and is independent even modulo the
ideal generated by the first two equations. Regularity of the second
cubic modulo the first is a separate geometric issue.
-/

namespace PfaffianDescent

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial Module
open AllCharacteristics AllCharacteristics.HomogeneousProjective
open AllCharacteristics.UniversalHomogeneous

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

structure GenericCubicSixteenIndependentSectionPair
    (F A : Type u) [Field F] [CommRing A] [Algebra F A]
    (p : MvPolynomial (Fin 4) F) where
  x : Fin 4 → A
  surfaceZero : p.eval₂ (algebraMap F A) x = 0
  q : MvPolynomial (Fin 4) F
  qHomogeneous : q.IsHomogeneous 3
  qZero : q.eval₂ (algebraMap F A) x = 0
  qRegular : IsRelPrime p q
  h : MvPolynomial (Fin 4) F
  hHomogeneous : h.IsHomogeneous 3
  hZero : h.eval₂ (algebraMap F A) x = 0
  hIndependent : h ∉ Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) F))

/-- If the intermediate cubic--cubic intersection is integral, the
independent second section is a non-zero-divisor modulo its ideal. -/
theorem GenericCubicSixteenIndependentSectionPair.thirdRegular_of_primeIntermediate
    {F A : Type u} [Field F] [CommRing A] [Algebra F A]
    {p : MvPolynomial (Fin 4) F}
    (D : GenericCubicSixteenIndependentSectionPair F A p)
    (hprime : (Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))).IsPrime) :
    ∀ y : MvPolynomial (Fin 4) F,
      D.h * y ∈ Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F)) →
        y ∈ Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F)) :=
  third_equation_regular_of_span_isPrime p D.q D.h hprime D.hIndependent

/-- The three actual equations selected on the generic sixteen-point chart
form a regular sequence when the surface equation is prime and the selected
intermediate cubic--cubic intersection is prime. -/
theorem GenericCubicSixteenIndependentSectionPair.isRegular_of_primeIntermediate
    {F A : Type u} [Field F] [CommRing A] [Algebra F A]
    {p : MvPolynomial (Fin 4) F}
    (D : GenericCubicSixteenIndependentSectionPair F A p)
    (hpHomogeneous : p.IsHomogeneous 3) (hpPrime : Prime p)
    (hprime : (Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))).IsPrime) :
    RingTheory.Sequence.IsRegular (MvPolynomial (Fin 4) F) [p, D.q, D.h] :=
  triple_cubics_isRegular_of_sequential_regular p D.q D.h
    hpHomogeneous D.qHomogeneous D.hHomogeneous hpPrime.ne_zero
    (regular_mod_span_singleton_of_isRelPrime D.qRegular)
    (D.thirdRegular_of_primeIntermediate hprime)

/-- Associated-prime avoidance on the actual cubic vanishing system selects
a regular third cubic on the same sixteen-point chart. This criterion does
not require the intermediate cubic--cubic curve to be integral. -/
theorem GenericCubicSixteenIndependentSectionPair.exists_regularThird_of_avoidsAssociatedPrimes
    {F A : Type u} [Field F] [Infinite F] [CommRing A] [Algebra F A]
    [FiniteDimensional F A]
    {p : MvPolynomial (Fin 4) F}
    (D : GenericCubicSixteenIndependentSectionPair F A p)
    (havoid : ∀ P ∈ associatedPrimes
        (MvPolynomial (Fin 4) F ⧸
          Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F)))
        (MvPolynomial (Fin 4) F ⧸
          Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))),
      ∃ r ∈ homogeneousVanishingPolynomialSubmodule
          (K := F) (A := A) (sigma := Fin 4) D.x 3,
        Ideal.Quotient.mk
          (Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))) r ∉ P) :
    ∃ r : MvPolynomial (Fin 4) F,
      r.IsHomogeneous 3 ∧ r.eval₂ (algebraMap F A) D.x = 0 ∧
      (∀ y : MvPolynomial (Fin 4) F,
        r * y ∈ Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F)) →
          y ∈ Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))) :=
  exists_regular_third_cubic_section_data_of_avoids_associatedPrimes
    p D.q D.x havoid

/-- With a prime surface equation, the associated-prime criterion yields an
actual regular sequence of three cubics through the generic configuration. -/
theorem GenericCubicSixteenIndependentSectionPair.exists_regularTriple_of_avoidsAssociatedPrimes
    {F A : Type u} [Field F] [Infinite F] [CommRing A] [Algebra F A]
    [FiniteDimensional F A]
    {p : MvPolynomial (Fin 4) F}
    (D : GenericCubicSixteenIndependentSectionPair F A p)
    (hpHomogeneous : p.IsHomogeneous 3) (hpPrime : Prime p)
    (havoid : ∀ P ∈ associatedPrimes
        (MvPolynomial (Fin 4) F ⧸
          Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F)))
        (MvPolynomial (Fin 4) F ⧸
          Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))),
      ∃ r ∈ homogeneousVanishingPolynomialSubmodule
          (K := F) (A := A) (sigma := Fin 4) D.x 3,
        Ideal.Quotient.mk
          (Ideal.span ({p, D.q} : Set (MvPolynomial (Fin 4) F))) r ∉ P) :
    ∃ r : MvPolynomial (Fin 4) F,
      r.IsHomogeneous 3 ∧ r.eval₂ (algebraMap F A) D.x = 0 ∧
      RingTheory.Sequence.IsRegular (MvPolynomial (Fin 4) F) [p, D.q, r] := by
  obtain ⟨r, hrhom, hrzero, hrreg⟩ :=
    D.exists_regularThird_of_avoidsAssociatedPrimes havoid
  exact ⟨r, hrhom, hrzero,
    triple_cubics_isRegular_of_sequential_regular p D.q r
      hpHomogeneous D.qHomogeneous hrhom hpPrime.ne_zero
      (regular_mod_span_singleton_of_isRelPrime D.qRegular) hrreg⟩

/-- On the actual generic sixteen-point subscheme, choose one cubic
regular modulo the surface equation and another vanishing cubic outside
the ideal of those two equations, using the same normalized coordinates. -/
theorem exists_cubicConfigurationGenericSixteen_regularFirst_and_independentSecond
    {K : Type u} [Field K] [IsAlgClosed K]
    (cubic : MvPolynomial (Fin 4) K) (hcubic : cubic.IsHomogeneous 3)
    (hcubic_ne : cubic ≠ 0)
    (hcubic_prime :
      (Ideal.span ({cubic} : Set (MvPolynomial (Fin 4) K))).IsPrime)
    [hsep : IsSeparated (hypersurfaceToBase cubic hcubic)]
    [hlft : LocallyOfFiniteType (hypersurfaceToBase cubic hcubic)]
    [hint : IsIntegral
      (projectiveConfigurationQuotientOpen (grading (equationIdeal cubic hcubic))
        (hypersurfaceToBase cubic hcubic) 16).toScheme]
    [hbase : IsIntegral (cubicConfigurationBase cubic hcubic 16)]
    [Infinite (cubicConfigurationBase cubic hcubic 16).functionField]
    (a : CommRingCat.of K ⟶ CommRingCat.of
      (cubicConfigurationBase cubic hcubic 16).functionField)
    (ha : Spec.map a = cubicConfigurationGenericBaseMap cubic hcubic 16 ≫
      cubicConfigurationToBase cubic hcubic 16)
    (hprime :
      (Ideal.span ({cubic.map a.hom} : Set
        (MvPolynomial (Fin 4)
          (cubicConfigurationBase cubic hcubic 16).functionField))).IsPrime)
    {m : ℕ} (e : Fin m ≃ Monomials (Fin 4) 3) :
    let Q := cubicConfigurationBase cubic hcubic 16
    let D := cubicConfigurationGenericFiniteSubscheme cubic hcubic 16 a ha
    let pD := cubicConfigurationCoefficientChangedBaseMap cubic hcubic 16 a ha
    letI : IsFinite pD := D.property.1
    letI := finiteSchemeCoefficientAlgebra pD
    Nonempty (GenericCubicSixteenIndependentSectionPair
      Q.functionField Γ(D.val.subscheme, ⊤) (cubic.map a.hom)) := by
  dsimp only
  let Q := cubicConfigurationBase cubic hcubic 16
  let D := cubicConfigurationGenericFiniteSubscheme cubic hcubic 16 a ha
  let pD := cubicConfigurationCoefficientChangedBaseMap cubic hcubic 16 a ha
  letI : IsFinite pD := D.property.1
  letI := finiteSchemeCoefficientAlgebra pD
  haveI : FiniteDimensional Q.functionField Γ(D.val.subscheme, ⊤) :=
    finiteSchemeCoefficient_finite pD
  obtain ⟨x, hpx, hdim⟩ :=
    exists_cubicConfigurationGenericSixteen_cubicVanishingModuloEquation_finrank_three
      cubic hcubic hcubic_ne hcubic_prime a ha e
  have hne : cubic.map a.hom ≠ 0 :=
    cubicConfigurationCoefficientChange_ne_zero cubic hcubic 16 a hcubic_ne
  obtain ⟨q, hqhom, hqvan, _hqnot, hqrel⟩ :=
    exists_regular_cubic_section_data_of_prime_with_not_mem
      (cubic.map a.hom) (hcubic.map a.hom) hne x hpx
        (by omega) hprime
  obtain ⟨h, hhmem, hhnot⟩ :=
    exists_cubic_vanishing_section_not_mem_span_pair
      (cubic.map a.hom) q (hcubic.map a.hom) x hpx
        hqhom hqvan (by omega)
  obtain ⟨hhhom, hhvan⟩ :=
    (mem_homogeneousVanishingPolynomialSubmodule_iff
      (K := Q.functionField) (A := Γ(D.val.subscheme, ⊤))
      (sigma := Fin 4) x 3 h).mp hhmem
  exact ⟨{
    x := x
    surfaceZero := hpx
    q := q
    qHomogeneous := hqhom
    qZero := hqvan
    qRegular := hqrel
    h := h
    hHomogeneous := hhhom
    hZero := hhvan
    hIndependent := hhnot
  }⟩

end PfaffianDescent
