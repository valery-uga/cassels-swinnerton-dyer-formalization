import PfaffianDescent.VoisinRegularPrincipalPrincipalOpens
import PfaffianDescent.VoisinSmoothCubicChartDomain

/-!
# Four principal opens for a plane conic on a cubic

The cubic relation `ell*a + q*b = 0` makes the conic ideal `(ell,q)`
principal on each of the four opens where `ell`, `q`, `a`, or `b` is a unit.
Zero functions are omitted from the index, so each localized ring remains
a domain when the original chart ring is a domain.
-/

namespace PfaffianDescent

open AlgebraicGeometry MvPolynomial
open AllCharacteristics.HomogeneousProjective

universe u

/-- The nonempty principal-open refinements among the four natural conic
functions. -/
def conicPrincipalOpenIndex
    {A : Type u} [CommRing A] (ell q a b : A) : Type u :=
  {t : A // t ∈ ({ell, q, a, b} : Set A) ∧ t ≠ 0}

/-- Removing zero functions does not change the ideal generated by the
four conic functions. -/
theorem conicPrincipalOpenIndex_span_top
    {A : Type u} [CommRing A] (ell q a b : A)
    (hcover : Ideal.span ({ell, q, a, b} : Set A) = ⊤) :
    Ideal.span (Set.range (fun t : conicPrincipalOpenIndex ell q a b =>
      t.1)) = ⊤ := by
  apply top_unique
  rw [← hcover]
  apply Ideal.span_le.mpr
  intro t ht
  by_cases ht0 : t = 0
  · rw [ht0]
    exact Ideal.zero_mem _
  · exact Ideal.subset_span ⟨⟨t, ht, ht0⟩, rfl⟩

/-- Localizing a two-generator conic quotient on any of the four nonempty
natural principal opens gives a regular-principal kernel. -/
theorem conicPrincipalOpen_localizedKernel_regularPrincipal
    {A B : Type u} [CommRing A] [CommRing B] [IsDomain A]
    (g : A →+* B) (ell q a b : A)
    (hker : RingHom.ker g = Ideal.span ({ell, q} : Set A))
    (hrel : ell * a + q * b = 0)
    (hell0 : ell ≠ 0)
    (t : conicPrincipalOpenIndex ell q a b) :
    ∃ z : Localization.Away t.1, IsRegular z ∧
      RingHom.ker (Localization.awayMap g t.1) =
        Ideal.span ({z} : Set (Localization.Away t.1)) := by
  let T := Localization.Away t.1
  let f : A →+* T := algebraMap A T
  have ht0 : t.1 ≠ 0 := t.property.2
  have hM : Submonoid.powers t.1 ≤ nonZeroDivisors A := by
    intro x hx
    obtain ⟨n, rfl⟩ := hx
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n ht0)
  letI : IsDomain T := IsLocalization.isDomain_localization hM
  have hfinj : Function.Injective f := IsLocalization.injective T hM
  have hellT : f ell ≠ 0 := by
    intro hzero
    exact hell0 (hfinj (hzero.trans (map_zero f).symm))
  have hrelT : f ell * f a + f q * f b = 0 := by
    simpa only [map_add, map_mul, map_zero] using congrArg f hrel
  have hunitT : IsUnit (f ell) ∨ IsUnit (f q) ∨
      IsUnit (f a) ∨ IsUnit (f b) := by
    have htunit : IsUnit (f t.1) :=
      IsLocalization.Away.algebraMap_isUnit t.1
    have htmem := t.property.1
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at htmem
    rcases htmem with he | hq | ha | hb
    · exact Or.inl (by simpa only [he] using htunit)
    · exact Or.inr (Or.inl (by simpa only [hq] using htunit))
    · exact Or.inr (Or.inr (Or.inl (by simpa only [ha] using htunit)))
    · exact Or.inr (Or.inr (Or.inr (by simpa only [hb] using htunit)))
  obtain ⟨z, hzreg, hzideal⟩ :=
    conicIdeal_regularPrincipal_of_unit_cover
      (f ell) (f q) (f a) (f b) hrelT (Or.inl hellT) hunitT
  refine ⟨z, hzreg, ?_⟩
  have hkerLoc : RingHom.ker (Localization.awayMap g t.1) =
      (RingHom.ker g).map f := by
    simpa only [f, T, Localization.awayMap, IsLocalization.Away.map] using
      (IsLocalization.ker_map (S := T)
        (Q := Localization.Away (g t.1)) (g := g)
        (Submonoid.map_powers g t.1))
  rw [hkerLoc, hker, Ideal.map_span]
  simpa only [Set.image_insert_eq, Set.image_singleton] using hzideal

/-- The same local kernel certificate for one of the four displayed
functions, allowing the chosen function to be zero. A zero function has an
empty principal open and therefore a zero localized target ring. -/
theorem conicPrincipalOpen_localizedKernel_regularPrincipal_of_mem
    {A B : Type u} [CommRing A] [CommRing B] [IsDomain A]
    (g : A →+* B) (ell q a b : A)
    (hker : RingHom.ker g = Ideal.span ({ell, q} : Set A))
    (hrel : ell * a + q * b = 0)
    (hell0 : ell ≠ 0)
    (t : A) (ht : t ∈ ({ell, q, a, b} : Set A)) :
    ∃ z : Localization.Away t, IsRegular z ∧
      RingHom.ker (Localization.awayMap g t) =
        Ideal.span ({z} : Set (Localization.Away t)) := by
  by_cases ht0 : t = 0
  · subst t
    haveI : Subsingleton (Localization.Away (g (0 : A))) :=
      IsLocalization.subsingleton (M := Submonoid.powers (g (0 : A)))
        (S := Localization.Away (g (0 : A))) (by
          refine ⟨1, ?_⟩
          simp)
    refine ⟨1, isRegular_one, ?_⟩
    rw [Ideal.span_singleton_one]
    apply top_unique
    intro x hx
    change Localization.awayMap g (0 : A) x = 0
    exact Subsingleton.elim _ _
  · exact conicPrincipalOpen_localizedKernel_regularPrincipal
      g ell q a b hker hrel hell0 ⟨t, ht, ht0⟩

end PfaffianDescent
