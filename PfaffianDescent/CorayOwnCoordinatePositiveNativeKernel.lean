import PfaffianDescent.CorayGradedPrincipalPositiveNativeExact
import PfaffianDescent.CorayGradedPrincipalPositiveFractionExact
import PfaffianDescent.CorayOwnCoordinateCokernelCanonicalCutMap
import PfaffianDescent.ProjectiveSurjectionImage
import Mathlib.RingTheory.Ideal.Quotient.PowTransition

/-! SOURCE ONLY. Kernel equality for the SAME positive coordinate map
and SAME whole coordinate-cut restriction on every original native stalk.
The whole cut may be nonreduced; no target-domain assumption is made. -/
noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopCat
open AllCharacteristics.HomogeneousProjective ProjectiveNegativeTwist
universe u
variable {K : Type u} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- The actual WHOLE coordinate quotient has the principal graded kernel
generated by the SAME original coordinate class. -/
theorem ownCoordinateCut_gradedQuotientMap_ker
    (C : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (j : Fin 4) :
    RingHom.ker (gradedQuotientMap C
      (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j))
      le_sup_left).toRingHom =
        Ideal.span ({coordinate C j} : Set (CoordinateRing C)) := by
  change RingHom.ker (Ideal.Quotient.factor
    (show C.toIdeal ≤
      (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j)).toIdeal
      from le_sup_left)) = _
  rw [Ideal.Quotient.factor_ker, HomogeneousIdeal.toIdeal_sup, Ideal.map_sup,
    Ideal.map_quotient_self, bot_sup_eq]
  change (Ideal.span ({MvPolynomial.X j} : Set (MvPolynomial (Fin 4) K))).map
    (Ideal.Quotient.mk C.toIdeal) = _
  rw [Ideal.map_span, Set.image_singleton]
  rfl

/-- Native categorical stalk exactness at each point of the WHOLE cut.
Actual fraction/stalk and actual pushforward/stalk maps transport the
proved homogeneous-annihilator exactness, without a kernel certificate. -/
theorem ownCoordinateCutPositiveRestriction_stalk_exact_image
    (C : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (j : Fin 4) (m : ℕ)
    (y : scheme (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j))) :
    Function.Exact
      (schemeModuleStalkLinearMap (ownPositiveCoordinateMultiplication C j m)
        (schemeQuotientMap C
          (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j))
          le_sup_left y))
      (schemeModuleStalkLinearMap (ownCoordinateCutPositiveRestriction C j m)
        (schemeQuotientMap C
          (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j))
          le_sup_left y)) := by
  let D := C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j)
  exact gradedPrincipal_positiveNativeStalk_exact_image
    (grading C) (grading D) (gradedQuotientMap C D le_sup_left)
    (gradedQuotientMap_surjective C D le_sup_left)
    (⟨coordinate C j, coordinate_mem C j⟩ : grading C 1)
    (ownCoordinateCut_gradedQuotientMap_ker C j) m y

/-- Off the actual cut, the SAME coordinate multiplication is bijective
and the actual target pushforward stalk is zero. -/
theorem ownCoordinateCutPositiveRestriction_stalk_exact_off_range
    (C : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (j : Fin 4) (m : ℕ) (x : scheme C)
    (hx : x ∉ Set.range (schemeQuotientMap C
      (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j)) le_sup_left)) :
    Function.Exact
      (schemeModuleStalkLinearMap (ownPositiveCoordinateMultiplication C j m) x)
      (schemeModuleStalkLinearMap (ownCoordinateCutPositiveRestriction C j m) x) := by
  let D := C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j)
  let f := gradedQuotientMap C D le_sup_left
  let hf := gradedQuotientMap_surjective C D le_sup_left
  let i := schemeQuotientMap C D le_sup_left
  letI : IsClosedImmersion i := schemeQuotientMap_closedImmersion C D le_sup_left
  let s : grading C 1 := ⟨coordinate C j, coordinate_mem C j⟩
  have hs : (s : CoordinateRing C) ∉ x.asHomogeneousIdeal.toIdeal := by
    intro hs
    apply hx
    change x ∈ Set.range (Proj.map f (gradedSurjective_irrelevant_le f hf))
    rw [projectiveMap_mem_range_iff f hf x, ownCoordinateCut_gradedQuotientMap_ker C j,
      Ideal.span_le]
    exact Set.singleton_subset_iff.mpr hs
  let fA := schemeModuleStalkLinearMap (ownPositiveCoordinateMultiplication C j m) x
  let gA := schemeModuleStalkLinearMap (ownCoordinateCutPositiveRestriction C j m) x
  have hsurj : Function.Surjective fA :=
    (positiveMulHomogeneous_stalkMap_bijective_of_mem_primeCompl
      (grading C) s m x hs s hs).surjective
  letI : Subsingleton (((Scheme.Modules.pushforward i).obj
      (positiveSheafOfModules (grading D) (m + 1))).presheaf.stalk x) :=
    schemeModulePushforward_stalk_subsingleton_off_range i
      (positiveSheafOfModules (grading D) (m + 1)) x hx
  change Function.Exact fA gA
  intro v
  constructor
  · intro _
    exact hsurj v
  · intro _
    exact Subsingleton.elim _ _

/-- Complete kernel equality at every ACTUAL original stalk. Both on-cut
and off-cut cases are proved internally, including nonreduced whole cuts. -/
theorem ownCoordinateCutPositiveRestriction_stalk_exact
    (C : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 4) K))
    (j : Fin 4) (m : ℕ) (x : scheme C) :
    Function.Exact
      (schemeModuleStalkLinearMap (ownPositiveCoordinateMultiplication C j m) x)
      (schemeModuleStalkLinearMap (ownCoordinateCutPositiveRestriction C j m) x) := by
  by_cases hx : x ∈ Set.range (schemeQuotientMap C
      (C ⊔ equationIdeal (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X K j)) le_sup_left)
  · obtain ⟨y, rfl⟩ := hx
    exact ownCoordinateCutPositiveRestriction_stalk_exact_image C j m y
  · exact ownCoordinateCutPositiveRestriction_stalk_exact_off_range C j m x hx

end PfaffianDescent.Coray
end
