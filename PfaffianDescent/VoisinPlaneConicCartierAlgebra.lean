import PfaffianDescent.VoisinCartierInverseTwist

/-!
# A local Cartier certificate for a plane conic on a cubic surface

If a cubic equation is `ell * a + q * b = 0` in the cubic surface's
coordinate ring, then the conic ideal `(ell,q)` becomes principal wherever
`a` or `b` is a unit. These lemmas isolate the exact local algebra needed
to turn the two homogeneous conic generators into a regular-principal
immersion. The geometric work remains to produce these certificates on a
cover of the concrete conic.
-/

namespace PfaffianDescent

universe u

/-- On a cubic chart where the coefficient of the plane equation is a unit,
the conic ideal is generated by its quadratic equation. -/
theorem conicIdeal_eq_span_quadratic_of_unit_linear_coefficient
    {A : Type u} [CommRing A] (ell q a b : A)
    (h : ell * a + q * b = 0) (ha : IsUnit a) :
    Ideal.span ({ell, q} : Set A) = Ideal.span ({q} : Set A) := by
  obtain ⟨v, rfl⟩ := ha
  let J : Ideal A := Ideal.span ({q} : Set A)
  have hq : q ∈ J := Ideal.subset_span (Set.mem_singleton q)
  have hmul : ell * (v : A) ∈ J := by
    have heq : ell * (v : A) = -(q * b) := by
      linear_combination h
    rw [heq]
    exact J.neg_mem (J.mul_mem_right b hq)
  have hell : ell ∈ J := by
    have hh := J.mul_mem_right (↑v⁻¹ : A) hmul
    simpa [mul_assoc] using hh
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro x hx
    rcases hx with (rfl | rfl)
    · exact hell
    · exact hq
  · exact Ideal.span_mono (by simp)

/-- On a cubic chart where the coefficient of the quadratic equation is a
unit, the conic ideal is generated by its plane equation. -/
theorem conicIdeal_eq_span_linear_of_unit_quadratic_coefficient
    {A : Type u} [CommRing A] (ell q a b : A)
    (h : ell * a + q * b = 0) (hb : IsUnit b) :
    Ideal.span ({ell, q} : Set A) = Ideal.span ({ell} : Set A) := by
  obtain ⟨v, rfl⟩ := hb
  let J : Ideal A := Ideal.span ({ell} : Set A)
  have hell : ell ∈ J := Ideal.subset_span (Set.mem_singleton ell)
  have hmul : q * (v : A) ∈ J := by
    have heq : q * (v : A) = -(ell * a) := by
      linear_combination h
    rw [heq]
    exact J.neg_mem (J.mul_mem_right a hell)
  have hq : q ∈ J := by
    have hh := J.mul_mem_right (↑v⁻¹ : A) hmul
    simpa [mul_assoc] using hh
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro x hx
    rcases hx with (rfl | rfl)
    · exact hell
    · exact hq
  · exact Ideal.span_mono (by simp)

/-- A two-generator conic quotient has a regular-principal kernel on a
chart where one coefficient in the cubic relation is a unit and the other
generator is regular. -/
theorem conicChart_regularPrincipal_of_unit_coefficient
    {A B : Type u} [CommRing A] [CommRing B] (g : A →+* B)
    (ell q a b : A)
    (h : ell * a + q * b = 0)
    (hker : RingHom.ker g = Ideal.span ({ell, q} : Set A))
    (hunit : (IsUnit a ∧ IsRegular q) ∨ (IsUnit b ∧ IsRegular ell)) :
    ∃ z : A, IsRegular z ∧
      RingHom.ker g = Ideal.span ({z} : Set A) := by
  rcases hunit with ⟨ha, hq⟩ | ⟨hb, hell⟩
  · exact ⟨q, hq, hker.trans
      (conicIdeal_eq_span_quadratic_of_unit_linear_coefficient ell q a b h ha)⟩
  · exact ⟨ell, hell, hker.trans
      (conicIdeal_eq_span_linear_of_unit_quadratic_coefficient ell q a b h hb)⟩

end PfaffianDescent
