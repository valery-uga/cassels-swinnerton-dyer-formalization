import Mathlib.RingTheory.Ideal.Prime
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.Algebra.GroupWithZero.Associated
import Mathlib.Algebra.MvPolynomial.NoZeroDivisors
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Regular.Flat
import Mathlib.RingTheory.Regular.RegularSequence
import PfaffianDescent.HomogeneousProjection

/-!
# Algebraic criteria for Voisin's regular complete intersections

The generic-geometry argument will produce prime intermediate intersections
and sections avoiding them.  These elementary lemmas translate those outputs
into the exact `IsRelPrime` and non-zero-divisor hypotheses used by the
Koszul/Hilbert computations.
-/

namespace PfaffianDescent

open MvPolynomial
open RingTheory.Sequence

/-- Avoiding a prime ideal makes multiplication injective modulo that ideal. -/
theorem regular_mod_ideal_of_isPrime_not_mem
    {R : Type*} [CommRing R] (I : Ideal R) (hI : I.IsPrime)
    {f : R} (hf : f ∉ I) :
    ∀ x : R, f * x ∈ I → x ∈ I := by
  intro x hx
  exact (hI.mem_or_mem hx).resolve_left hf

/-- Passing from the polynomial ring to the cubic surface's coordinate ring
identifies the two-generator ideal `(p, q)` with the principal ideal
generated by the image of `q`.  Thus integrality of the intermediate
cubic--cubic curve can be checked in the coordinate ring. -/
theorem ideal_span_pair_isPrime_iff_quotient_mk_span_isPrime
    {R : Type*} [CommRing R] (p q : R) :
    (Ideal.span ({p, q} : Set R)).IsPrime ↔
      (Ideal.span ({Ideal.Quotient.mk (Ideal.span ({p} : Set R)) q} : Set
        (R ⧸ Ideal.span ({p} : Set R)))).IsPrime := by
  have hmap :
      (Ideal.span ({p, q} : Set R)).map
          (Ideal.Quotient.mk (Ideal.span ({p} : Set R))) =
        Ideal.span ({Ideal.Quotient.mk (Ideal.span ({p} : Set R)) q} : Set
          (R ⧸ Ideal.span ({p} : Set R))) := by
    rw [Ideal.map_span]
    ext x
    simp only [Set.image_pair]
    have hpzero : Ideal.Quotient.mk (Ideal.span ({p} : Set R)) p = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton p))
    rw [hpzero]
    simp
  constructor
  · intro h
    have hle : Ideal.span ({p} : Set R) ≤ Ideal.span ({p, q} : Set R) := by
      apply Ideal.span_mono
      simp
    rw [← hmap]
    exact Ideal.isPrime_map_quotientMk_of_isPrime hle
  · intro h
    have hcomap := h.comap (Ideal.Quotient.mk (Ideal.span ({p} : Set R)))
    rw [← hmap] at hcomap
    rw [Ideal.comap_map_quotientMk] at hcomap
    have hle : Ideal.span ({p} : Set R) ≤ Ideal.span ({p, q} : Set R) := by
      apply Ideal.span_mono
      simp
    simpa [sup_eq_right.mpr hle] using hcomap

/-- On an integral cubic surface, the intermediate ideal `(p, q)` is prime
exactly when the selected section is a prime element of the coordinate ring.
This is the form supplied by an irreducibility theorem for a member of the
linear system. -/
theorem ideal_span_pair_isPrime_iff_quotient_mk_prime
    {R : Type*} [CommRing R] (p q : R)
    (_hp : (Ideal.span ({p} : Set R)).IsPrime)
    (hq : q ∉ Ideal.span ({p} : Set R)) :
    (Ideal.span ({p, q} : Set R)).IsPrime ↔
      Prime (Ideal.Quotient.mk (Ideal.span ({p} : Set R)) q) := by
  let _ : IsDomain (R ⧸ Ideal.span ({p} : Set R)) :=
    (Ideal.Quotient.isDomain_iff_prime (Ideal.span ({p} : Set R))).mpr _hp
  have hq0 : Ideal.Quotient.mk (Ideal.span ({p} : Set R)) q ≠ 0 := by
    intro hzero
    exact hq (Ideal.Quotient.eq_zero_iff_mem.mp hzero)
  exact (ideal_span_pair_isPrime_iff_quotient_mk_span_isPrime p q).trans
    (Ideal.span_singleton_prime hq0)

/-- A prime selected section in the coordinate ring supplies the prime
intermediate ideal used by the first residual. -/
theorem ideal_span_pair_isPrime_of_quotient_mk_prime
    {R : Type*} [CommRing R] (p q : R)
    (hp : (Ideal.span ({p} : Set R)).IsPrime)
    (hqprime : Prime (Ideal.Quotient.mk (Ideal.span ({p} : Set R)) q)) :
    (Ideal.span ({p, q} : Set R)).IsPrime := by
  apply (ideal_span_pair_isPrime_iff_quotient_mk_prime p q hp ?_).mpr hqprime
  intro hq
  apply hqprime.ne_zero
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hq

/-- Regularity of the second equation modulo the first implies the relative
primality condition used by the two-step Koszul complex.  This formulation
does not require the first equation itself to be prime. -/
theorem isRelPrime_of_regular_mod_span_singleton
    {R : Type*} [CommRing R] [IsDomain R] {f g : R}
    (hf : f ≠ 0)
    (hregular : ∀ x : R, g * x ∈ Ideal.span ({f} : Set R) →
      x ∈ Ideal.span ({f} : Set R)) :
    IsRelPrime f g := by
  intro d hdf hdg
  obtain ⟨a, hfa⟩ := hdf
  obtain ⟨b, hgb⟩ := hdg
  have ha0 : a ≠ 0 := by
    intro ha
    apply hf
    rw [hfa, ha, mul_zero]
  have hga : g * a ∈ Ideal.span ({f} : Set R) := by
    rw [Ideal.mem_span_singleton]
    refine ⟨b, ?_⟩
    rw [hfa, hgb]
    ac_rfl
  have haMem := hregular a hga
  rw [Ideal.mem_span_singleton] at haMem
  obtain ⟨r, har⟩ := haMem
  apply isUnit_iff_dvd_one.mpr
  refine ⟨r, ?_⟩
  apply mul_left_cancel₀ ha0
  calc
    a * 1 = a := mul_one a
    _ = f * r := har
    _ = (d * a) * r := by rw [hfa]
    _ = a * (d * r) := by ac_rfl

/-- Relatively prime equations make the second equation a
non-zero-divisor modulo the first.  Together with the converse above, this
identifies the two-generator Koszul hypothesis with the usual sequential
regularity condition. -/
theorem regular_mod_span_singleton_of_isRelPrime
    {R : Type*} [CommRing R] [DecompositionMonoid R] {f g : R}
    (hrel : IsRelPrime f g) :
    ∀ x : R, g * x ∈ Ideal.span ({f} : Set R) →
      x ∈ Ideal.span ({f} : Set R) := by
  intro x hx
  rw [Ideal.mem_span_singleton] at hx ⊢
  exact hrel.dvd_of_dvd_mul_left hx

/-- If multiplication by the second equation is injective modulo the
first, then the second equation cannot vanish when the first is not a unit. -/
theorem right_ne_zero_of_regular_mod_span_singleton
    {R : Type*} [CommRing R] {f g : R}
    (hf : ¬ IsUnit f)
    (hregular : ∀ x : R, g * x ∈ Ideal.span ({f} : Set R) →
      x ∈ Ideal.span ({f} : Set R)) :
    g ≠ 0 := by
  intro hg
  have h1 : (1 : R) ∈ Ideal.span ({f} : Set R) := by
    apply hregular 1
    simp [hg]
  apply hf
  exact isUnit_iff_dvd_one.mpr (Ideal.mem_span_singleton.mp h1)

/-- A polynomial not divisible by a prime polynomial is relatively prime to
it, in the divisor-theoretic sense required by the Koszul exactness proof. -/
theorem isRelPrime_of_prime_not_dvd
    {K σ : Type*} [Field K]
    {f g : MvPolynomial σ K} (hf : Prime f) (hg : ¬f ∣ g) :
    IsRelPrime f g :=
  hf.irreducible.isRelPrime_iff_not_dvd.mpr hg

/-- A nonzero homogeneous form of smaller degree cannot be divisible by a
prime homogeneous form.  This supplies the first regular quadric in
Voisin's cubic--quadric complete intersection once the cubic is prime. -/
theorem isRelPrime_of_prime_homogeneous_degree_lt
    {K σ : Type*} [Field K] {f g : MvPolynomial σ K} {d e : ℕ}
    (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous e)
    (hfprime : Prime f) (hg0 : g ≠ 0) (hdeg : e < d) :
    IsRelPrime f g := by
  apply isRelPrime_of_prime_not_dvd hfprime
  intro hdiv
  obtain ⟨q, hq⟩ := hdiv
  have hq0 : q ≠ 0 := by
    intro hq0
    apply hg0
    rw [hq, hq0, mul_zero]
  have hfd : f.totalDegree = d := hf.totalDegree hfprime.ne_zero
  have hgd : g.totalDegree = e := hg.totalDegree hg0
  have hmul : (f * q).totalDegree = f.totalDegree + q.totalDegree :=
    totalDegree_mul_of_isDomain hfprime.ne_zero hq0
  have hde : e = d + q.totalDegree := by
    calc
      e = g.totalDegree := hgd.symm
      _ = (f * q).totalDegree := by rw [hq]
      _ = f.totalDegree + q.totalDegree := hmul
      _ = d + q.totalDegree := by rw [hfd]
  omega

/-- In a homogeneous ideal generated by forms of degrees `d + 1` and `d`,
every degree-`d` form is a scalar multiple of the second generator.  The
higher-degree generator cannot contribute to that graded component. -/
theorem homogeneous_mem_span_succ_degree_pair_eq_smul
    {K σ : Type*} [Field K] {p q r : MvPolynomial σ K} {d : ℕ}
    (hp : p.IsHomogeneous (d + 1)) (hq : q.IsHomogeneous d)
    (hr : r.IsHomogeneous d)
    (hmem : r ∈ Ideal.span ({p, q} : Set (MvPolynomial σ K))) :
    ∃ a : K, r = a • q := by
  obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp hmem
  have hu : homogeneousComponent d (u * p) = 0 := by
    exact homogeneousComponent_mul_right_of_lt hp (by omega)
  have hv : homogeneousComponent d (v * q) = C (coeff 0 v) * q := by
    have hcomp := homogeneousComponent_mul_right (p := v) hq 0
    simpa using hcomp
  have hleft := congrArg (homogeneousComponent d) huv
  rw [map_add, hu, hv, zero_add, homogeneousComponent_eq_self hr] at hleft
  exact ⟨coeff 0 v, by simpa only [smul_eq_C_mul] using hleft.symm⟩

/-- Two nonzero homogeneous polynomials of the same degree cannot properly
divide one another: the quotient is a scalar. -/
theorem homogeneous_dvd_same_degree_eq_smul
    {K σ : Type*} [Field K] {f g : MvPolynomial σ K} {d : ℕ}
    (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous d)
    (hf0 : f ≠ 0) (hg0 : g ≠ 0) (hdiv : f ∣ g) :
    ∃ a : K, g = a • f := by
  obtain ⟨q, rfl⟩ := hdiv
  have hq0 : q ≠ 0 := by
    intro hq
    apply hg0
    rw [hq, mul_zero]
  have hfd : f.totalDegree = d := hf.totalDegree hf0
  have hgd : (f * q).totalDegree = d := hg.totalDegree (mul_ne_zero hf0 hq0)
  have hmul : (f * q).totalDegree = f.totalDegree + q.totalDegree :=
    totalDegree_mul_of_isDomain hf0 hq0
  have hqdeg : q.totalDegree = 0 := by omega
  obtain ⟨a, ha⟩ : ∃ a : K, q = C a :=
    ⟨_, (totalDegree_eq_zero_iff_eq_C (p := q)).mp hqdeg⟩
  refine ⟨a, ?_⟩
  rw [ha, smul_eq_C_mul, mul_comm]

/- A positive-degree homogeneous form cannot be a unit: evaluation at the
   origin sends it to zero, whereas a unit must map to a unit. -/
theorem homogeneous_not_isUnit_of_pos_degree
    {K σ : Type*} [Field K] {f : MvPolynomial σ K} {d : ℕ}
    (hf : f.IsHomogeneous d) (hd : 0 < d) : ¬ IsUnit f := by
  intro hunit
  obtain ⟨a, ha⟩ := isUnit_iff_dvd_one.mp hunit
  have hzeroCoeff : MvPolynomial.coeff 0 f = 0 :=
    hf.coeff_eq_zero (d := (0 : σ →₀ ℕ)) (by
      simpa using (Nat.ne_of_gt hd).symm)
  have hzeroEval : MvPolynomial.eval₂Hom (RingHom.id K)
      (0 : σ → K) f = 0 := by
    rw [MvPolynomial.eval₂Hom_zero_apply, MvPolynomial.constantCoeff_eq,
      hzeroCoeff]
    rfl
  have he := congrArg (MvPolynomial.eval₂Hom (RingHom.id K)
    (0 : σ → K)) ha
  rw [map_mul, hzeroEval, zero_mul] at he
  simpa using he

/-- A section relatively prime to a positive-degree homogeneous equation is
nonzero.  This discharges the apparently separate nonvanishing condition in
the complete-intersection residual construction. -/
theorem isRelPrime_right_ne_zero_of_left_homogeneous_pos_degree
    {K σ : Type*} [Field K] {f g : MvPolynomial σ K} {d : ℕ}
    (hf : f.IsHomogeneous d) (hd : 0 < d) (hrel : IsRelPrime f g) : g ≠ 0 := by
  intro hg
  apply homogeneous_not_isUnit_of_pos_degree hf hd
  rw [hg] at hrel
  exact isRelPrime_zero_right.mp hrel

/-- For homogeneous forms of the same positive-dimensional linear system,
linear independence from a prime form is enough for relative primality. -/
theorem isRelPrime_homogeneous_of_prime_of_not_smul
    {K σ : Type*} [Field K] {f g : MvPolynomial σ K} {d : ℕ}
    (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous d)
    (hfprime : Prime f) (hg0 : g ≠ 0)
    (hindependent : ∀ a : K, g ≠ a • f) :
    IsRelPrime f g := by
  apply isRelPrime_of_prime_not_dvd hfprime
  intro hdiv
  obtain ⟨a, ha⟩ := homogeneous_dvd_same_degree_eq_smul
    hf hg hfprime.ne_zero hg0 hdiv
  exact hindependent a ha

/-- Prime intermediate intersection plus avoidance of the third equation is
the concrete regularity hypothesis used for a three-equation complete
intersection. -/
theorem third_equation_regular_of_span_isPrime
    {R : Type*} [CommRing R] (f g h : R)
    (hprime : (Ideal.span ({f, g} : Set R)).IsPrime)
    (havoid : h ∉ Ideal.span ({f, g} : Set R)) :
    ∀ x : R, h * x ∈ Ideal.span ({f, g} : Set R) →
      x ∈ Ideal.span ({f, g} : Set R) :=
  regular_mod_ideal_of_isPrime_not_mem
    (Ideal.span ({f, g} : Set R)) hprime havoid

/-- A prime positive-degree homogeneous equation and a relatively-prime
positive-degree homogeneous equation form a regular sequence in the
polynomial ring.  This is the exact complete-intersection hypothesis behind a
smooth cubic--quadric intersection; the separate unmixedness consequence
still requires commutative-algebra input not currently packaged in Mathlib. -/
theorem homogeneous_pair_isRegular_of_prime_of_isRelPrime
    {K : Type*} [Field K] {f g : MvPolynomial (Fin 4) K} {d e : ℕ}
    (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous e)
    (hd : 0 < d) (he : 0 < e) (hfprime : Prime f)
    (hrel : IsRelPrime f g) :
    IsRegular (MvPolynomial (Fin 4) K) [f, g] := by
  refine ⟨?_, ?_⟩
  · rw [isWeaklyRegular_iff_Fin]
    intro i
    fin_cases i
    · rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
      intro x hx
      have hzero : f * x = 0 := by
        simpa [Ideal.ofList_nil] using hx
      have hxzero : x = 0 := (mul_eq_zero.mp hzero).resolve_left hfprime.ne_zero
      simpa [Ideal.ofList_nil] using hxzero
    · simp only [List.take, List.length_cons, List.length_nil, Nat.zero_add]
      have hspan :
          Ideal.ofList [f] • (⊤ : Submodule (MvPolynomial (Fin 4) K)
            (MvPolynomial (Fin 4) K)) = Ideal.span ({f} : Set (MvPolynomial (Fin 4) K)) := by
        rw [Ideal.ofList_singleton]
        simpa using (Ideal.smul_top_eq_map (S := MvPolynomial (Fin 4) K)
          (Ideal.span ({f} : Set (MvPolynomial (Fin 4) K))))
      let e' := Submodule.quotEquivOfEq _ _ hspan
      exact (e'.isSMulRegular_congr g).mpr
        ((isSMulRegular_quotient_iff_mem_of_smul_mem
          (Ideal.span ({f} : Set (MvPolynomial (Fin 4) K))) g).mpr
          (regular_mod_ideal_of_isPrime_not_mem _
            ((Ideal.span_singleton_prime hfprime.ne_zero).mpr hfprime) (by
              intro hgf
              have hdiv : f ∣ g := Ideal.mem_span_singleton.mp hgf
              have hunit : IsUnit f := hrel dvd_rfl hdiv
              exact (homogeneous_not_isUnit_of_pos_degree hf hd) hunit)))
  · intro htop
    have hspan :
        Ideal.ofList [f, g] • (⊤ : Submodule (MvPolynomial (Fin 4) K)
          (MvPolynomial (Fin 4) K)) = Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) := by
      have heq : Ideal.ofList [f, g] =
          Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) := by
        apply congrArg Ideal.span
        ext r
        simp
      rw [heq]
      simpa using (Ideal.smul_top_eq_map (S := MvPolynomial (Fin 4) K)
        (Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K))))
    have hunit : (1 : MvPolynomial (Fin 4) K) ∈
        Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) := by
      rw [← hspan, ← htop]
      exact Submodule.mem_top
    have hker : Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) ≤
        RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin 4) K →+* K) := by
      apply Ideal.span_le.mpr
      intro r hr
      have hfg : r = f ∨ r = g := by simpa using hr
      rcases hfg with hrf | hrg
      · rw [hrf]
        change MvPolynomial.coeff 0 f = 0
        exact hf.coeff_eq_zero (d := (0 : Fin 4 →₀ ℕ)) (by
          simpa using (Nat.ne_of_gt hd).symm)
      · rw [hrg]
        change MvPolynomial.coeff 0 g = 0
        exact hg.coeff_eq_zero (d := (0 : Fin 4 →₀ ℕ)) (by
          simpa using (Nat.ne_of_gt he).symm)
    have hzero := hker hunit
    change MvPolynomial.constantCoeff (1 : MvPolynomial (Fin 4) K) = 0 at hzero
    have : (1 : K) = 0 := by simpa using hzero
    exact one_ne_zero this

/-- The cubic--quadric specialization of
`homogeneous_pair_isRegular_of_prime_of_isRelPrime`.  This is the form used
for the selected first quadric on a smooth cubic surface. -/
theorem cubic_quadric_isRegular_of_prime_of_isRelPrime
    {K : Type*} [Field K] (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (hpprime : Prime p) (hrel : IsRelPrime p q) :
    IsRegular (MvPolynomial (Fin 4) K) [p, q] :=
  homogeneous_pair_isRegular_of_prime_of_isRelPrime hp hq (by norm_num)
    (by norm_num) hpprime hrel

/-- The cubic--quadric complete intersection remains a regular sequence after
localizing at any prime component containing it.  This is the local form
needed to connect the selected intersection to regular-local-ring arguments. -/
theorem cubic_quadric_isRegular_atPrime_of_prime_of_isRelPrime
    {K : Type*} [Field K] (p q : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 2)
    (hpprime : Prime p) (hrel : IsRelPrime p q)
    (P : Ideal (MvPolynomial (Fin 4) K)) [P.IsPrime]
    (hspan : Ideal.span ({p, q} : Set (MvPolynomial (Fin 4) K)) ≤ P) :
    IsRegular (Localization.AtPrime P)
      [algebraMap (MvPolynomial (Fin 4) K) (Localization.AtPrime P) p,
        algebraMap (MvPolynomial (Fin 4) K) (Localization.AtPrime P) q] := by
  apply IsWeaklyRegular.isRegular_of_isLocalization_of_mem
    (S := Localization.AtPrime P) P
    (cubic_quadric_isRegular_of_prime_of_isRelPrime p q hp hq hpprime hrel).toIsWeaklyRegular
  intro r hr
  have hr' : r = p ∨ r = q := by simpa using hr
  rcases hr' with rfl | rfl
  · exact hspan (Ideal.subset_span (by simp))
  · exact hspan (Ideal.subset_span (by simp))

end PfaffianDescent
