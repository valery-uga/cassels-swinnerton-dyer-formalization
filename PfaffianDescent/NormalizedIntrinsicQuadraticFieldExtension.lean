import PfaffianDescent.HomogeneousEvaluationFieldExtension
import PfaffianDescent.IntrinsicQuadraticCoordinatePermutation
import AllCharacteristics.ProjectiveBaseChange

/-! Formation of the full intrinsic quadratic series and base scheme for
an actual normalized finite point, under arbitrary extension of fields.
No reducedness, radical ideal, or full-system comparison premise occurs. -/

noncomputable section
namespace PfaffianDescent
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial Module
open AllCharacteristics.HomogeneousProjective
open scoped TensorProduct
universe u
variable {k K A : Type u} [Field k] [Field K] [CommRing A]
  [Algebra k K] [Algebra k A] [Module.Finite k A]
attribute [local instance] MvPolynomial.gradedAlgebra

theorem ambientNormalizedCoordinateChartPoint_intrinsicQuadratics_fieldExtension
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    intrinsicFullQuadraticSystem (ambientNormalizedCoordinateChartPoint
      (F := K) (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx)) =
      homogeneousPolynomialCoefficientSpan (K := K)
        (intrinsicFullQuadraticSystem (ambientNormalizedCoordinateChartPoint (F := k) x j hx)) := by
  rw [ambientNormalizedCoordinateChartPoint_intrinsicQuadratics,
    ambientNormalizedCoordinateChartPoint_intrinsicQuadratics]
  exact homogeneousVanishingPolynomialSubmodule_fieldExtension x 2

/-- Taking the ideal generated by the entire scalar-extended submodule
equals scalar extension of its original ideal. -/
theorem ideal_span_homogeneousPolynomialCoefficientSpan
    (W : Submodule k (MvPolynomial (Fin 4) k)) :
    Ideal.span (homogeneousPolynomialCoefficientSpan (K := K) W :
        Set (MvPolynomial (Fin 4) K)) =
      (Ideal.span (W : Set (MvPolynomial (Fin 4) k))).map
        (MvPolynomial.map (algebraMap k K)) := by
  rw [Ideal.map_span]
  change Ideal.span (Submodule.span K
    (MvPolynomial.map (algebraMap k K) '' (W : Set (MvPolynomial (Fin 4) k))) :
      Set (MvPolynomial (Fin 4) K)) = _
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro p hp
    let J := Ideal.span (MvPolynomial.map (algebraMap k K) ''
      (W : Set (MvPolynomial (Fin 4) k)))
    have hle : Submodule.span K (MvPolynomial.map (algebraMap k K) ''
        (W : Set (MvPolynomial (Fin 4) k))) ≤
        J.restrictScalars K := by
      apply Submodule.span_le.mpr
      intro q hq
      exact Ideal.subset_span hq
    exact hle hp
  · apply Ideal.span_le.mpr
    intro p hp
    exact Ideal.subset_span (Submodule.subset_span hp)

theorem ambientNormalizedCoordinateChartPoint_intrinsicFullBaseIdeal_fieldExtension
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    (intrinsicFullQuadraticBaseIdeal (ambientNormalizedCoordinateChartPoint
      (F := K) (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx))).toIdeal =
      (intrinsicFullQuadraticBaseIdeal (ambientNormalizedCoordinateChartPoint (F := k) x j hx)).toIdeal.map
        (MvPolynomial.map (algebraMap k K)) := by
  change Ideal.span (intrinsicFullQuadraticSystem
    (ambientNormalizedCoordinateChartPoint (F := K)
      (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx)) :
        Set (MvPolynomial (Fin 4) K)) = _
  rw [ambientNormalizedCoordinateChartPoint_intrinsicQuadratics_fieldExtension]
  exact ideal_span_homogeneousPolynomialCoefficientSpan _

/-- Equality of the WHOLE homogeneous base ideals, not their radicals. -/
theorem ambientNormalizedCoordinateChartPoint_intrinsicFullBase_fieldExtension
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    intrinsicFullQuadraticBaseIdeal (ambientNormalizedCoordinateChartPoint
      (F := K) (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx)) =
      HomogeneousIdeal.map (ambientCoefficientGradedRingHom (algebraMap k K))
        (intrinsicFullQuadraticBaseIdeal (ambientNormalizedCoordinateChartPoint (F := k) x j hx)) := by
  apply HomogeneousIdeal.ext
  exact ambientNormalizedCoordinateChartPoint_intrinsicFullBaseIdeal_fieldExtension x j hx

/-- The full new base scheme is the ACTUAL categorical base change of the
original full base scheme, including all nilpotents. -/
def normalizedIntrinsicFullQuadraticBaseFieldExtensionIso
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    scheme (intrinsicFullQuadraticBaseIdeal (ambientNormalizedCoordinateChartPoint
      (F := K) (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx))) ≅
      pullback (toBase (intrinsicFullQuadraticBaseIdeal
        (ambientNormalizedCoordinateChartPoint (F := k) x j hx)))
        (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
  projectiveBaseChangeIso (algebraMap k K) _ _
    (ambientNormalizedCoordinateChartPoint_intrinsicFullBaseIdeal_fieldExtension x j hx).symm

theorem normalizedIntrinsicFullQuadraticBaseFieldExtensionIso_hom_toField
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    (normalizedIntrinsicFullQuadraticBaseFieldExtensionIso (K := K) x j hx).hom ≫
      pullback.snd _ _ = toBase (intrinsicFullQuadraticBaseIdeal
        (ambientNormalizedCoordinateChartPoint (F := K)
          (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx))) :=
  projectiveBaseChangeIso_hom_snd _ _ _ _

theorem normalizedIntrinsicFullQuadraticBaseFieldExtensionIso_hom_ambient
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    (normalizedIntrinsicFullQuadraticBaseFieldExtensionIso (K := K) x j hx).hom ≫
      pullback.fst _ _ ≫ quotientProjMap
        (intrinsicFullQuadraticBaseIdeal (ambientNormalizedCoordinateChartPoint (F := k) x j hx)) =
      quotientProjMap (intrinsicFullQuadraticBaseIdeal
        (ambientNormalizedCoordinateChartPoint (F := K)
          (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx))) ≫
        ambientCoefficientMap (algebraMap k K) := by
  rw [normalizedIntrinsicFullQuadraticBaseFieldExtensionIso, ← Category.assoc,
    projectiveBaseChangeIso_hom_fst]
  exact projectiveCoefficientMap_comp_quotientProjMap _ _ _ _

theorem ambientNormalizedCoordinateChartPoint_intrinsicQuadratics_fieldExtension_finrank
    (x : Fin 4 → A) (j : Fin 4) (hx : x j = 1) :
    finrank K (intrinsicFullQuadraticSystem (ambientNormalizedCoordinateChartPoint
      (F := K) (fun r => (1 : K) ⊗ₜ[k] x r) j (tensor_coordinate_eq_one x j hx))) =
      finrank k (intrinsicFullQuadraticSystem (ambientNormalizedCoordinateChartPoint (F := k) x j hx)) := by
  rw [ambientNormalizedCoordinateChartPoint_intrinsicQuadratics,
    ambientNormalizedCoordinateChartPoint_intrinsicQuadratics]
  exact homogeneousVanishingPolynomialSubmodule_fieldExtension_finrank x 2

end PfaffianDescent
