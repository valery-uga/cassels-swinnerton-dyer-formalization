import PfaffianDescent.FiniteProjectiveStandardChartAlgebra
import PfaffianDescent.IntrinsicQuadraticChosenChartKernel
import PfaffianDescent.HomogeneousFourChartKernelFieldExtension
import AllCharacteristics.AmbientProjectiveBaseChange

/-! Actual restriction to each standard chart of an arbitrary finite closed
projective subscheme. The target is its TRUE affine-open section ring, with
nilpotents retained. Its product kernel describes the entire intrinsic
quadratic system, without a globally avoiding ground linear form. -/

noncomputable section
namespace PfaffianDescent
open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization
open AllCharacteristics.HomogeneousProjective
universe u
variable {k : Type u} [Field k]
attribute [local instance] MvPolynomial.gradedAlgebra
set_option backward.isDefEq.respectTransparency false

/-- No presentation of the source is chosen: this map is the actual scheme
section map followed by the canonical restriction-open top Iso. -/
def finiteProjectiveStandardChartPolynomialRestriction
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k)) (j : Fin 4) :
    MvPolynomial (Fin 4) k →+* Γ(finiteProjectiveStandardChart i j, ⊤) :=
  (finiteProjectiveStandardChartOpen i j).topIso.inv.hom.comp
    ((i.app (intrinsicQuadraticAmbientOpen (K := k) j).1).hom.comp
      ((Proj.awayToSection (homogeneousSubmodule (Fin 4) k) (X j)).hom.comp
        (ambientChartEvaluation j)))

theorem finiteProjectiveStandardChartPolynomialRestriction_zero_iff
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k)) [QuasiCompact i]
    (j : Fin 4) (p : MvPolynomial (Fin 4) k) :
    finiteProjectiveStandardChartPolynomialRestriction i j p = 0 ↔
      p ∈ intrinsicQuadraticChartIdeal i j := by
  let U := intrinsicQuadraticAmbientOpen (K := k) j
  let V := finiteProjectiveStandardChartOpen i j
  change V.topIso.inv (i.app U.1
    (Proj.awayToSection (homogeneousSubmodule (Fin 4) k) (X j)
      (ambientChartEvaluation j p))) = 0 ↔ _
  unfold intrinsicQuadraticChartIdeal
  change V.topIso.inv (i.app U.1
    (Proj.awayToSection (homogeneousSubmodule (Fin 4) k) (X j)
      (ambientChartEvaluation j p))) = 0 ↔
    Proj.awayToSection (homogeneousSubmodule (Fin 4) k) (X j)
      (ambientChartEvaluation j p) ∈ i.ker.ideal U
  rw [i.ker_apply U]
  exact map_eq_zero_iff V.topIso.inv.hom
    (ConcreteCategory.bijective_of_isIso V.topIso.inv).1

/-- The full intrinsic restriction is the joint kernel of the FOUR ACTUAL
affine chart evaluations, not a condition on the reduced point set. -/
theorem mem_intrinsicFullQuadraticSystem_iff_four_actual_chart_restrictions
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k)) [QuasiCompact i]
    (p : MvPolynomial (Fin 4) k) :
    p ∈ intrinsicFullQuadraticSystem i ↔
      p.IsHomogeneous 2 ∧
        ∀ j : Fin 4, finiteProjectiveStandardChartPolynomialRestriction i j p = 0 := by
  constructor
  · intro hp
    refine ⟨hp.1, ?_⟩
    intro j
    apply (finiteProjectiveStandardChartPolynomialRestriction_zero_iff i j p).mpr
    exact ((Submodule.mem_iInf _).mp hp.2) j
  · rintro ⟨hhom, hzero⟩
    refine ⟨hhom, ?_⟩
    apply (Submodule.mem_iInf _).mpr
    intro j
    exact (finiteProjectiveStandardChartPolynomialRestriction_zero_iff i j p).mp (hzero j)

theorem finiteProjectiveStandardChartPolynomialRestriction_coordinate_one
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k)) (j : Fin 4) :
    finiteProjectiveStandardChartPolynomialRestriction i j (X j) = 1 := by
  change (finiteProjectiveStandardChartOpen i j).topIso.inv.hom
    ((i.app (intrinsicQuadraticAmbientOpen (K := k) j).1).hom
      ((Proj.awayToSection (homogeneousSubmodule (Fin 4) k) (X j)).hom
        (ambientChartEvaluation j (X j)))) = 1
  simp only [ambientChartEvaluation, eval₂Hom_X', ambientChartCoordinate_self,
    map_one]

/-- This evaluator is generated by its actual constants and coordinates.
Compatibility of these constants with the finite-scheme coefficient algebra
is a distinct scalar-structure lemma, not assumed here. -/
theorem finiteProjectiveStandardChartPolynomialRestriction_eq_eval
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k)) (j : Fin 4) :
    finiteProjectiveStandardChartPolynomialRestriction i j =
      eval₂Hom ((finiteProjectiveStandardChartPolynomialRestriction i j).comp C)
        (fun r => finiteProjectiveStandardChartPolynomialRestriction i j (X r)) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simp only [RingHom.comp_apply, eval₂Hom_C]
  · intro r
    simp only [eval₂Hom_X']

/-- The constants of the actual chart restriction are the ACTUAL coefficient
map induced by its finite structural morphism. This is derived using affine
reconstruction and the original morphism's section map. -/
theorem finiteProjectiveStandardChartPolynomialRestriction_coefficients
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k))
    [IsFinite (i ≫ ambientToBase)] (j : Fin 4) :
    letI := finiteProjectiveStandardChartCoefficientAlgebra i j
    (finiteProjectiveStandardChartPolynomialRestriction i j).comp C =
      algebraMap k Γ(finiteProjectiveStandardChart i j, ⊤) := by
  let U := intrinsicQuadraticAmbientOpen (K := k) j
  let V := finiteProjectiveStandardChartOpen i j
  let t := finiteProjectiveStandardChartToBase i j
  letI : IsFinite t := finiteProjectiveStandardChartToBase_isFinite i j
  letI : IsAffineHom t := (finiteProjectiveStandardChartToBase_isFinite i j).toIsAffineHom
  letI : IsAffine (finiteProjectiveStandardChart i j) := isAffine_of_isAffineHom t
  letI : IsAffine V := by
    change IsAffine (finiteProjectiveStandardChart i j)
    exact isAffine_of_isAffineHom t
  let hV : IsAffineOpen V := inferInstanceAs (IsAffine V)
  letI := finiteProjectiveStandardChartCoefficientAlgebra i j
  let ev := Proj.awayToSection (homogeneousSubmodule (Fin 4) k) (X j)
  let b := AllCharacteristics.GradedChart.baseMap
    (homogeneousSubmodule (Fin 4) k) (z := X j)
  have hUb : Spec.map (CommRingCat.ofHom (ev.hom.comp b)) =
      U.2.fromSpec ≫ ambientToBase (R := k) := by
    calc
      Spec.map (CommRingCat.ofHom (ev.hom.comp b)) =
          Spec.map ev ≫ Spec.map (CommRingCat.ofHom b) := by rw [← Spec.map_comp]; rfl
      _ = Spec.map ev ≫
          (Proj.awayι (homogeneousSubmodule (Fin 4) k) (X j)
            (isHomogeneous_X k j) (by decide : 0 < 1) ≫ ambientToBase (R := k)) := by
        rw [ambientCoordinateChart_toBase]
      _ = _ := by
        rw [← Category.assoc, ambientCoordinateChart_fromSpec]
  have hR : CommRingCat.ofHom ((finiteProjectiveStandardChartPolynomialRestriction i j).comp C) =
      CommRingCat.ofHom (ev.hom.comp b) ≫ i.app U.1 ≫ V.topIso.inv := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    change V.topIso.inv (i.app U.1 (ev (ambientChartEvaluation j (C c)))) =
      V.topIso.inv (i.app U.1 (ev (b c)))
    rw [ambientChartEvaluation, eval₂Hom_C]
  have hSpec : Spec.map (CommRingCat.ofHom
      ((finiteProjectiveStandardChartPolynomialRestriction i j).comp C)) =
      Spec.map (CommRingCat.ofHom
        (algebraMap k Γ(finiteProjectiveStandardChart i j, ⊤))) := by
    calc
      Spec.map (CommRingCat.ofHom
          ((finiteProjectiveStandardChartPolynomialRestriction i j).comp C)) =
          Spec.map V.topIso.inv ≫ Spec.map (i.app U.1) ≫ U.2.fromSpec ≫ ambientToBase := by
        erw [hR, Spec.map_comp, Spec.map_comp]
        simp only [Category.assoc]
        erw [hUb]
      _ = Spec.map V.topIso.inv ≫ hV.fromSpec ≫ i ≫ ambientToBase := by
        have hApp : Spec.map (i.app U.1) ≫ U.2.fromSpec = hV.fromSpec ≫ i := by
          rw [Scheme.Hom.app_eq_appLE]
          change Spec.map (i.appLE U.1 V le_rfl) ≫ U.2.fromSpec = _
          exact IsAffineOpen.SpecMap_appLE_fromSpec i U.2 hV le_rfl
        simpa only [Category.assoc] using
          congrArg (fun f => Spec.map V.topIso.inv ≫ f ≫ ambientToBase) hApp
      _ = V.toScheme.isoSpec.inv ≫ t := by
        simp only [IsAffineOpen.fromSpec, IsAffineOpen.isoSpec_inv, Category.assoc]
        change Spec.map V.topIso.inv ≫ Spec.map V.topIso.hom ≫
          V.toScheme.isoSpec.inv ≫ V.ι ≫ i ≫ ambientToBase = _
        rw [← Spec.map_comp_assoc, Iso.hom_inv_id, Spec.map_id, Category.id_comp]
        rfl
      _ = Spec.map (CommRingCat.ofHom (algebraMap k Γ(finiteProjectiveStandardChart i j, ⊤))) :=
        (finiteSchemeCoefficient_spec t).symm
  exact congrArg CommRingCat.Hom.hom (Spec.map_injective hSpec)

def finiteProjectiveStandardChartRestrictionAlgHom
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k))
    [IsFinite (i ≫ ambientToBase)] (j : Fin 4) :
    letI := finiteProjectiveStandardChartCoefficientAlgebra i j
    MvPolynomial (Fin 4) k →ₐ[k] Γ(finiteProjectiveStandardChart i j, ⊤) := by
  letI := finiteProjectiveStandardChartCoefficientAlgebra i j
  refine { finiteProjectiveStandardChartPolynomialRestriction i j with commutes' := ?_ }
  intro c
  exact DFunLike.congr_fun
    (finiteProjectiveStandardChartPolynomialRestriction_coefficients i j) c

/-- On the ACTUAL four finite affine chart algebras, the intrinsic system
is their joint homogeneous evaluation kernel. All scalar structures and
section maps are derived internally from i. -/
theorem intrinsicFullQuadraticSystem_eq_actual_fourChartKernel
    {Z : Scheme.{u}}
    (i : Z ⟶ Proj (homogeneousSubmodule (Fin 4) k)) [IsClosedImmersion i]
    [IsFinite (i ≫ ambientToBase)] :
    let A : Fin 4 → Type u := fun j => Γ(finiteProjectiveStandardChart i j, ⊤)
    letI : ∀ j, Algebra k (A j) := fun j => finiteProjectiveStandardChartCoefficientAlgebra i j
    letI : ∀ j, Module.Finite k (A j) := fun j => finiteProjectiveStandardChart_coefficient_finite i j
    let x : ∀ j, Fin 4 → A j := fun j r => finiteProjectiveStandardChartPolynomialRestriction i j (X r)
    intrinsicFullQuadraticSystem i = homogeneousFourChartVanishingSystem A x 2 := by
  let A : Fin 4 → Type u := fun j => Γ(finiteProjectiveStandardChart i j, ⊤)
  letI : ∀ j, Algebra k (A j) := fun j => finiteProjectiveStandardChartCoefficientAlgebra i j
  letI : ∀ j, Module.Finite k (A j) := fun j => finiteProjectiveStandardChart_coefficient_finite i j
  let x : ∀ j, Fin 4 → A j := fun j r => finiteProjectiveStandardChartPolynomialRestriction i j (X r)
  have hev (j : Fin 4) (p : MvPolynomial (Fin 4) k) :
      aeval (R := k) (x j) p = finiteProjectiveStandardChartPolynomialRestriction i j p := by
    have h := finiteProjectiveStandardChartPolynomialRestriction_eq_eval i j
    rw [finiteProjectiveStandardChartPolynomialRestriction_coefficients i j] at h
    exact (DFunLike.congr_fun h p).symm
  ext p
  rw [mem_intrinsicFullQuadraticSystem_iff_four_actual_chart_restrictions]
  constructor
  · rintro ⟨hhom, hzero⟩
    apply (Submodule.mem_iInf _).mpr
    intro j
    apply (mem_homogeneousVanishingPolynomialSubmodule_iff _ 2 p).mpr
    exact ⟨hhom, (hev j p).trans (hzero j)⟩
  · intro hp
    have hall := (Submodule.mem_iInf _).mp hp
    refine ⟨((mem_homogeneousVanishingPolynomialSubmodule_iff _ 2 p).mp (hall 0)).1, ?_⟩
    intro j
    rw [← hev j p]
    exact ((mem_homogeneousVanishingPolynomialSubmodule_iff _ 2 p).mp (hall j)).2

end PfaffianDescent
