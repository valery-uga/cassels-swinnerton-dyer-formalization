import PfaffianDescent.QuarticNetKoszul
import PfaffianDescent.VoisinFiniteCoordinateSelection
import PfaffianDescent.VoisinDegreeEightFixedCurveSections
import PfaffianDescent.VoisinFlatIdealPieceBaseChange

/-!
# Quadratic equations of a cubic--quadric--quadric intersection

The degree-two part of the homogeneous ideal generated by a cubic and two
quadrics is precisely the scalar span of the two quadrics. This is the
algebraic kernel calculation for the proposed twelve-point witness route.
-/

namespace PfaffianDescent

open MvPolynomial
open AllCharacteristics.HomogeneousProjective

section

variable {K : Type*} [Field K]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- A quadratic polynomial in the ideal of a cubic and two quadrics is a
scalar linear combination of the two quadrics. -/
theorem quadratic_mem_cubic_two_quadric_ideal_iff_scalar_span
    (p q r s : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3)
    (hq : q.IsHomogeneous 2) (hr : r.IsHomogeneous 2)
    (hs : s.IsHomogeneous 2) :
    s ∈ Ideal.span ({p, q, r} : Set (MvPolynomial (Fin 4) K)) ↔
      ∃ a b : K, s = C a * q + C b * r := by
  constructor
  · intro hmem
    rw [← threeGeneratorLast_range] at hmem
    obtain ⟨⟨A, B, D⟩, hABC⟩ := hmem
    change p * A + q * B + r * D = s at hABC
    have hpterm : homogeneousComponent 2 (p * A) = 0 := by
      rw [mul_comm]
      exact homogeneousComponent_mul_right_of_lt hp (by decide)
    have hqterm : homogeneousComponent 2 (q * B) =
        q * C (coeff 0 B) := by
      simpa only [zero_add, homogeneousComponent_zero] using
        homogeneousComponent_mul_left hq 0
    have hrterm : homogeneousComponent 2 (r * D) =
        r * C (coeff 0 D) := by
      simpa only [zero_add, homogeneousComponent_zero] using
        homogeneousComponent_mul_left hr 0
    have hcomp := congrArg (homogeneousComponent 2) hABC
    rw [map_add, map_add, hpterm, zero_add, hqterm, hrterm,
      homogeneousComponent_eq_self hs] at hcomp
    exact ⟨coeff 0 B, coeff 0 D, by
      simpa only [mul_comm] using hcomp.symm⟩
  · rintro ⟨a, b, rfl⟩
    apply Ideal.add_mem
    · exact Ideal.mul_mem_left _ _
        (Ideal.subset_span (by simp : q ∈ ({p, q, r} :
          Set (MvPolynomial (Fin 4) K))))
    · exact Ideal.mul_mem_left _ _
        (Ideal.subset_span (by simp : r ∈ ({p, q, r} :
          Set (MvPolynomial (Fin 4) K))))

/-- For two independent defining quadrics, the degree-two piece of the
complete-intersection ideal has dimension exactly two. -/
theorem cubic_two_quadric_quadratic_ideal_finrank_eq_two
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3)
    (hq : q.IsHomogeneous 2) (hr : r.IsHomogeneous 2)
    (hqr : LinearIndependent K ![q, r]) :
    Module.finrank K
      (fixedCurveQuadraticPolynomialSystem
        (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr)) = 2 := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  let Q : Fin 2 → MvPolynomial (Fin 4) K := ![q, r]
  have hW : fixedCurveQuadraticPolynomialSystem I =
      Submodule.span K (Set.range Q) := by
    apply le_antisymm
    · intro s hs
      obtain ⟨hshom, hsideal⟩ :=
        (mem_fixedCurveQuadraticPolynomialSystem_iff I s).mp hs
      have hs' : s ∈ Ideal.span ({p, q, r} :
          Set (MvPolynomial (Fin 4) K)) := hsideal
      obtain ⟨a, b, hrep⟩ :=
        (quadratic_mem_cubic_two_quadric_ideal_iff_scalar_span
          p q r s hp hq hr hshom).mp hs'
      rw [hrep]
      apply Submodule.add_mem
      · simpa only [smul_eq_C_mul] using
          Submodule.smul_mem (Submodule.span K (Set.range Q)) a
            (Submodule.subset_span (show q ∈ Set.range Q from ⟨0, rfl⟩))
      · simpa only [smul_eq_C_mul] using
          Submodule.smul_mem (Submodule.span K (Set.range Q)) b
            (Submodule.subset_span (show r ∈ Set.range Q from ⟨1, rfl⟩))
    · apply Submodule.span_le.mpr
      rintro s ⟨i, rfl⟩
      fin_cases i
      · apply (mem_fixedCurveQuadraticPolynomialSystem_iff I q).mpr
        exact ⟨hq, Ideal.subset_span (by simp)⟩
      · apply (mem_fixedCurveQuadraticPolynomialSystem_iff I r).mpr
        exact ⟨hr, Ideal.subset_span (by simp)⟩
  rw [hW, finrank_span_eq_card hqr]
  norm_num

/-- The quadratic coordinate quotient of a cubic--quadric--quadric
intersection defined by independent quadrics has dimension eight. -/
theorem cubic_two_quadric_quadratic_quotient_finrank_eq_eight
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3)
    (hq : q.IsHomogeneous 2) (hr : r.IsHomogeneous 2)
    (hqr : LinearIndependent K ![q, r]) :
    Module.finrank K
      (grading (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr) 2) = 8 := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  have hpiece : Module.finrank K (homogeneousIdealPiece I 2) = 2 := by
    calc
      Module.finrank K (homogeneousIdealPiece I 2) =
          Module.finrank K (fixedCurveQuadraticPolynomialSystem I) :=
        (finrank_fixedCurveQuadraticPolynomialSystem I).symm
      _ = 2 := cubic_two_quadric_quadratic_ideal_finrank_eq_two
        p q r hp hq hr hqr
  have hcomplement := homogeneousIdealPiece_quadratic_finrank_eq_complement I
  rw [hpiece] at hcomplement
  change Module.finrank K (grading I 2) = 8
  omega

/-- If twelve reduced intersection-point evaluations detect the quadratic
coordinate quotient, eight of them already detect it. The quotient dimension
is derived from the cubic and the two independent quadrics. -/
theorem cubic_two_quadric_exists_eight_separating_intersection_coordinates
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3)
    (hq : q.IsHomogeneous 2) (hr : r.IsHomogeneous 2)
    (hqr : LinearIndependent K ![q, r])
    (E : grading (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr) 2 →ₗ[K]
      (Fin 12 → K))
    (hE : Function.Injective E) :
    ∃ (κ : Type) (a : κ → Fin 12) (inst : Fintype κ),
      Function.Injective a ∧
      @Fintype.card κ inst = 8 ∧
      ∀ v : grading (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr) 2,
        (∀ j : κ, (E v) (a j) = 0) → v = 0 := by
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  let H := homogeneousSubmodule (Fin 4) K 2
  let f := homogeneousIdealPieceQuotientMap I 2
  letI : FiniteDimensional K H :=
    (Submodule.fg_iff_finiteDimensional H).mp
      (MvPolynomial.homogeneousSubmodule_fg (Fin 4) K 2)
  letI : Module.Finite K (grading I 2) :=
    Module.Finite.of_surjective f
      (homogeneousIdealPieceQuotientMap_surjective I 2)
  exact exists_eight_separating_coordinates_of_injective_twelve_evaluation
    (cubic_two_quadric_quadratic_quotient_finrank_eq_eight
      p q r hp hq hr hqr) E hE

/-- From twelve evaluations that detect the quadratic coordinate quotient,
select eight for which evaluation of all ambient quadrics is surjective.
Their exact kernel is the pencil generated by the two defining quadrics.
This is the algebraic part of constructing one good eight-point
configuration from a reduced cubic--quadric--quadric intersection. -/
theorem cubic_two_quadric_exists_eight_evaluations_with_exact_pencil_kernel
    (p q r : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3)
    (hq : q.IsHomogeneous 2) (hr : r.IsHomogeneous 2)
    (hqr : LinearIndependent K ![q, r])
    (E : grading (tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr) 2 →ₗ[K]
      (Fin 12 → K))
    (hE : Function.Injective E) :
    let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
    let Q := homogeneousIdealPieceQuotientMap I 2
    ∃ (κ : Type) (a : κ → Fin 12) (inst : Fintype κ),
      Function.Injective a ∧ @Fintype.card κ inst = 8 ∧
      ∃ F : homogeneousSubmodule (Fin 4) K 2 →ₗ[K] (κ → K),
        (∀ s j, F s j = E (Q s) (a j)) ∧
        Function.Surjective F ∧
        ∀ s, F s = 0 ↔
          ∃ α β : K, s.1 = C α * q + C β * r := by
  dsimp only
  let I := tripleCompleteIntersectionHomogeneousIdeal p q r hp hq hr
  let Q := homogeneousIdealPieceQuotientMap I 2
  let V := homogeneousSubmodule (Fin 4) K 2
  let E' : V →ₗ[K] (Fin 12 → K) := E.comp Q
  have hker : LinearMap.ker E' = homogeneousIdealPiece I 2 := by
    calc
      LinearMap.ker E' = LinearMap.ker Q := by
        ext s
        simp only [LinearMap.mem_ker]
        constructor
        · intro hs
          exact hE (by simpa [E'] using hs)
        · intro hs
          simp [E', hs]
      _ = homogeneousIdealPiece I 2 := homogeneousIdealPieceQuotientMap_ker I 2
  have hkerDim : Module.finrank K (LinearMap.ker E') = 2 := by
    rw [hker]
    exact (finrank_fixedCurveQuadraticPolynomialSystem I).symm.trans
      (cubic_two_quadric_quadratic_ideal_finrank_eq_two
        p q r hp hq hr hqr)
  have hV : Module.finrank K V = 10 := by
    change Module.finrank K (homogeneousSubmodule (Fin 4) K 2) = 10
    rw [four_variable_homogeneous_finrank]
    decide
  letI : FiniteDimensional K V :=
    (Submodule.fg_iff_finiteDimensional V).mp
      (MvPolynomial.homogeneousSubmodule_fg (Fin 4) K 2)
  obtain ⟨κ, a, inst, ha, hcard, F, hF, hsurj, hFker⟩ :=
    exists_eight_surjective_coordinates_of_twelve_evaluation_with_two_kernel
      E' hV hkerDim
  refine ⟨κ, a, inst, ha, hcard, F, ?_, hsurj, ?_⟩
  · intro s j
    exact hF s j
  · intro s
    rw [← LinearMap.mem_ker, hFker, hker]
    change s.1 ∈ I.toIdeal ↔ _
    exact quadratic_mem_cubic_two_quadric_ideal_iff_scalar_span
      p q r s.1 hp hq hr s.property

end

end PfaffianDescent
