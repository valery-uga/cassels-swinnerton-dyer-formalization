import PfaffianDescent.CorayProjectiveEvaluationLinearForm
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.RingTheory.Ideal.Quotient.Operations

noncomputable section
namespace PfaffianDescent.Coray
open AlgebraicGeometry CategoryTheory MvPolynomial
open AllCharacteristics.HomogeneousProjective
universe u
attribute [local instance] MvPolynomial.gradedAlgebra
set_option autoImplicit false

/-- Package the ACTUAL original projective chart hom with its proved
original-K coefficient action, without choosing another field map. -/
def projectiveEvaluationChartAlgHom {K F : Type u} [Field K] [Field F] [Algebra K F]
    {σ : Type} (x : σ → F) (a : σ) (ha : x a ≠ 0) :
    letI : Algebra K (ChartRing (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a) :=
      (chartBaseMap (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a).toAlgebra
    ChartRing (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a →ₐ[K] F := by
  letI : Algebra K (ChartRing (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a) :=
    (chartBaseMap (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a).toAlgebra
  exact
    { toRingHom := projectiveEvaluationChartMap (algebraMap K F) x a ha
      commutes' := fun c => RingHom.congr_fun
        (projectiveEvaluationChartMap_base (algebraMap K F) x a ha) c }

/-- The literal chart-map image algebra is exactly generated by the SAME
normalized full-basis coordinates. This is a ring-image construction, not a
replacement for the SAME full scheme image or an image-dimension assertion. -/
theorem projectiveEvaluationChartAlgHom_range_eq_normalizedAdjoin001
    {K F : Type u} [Field K] [Field F] [Algebra K F]
    {σ : Type} (x : σ → F) (a : σ) (ha : x a ≠ 0) :
    letI : Algebra K (ChartRing (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a) :=
      (chartBaseMap (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a).toAlgebra
    (projectiveEvaluationChartAlgHom x a ha).range =
      Algebra.adjoin K (Set.range (fun i => x i / x a)) := by
  let I : HomogeneousIdeal (homogeneousSubmodule σ K) := ⊥
  letI : Algebra K (ChartRing I a) := (chartBaseMap I a).toAlgebra
  let g := projectiveEvaluationChartMap (algebraMap K F) x a ha
  have hBase : g.comp (chartBaseMap I a) = algebraMap K F :=
    projectiveEvaluationChartMap_base (algebraMap K F) x a ha
  have hCoordinates : (fun i => g (chartCoordinate I a i)) = (fun i => x i / x a) := by
    funext i
    exact projectiveEvaluationChartMap_coordinate (algebraMap K F) x a ha i
  apply le_antisymm
  · rintro z ⟨r, rfl⟩
    obtain ⟨q, rfl⟩ := eval₂_chartCoordinate_surjective I a r
    change g (q.eval₂ (chartBaseMap I a) (chartCoordinate I a)) ∈
      Algebra.adjoin K (Set.range (fun i => x i / x a))
    rw [MvPolynomial.hom_eval₂, hBase, hCoordinates]
    exact MvPolynomial.eval₂_mem
      (fun d _ => (Algebra.adjoin K (Set.range (fun i => x i / x a))).algebraMap_mem (q.coeff d))
      (fun i => Algebra.subset_adjoin (Set.mem_range_self i))
  · apply Algebra.adjoin_le
    rintro z ⟨i, rfl⟩
    refine ⟨chartCoordinate I a i, ?_⟩
    exact projectiveEvaluationChartMap_coordinate (algebraMap K F) x a ha i

/-- The ACTUAL full affine kernel quotient is identified with the actual
normalized-coordinate algebra, over the original K action. -/
theorem projectiveEvaluationChartMap_fullKernelQuotient_normalizedAdjoinIso001
    {K F : Type u} [Field K] [Field F] [Algebra K F]
    {σ : Type} (x : σ → F) (a : σ) (ha : x a ≠ 0) :
    let A := ChartRing (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a
    letI : Algebra K A :=
      (chartBaseMap (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a).toAlgebra
    Nonempty ((A ⧸ RingHom.ker (projectiveEvaluationChartMap (algebraMap K F) x a ha)) ≃ₐ[K]
      Algebra.adjoin K (Set.range (fun i => x i / x a))) := by
  let A := ChartRing (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a
  letI : Algebra K A :=
    (chartBaseMap (⊥ : HomogeneousIdeal (homogeneousSubmodule σ K)) a).toAlgebra
  let g := projectiveEvaluationChartAlgHom (K := K) x a ha
  have hRange := projectiveEvaluationChartAlgHom_range_eq_normalizedAdjoin001 (K := K) x a ha
  exact ⟨(Ideal.quotientKerEquivRange g).trans (Subalgebra.equivOfEq _ _ hRange)⟩

end PfaffianDescent.Coray
