import PfaffianDescent.VoisinTwelvePointQuadraticKernel

/-! # The cubic part of an ideal generated by three cubics -/

namespace PfaffianDescent
open MvPolynomial Module
open AllCharacteristics.HomogeneousProjective
universe u
attribute [local instance] MvPolynomial.gradedAlgebra
set_option autoImplicit false

theorem voisinDegreeTenSelectedAvoidance_cubic_mem_triple_iff_scalar_span
    {K : Type u} [Field K] (p q r s : MvPolynomial (Fin 4) K)
    (hp : p.IsHomogeneous 3) (hq : q.IsHomogeneous 3)
    (hr : r.IsHomogeneous 3) (hs : s.IsHomogeneous 3) :
    s ∈ Ideal.span ({p, q, r} : Set (MvPolynomial (Fin 4) K)) ↔
      ∃ a b c : K, s = C a * p + C b * q + C c * r := by
  constructor
  · intro hmem
    rw [← threeGeneratorLast_range] at hmem
    obtain ⟨⟨A, B, D⟩, hABC⟩ := hmem
    change p * A + q * B + r * D = s at hABC
    have hterm (t T : MvPolynomial (Fin 4) K) (ht : t.IsHomogeneous 3) :
        homogeneousComponent 3 (t * T) = t * C (coeff 0 T) := by
      simpa only [zero_add, homogeneousComponent_zero] using
        homogeneousComponent_mul_left ht 0
    have hcomp := congrArg (homogeneousComponent 3) hABC
    rw [map_add, map_add, hterm p A hp, hterm q B hq, hterm r D hr,
      homogeneousComponent_eq_self hs] at hcomp
    exact ⟨coeff 0 A, coeff 0 B, coeff 0 D, by
      simpa only [mul_comm] using hcomp.symm⟩
  · rintro ⟨a, b, c, rfl⟩
    apply Ideal.add_mem
    · apply Ideal.add_mem
      · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
      · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))

/-- For generators of one degree, that homogeneous ideal piece is their
scalar span. This includes the native three-cubic grid. -/
theorem voisinDegreeTenSelectedAvoidance_homogeneous_piece_map_eq_span
    {K : Type u} [Field K]
    (I : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K)) (d : ℕ)
    (Q : Fin 3 → MvPolynomial (Fin 4) K)
    (hQ : ∀ i, (Q i).IsHomogeneous d)
    (hIQ : I.toIdeal = Ideal.span (Set.range Q)) :
    (homogeneousIdealPiece I d).map (homogeneousSubmodule (Fin 4) K d).subtype =
      Submodule.span K (Set.range Q) := by
  apply le_antisymm
  · rintro p ⟨q, hq, rfl⟩
    have hmem : q.val ∈ Ideal.span (Set.range Q) := by
      rw [← hIQ]
      exact hq
    obtain ⟨A, hA⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
    have hcomponent := congrArg (homogeneousComponent d) hA
    rw [map_sum] at hcomponent
    have hterm (i : Fin 3) :
        homogeneousComponent d (A i * Q i) = C (coeff 0 (A i)) * Q i := by
      simpa only [zero_add, homogeneousComponent_zero] using
        homogeneousComponent_mul_right (p := A i) (q := Q i) (hQ i) 0
    simp only [hterm] at hcomponent
    have hrepr : q.val = ∑ i, C (coeff 0 (A i)) * Q i :=
      (hcomponent.trans (homogeneousComponent_eq_self q.property)).symm
    change q.val ∈ Submodule.span K (Set.range Q)
    rw [hrepr]
    apply Submodule.sum_mem
    intro i _
    simpa only [smul_eq_C_mul] using
      Submodule.smul_mem (Submodule.span K (Set.range Q)) (coeff 0 (A i))
        (Submodule.subset_span (Set.mem_range_self i))
  · apply Submodule.span_le.mpr
    rintro p ⟨i, rfl⟩
    let q : homogeneousSubmodule (Fin 4) K d := ⟨Q i, hQ i⟩
    have hq : q ∈ homogeneousIdealPiece I d := by
      change Q i ∈ I.toIdeal
      rw [hIQ]
      exact Ideal.subset_span (Set.mem_range_self i)
    exact ⟨q, hq, rfl⟩

theorem voisinDegreeTenSelectedAvoidance_homogeneous_piece_finrank_three
    {K : Type u} [Field K]
    (I : HomogeneousIdeal (homogeneousSubmodule (Fin 4) K)) (d : ℕ)
    (Q : Fin 3 → MvPolynomial (Fin 4) K)
    (hQ : ∀ i, (Q i).IsHomogeneous d)
    (hIQ : I.toIdeal = Ideal.span (Set.range Q))
    (hlin : LinearIndependent K Q) :
    finrank K (homogeneousIdealPiece I d) = 3 := by
  let H := homogeneousSubmodule (Fin 4) K d
  let P := homogeneousIdealPiece I d
  let f : P →ₗ[K] MvPolynomial (Fin 4) K := H.subtype.domRestrict P
  have hf : Function.Injective f := by
    intro x y hxy
    exact Subtype.ext (Subtype.ext hxy)
  let e : P ≃ₗ[K] f.range := LinearEquiv.ofInjective f hf
  calc
    finrank K P = finrank K f.range := e.finrank_eq
    _ = finrank K (P.map H.subtype) := by
      rw [← LinearMap.range_domRestrict P H.subtype]
    _ = finrank K (Submodule.span K (Set.range Q)) := by
      rw [voisinDegreeTenSelectedAvoidance_homogeneous_piece_map_eq_span I d Q hQ hIQ]
    _ = 3 := by simpa using finrank_span_eq_card hlin

end PfaffianDescent
