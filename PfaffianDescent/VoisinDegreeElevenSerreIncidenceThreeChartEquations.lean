import PfaffianDescent.VoisinDegreeElevenSerreIncidenceUniversalLinearEquations

/-! # The actual triple incidence ideal has six local scalar equations -/
noncomputable section
open AlgebraicGeometry CategoryTheory
namespace PfaffianDescent
universe u
set_option backward.isDefEq.respectTransparency false

lemma serreIncidence_span_paired {R : Type u} [CommRing R]
    {α β : Type*} (g : α → β → R) :
    (⨆ i, Ideal.span (Set.range (g i))) =
      Ideal.span (Set.range fun r : α × β => g r.1 r.2) := by
  apply le_antisymm
  · refine iSup_le fun i => Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨(i,j), rfl⟩
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨i,j⟩, rfl⟩
    exact (le_iSup (fun i => Ideal.span (Set.range (g i))) i)
      (Ideal.subset_span ⟨j, rfl⟩)

lemma serreIncidence_iSup_coordinateIdeals
    {B : Scheme.{u}} [IsAffine B] {α β : Type*}
    (g : α → β → Γ(B, ⊤)) :
    (⨆ i, Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range (g i)))) =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range fun r : α × β => g r.1 r.2)) := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  simpa [Scheme.IdealSheafData.ideal_iSup] using serreIncidence_span_paired g

/-- A literal local equation presentation of each actual marked pullback
assembles into the actual incidence ideal presentation. -/
theorem serreThreePointSectionIncidenceIdeal_comap_of_equations
    {S B X P Z T : Scheme.{u}} [IsAffine T]
    (b : B ⟶ S) (x : X ⟶ S) (p : P ⟶ S)
    (marked : Fin 3 → (B ⟶ X)) (hmarked : ∀ i, marked i ≫ x = b)
    (zero : Z ⟶ properFiniteIncidenceParameterSpace x p) [IsClosedImmersion zero]
    (a : T ⟶ properFiniteIncidenceParameterSpace b p)
    {β : Type u} (g : Fin 3 → β → Γ(T, ⊤))
    (h : ∀ i, zero.ker.comap
      (a ≫ fixedLinearSystemIncidenceMap b x p marked hmarked i) =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range (g i)))) :
    (serreThreePointSectionIncidenceIdeal b x p marked hmarked zero).comap a =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range fun r : Fin 3 × β => g r.1 r.2)) := by
  unfold serreThreePointSectionIncidenceIdeal
  rw [(Scheme.IdealSheafData.map_gc a).l_iSup]
  have heq : ∀ i : Fin 3,
      (zero.ker.comap (fixedLinearSystemIncidenceMap b x p marked hmarked i)).comap a =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range (g i))) := by
    intro i
    rw [← Scheme.IdealSheafData.comap_comp]
    exact h i
  exact (congrArg (fun h : Fin 3 → T.IdealSheafData => iSup h) (funext heq)).trans
    (serreIncidence_iSup_coordinateIdeals (B := T) g)

/-- On an actual affine chart of configuration times projective parameters,
the three literal marked incidence conditions are generated by the six
actual linear scalar equations. The chart maps and their identities remain
morphisms of the actual universal family. -/
theorem serreThreePointSectionIncidenceIdeal_comap_threeCharts
    {K : Type u} [Field K] {X B T : Scheme.{u}} [IsAffine T]
    (base : X ⟶ Spec (.of K)) [IsSeparated base] (M : X.Modules)
    [FiniteDimensional K (SchemeModuleGlobalSectionsOver base M)]
    (C : SchemeModuleFiniteFreeAffineCover M (ULift (Fin 2)))
    (b : B ⟶ Spec (.of K)) (marked : Fin 3 → (B ⟶ X))
    (hmarked : ∀ i, marked i ≫ base = b)
    (a : T ⟶ properFiniteIncidenceParameterSpace b
      (schemeModuleGlobalSectionsProjectiveParametersToBase base M))
    (ij : Fin 3 → (C.projectiveSectionOpenCover base M).I₀)
    (f : ∀ i, T ⟶ (C.projectiveSectionOpenCover base M).X (ij i))
    (hf : ∀ i, a ≫ fixedLinearSystemIncidenceMap b base
      (schemeModuleGlobalSectionsProjectiveParametersToBase base M) marked hmarked i =
      f i ≫ (C.projectiveSectionOpenCover base M).f (ij i)) :
    letI := C.isClosedImmersion_projectiveSectionLocalZeroGluedToAmbient base M
    (serreThreePointSectionIncidenceIdeal b base
      (schemeModuleGlobalSectionsProjectiveParametersToBase base M) marked hmarked
      (C.projectiveSectionLocalZeroGluedToAmbient base M)).comap a =
    Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun r : Fin 3 × ULift (Fin 2) =>
      ∑ k, (f r.1).appTop (C.projectiveSectionLocalCoefficient base M (ij r.1) k) *
        serreUniversalChartEvaluationCoordinate base M C (ij r.1) (f r.1) r.2 k)) := by
  letI := C.isClosedImmersion_projectiveSectionLocalZeroGluedToAmbient base M
  let g : Fin 3 → ULift (Fin 2) → Γ(T, ⊤) := fun i r =>
    ∑ k, (f i).appTop (C.projectiveSectionLocalCoefficient base M (ij i) k) *
      serreUniversalChartEvaluationCoordinate base M C (ij i) (f i) r k
  apply serreThreePointSectionIncidenceIdeal_comap_of_equations b base
    (schemeModuleGlobalSectionsProjectiveParametersToBase base M) marked hmarked
    (C.projectiveSectionLocalZeroGluedToAmbient base M) a g
  intro i
  exact (congrArg (fun t =>
    (C.projectiveSectionLocalZeroGluedToAmbient base M).ker.comap t) (hf i)).trans
      (serreIncidenceUniversalZeroIdeal_comap_linearEquations base M C (ij i) (f i))

end PfaffianDescent
