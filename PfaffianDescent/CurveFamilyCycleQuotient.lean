import PfaffianDescent.RationalCycleFamilies

namespace PfaffianDescent
open AlgebraicGeometry CategoryTheory AllCharacteristics
universe u
section
variable {K : Type u} [Field K] {X : Scheme.{u}} (p : X ⟶ Spec (.of K)) [IsSeparated p]

/-- The subgroup generated by differences of actual zero and infinity fibers of finite-flat curve families. -/
noncomputable def curveFamilyCycleRelations : Submodule ℤ (ZeroCycle X) :=
  Submodule.span ℤ (Set.range (fun F : RationalCycleFamily p => F.cycleDifference))

lemma curveFamilyCycleRelations_le_degree_ker :
    curveFamilyCycleRelations p ≤ (ZeroCycle.degree p).ker := by
  apply Submodule.span_le.mpr
  rintro z ⟨F, rfl⟩
  exact F.cycleDifference_degree

/-- Signed zero-cycles modulo the actual finite-flat curve-family relations. -/
noncomputable abbrev CurveFamilyCycleQuotient := ZeroCycle X ⧸ curveFamilyCycleRelations p

noncomputable def curveFamilyCycleClass : ZeroCycle X →ₗ[ℤ] CurveFamilyCycleQuotient p :=
  (curveFamilyCycleRelations p).mkQ

/-- The degree map descends because each geometric generating relation has degree zero. -/
noncomputable def curveFamilyCycleDegree : CurveFamilyCycleQuotient p →ₗ[ℤ] ℤ :=
  (curveFamilyCycleRelations p).liftQ (ZeroCycle.degree p) (curveFamilyCycleRelations_le_degree_ker p)

lemma curveFamilyCycleDegree_class (z : ZeroCycle X) :
    curveFamilyCycleDegree p (curveFamilyCycleClass p z) = ZeroCycle.degree p z := rfl

/-- Equality of cycle classes is exactly membership of the difference in the relation subgroup. -/
lemma curveFamilyCycleClass_eq_iff (z w : ZeroCycle X) :
    curveFamilyCycleClass p z = curveFamilyCycleClass p w ↔ z - w ∈ curveFamilyCycleRelations p :=
  Submodule.Quotient.eq _

/-- Equal cycle classes have equal actual residue-field degrees. -/
theorem curveFamilyCycleClass_degree_eq {z w : ZeroCycle X}
    (h : curveFamilyCycleClass p z = curveFamilyCycleClass p w) : ZeroCycle.degree p z = ZeroCycle.degree p w :=
  congrArg (curveFamilyCycleDegree p) h

/-- The two intrinsic fiber cycles of every curve family define the same class. -/
theorem curveFamilyCycleClass_fibers (F : RationalCycleFamily p) :
    curveFamilyCycleClass p (F.fiberCycle false).toZeroCycle =
      curveFamilyCycleClass p (F.fiberCycle true).toZeroCycle := by
  apply (curveFamilyCycleClass_eq_iff p _ _).mpr
  exact Submodule.subset_span ⟨F, rfl⟩

/-- Effectivity means admitting a representative with nonnegative multiplicities on actual closed points. -/
def CurveFamilyCycleQuotient.IsEffective (c : CurveFamilyCycleQuotient p) : Prop :=
  ∃ z : EffectiveZeroCycle X, curveFamilyCycleClass p z.toZeroCycle = c

lemma curveFamilyCycleClass_effective (z : EffectiveZeroCycle X) :
    CurveFamilyCycleQuotient.IsEffective p (curveFamilyCycleClass p z.toZeroCycle) := ⟨z, rfl⟩

/-- An effective representative can be recovered together with its equality of
classes.  This is a small elimination lemma, but keeping it named makes the
effectivity calculations in Voisin's argument readable. -/
lemma CurveFamilyCycleQuotient.IsEffective.exists_rep
    {c : CurveFamilyCycleQuotient p} (h : CurveFamilyCycleQuotient.IsEffective p c) :
    ∃ z : EffectiveZeroCycle X, curveFamilyCycleClass p z.toZeroCycle = c := h

/-- The degree of any effective representative is determined by its class. -/
lemma effectiveRepresentative_degree_eq {c : CurveFamilyCycleQuotient p}
    (z : EffectiveZeroCycle X) (hz : curveFamilyCycleClass p z.toZeroCycle = c) :
    (EffectiveZeroCycle.degree p z : ℤ) = curveFamilyCycleDegree p c := by
  rw [← hz, curveFamilyCycleDegree_class, EffectiveZeroCycle.degree_toZeroCycle]

/- The integer degree equality can be converted back to the natural
scheme-theoretic degree used by the effective-cycle API. -/
lemma effectiveRepresentative_natDegree_eq {c : CurveFamilyCycleQuotient p}
    (z : EffectiveZeroCycle X) (hz : curveFamilyCycleClass p z.toZeroCycle = c)
    {n : ℕ} (hc : curveFamilyCycleDegree p c = (n : ℤ)) :
    EffectiveZeroCycle.degree p z = n := by
  have h := effectiveRepresentative_degree_eq p z hz
  rw [hc] at h
  exact Int.ofNat_inj.mp h

/-- The degree of an effective class is nonnegative. -/
lemma CurveFamilyCycleQuotient.IsEffective.degree_nonnegative {c : CurveFamilyCycleQuotient p}
    (h : CurveFamilyCycleQuotient.IsEffective p c) : 0 ≤ curveFamilyCycleDegree p c := by
  obtain ⟨z, rfl⟩ := h
  rw [curveFamilyCycleDegree_class, EffectiveZeroCycle.degree_toZeroCycle]
  exact Int.natCast_nonneg _

end
end PfaffianDescent
