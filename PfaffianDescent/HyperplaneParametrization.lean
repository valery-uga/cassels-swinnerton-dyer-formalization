import PfaffianDescent.LinearSectionImage
import Mathlib.Algebra.BigOperators.Fin

namespace PfaffianDescent
open MvPolynomial
section
variable {K : Type*} [Field K] {n : ℕ}

noncomputable def homogeneousLinearForm (c : Fin (n+1) → K) : MvPolynomial (Fin (n+1)) K :=
  ∑ i, C (c i) * X i

/-- Solve the hyperplane equation for a chosen nonzero pivot coefficient. -/
noncomputable def hyperplaneInclusion (c : Fin (n+1) → K) (i : Fin (n+1)) :
    Matrix (Fin (n+1)) (Fin n) K :=
  fun k j => if k = i then -(c i)⁻¹ * c (i.succAbove j)
    else if k = i.succAbove j then 1 else 0

noncomputable def coordinateOmission (i : Fin (n+1)) : Matrix (Fin n) (Fin (n+1)) K :=
  fun j k => if k = i.succAbove j then 1 else 0

lemma hyperplaneInclusion_leftInverse (c : Fin (n+1) → K) (i : Fin (n+1)) :
    coordinateOmission (K := K) i * hyperplaneInclusion c i = 1 := by
  ext j k
  rw [Matrix.mul_apply, Finset.sum_eq_single (i.succAbove j)]
  · simp [coordinateOmission, hyperplaneInclusion, Fin.succAbove_ne,
      Fin.succAbove_right_inj, Matrix.one_apply]
  · intro k' _ hk'
    simp [coordinateOmission, hk']
  · simp

lemma coordinateOmission_substitution_X (i : Fin (n+1)) (j : Fin n) :
    rectangularSubstitution (coordinateOmission (K := K) i) (X j) = X (i.succAbove j) := by
  rw [rectangularSubstitution_X]
  simp [rectangularLinearCoordinate, coordinateOmission, Matrix.mulVec, dotProduct]

lemma hyperplaneInclusion_other_coordinate (c : Fin (n+1) → K) (i : Fin (n+1)) (j : Fin n) :
    rectangularLinearCoordinate (hyperplaneInclusion c i) (i.succAbove j) = X j := by
  simp [rectangularLinearCoordinate, hyperplaneInclusion, Matrix.mulVec, dotProduct,
    Fin.succAbove_ne, Fin.succAbove_right_inj]

lemma hyperplaneInclusion_pivot_coordinate (c : Fin (n+1) → K) (i : Fin (n+1)) :
    rectangularLinearCoordinate (hyperplaneInclusion c i) i =
      -C ((c i)⁻¹) * ∑ j, C (c (i.succAbove j)) * X j := by
  simp only [rectangularLinearCoordinate, hyperplaneInclusion, Matrix.mulVec, dotProduct,
    Matrix.map_apply, ↓reduceIte, map_mul, map_neg]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

lemma hyperplaneInclusion_other_relation (c : Fin (n+1) → K) (i : Fin (n+1)) (j : Fin n) :
    linearSectionRelation (hyperplaneInclusion c i) (coordinateOmission i) (i.succAbove j) = 0 := by
  rw [linearSectionRelation, hyperplaneInclusion_other_coordinate,
    coordinateOmission_substitution_X, sub_self]

/-- The sole nontrivial equation of the parametrized hyperplane is the
original linear equation, up to multiplication by the inverse pivot. -/
theorem hyperplaneInclusion_pivot_relation (c : Fin (n+1) → K) (i : Fin (n+1)) (hi : c i ≠ 0) :
    linearSectionRelation (hyperplaneInclusion c i) (coordinateOmission i) i =
      C ((c i)⁻¹) * homogeneousLinearForm c := by
  rw [linearSectionRelation, hyperplaneInclusion_pivot_coordinate]
  simp only [map_mul, map_neg, map_sum, algHom_C, MvPolynomial.algebraMap_eq, coordinateOmission_substitution_X]
  have hunit : (C ((c i)⁻¹) : MvPolynomial (Fin (n+1)) K) * C (c i) = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hi, map_one]
  rw [homogeneousLinearForm, Fin.sum_univ_succAbove _ i]
  simp only [mul_add, ← mul_assoc, hunit, one_mul]
  ring

/-- A polynomial whose restriction to an explicitly parametrized hyperplane
vanishes belongs to the ideal generated by that hyperplane's linear form. -/
theorem mem_span_homogeneousLinearForm_of_hyperplane_restriction_eq_zero
    {K : Type*} [Field K]
    (c : Fin 4 → K) (k : Fin 4) (hk : c k ≠ 0)
    (q : MvPolynomial (Fin 4) K)
    (hq : rectangularSubstitution (hyperplaneInclusion c k) q = 0) :
    q ∈ Ideal.span ({homogeneousLinearForm c} : Set (MvPolynomial (Fin 4) K)) := by
  let M := hyperplaneInclusion c k
  let N := coordinateOmission (K := K) k
  let J := Ideal.span ({homogeneousLinearForm c} : Set (MvPolynomial (Fin 4) K))
  let e : MvPolynomial (Fin 4) K →ₐ[K] MvPolynomial (Fin 4) K ⧸ J :=
    Ideal.Quotient.mkₐ K J
  let t := e.comp (rectangularSubstitution N)
  have ht : t.comp (rectangularSubstitution M) = e := by
    apply MvPolynomial.algHom_ext
    intro i
    change e (rectangularSubstitution N (rectangularSubstitution M (X i))) = e (X i)
    have hrel : e (linearSectionRelation M N i) = 0 := by
      change Ideal.Quotient.mk J (linearSectionRelation M N i) = 0
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      by_cases hi : i = k
      · subst i
        rw [show M = hyperplaneInclusion c k by rfl,
          show N = coordinateOmission k by rfl,
          hyperplaneInclusion_pivot_relation c k hk]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
      · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq hi
        rw [show M = hyperplaneInclusion c k by rfl,
          show N = coordinateOmission k by rfl,
          hyperplaneInclusion_other_relation]
        exact Ideal.zero_mem _
    change e (X i - rectangularSubstitution N (rectangularLinearCoordinate M i)) = 0 at hrel
    rw [map_sub, sub_eq_zero] at hrel
    change e (rectangularSubstitution N (rectangularSubstitution M (X i))) = e (X i)
    rw [rectangularSubstitution_X]
    exact hrel.symm
  have heq := AlgHom.congr_fun ht q
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change e q = 0
  change t (rectangularSubstitution M q) = e q at heq
  rw [show rectangularSubstitution M q = 0 by exact hq] at heq
  simpa [t] using heq.symm

end
end PfaffianDescent

namespace PfaffianDescent
open MvPolynomial

universe u

/-- The explicit coordinate parametrization of a hyperplane satisfies its
linear equation after every field extension. -/
theorem hyperplaneInclusion_dot_mulVec_zero
    {K L : Type u} [Field K] [Field L] (f : K →+* L)
    (g : Fin 4 → K) (k : Fin 4) (hk : g k ≠ 0) (x : Fin 3 → L) :
    ∑ i, f (g i) * ((hyperplaneInclusion g k).map f).mulVec x i = 0 := by
  classical
  have hDk : ((hyperplaneInclusion g k).map f).mulVec x k =
      -(f (g k))⁻¹ * ∑ j, f (g (k.succAbove j)) * x j := by
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, hyperplaneInclusion,
      ↓reduceIte, map_neg, map_inv₀, map_mul]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hDother (j : Fin 3) :
      ((hyperplaneInclusion g k).map f).mulVec x (k.succAbove j) = x j := by
    simp [Matrix.mulVec, dotProduct, hyperplaneInclusion, Fin.succAbove_ne]
  have hfk : f (g k) ≠ 0 := by simpa using f.injective.ne hk
  rw [Fin.sum_univ_succAbove _ k, hDk]
  simp_rw [hDother]
  field_simp [hfk]
  ring

end PfaffianDescent
