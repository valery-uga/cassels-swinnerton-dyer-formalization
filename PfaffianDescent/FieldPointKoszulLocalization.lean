/-- The section-representer stalk on its open is free of rank one, hence has
no degree-one Ext into any local coefficient module. -/
theorem sectionRepresenterStalk_ext_one_subsingleton
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    [HasExt.{u + 1} (ModuleCat (X.presheaf.stalk x))]
    (N : ModuleCat.{u} (X.presheaf.stalk x)) :
    Subsingleton (Ext.{u + 1}
      ((schemeModuleStalkModuleFunctor X x).obj
        (show X.Modules from sectionRepresenter X.ringCatSheaf U)) N 1) := by
  let A := ModuleCat.of (X.presheaf.stalk x) (X.presheaf.stalk x)
  letI : Subsingleton (Ext.{u + 1} A N 1) :=
    Ext.subsingleton_of_projective A N 0
  exact ext_subsingleton_of_iso_left (sectionRepresenterStalkIso X U x hx) 1

