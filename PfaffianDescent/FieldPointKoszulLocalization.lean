/-!
# Localization of the explicit field-point Koszul class

Local vanishing forces the coefficient germ to lie in the point ideal. This
provides independent nonzero localized classes, without assuming that the
global-to-stalk Ext map is injective.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian AlgebraicGeometry
open scoped ZeroObject nonZeroDivisors

namespace PfaffianDescent

universe u

attribute [local instance] CategoryTheory.Abelian.hasFiniteBiproducts

set_option backward.isDefEq.respectTransparency false in
/-- A stalk boundary has coefficient coordinate in the ideal generated by
the two Koszul equations. -/
theorem sectionRepresenterKoszul_stalk_boundary_coordinate_mem_span
    {X : Scheme.{u}} (U : X.Opens) (x : X) (hx : x ∈ U)
    (q f : Γ(X, U)) (Y : X.Modules) (y : Γ(Y, U))
    (qY : (schemeModuleStalkModuleFunctor X x).obj Y ≅
      ModuleCat.of (X.presheaf.stalk x) (X.presheaf.stalk x))
    (g : (schemeModuleStalkModuleFunctor X x).obj
        (show X.Modules from ⨁ sectionRepresenterKoszulPair X.ringCatSheaf U) ⟶
      (schemeModuleStalkModuleFunctor X x).obj Y)
    (hg : (schemeModuleStalkModuleFunctor X x).map
        (sectionRepresenterKoszulFirst X.ringCatSheaf U q f) ≫ g =
      (schemeModuleStalkModuleFunctor X x).map
        (sectionRepresenterAugmentation X.ringCatSheaf U Y y)) :
    schemeModuleSectionStalkCoordinateAddHom U x hx Y qY y ∈
      Ideal.span ({X.presheaf.germ U x hx q,
        X.presheaf.germ U x hx f} : Set (X.presheaf.stalk x)) := by
  let e₁ := sectionRepresenterStalkIso X U x hx
  let e₂ := sectionRepresenterKoszulPairStalkIso X U x hx
  let l := e₂.inv ≫ g ≫ qY.hom
  have he : ModuleCat.ofHom (twoGeneratorFirst
        (X.presheaf.germ U x hx q) (X.presheaf.germ U x hx f)) ≫ l =
      e₁.hom ≫ (schemeModuleStalkModuleFunctor X x).map
        (sectionRepresenterAugmentation X.ringCatSheaf U Y y) ≫ qY.hom := by
    rw [← sectionRepresenterKoszulFirst_stalk_conjugacy X U x hx q f]
    dsimp only [l, e₁, e₂]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← hg]
    simp only [Category.assoc]
  have hval := congrArg (fun k ↦ k (1 : X.presheaf.stalk x)) he
  have hcoord : l (-X.presheaf.germ U x hx f, X.presheaf.germ U x hx q) =
      schemeModuleSectionStalkCoordinateAddHom U x hx Y qY y := by
    change l (-X.presheaf.germ U x hx f, X.presheaf.germ U x hx q) =
      qY.hom (Y.presheaf.germ U x hx y)
    simp only [ConcreteCategory.comp_apply] at hval
    change l (-X.presheaf.germ U x hx f * 1,
        X.presheaf.germ U x hx q * 1) =
      qY.hom ((schemeModuleStalkModuleFunctor X x).map
        (sectionRepresenterAugmentation X.ringCatSheaf U Y y)
        (sectionRepresenterStalkGeneratorHom X U x hx 1)) at hval
    rw [mul_one, mul_one, sectionRepresenterStalkGeneratorHom_apply_one,
      sectionRepresenterAugmentation_stalk_generator] at hval
    exact hval
  have hl : l (-X.presheaf.germ U x hx f, X.presheaf.germ U x hx q) =
      -X.presheaf.germ U x hx f * l (1, 0) +
        X.presheaf.germ U x hx q * l (0, 1) := by
    have hp : (-X.presheaf.germ U x hx f, X.presheaf.germ U x hx q) =
        (-X.presheaf.germ U x hx f) • (1, 0) +
          (X.presheaf.germ U x hx q) • (0, 1) := by
      ext <;> simp
    rw [hp, l.hom.map_add, l.hom.map_smul, l.hom.map_smul]
    rfl
  rw [← hcoord, hl]
  apply Ideal.add_mem
  · apply Ideal.mul_mem_right
    exact (Ideal.span ({X.presheaf.germ U x hx q,
      X.presheaf.germ U x hx f} : Set (X.presheaf.stalk x))).neg_mem
      (Ideal.subset_span (by simp))
  · apply Ideal.mul_mem_right
    exact Ideal.subset_span (by simp)

