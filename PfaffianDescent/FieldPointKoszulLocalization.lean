/-- The explicit unit-coefficient class has nonzero field-valued residue,
independently of injectivity of localization or affine Ext-acyclicity. -/
theorem fieldPointKoszulUnitClass_residue_ne_zero
    {L : Type u} [Field L] {X : Scheme.{u}}
    (i : Spec (.of L) ⟶ X) [IsClosedImmersion i]
    (T : X.Modules) {J : Type u} (V : J → X.Opens)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (eV : ∀ j, (SheafOfModules.overFunctor X.ringCatSheaf (V j)).obj T ≅
      SheafOfModules.unit (SheafOfModules.commRingSheafToRingSheaf
        (SheafOfModules.commRingSheafOver X.sheaf (V j))))
    (U : X.Opens) (hx : i default ∈ U) (q f : Γ(X, U))
    (qM : (schemeModuleStalkModuleFunctor X (i default)).obj
        (closedImmersionIdealTwistSequence i T).X₃ ≅
      ModuleCat.of (X.presheaf.stalk (i default))
        (sectionRepresenterPointKoszulQuotient
          X U (i default) hx q f))
    (hspan : ∀ (z : X) (hz : z ∈ U), z ≠ i default →
      Ideal.span
        ({X.presheaf.germ U z hz q, X.presheaf.germ U z hz f} :
          Set (X.presheaf.stalk z)) = ⊤)
    (hqreg : X.presheaf.germ U (i default) hx q ∈
      (X.presheaf.stalk (i default))⁰)
    (hfreg : Ideal.Quotient.mk
        (Ideal.span {X.presheaf.germ U (i default) hx q})
        (X.presheaf.germ U (i default) hx f) ∈
      ((X.presheaf.stalk (i default)) ⧸
        Ideal.span {X.presheaf.germ U (i default) hx q})⁰)
    [hExt : HasExt.{u} X.Modules]
    [HasExt.{u + 1} (ModuleCat (X.presheaf.stalk (i default)))]
    (hqmax : X.presheaf.germ U (i default) hx q ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk (i default)))
    (hfmax : X.presheaf.germ U (i default) hx f ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk (i default)))
    (hmax : Ideal.span
        ({X.presheaf.germ U (i default) hx q,
          X.presheaf.germ U (i default) hx f} : Set _) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk (i default)))
 :
    fieldPointExtTwoResidueCoordinate i default
      (closedImmersionIdealTwistSequence i T).X₃
      (show X.Modules from SheafOfModules.unit X.ringCatSheaf)
      (X.presheaf.germ U (i default) hx q)
      (X.presheaf.germ U (i default) hx f) hqreg hfreg hqmax hfmax
      qM (schemeModuleUnitStalkIso X (i default))
      (fieldPointSectionRepresenterKoszulDegreeTwoClass
        i T V hV eV U hx q f qM hspan hqreg hfreg
        (show X.Modules from SheafOfModules.unit X.ringCatSheaf) (1 : Γ(X, U))) ≠ 0 := by
  let Y : X.Modules := SheafOfModules.unit X.ringCatSheaf
  let qY := schemeModuleUnitStalkIso X (i default)
  let z := fieldPointSectionRepresenterKoszulDegreeTwoClass
    i T V hV eV U hx q f qM hspan hqreg hfreg Y (1 : Γ(X, U))
  have hy : schemeModuleSectionStalkCoordinateAddHom
      U (i default) hx Y qY (1 : Γ(X, U)) ∉
      Ideal.span ({X.presheaf.germ U (i default) hx q,
        X.presheaf.germ U (i default) hx f} : Set _) := by
    apply schemeModuleSectionStalkCoordinateAddHom_not_mem_span_of_eq_one
      U (i default) hx Y qY q f (1 : Γ(X, U)) hqmax hfmax
    rw [schemeModuleSectionStalkCoordinateAddHom_unit]
    exact map_one _
  have hn := fieldPointSectionRepresenterKoszulDegreeTwoClass_stalk_ne_zero
    i T V hV eV U hx q f qM hspan hqreg hfreg
    Y (1 : Γ(X, U)) qY hy
  intro hz
  apply hn
  apply (schemeModuleExtLocalResidueComponentLarge_eq_zero_iff_stalk_eq_zero
    (i default) (closedImmersionIdealTwistSequence i T).X₃ Y
    (X.presheaf.germ U (i default) hx q)
    (X.presheaf.germ U (i default) hx f) hqreg hfreg hqmax hfmax
    qM qY hmax z).mp
  apply (closedFieldPointResidueRingEquivAt i default).injective
  change closedFieldPointResidueRingEquivAt i default
      (schemeModuleExtLocalResidueComponentLarge (i default)
        (closedImmersionIdealTwistSequence i T).X₃ Y
        (X.presheaf.germ U (i default) hx q)
        (X.presheaf.germ U (i default) hx f) hqreg hfreg hqmax hfmax qM qY z) =
      closedFieldPointResidueRingEquivAt i default 0
  change closedFieldPointResidueRingEquivAt i default
      (schemeModuleExtLocalResidueComponentLarge (i default)
        (closedImmersionIdealTwistSequence i T).X₃ Y
        (X.presheaf.germ U (i default) hx q)
        (X.presheaf.germ U (i default) hx f) hqreg hfreg hqmax hfmax qM qY z) = 0 at hz
  simpa only [map_zero] using hz

