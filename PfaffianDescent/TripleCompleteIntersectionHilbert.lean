import PfaffianDescent.ThreeGeneratorGradedComplex
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# Hilbert function of a three-equation complete intersection in `P³`

The result is proved from the concrete homogeneous Koszul complex.  The two
numerical specializations used by Voisin are a triple of cubics (length 27)
and a cubic with two quadrics (length 12).
-/

namespace PfaffianDescent

open MvPolynomial Module

section
variable {K : Type*} [Field K] {a b c : ℕ}
attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable def tripleCompleteIntersectionIdeal
    (f g h : MvPolynomial (Fin 4) K) : Ideal (MvPolynomial (Fin 4) K) :=
  Ideal.span ({f, g, h} : Set (MvPolynomial (Fin 4) K))

lemma tripleCompleteIntersectionIdeal_homogeneous
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous a) (hg : g.IsHomogeneous b)
    (hh : h.IsHomogeneous c) :
    (tripleCompleteIntersectionIdeal f g h).IsHomogeneous
      (homogeneousSubmodule (Fin 4) K) := by
  apply Ideal.homogeneous_span
  intro q hq
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
  rcases hq with rfl | rfl | rfl
  · exact ⟨a, hf⟩
  · exact ⟨b, hg⟩
  · exact ⟨c, hh⟩

noncomputable def tripleCompleteIntersectionHomogeneousIdeal
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous a) (hg : g.IsHomogeneous b)
    (hh : h.IsHomogeneous c) :
    HomogeneousIdeal (homogeneousSubmodule (Fin 4) K) :=
  ⟨tripleCompleteIntersectionIdeal f g h,
    tripleCompleteIntersectionIdeal_homogeneous f g h hf hg hh⟩

/-- Forgetting the homogeneous structure on the complete-intersection ideal
recovers the ordinary ideal generated by its three equations. -/
theorem tripleCompleteIntersectionHomogeneousIdeal_toIdeal
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous a) (hg : g.IsHomogeneous b)
    (hh : h.IsHomogeneous c) :
    (tripleCompleteIntersectionHomogeneousIdeal f g h hf hg hh).toIdeal =
      tripleCompleteIntersectionIdeal f g h := rfl

/-- The actual degree-`d` component of the homogeneous quotient. -/
noncomputable def tripleCompleteIntersectionComponent
    (f g h : MvPolynomial (Fin 4) K) (d : ℕ) :
    Submodule K (MvPolynomial (Fin 4) K ⧸ tripleCompleteIntersectionIdeal f g h) :=
  (FourHomogeneous K d).map
    (Ideal.Quotient.mkₐ K (tripleCompleteIntersectionIdeal f g h)).toLinearMap

noncomputable def tripleCompleteIntersectionProjection
    (f g h : MvPolynomial (Fin 4) K) (d : ℕ) :
    FourHomogeneous K d →ₗ[K]
      (MvPolynomial (Fin 4) K ⧸ tripleCompleteIntersectionIdeal f g h) :=
  (Ideal.Quotient.mkₐ K (tripleCompleteIntersectionIdeal f g h)).toLinearMap.comp
    (FourHomogeneous K d).subtype

lemma tripleCompleteIntersectionProjection_range
    (f g h : MvPolynomial (Fin 4) K) (d : ℕ) :
    LinearMap.range (tripleCompleteIntersectionProjection f g h d) =
      tripleCompleteIntersectionComponent f g h d := by
  rw [tripleCompleteIntersectionProjection, LinearMap.range_comp,
    Submodule.range_subtype]
  rfl

/-- The final homogeneous Koszul differential is precisely the kernel of
projection to the quotient. -/
theorem tripleCompleteIntersectionProjection_exact
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous a) (hg : g.IsHomogeneous b)
    (hh : h.IsHomogeneous c) (d : ℕ) :
    LinearMap.range (threeGeneratorGradedLast f g h hf hg hh d) =
      LinearMap.ker
        (tripleCompleteIntersectionProjection f g h (d + a + b + c)) := by
  apply le_antisymm
  · rintro v ⟨x, rfl⟩
    change Ideal.Quotient.mk (tripleCompleteIntersectionIdeal f g h)
      (f * x.1.val + g * x.2.1.val + h * x.2.2.val) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    change f * x.1.val + g * x.2.1.val + h * x.2.2.val ∈
      Ideal.span ({f, g, h} : Set (MvPolynomial (Fin 4) K))
    rw [← threeGeneratorLast_range]
    exact ⟨(x.1.val, x.2.1.val, x.2.2.val), rfl⟩
  · intro v hv
    change Ideal.Quotient.mk (tripleCompleteIntersectionIdeal f g h) v.val = 0 at hv
    have hmem := Ideal.Quotient.eq_zero_iff_mem.mp hv
    change v.val ∈ Ideal.span ({f, g, h} : Set (MvPolynomial (Fin 4) K)) at hmem
    rw [← threeGeneratorLast_range] at hmem
    obtain ⟨⟨r, s, t⟩, hrst⟩ := hmem
    change f * r + g * s + h * t = v.val at hrst
    let r' := homogeneousComponent (d + b + c) r
    let s' := homogeneousComponent (d + a + c) s
    let t' := homogeneousComponent (d + a + b) t
    refine ⟨(⟨r', homogeneousComponent_isHomogeneous _ _⟩,
      ⟨s', homogeneousComponent_isHomogeneous _ _⟩,
      ⟨t', homogeneousComponent_isHomogeneous _ _⟩), ?_⟩
    apply Subtype.ext
    change f * r' + g * s' + h * t' = v.val
    have hfr : homogeneousComponent (d + a + b + c) (f * r) = f * r' := by
      rw [show d + a + b + c = a + (d + b + c) by omega]
      exact homogeneousComponent_mul_left (q := r) hf (d + b + c)
    have hgs : homogeneousComponent (d + a + b + c) (g * s) = g * s' := by
      rw [show d + a + b + c = b + (d + a + c) by omega]
      exact homogeneousComponent_mul_left (q := s) hg (d + a + c)
    have hht : homogeneousComponent (d + a + b + c) (h * t) = h * t' := by
      rw [show d + a + b + c = c + (d + a + b) by omega]
      exact homogeneousComponent_mul_left (q := t) hh (d + a + b)
    rw [← hfr, ← hgs, ← hht, ← map_add, ← map_add, hrst,
      homogeneousComponent_eq_self v.property]

/-- Euler-characteristic identity for the concrete homogeneous Koszul
resolution. -/
theorem tripleCompleteIntersection_hilbert_identity
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous a) (hg : g.IsHomogeneous b)
    (hh : h.IsHomogeneous c) (hf0 : f ≠ 0) (hg0 : g ≠ 0)
    (hrel : IsRelPrime f g)
    (hregular : ∀ x : MvPolynomial (Fin 4) K,
      h * x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)))
    (d : ℕ) :
    finrank K (tripleCompleteIntersectionComponent f g h (d + a + b + c)) +
        (finrank K (FourHomogeneous K (d + b + c)) +
          finrank K (FourHomogeneous K (d + a + c)) +
          finrank K (FourHomogeneous K (d + a + b))) +
        finrank K (FourHomogeneous K d) =
      finrank K (FourHomogeneous K (d + a + b + c)) +
        (finrank K (FourHomogeneous K (d + c)) +
          finrank K (FourHomogeneous K (d + b)) +
          finrank K (FourHomogeneous K (d + a))) := by
  let F := threeGeneratorGradedFirst f g h hf hg hh d
  let M := threeGeneratorGradedMiddle f g h hf hg hh d
  let L := threeGeneratorGradedLast f g h hf hg hh d
  let Q := tripleCompleteIntersectionProjection f g h (d + a + b + c)
  have hF := F.finrank_range_add_finrank_ker
  have hM := M.finrank_range_add_finrank_ker
  have hL := L.finrank_range_add_finrank_ker
  have hQ := Q.finrank_range_add_finrank_ker
  have hFinj : Function.Injective F :=
    threeGeneratorGradedFirst_injective f g h hf hg hh hf0 d
  have hMex : LinearMap.range F = LinearMap.ker M :=
    threeGeneratorGraded_exact_middle f g h hf hg hh hg0 hf0 hrel d
  have hLex : LinearMap.range M = LinearMap.ker L :=
    threeGeneratorGraded_exact_last f g h hf hg hh hf0 hrel hregular d
  have hQex : LinearMap.range L = LinearMap.ker Q :=
    tripleCompleteIntersectionProjection_exact f g h hf hg hh d
  rw [LinearMap.ker_eq_bot.mpr hFinj, finrank_bot, add_zero] at hF
  rw [← hMex, hF, Module.finrank_prod] at hM
  rw [← hLex, Module.finrank_prod] at hL
  rw [tripleCompleteIntersectionProjection_range, ← hQex] at hQ
  simp only [Module.finrank_prod] at hM hL hQ ⊢
  omega

lemma four_homogeneous_finrank (d : ℕ) :
    finrank K (FourHomogeneous K d) = (d + 3).choose 3 := by
  rw [homogeneous_polynomial_finrank]
  have h : 4 + d - 1 = d + 3 := by omega
  rw [h]
  exact Nat.choose_symm_add

/-- The binomial identity giving Bézout length `3·3·3`. -/
lemma triple_cubic_choose_identity (d : ℕ) :
    27 + 3 * (d + 9).choose 3 + (d + 3).choose 3 =
      (d + 12).choose 3 + 3 * (d + 6).choose 3 := by
  simp only [Nat.add_succ, Nat.choose_succ_succ, Nat.choose_one_right,
    Nat.choose_zero_right]
  ring

/-- A regular intersection of three cubic surfaces in `P³` has constant
Hilbert function 27 from degree nine onward. -/
theorem triple_cubic_hilbert_twenty_seven
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous 3) (hg : g.IsHomogeneous 3)
    (hh : h.IsHomogeneous 3) (hf0 : f ≠ 0) (hg0 : g ≠ 0)
    (hrel : IsRelPrime f g)
    (hregular : ∀ x : MvPolynomial (Fin 4) K,
      h * x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)))
    (d : ℕ) :
    finrank K (tripleCompleteIntersectionComponent f g h (d + 9)) = 27 := by
  have hdim := tripleCompleteIntersection_hilbert_identity
    f g h hf hg hh hf0 hg0 hrel hregular d
  have hdim' :
      finrank K (tripleCompleteIntersectionComponent f g h (d + 9)) +
          (finrank K (FourHomogeneous K (d + 6)) +
            finrank K (FourHomogeneous K (d + 6)) +
            finrank K (FourHomogeneous K (d + 6))) +
          finrank K (FourHomogeneous K d) =
        finrank K (FourHomogeneous K (d + 9)) +
          (finrank K (FourHomogeneous K (d + 3)) +
            finrank K (FourHomogeneous K (d + 3)) +
            finrank K (FourHomogeneous K (d + 3))) := by
    exact hdim
  simp only [four_homogeneous_finrank] at hdim'
  have hdim'' :
      finrank K (tripleCompleteIntersectionComponent f g h (d + 9)) +
          ((d + 9).choose 3 + (d + 9).choose 3 + (d + 9).choose 3) +
          (d + 3).choose 3 =
        (d + 12).choose 3 +
          ((d + 6).choose 3 + (d + 6).choose 3 + (d + 6).choose 3) := by
    exact hdim'
  have hchoose := triple_cubic_choose_identity d
  clear hdim hdim'
  omega

/-- The binomial identity giving Bézout length `3·2·2`. -/
lemma cubic_two_quadrics_choose_identity (d : ℕ) :
    12 + (d + 7).choose 3 + 2 * (d + 8).choose 3 + (d + 3).choose 3 =
      (d + 10).choose 3 + 2 * (d + 5).choose 3 + (d + 6).choose 3 := by
  simp only [Nat.add_succ, Nat.choose_succ_succ, Nat.choose_one_right,
    Nat.choose_zero_right]
  ring

/-- A regular intersection of a cubic and two quadrics in `P³` has constant
Hilbert function 12 from degree seven onward. -/
theorem cubic_two_quadrics_hilbert_twelve
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous 3) (hg : g.IsHomogeneous 2)
    (hh : h.IsHomogeneous 2) (hf0 : f ≠ 0) (hg0 : g ≠ 0)
    (hrel : IsRelPrime f g)
    (hregular : ∀ x : MvPolynomial (Fin 4) K,
      h * x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)))
    (d : ℕ) :
    finrank K (tripleCompleteIntersectionComponent f g h (d + 7)) = 12 := by
  have hdim := tripleCompleteIntersection_hilbert_identity
    f g h hf hg hh hf0 hg0 hrel hregular d
  have hdim' :
      finrank K (tripleCompleteIntersectionComponent f g h (d + 7)) +
          (finrank K (FourHomogeneous K (d + 4)) +
            finrank K (FourHomogeneous K (d + 5)) +
            finrank K (FourHomogeneous K (d + 5))) +
          finrank K (FourHomogeneous K d) =
        finrank K (FourHomogeneous K (d + 7)) +
          (finrank K (FourHomogeneous K (d + 2)) +
            finrank K (FourHomogeneous K (d + 2)) +
            finrank K (FourHomogeneous K (d + 3))) := by
    exact hdim
  simp only [four_homogeneous_finrank] at hdim'
  have hdim'' :
      finrank K (tripleCompleteIntersectionComponent f g h (d + 7)) +
          ((d + 7).choose 3 + (d + 8).choose 3 + (d + 8).choose 3) +
          (d + 3).choose 3 =
        (d + 10).choose 3 +
          ((d + 5).choose 3 + (d + 5).choose 3 + (d + 6).choose 3) := by
    exact hdim'
  have hchoose := cubic_two_quadrics_choose_identity d
  clear hdim hdim'
  omega

/-- The binomial identity giving Bézout length `2·2·2`. -/
lemma triple_quadrics_choose_identity (d : ℕ) :
    8 + 3 * (d + 7).choose 3 + (d + 3).choose 3 =
      (d + 9).choose 3 + 3 * (d + 5).choose 3 := by
  simp only [Nat.add_succ, Nat.choose_succ_succ, Nat.choose_one_right,
    Nat.choose_zero_right]
  ring

/-- A regular intersection of three quadrics in `P³` has constant Hilbert
function eight from degree six onward. This is the Bézout calculation used in
the net-of-quadrics lemma of Section 4. -/
theorem triple_quadrics_hilbert_eight
    (f g h : MvPolynomial (Fin 4) K)
    (hf : f.IsHomogeneous 2) (hg : g.IsHomogeneous 2)
    (hh : h.IsHomogeneous 2) (hf0 : f ≠ 0) (hg0 : g ≠ 0)
    (hrel : IsRelPrime f g)
    (hregular : ∀ x : MvPolynomial (Fin 4) K,
      h * x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)) →
        x ∈ Ideal.span ({f, g} : Set (MvPolynomial (Fin 4) K)))
    (d : ℕ) :
    finrank K (tripleCompleteIntersectionComponent f g h (d + 6)) = 8 := by
  have hdim := tripleCompleteIntersection_hilbert_identity
    f g h hf hg hh hf0 hg0 hrel hregular d
  have hdim' :
      finrank K (tripleCompleteIntersectionComponent f g h (d + 6)) +
          (finrank K (FourHomogeneous K (d + 4)) +
            finrank K (FourHomogeneous K (d + 4)) +
            finrank K (FourHomogeneous K (d + 4))) +
          finrank K (FourHomogeneous K d) =
        finrank K (FourHomogeneous K (d + 6)) +
          (finrank K (FourHomogeneous K (d + 2)) +
            finrank K (FourHomogeneous K (d + 2)) +
            finrank K (FourHomogeneous K (d + 2))) := by
    exact hdim
  simp only [four_homogeneous_finrank] at hdim'
  have hdim'' :
      finrank K (tripleCompleteIntersectionComponent f g h (d + 6)) +
          ((d + 7).choose 3 + (d + 7).choose 3 + (d + 7).choose 3) +
          (d + 3).choose 3 =
        (d + 9).choose 3 +
          ((d + 5).choose 3 + (d + 5).choose 3 + (d + 5).choose 3) := by
    exact hdim'
  have hchoose := triple_quadrics_choose_identity d
  clear hdim hdim'
  omega

end

end PfaffianDescent
