import AllCharacteristics.RegularPairSquareZeroFiniteFlat
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.Ring

/-!
Replace the regular-pair-specific Koszul correction
by an arbitrary finite syzygy presentation. The reduced relation module
must be generated by the specified reduced matrix; its lifted columns
must satisfy the relation exactly. These are explicit algebraic inputs,
not flatness or deformation-lift conclusions.
-/

noncomputable section
namespace AllCharacteristics
open Module LinearMap TensorProduct
open scoped BigOperators
universe u v w t

section CoefficientCorrection
variable {A' : Type u} {A : Type v} [CommRing A'] [CommRing A]
variable {ι : Type w} {κ : Type t} [Fintype ι] [Fintype κ]

/-- A linear combination of exact syzygy columns is again a relation. -/
lemma finiteSyzygy_total_relation318
    (f : ι → A') (M : ι → κ → A')
    (hsyz : ∀ j, ∑ i, f i * M i j = 0) (b : κ → A') :
    ∑ i, (∑ j, M i j * b j) * f i = 0 := by
  calc
    (∑ i, (∑ j, M i j * b j) * f i) =
        ∑ j, b j * (∑ i, f i * M i j) := by
      simp only [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j hj
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ = 0 := by simp only [hsyz, mul_zero, Finset.sum_const_zero]

/-- Correct the coefficients of a prescribed lifted ideal element by
lifting a presentation of its reduced relation. Neither nilpotence nor
ambient flatness is needed for this exact coefficient calculation. -/
theorem liftedSyzygy_kernelCoefficients318
    (π : A' →+* A) (hπ : Function.Surjective π)
    (f : ι → A') (M : ι → κ → A')
    (hsyz : ∀ j, ∑ i, f i * M i j = 0)
    (hrelations : ∀ a : ι → A, (∑ i, a i * π (f i)) = 0 →
      ∃ b : κ → A, ∀ i, a i = ∑ j, π (M i j) * b j)
    (x : A') (hxK : x ∈ RingHom.ker π)
    (hxJ : x ∈ Ideal.span (Set.range f)) :
    ∃ a : ι → A', (∀ i, a i ∈ RingHom.ker π) ∧
      ∑ i, a i * f i = x := by
  classical
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hxJ
  have hrel : (∑ i, π (a i) * π (f i)) = 0 := by
    calc
      (∑ i, π (a i) * π (f i)) = π (∑ i, a i * f i) := by
        simp only [map_sum, map_mul]
      _ = 0 := by rw [ha]; exact RingHom.mem_ker.mp hxK
  obtain ⟨b, hb⟩ := hrelations (fun i => π (a i)) hrel
  choose b' hb' using fun j => hπ (b j)
  refine ⟨fun i => a i - ∑ j, M i j * b' j, ?_, ?_⟩
  · intro i
    rw [RingHom.mem_ker, map_sub, map_sum]
    simp only [map_mul, hb']
    rw [← hb i, sub_self]
  · simp only [sub_mul, Finset.sum_sub_distrib]
    rw [finiteSyzygy_total_relation318 f M hsyz b', sub_zero]
    exact ha

/-- A lifted finite syzygy presentation eliminates the whole ideal
intersection obstruction, extending165 beyond two generators. -/
theorem liftedSyzygy_kernel_inf_eq_mul318
    (π : A' →+* A) (hπ : Function.Surjective π)
    (f : ι → A') (M : ι → κ → A')
    (hsyz : ∀ j, ∑ i, f i * M i j = 0)
    (hrelations : ∀ a : ι → A, (∑ i, a i * π (f i)) = 0 →
      ∃ b : κ → A, ∀ i, a i = ∑ j, π (M i j) * b j) :
    RingHom.ker π ⊓ Ideal.span (Set.range f) =
      RingHom.ker π * Ideal.span (Set.range f) := by
  classical
  refine le_antisymm ?_ Ideal.mul_le_inf
  intro x hx
  obtain ⟨a, ha, hax⟩ := liftedSyzygy_kernelCoefficients318
    π hπ f M hsyz hrelations x hx.1 hx.2
  rw [← hax]
  exact Ideal.sum_mem _ fun i hi =>
    Ideal.mul_mem_mul (ha i) (Ideal.mem_span_range_self (x := i))

end CoefficientCorrection

end AllCharacteristics
end
