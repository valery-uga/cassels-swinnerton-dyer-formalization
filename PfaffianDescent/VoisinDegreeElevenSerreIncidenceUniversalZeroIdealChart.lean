import PfaffianDescent.VoisinDegreeElevenSerreIncidenceClosedFamily
import PfaffianDescent.VoisinDegreeElevenSerreIncidenceAffineZeroEquations

/-! # Literal chart ideals of the actual glued universal zero family -/
noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
namespace PfaffianDescent
universe u
set_option backward.isDefEq.respectTransparency false

/-- The actual globally glued universal zero ideal restricts to its actual
free-coordinate zero ideal on every universal surface--parameter chart. -/
theorem serreIncidenceUniversalZeroIdeal_comap_chart
    {K : Type u} [Field K] {X : Scheme.{u}}
    (base : X ⟶ Spec (.of K)) [IsSeparated base] (M : X.Modules)
    [FiniteDimensional K (SchemeModuleGlobalSectionsOver base M)]
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (C : SchemeModuleFiniteFreeAffineCover M ι)
    (ij : (C.projectiveSectionOpenCover base M).I₀) :
    (C.projectiveSectionLocalZeroGluedToAmbient base M).ker.comap
        ((C.projectiveSectionOpenCover base M).f ij) =
      C.projectiveSectionLocalZeroIdeal base M ij := by
  letI := C.isClosedImmersion_projectiveSectionLocalZeroGluedToAmbient base M
  letI := C.isIso_projectiveSectionLocalZeroGluedTargetPullbackι base M ij
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,
    ← pullbackSymmetry_hom_comp_snd,
    Scheme.Hom.ker_comp_of_isIso]
  rw [← Scheme.Hom.ker_comp_of_isIso
    (C.projectiveSectionLocalZeroGluedTargetPullbackι base M ij)]
  exact (congrArg Scheme.Hom.ker
    (C.projectiveSectionLocalZeroGluedTargetPullbackι_comp_snd base M ij)).trans
      (Scheme.IdealSheafData.ker_subschemeι _)

/-- Along an actual affine map into a universal product chart, the global
zero ideal is generated by the actual pulled-back section coordinates. -/
theorem serreIncidenceUniversalZeroIdeal_comap_affineChart
    {K : Type u} [Field K] {X B : Scheme.{u}} [IsAffine B]
    (base : X ⟶ Spec (.of K)) [IsSeparated base] (M : X.Modules)
    [FiniteDimensional K (SchemeModuleGlobalSectionsOver base M)]
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (C : SchemeModuleFiniteFreeAffineCover M ι)
    (ij : (C.projectiveSectionOpenCover base M).I₀)
    (f : B ⟶ (C.projectiveSectionOpenCover base M).X ij) :
    (C.projectiveSectionLocalZeroGluedToAmbient base M).ker.comap
        (f ≫ (C.projectiveSectionOpenCover base M).f ij) =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range fun a => f.appTop
          (BundleSectionZeroLocus.sectionCoordinateOfFreeIso ι
            (C.projectiveSectionLocalFreeIso base M ij)
            (C.projectiveSectionLocalUniversalSection base M ij) a))) := by
  rw [Scheme.IdealSheafData.comap_comp, serreIncidenceUniversalZeroIdeal_comap_chart]
  unfold SchemeModuleFiniteFreeAffineCover.projectiveSectionLocalZeroIdeal
  exact serreIncidenceZeroIdeal_comap_affine f ι _ _

end PfaffianDescent
